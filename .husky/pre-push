# 確保 git / gh 在 PATH（husky 環境 PATH 比 shell 窄）
export PATH="$PATH:/usr/local/bin:/opt/homebrew/bin:/Users/cheyuwu/.bun/bin"

# ─────────────────────────────────────────────────────────────────────────
# pre-push — 胼胝體鐵律 push 階段把關
#   canonical: BECOME §行動鐵律 5 / REFLEXES #68
#   設計: reports/multicore-git-coordination-design-2026-06-14.md §6.2
#
# 設計原則（兩類，刻意分開）：
#   A. coordination 檢查（REMOTE_AHEAD / in-flight deploy / 工具不可用）：advisory + bounded-wait，
#      「警告/等待但放行」，不 hard-block（避免打斷無人值守 routine；git+CI 自己處理硬情況）。
#   B. correctness 檢查（全站 article-health = CI ci-deploy 同款 mirror，2026-06-21 新增）：HARD fail → block。
#      理由：full sweep 紅＝CI 一定紅、deploy 一定不發生，提早在本機擋＝把失敗從 ci/cd 拉回 push
#      （哲宇 directive「不要一直等到 ci/cd 才發現」）。pre-commit 只驗 staged 檔，抓不到「新 check /
#      prettier mangle 讓不在本次 commit 的舊檔失格」這種 cross-file 失格——只有全掃抓得到。
#      self-preventing：每個 push 都擋 → 壞樹永遠 land 不了 main → 後續 routine 不會被別人的 mess 連坐。
#      逃生：TWMD_SKIP_PREPUSH_SWEEP=1（routine 真的不能停時；reflog 留痕，CI 仍會擋）。~4.5s on full corpus。
#   coordination 三件事：
#   1. REMOTE_AHEAD → 提醒先 rebase（git 自己會 reject non-ff，hook 不擋）
#   2. in-flight deploy 已跑 >70% 典型時長(245s/350s) → bounded 等它完，避免白白觸發 66% 取消
#   3. gh/工具不可用 → fail-loud 警告但放行（MANIFESTO §禁忌一：不 silent）
#   跳過等待：TWMD_SKIP_PREPUSH_WAIT=1（給不能等的 routine）；上限 TWMD_PREPUSH_MAXWAIT(秒)
# ─────────────────────────────────────────────────────────────────────────
REPO="$(git rev-parse --show-toplevel 2>/dev/null)" || exit 0

# 1. parallel-actor / remote-ahead 狀態（共用 lib，含 git fetch）
LIB="$REPO/scripts/tools/lib/check-parallel-actor.sh"
if [ -x "$LIB" ]; then
  st="$(sh "$LIB" --status 2>/dev/null || echo CLEAN)"
  case "$st" in
    REMOTE_AHEAD) echo "🧬 pre-push: ⚠️ origin 領先 — 建議先 git pull --rebase 再 push（避 ref-lock reject）" ;;
    ACTOR_BUSY)   echo "🧬 pre-push: ⚠️ 偵測到平行 git actor — 確認 push 範圍沒包到別 session 的檔（git log @{u}..）" ;;
    DIRTY_BATCH)  echo "🧬 pre-push: ⚠️ working tree 有大量未 commit .md（疑似 sibling 翻譯批次）— 確認沒掃到" ;;
  esac
fi

# 2. correctness gate — 全站 article-health（CI ci-deploy 同款 mirror）。HARD fail → block。
#    抓 pre-commit staged-only 抓不到的 cross-file 失格（新 check / prettier mangle 弄壞舊檔）。
#    ~4.5s。逃生：TWMD_SKIP_PREPUSH_SWEEP=1。先跑這個 → 壞樹直接擋，不用等下面 in-flight CI。
#    2026-08-22：加 push 目標判斷。全站掃描假設「腳下這棵樹是 main」——MAINTAINER §1b 的 P1
#    路徑要求 checkout 到投稿者分支去推格式修補，那一刻整棵樹是對方 fork 當下的快照，全掃紅的是
#    他兩天前叉出去這件事，不是這次 push（LESSONS `whole-tree-gate-judges-from-the-branch-it-is-standing-on`：
#    PR #1561 因 8/20 才 heal 進 main 的四張圖在那棵樹上不存在而被擋）。推到非本庫 remote 時
#    退成「只驗這次要 push 的 commit 動到的檔」——那是在那棵樹上唯一有意義的問題。
PUSH_URL="${2:-}"
case "$PUSH_URL" in
  *frank890417/taiwan-md*|"") SWEEP_SCOPE="all" ;;
  *)                          SWEEP_SCOPE="changed" ;;
esac

if [ "${TWMD_SKIP_PREPUSH_SWEEP:-0}" = "1" ]; then
  echo "🧬 pre-push: TWMD_SKIP_PREPUSH_SWEEP=1，跳過全站 article-health 全掃（CI 仍會擋）"
elif [ "$SWEEP_SCOPE" = "changed" ] && [ -f "$REPO/scripts/tools/article-health.py" ] && command -v python3 >/dev/null 2>&1; then
  # 推到別人的 fork（P1 heal-to-contributor-branch）：只驗本次 commit 動到的 knowledge/*.md
  # || true 不可省（2026-08-27）：兩個 grep 都沒命中時整條命令替換回非零，husky 是
  # `sh -e` 起的，賦值失敗會**靜默**結束整個 hook——沒有任何一行輸出，push 端只看到
  # 「husky - pre-push script failed (code 1)」。而「兩個 grep 都沒命中」正是 P1 路徑
  # 的常態：維護者上一個 main commit 多半是工具或文件，不含 knowledge/*.md。
  # 結果是格式債的 canonical default（§1b P1 推修補進投稿者分支）在維護者剛改完工具時
  # 一定失敗，且失敗訊息完全不指向原因。這跟本檔第 129 行那句「|| true 必要」是同一種病，
  # 教訓學在下面那一處、沒有 apply 到上面這一處。
  CHANGED="$( { git diff --name-only "@{u}"...HEAD 2>/dev/null; git show --name-only --pretty=format: HEAD 2>/dev/null; } | grep -E '^knowledge/.*\.md$' | sort -u || true)"
  if [ -n "$CHANGED" ]; then
    BAD=0
    for f in $CHANGED; do
      [ -f "$f" ] || continue
      python3 "$REPO/scripts/tools/article-health.py" "$f" --profile=ci-deploy --quiet >/dev/null 2>&1 || BAD=1
    done
    if [ "$BAD" = "1" ]; then
      echo "🧬 pre-push: ⛔ 本次改動的 knowledge/*.md 有 HARD fail — 修掉再推對方分支。"
      exit 1
    fi
  fi
  echo "🧬 pre-push: ✅ 本次改動檔全綠（推往非本庫 remote，全站掃描在對方樹上無意義，已退成 changed-only）"
elif [ -f "$REPO/scripts/tools/article-health.py" ] && command -v python3 >/dev/null 2>&1; then
  if ! python3 "$REPO/scripts/tools/article-health.py" --all --profile=ci-deploy --quiet >/dev/null 2>&1; then
    echo ""
    echo "🧬 pre-push: ⛔ 全站 article-health 有 HARD fail — CI 一定會紅、deploy 不會發生。先在本機修掉再 push。"
    echo "   哪幾篇＋哪個 check："
    echo "     python3 scripts/tools/article-health.py --all --profile=ci-deploy | grep -B30 'passed=False' | grep -E '🧬 knowledge|🔴'"
    echo "   這道 gate 防的是「新 check / prettier mangle 讓不在本次 commit 的舊檔失格」——pre-commit 只驗 staged 抓不到。"
    echo "   逃生（routine 真的不能停）：TWMD_SKIP_PREPUSH_SWEEP=1 git push …（reflog 留痕，CI 仍會擋）"
    exit 1
  fi
  echo "🧬 pre-push: ✅ 全站 article-health 全綠（ci-deploy mirror）"
fi

# 2b. correctness gate — UI 字串層語言正確性。HARD fail → block。~0.2s。
#     文章層有 cjk-leak-check 守著，src/i18n/*.ts 這層在 2026-08-11 之前一支都沒有，
#     於是同一種病靠讀者回報了三次：8/06 俄文讀者看到烏克蘭文介面、8/10 taiwan-shape
#     與回饋模組多語未譯（#1311/#1314）、8/11 ar 整段是簡體中文且用中國詞彙（#1318）。
#     UI 字串在每一頁都出現，曝光量遠高於任何單篇文章——保護密度不該跟曝光量成反比。
#     逃生：TWMD_SKIP_UI_LANG=1。
if [ "${TWMD_SKIP_UI_LANG:-0}" = "1" ]; then
  echo "🧬 pre-push: TWMD_SKIP_UI_LANG=1，跳過 UI 字串語言閘門（CI 仍會擋）"
elif [ -f "$REPO/scripts/tools/check-ui-language.mjs" ] && command -v node >/dev/null 2>&1; then
  if ! node "$REPO/scripts/tools/check-ui-language.mjs" >/dev/null 2>&1; then
    echo ""
    echo "🧬 pre-push: ⛔ UI 字串語言閘門有問題 — 某個語言的讀者會看到不是自己語言的字。"
    echo "   明細：npm run check:ui-lang"
    echo "   字形層：SIMPLIFIED_LEAK（簡體外洩）／UNTRANSLATED_CJK（整串沒翻）／TABLE_DRIFT（字串表落後語言註冊表）"
    echo "   語意層：PRC_TERM（zh-TW 用中國用語）／UNREADABLE_FOR_LOCALE（這語言的讀者讀不到任何一個字）"
    echo "   逃生：TWMD_SKIP_UI_LANG=1 git push …（reflog 留痕）"
    exit 1
  fi
  echo "🧬 pre-push: ✅ UI 字串語言閘門全綠"
fi

# 2b-2. correctness gate — 模板層的中文 fallback。HARD fail → block。~0.3s。
#     上面那道守 src/i18n/*.ts；**沒進字串表的中文它一個字也看不到**，而 .astro 裡
#     到處是 `{lang === 'en' ? '英文' : '中文'}`——對英文讀者是英文，對其他十一種語言
#     全部是中文。2026-08-17 首掃：8 個檔案 125 處，包含 /vi/contribute/ 底部整塊捐款區。
#     只擋「語言三元式把中文當 default」這類（判準硬）；沒有語言條件的裸中文只印不擋。
#     逃生：TWMD_SKIP_TMPL_LANG=1。
if [ "${TWMD_SKIP_TMPL_LANG:-0}" = "1" ]; then
  echo "🧬 pre-push: TWMD_SKIP_TMPL_LANG=1，跳過模板層語言閘門（CI 仍會擋）"
elif [ -f "$REPO/scripts/tools/check-template-language.mjs" ] && command -v node >/dev/null 2>&1; then
  if ! node "$REPO/scripts/tools/check-template-language.mjs" >/dev/null 2>&1; then
    echo ""
    echo "🧬 pre-push: ⛔ 模板層有中文 fallback — 非英文語言的讀者會在那些位置看到中文。"
    echo "   明細：npm run check:tmpl-lang"
    echo "   修法：把字串抽進 src/i18n/<module>.ts 走 t()，12 個語言區塊補齊"
    echo "   逃生：TWMD_SKIP_TMPL_LANG=1 git push …（reflog 留痕）"
    exit 1
  fi
  echo "🧬 pre-push: ✅ 模板層語言閘門全綠"
fi

# 2b. orphan gate — 譯本 translatedFrom 指向已刪除的中文 source ＝ CD prebuild exit 2、deploy 不發生。
#     pre-commit 只驗 staged，抓不到「rename/刪 zh 檔讓某語譯本變孤兒」這種 cross-file 後果。
#     觸發：2026-06-28 流行音樂與金曲獎→金曲獎 rename，fr 譯本用雙引號漏掉 sed → orphan 滑到 CD 才爆。
#     read-only --check（不寫 _translations.json）。grep 輸出抓 orphan（不靠 exit code，免被 out-of-sync 遮蔽）。
if [ "${TWMD_SKIP_PREPUSH_SWEEP:-0}" != "1" ] &&
  [ -f "$REPO/scripts/tools/sync-translations-json.py" ] &&
  command -v python3 >/dev/null 2>&1; then
  # || true 必要：--check 對 out-of-sync（非 orphan）也 exit 1，husky sh -e 下賦值失敗會靜默炸整個 hook
  # （2026-07-24 實測：article-health ✅ 後 hook 無訊息 fail code 1——正是下面註解說要避免的「被 out-of-sync 遮蔽」）
  tf_out="$(python3 "$REPO/scripts/tools/sync-translations-json.py" --check 2>&1 || true)"
  if printf '%s' "$tf_out" | grep -q "Orphan translations"; then
    echo ""
    echo "🧬 pre-push: ⛔ 偵測到 orphan 譯本（translatedFrom 指向已刪除的中文 source）— CD prebuild 會 exit 2、deploy 不會發生。先在本機修掉再 push。"
    printf '%s\n' "$tf_out" | grep -A6 "Orphan translations"
    echo "   修：把 orphan 譯本 frontmatter 的 translatedFrom 改指新 slug，或刪掉該譯本 + redirect。"
    echo "   逃生（routine 真的不能停）：TWMD_SKIP_PREPUSH_SWEEP=1 git push …（reflog 留痕，CI 仍會擋）"
    exit 1
  fi
fi

# 3. in-flight deploy 近完成 → 等它，避免白白取消（哲宇選 cancel-in-progress=true latest-wins）
if [ "${TWMD_SKIP_PREPUSH_WAIT:-0}" = "1" ]; then
  echo "🧬 pre-push: TWMD_SKIP_PREPUSH_WAIT=1，跳過 in-flight CI 等待"
elif command -v gh >/dev/null 2>&1; then
  MAXWAIT="${TWMD_PREPUSH_MAXWAIT:-120}"  # 等待上限，避免無限卡 routine
  # 「近完成」跟著實測的典型時長走，不寫死（REFLEXES #66 的校準原則，這裡把它做成每次重量）。
  # 2026-06-14 校準時一次 deploy 約 350s，寫死 THRESH=245、WAIT_WINDOW=900；2026-09-28 量到
  # 近五次成功中位 2,348s（Build 一步就 34 分鐘），於是第 4–15 分鐘的每次 push 白等 120 秒、
  # 最後照樣取消它，真正快跑完的第 37–40 分鐘反而直接取消。現在只在「剩下的時間 ≤ MAXWAIT」
  # 時才等；等不到的就直接 push。latest-wins 取消策略（哲宇選的）不變。
  # || true 不可省（同上面 2b 那條）：gh 有裝但沒登入（exit 4）、被限速或 API 出錯時，
  # 賦值失敗會讓 sh -e 靜默結束整個 hook，push 被擋卻一行訊息都沒有。投稿者裝了 gh
  # 但沒 gh auth login 是常態。
  TYPICAL="$(gh api "repos/{owner}/{repo}/actions/workflows/deploy.yml/runs?status=success&per_page=5" \
    --jq '[.workflow_runs[] | ((.updated_at|fromdate) - (.run_started_at|fromdate))] | sort | .[(length/2|floor)] | floor' 2>/dev/null || true)"
  case "$TYPICAL" in ''|*[!0-9]*) TYPICAL=350 ;; esac   # 查不到就用 06-14 的舊基準
  THRESH=$(( TYPICAL - MAXWAIT ))                     # 從這一刻起，等 MAXWAIT 有機會等到它完成
  [ "$THRESH" -lt 0 ] && THRESH=0
  WAIT_WINDOW=$(( TYPICAL + 600 ))                    # 超過典型時長十分鐘還沒完，不再當它快好了
  WAITED=0
  while :; do
    started="$(gh run list --workflow=deploy.yml --status=in_progress --json startedAt -q '.[0].startedAt' 2>/dev/null || true)"
    [ -z "$started" ] && break           # 無 in-flight deploy → 放行
    # -u 不可省：GitHub 回的 startedAt 是 UTC，但 macOS `date -j -f` 預設用「本機時區」
    # 解讀輸入（格式字串裡的 Z 是字面量，不是時區指示）。在 Asia/Taipei 會讓 epoch 少
    # 28800 秒，elapsed 因此永遠多算 8 小時 —— 恆大於 WAIT_WINDOW=900，於是每一次 push 都被
    # 判成 zombie，「近完成就等它」這條分支從寫下來到 2026-08-09 從沒真正跑過一次。
    start_epoch="$(date -j -u -f "%Y-%m-%dT%H:%M:%SZ" "$started" +%s 2>/dev/null || echo 0)"
    elapsed=$(( $(date -u +%s) - start_epoch ))
    if [ "$start_epoch" -eq 0 ] || [ "$elapsed" -lt "$THRESH" ]; then
      echo "🧬 pre-push: in-flight deploy 還早（${elapsed}s，典型 ${TYPICAL}s，等 ${MAXWAIT}s 也等不到）— 直接 push，cancel-in-progress 接手 latest-wins"
      break
    fi
    if [ "$elapsed" -gt "$WAIT_WINDOW" ]; then
      echo "🧬 pre-push: in-flight run 已跑 ${elapsed}s（超過 ${WAIT_WINDOW}s 等待窗口，無法只憑耗時判定卡住）— 依 latest-wins 策略放行"
      break
    fi
    if [ "$WAITED" -ge "$MAXWAIT" ]; then
      echo "🧬 pre-push: 等了 ${WAITED}s deploy 仍未完，放行（不無限等）"
      break
    fi
    echo "🧬 pre-push: in-flight deploy 已跑 ${elapsed}s（近完成）— 等它跑完免白白取消（${WAITED}/${MAXWAIT}s）"
    sleep 15; WAITED=$(( WAITED + 15 ))
  done
else
  echo "🧬 pre-push: ⚠️ gh 不可用，跳過 in-flight CI 檢查（fail-loud allow，per §禁忌一不 silent）"
fi

exit 0
