{
  "name": "taiwan-md",
  "type": "module",
  "version": "1.4.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "postinstall": "bash scripts/core/sync.sh",
    "twmd": "node scripts/twmd.mjs",
    "dev": "npm run prebuild:sync && npm run prebuild:gitinfo && (python3 scripts/core/generate-newsroom-data.py --quiet || true) && NODE_OPTIONS=\"${NODE_OPTIONS:---max-old-space-size=8192}\" astro dev",
    "prebuild": "npm run prebuild:icons && npm run prebuild:sync && npm run prebuild:status && npm run prebuild:aliases && run-p prebuild:api prebuild:map prebuild:dashboard prebuild:changelog prebuild:contributors prebuild:verify-contributors prebuild:supporters prebuild:china-terms prebuild:fork-graph prebuild:spores prebuild:buildperf prebuild:langswitch prebuild:og prebuild:i18n prebuild:content-dates prebuild:gitinfo prebuild:content-stats prebuild:i18n-progress prebuild:llms prebuild:stats && npm run prebuild:search && npm run prebuild:latest && npm run prebuild:redirects",
    "prebuild:sync": "bash scripts/core/sync.sh",
    "prebuild:status": "python3 scripts/tools/lang-sync/status.py && python3 scripts/tools/sync-translations-json.py && python3 scripts/tools/sync-spore-links.py --apply",
    "prebuild:api": "node scripts/core/generate-api.js",
    "prebuild:map": "node scripts/core/generate-map-markers.js",
    "prebuild:search": "node scripts/core/build-search-index.mjs",
    "prebuild:dashboard": "python3 scripts/tools/article-health.py --all --profile=dashboard --output=json --baseline-out scripts/tools/.quality-baseline.json > scripts/tools/.health-sweep.json && python3 scripts/core/generate-dashboard-immune.py --health-in scripts/tools/.health-sweep.json && node scripts/core/generate-dashboard-data.js && python3 scripts/core/generate-dashboard-forks.py && node scripts/core/generate-dashboard-alerts.mjs && python3 scripts/core/generate-newsroom-data.py --quiet && node scripts/core/generate-dashboard-status.mjs",
    "prebuild:changelog": "node scripts/core/generate-changelog-data.js",
    "prebuild:contributors": "node scripts/core/generate-contributors-data.js",
    "prebuild:verify-contributors": "node scripts/tools/verify-contributors.mjs",
    "prebuild:supporters": "node scripts/core/generate-supporters-data.js",
    "prebuild:china-terms": "python3 scripts/core/extract-china-terms.py --quiet",
    "prebuild:fork-graph": "python3 scripts/core/generate-fork-graph-data.py",
    "prebuild:spores": "python3 scripts/tools/generate-spore-records.py && python3 scripts/tools/generate-dashboard-spores.py",
    "prebuild:buildperf": "node scripts/core/extract-build-perf.mjs --runs 30 || true",
    "prebuild:aliases": "node scripts/core/generate-article-aliases.mjs",
    "prebuild:langswitch": "node scripts/core/generate-lang-switch-map.mjs",
    "prebuild:og": "node scripts/core/generate-og-images.mjs",
    "prebuild:i18n": "bash scripts/tools/i18n-coverage-audit.sh --json-out public/api/dashboard-i18n.json",
    "prebuild:content-dates": "node scripts/core/build-content-dates.mjs",
    "prebuild:latest": "node scripts/core/build-latest.mjs",
    "prebuild:content-stats": "node scripts/tools/generate-content-stats.js",
    "prebuild:i18n-progress": "python3 scripts/utils/i18n-status.py >/dev/null",
    "prebuild:llms": "python3 scripts/tools/refresh-llms-txt.py || true",
    "prebuild:stats": "bash scripts/tools/update-stats.sh || true",
    "build": "astro build",
    "test": "npm run test:markdown && npm run test:heading-id && node scripts/core/test-frontmatter.mjs",
    "test:ci": "npm run test:markdown && npm run test:heading-id && node scripts/core/test-frontmatter.mjs --ci",
    "test:markdown": "node --test tests/markdown-cjk.test.mjs tests/category-hub-links.test.mjs",
    "test:heading-id": "node --experimental-strip-types --test tests/article-heading-id.test.mjs",
    "test:anchors": "node --experimental-strip-types --test tests/article-anchor-integrity.test.mjs",
    "test:footnote": "node --experimental-strip-types --test tests/article-footnote.test.mjs",
    "test:terminology-wording": "node --experimental-strip-types --test tests/terminology-wording.test.mjs",
    "postbuild": "node scripts/core/emit-sitemap-alias.mjs && node scripts/tools/check-url-contract.mjs --strict",
    "postbuild:smoke": "node scripts/core/post-build-check.mjs",
    "postbuild:internal-links": "bash scripts/tools/verify-internal-links.sh",
    "preview": "astro preview",
    "sync": "bash scripts/core/sync.sh",
    "sync:build": "bash scripts/core/sync.sh && astro build",
    "check-images": "node scripts/utils/check-images.mjs",
    "check-links": "bash scripts/utils/check-links.sh",
    "check-internal-links": "bash scripts/tools/verify-internal-links.sh",
    "check:font-gate": "node scripts/tools/check-font-gate.mjs",
    "article-health": "python3 scripts/tools/article-health.py",
    "image-ingest": "node scripts/tools/image-ingest.mjs",
    "article-health:all": "python3 scripts/tools/article-health.py --all --profile=dashboard --output=json",
    "article-health:test": "python3 -m pytest tests/article_health -q",
    "test:python": "python3 -m pytest tests -q",
    "feedback:triage": "node scripts/feedback/triage.mjs",
    "feedback:test": "node --test scripts/feedback/*.test.mjs",
    "feedback:uxtest": "node tests/feedback/widget.uxtest.mjs",
    "test:404-mojibake": "node tests/404-mojibake.uxtest.mjs",
    "test:404-dup-lang": "node tests/404-dup-lang-prefix.uxtest.mjs",
    "feedback:devtest": "PUBLIC_FEEDBACK_MODE=mock astro dev --port 4330",
    "visual:baseline": "node scripts/visual/capture-baseline.mjs --baseline",
    "visual:capture": "node scripts/visual/capture-baseline.mjs",
    "visual:diff": "node scripts/visual/diff.mjs",
    "visual:check": "node scripts/visual/capture-baseline.mjs && node scripts/visual/diff.mjs",
    "astro": "astro",
    "format::check": "prettier --check .",
    "format::write": "prettier --write .",
    "og:generate": "node scripts/core/generate-og-images.mjs",
    "prepare": "husky",
    "prebuild:gitinfo": "node scripts/core/build-git-info.mjs",
    "prebuild:redirects": "node scripts/core/generate-redirects.mjs",
    "check:url-contract": "node scripts/tools/check-url-contract.mjs",
    "check:ui-lang": "node scripts/tools/check-ui-language.mjs",
    "check:tmpl-lang": "node scripts/tools/check-template-language.mjs",
    "check:rendered-lang": "node scripts/tools/check-rendered-language.mjs --dist dist --lang ar",
    "check:sticky": "node scripts/tools/check-sticky-viewport.mjs",
    "test:contracts": "npm run test:markdown && npm run test:heading-id && npm run test:anchors && npm run test:footnote && npm run test:terminology-wording && node --test tests/pr-changed-files.test.mjs tests/dashboard-coverage.test.mjs tests/dashboard-safe-html.test.mjs tests/ui-icons.test.mjs workers/mcp/test/*.test.js && npm run feedback:test",
    "check:types": "astro check --minimumFailingSeverity error --minimumSeverity error",
    "prebuild:icons": "node scripts/core/generate-icons.mjs"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.0",
    "@astrojs/rss": "^4.0.17",
    "@astrojs/sitemap": "^3.7.1",
    "@supabase/supabase-js": "^2.106.2",
    "@tailwindcss/vite": "^4.2.2",
    "astro": "^7.3.1",
    "d3": "^7.9.0",
    "gray-matter": "^4.0.3",
    "marked": "^17.0.4",
    "marked-cjk-friendly": "^0.1.0",
    "minisearch": "^7.2.0",
    "rehype-external-links": "^3.0.0",
    "remark-wiki-link": "^2.0.1",
    "tailwindcss": "^4.2.2"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@types/d3": "^7.4.3",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "npm-run-all2": "^8.0.4",
    "opencc-js": "^1.0.5",
    "parse5": "^8.0.1",
    "pixelmatch": "^6.0.0",
    "playwright": "^1.59.1",
    "pngjs": "^7.0.0",
    "prettier": "^3.8.1",
    "prettier-plugin-astro": "0.14.1",
    "sharp": "^0.35.4",
    "typescript": "^5.9.3"
  },
  "bin": {
    "twmd": "./scripts/twmd.mjs"
  }
}
