---
export interface Props {
  slug: string;
  href: string;
  name: string;
  description: string;
  count: number;
  articleLabel: string;
  ctaLabel: string;
  height: 'tall' | 'medium' | 'short';
}

const { slug, href, name, description, count, articleLabel, ctaLabel, height } =
  Astro.props;

const minHeightMap = {
  tall: '26rem',
  medium: '20rem',
  short: '16rem',
};
const minHeight = minHeightMap[height];

// Per-category accent colors
const accentMap: Record<string, string> = {
  history: '#8B5E3C',
  geography: '#2D7D5A',
  culture: '#C17D5E',
  food: '#D4843A',
  art: '#7A5EA8',
  music: '#2A7FA5',
  technology: '#2D6E8A',
  nature: '#3A8A4A',
  people: '#B54B4B',
  society: '#5E6EA8',
  economy: '#4A7A6A',
  lifestyle: '#A06878',
  politics: '#7C2D12',
};
const accent = accentMap[slug] ?? '#006D77';

// Per-category animation keyframe name
const animMap: Record<string, string> = {
  history: 'floatScroll',
  geography: 'floatDrift',
  culture: 'floatSwing',
  food: 'floatPulse',
  art: 'floatBrush',
  music: 'floatWave',
  technology: 'floatGlow',
  nature: 'floatDrift',
  people: 'floatSwing',
  society: 'floatPulse',
  economy: 'floatRise',
  lifestyle: 'floatDrift',
  politics: 'floatDrift',
};
const anim = animMap[slug] ?? 'floatDrift';

const cardId = `tc-${slug}`;
import { categoryIcons, iconSvg } from '../icons/taiwan-icons.mjs';

// categoryIcons 來自 .mjs，推不出索引簽章；slug 是任意字串，查不到就退 island
const iconMap: Record<string, string> = categoryIcons;
---

<!--
  Phase 4 leaf migration #14 (final): TopicCard.astro
  ───────────────────────────────────────────────────
  - Scoped <style> block removed entirely (~305 lines CSS deleted)
  - All per-category state (accent color, float-icon animation name,
    min-height) continues to flow through inline CSS variables
    (--accent / --min-h / --anim) from frontmatter; Tailwind arbitrary
    values read those vars wherever needed.
  - 8 @keyframes (floatDrift / floatSwing / floatPulse / floatGlow /
    floatWave / floatScroll / floatBrush / floatRise) moved to
    src/styles/global.css so the dynamic `var(--anim)` reference in
    the group-hover arbitrary animation utility can find them.
  - `group` + `group-hover:` propagates hover state from the root <a>
    to the watermark, title, float icon, and CTA arrow — replaces the
    old `.topic-card:hover .xxx` scoped rules.
  - motion-reduce: variants replace the old
    `@media (prefers-reduced-motion: reduce)` block.
  - color-mix(in srgb, var(--accent) X%, ...) is preserved verbatim
    inside arbitrary utilities using underscore-for-space syntax.
-->
<a
  id={cardId}
  href={href}
  class="group relative block min-h-[var(--min-h)] cursor-pointer overflow-hidden rounded-[1.25rem] no-underline shadow-[0_2px_8px_color-mix(in_srgb,var(--accent)_12%,transparent),0_1px_2px_rgba(0,0,0,0.06)] transition-[transform,box-shadow] duration-[350ms] [transition-timing-function:cubic-bezier(0.34,1.56,0.64,1)] hover:-translate-y-1.5 hover:shadow-[0_16px_40px_color-mix(in_srgb,var(--accent)_22%,transparent),0_4px_12px_rgba(0,0,0,0.1)] focus-visible:outline focus-visible:outline-[3px] focus-visible:outline-offset-[3px] focus-visible:outline-[#006d77] motion-reduce:transform-none motion-reduce:transition-none motion-reduce:hover:transform-none motion-reduce:hover:shadow-[0_2px_8px_color-mix(in_srgb,var(--accent)_20%,transparent)]"
  aria-label={name}
  style={`--accent: ${accent}; --min-h: ${minHeight}; --anim: ${anim};`}
>
  <div
    class="absolute inset-0 z-0 rounded-[inherit] border border-[color-mix(in_srgb,var(--accent)_18%,transparent)] bg-[color-mix(in_srgb,var(--accent)_6%,#f8f1e9)]"
    aria-hidden="true"
  >
  </div>

  <div
    class="absolute inset-0 z-0 rounded-[inherit] opacity-[0.045] [background-image:repeating-linear-gradient(45deg,var(--accent)_0px,var(--accent)_1px,transparent_1px,transparent_12px),repeating-linear-gradient(-45deg,var(--accent)_0px,var(--accent)_1px,transparent_1px,transparent_12px)]"
    aria-hidden="true"
  >
  </div>

  <div
    class="pointer-events-none absolute -bottom-4 -right-2 z-0 w-28 text-[var(--accent)] opacity-[0.05] transition-opacity duration-[350ms] ease group-hover:opacity-[0.09]"
    aria-hidden="true"
  >
    <!-- 行島縮版：路徑來自真實海岸線（舊版是手畫的橄欖形，REFLEXES #61） -->
    <Fragment set:html={iconSvg('island', '', 'h-auto w-full')} />
  </div>

  <div
    class="pointer-events-none absolute right-5 top-5 z-[2] h-12 w-12 translate-y-[6px] scale-[0.85] text-[var(--accent)] opacity-0 transition-[opacity,transform] duration-300 [transition-timing-function:cubic-bezier(0.34,1.56,0.64,1)] group-hover:translate-y-0 group-hover:scale-100 group-hover:opacity-[0.85] group-hover:[animation:var(--anim)_2.5s_ease-in-out_infinite] [&_svg]:h-full [&_svg]:w-full motion-reduce:transform-none motion-reduce:group-hover:animate-none motion-reduce:group-hover:transform-none"
    aria-hidden="true"
  >
    <Fragment set:html={iconSvg(iconMap[slug] ?? 'island')} />
  </div>

  <div
    class="relative z-[1] flex h-full min-h-[var(--min-h)] flex-col px-6 pb-6 pt-7"
  >
    <div class="mb-[0.85rem] flex items-baseline">
      <span
        class="font-['Noto_Serif_TC','Georgia',serif] text-[2rem] font-bold leading-none -tracking-[0.02em] text-[#c17d5e]"
      >
        {count}
      </span>
      <span
        class="font-['Satoshi','Noto_Sans_TC',sans-serif] text-[0.8rem] font-medium tracking-[0.03em] text-[#a8634a]"
      >
        &nbsp;{articleLabel}
      </span>
    </div>
    <h3
      class="mb-[0.65rem] mt-0 font-['Noto_Serif_TC','Georgia',serif] text-[clamp(1.25rem,2vw,1.625rem)] font-bold leading-[1.3] text-[#1a3c34] transition-colors duration-[250ms] ease group-hover:text-[#006d77]"
    >
      {name}
    </h3>
    <p
      class="mx-0 mb-5 mt-0 flex-1 font-['Satoshi','Noto_Sans_TC',sans-serif] text-[0.9rem] leading-[1.75] text-[#4a6560]"
    >
      {description}
    </p>
    <div
      class="mt-auto flex items-center gap-1 font-['Satoshi','Noto_Sans_TC',sans-serif] text-[0.875rem] font-semibold tracking-[0.01em] text-[#006d77]"
    >
      <span>{ctaLabel}</span>
      <span
        class="inline-block transition-transform duration-[250ms] [transition-timing-function:cubic-bezier(0.34,1.56,0.64,1)] group-hover:translate-x-1 motion-reduce:transform-none motion-reduce:group-hover:transform-none"
        set:html={iconSvg('arrow')}
      />
    </div>
  </div>
</a>
