---
/**
 * AboutMilestones：「Taiwan.md 的誕生」整條時間軸（2026-11-19 關於頁進化 v3）。
 *
 * 哲宇：「時間軸不要再讓他們額外展開了。想要探索到後面的人，應該就會想要看那些故事。」
 * 「橫向滾動在電腦版跟手機版上面都不是一個好的 UI/UX。」
 *
 * 所以這裡不再有橫向那一排里程碑卡、左右鍵、也不再收合。27 則全部直接排出來，
 * 由上往下讀：
 *
 *   1. 比例軸   一條照實際日期畫的橫軸（只在寬螢幕出現，不能點、不捲動）。
 *               細線是一則紀錄，圓點是里程碑，讓人一眼看見開站頭三週有多擠。
 *   2. 時間軸   依月份分組。寬螢幕左邊是月份欄（跟著那一組黏在畫面上），
 *               右邊是一欄好讀的正文；手機收成單欄，月份變成每組的小標。
 *               里程碑的圓點比較大、標題比較重，其他條目是空心小點。
 *
 * 每一則的內容（日期、標題、本文、媒體報導、延伸閱讀）都來自 about.ts 既有的
 * about.timeline.<key>.* 字串，13 語都有；月份小標用 Intl 依語言排，不另寫字串。
 * 每一則保留 id="tl-<key>"，舊連結照樣能直接跳到那一則。
 */
import type { Lang } from '../../types';
import { useTranslations } from '../../i18n/utils';
import type { TranslationKey } from '../../i18n/utils';
import { useAboutStrings, isEnglishFallback } from './strings';

/**
 * 本文的一段：字串是一個段落（about.timeline.<key>.<part>；結尾 .html 的照 HTML 輸出），
 * 字串陣列是一張條列（每一項一個子鍵）。
 */
export type TimelineBodyPart = string | string[];

export interface TimelinePress {
  href: string;
  source: string;
  title: string;
}

export interface TimelineEntry {
  /** about.timeline.<key>.* 的 key */
  key: string;
  /** ISO 日期；沒有單一日期的條目（2024—2025、持續進行中）給 null */
  date: string | null;
  milestone?: boolean;
  /** 本文由哪些子鍵組成，依序輸出。沒給就是 ['desc.html'] */
  body?: TimelineBodyPart[];
  /** 這一則附帶的媒體報導 */
  press?: TimelinePress[];
  /** 「關於」分類底下對應的長文 */
  related?: { href: string; label: string };
}

interface Props {
  lang: Lang;
  entries: TimelineEntry[];
  /** 軸的右端（今天）；ISO 日期 */
  today: string;
}
const { lang, entries, today } = Astro.props;
const t = useTranslations(lang);
const s = useAboutStrings(lang);
const tk = (k: string) => t(k as TranslationKey);
const fallbackEn = isEnglishFallback(lang, 'about.milestones.caption');

const DAY = 86_400_000;
const toMs = (iso: string) => Date.parse(`${iso}T00:00:00Z`);

const dated = entries.filter((e) => e.date) as (TimelineEntry & {
  date: string;
})[];
const milestones = dated.filter((e) => e.milestone);

// ── 比例軸 ─────────────────────────────────────────────────────────
// 從第一則有日期的條目那個月的 1 號，到今天（至少比最後一則多一週）
const first = new Date(toMs(dated[0].date));
const axisStart = Date.UTC(first.getUTCFullYear(), first.getUTCMonth(), 1);
const lastEntry = toMs(dated[dated.length - 1].date);
const axisEnd = Math.max(toMs(today), lastEntry + 7 * DAY);
const pos = (ms: number) =>
  Math.round(((ms - axisStart) / (axisEnd - axisStart)) * 10000) / 100;

const monthFmt = new Intl.DateTimeFormat(lang, {
  month: 'short',
  timeZone: 'UTC',
});
const months: { left: number; label: string }[] = [];
for (
  let d = new Date(axisStart);
  d.getTime() < axisEnd;
  d = new Date(Date.UTC(d.getUTCFullYear(), d.getUTCMonth() + 1, 1))
) {
  months.push({ left: pos(d.getTime()), label: monthFmt.format(d) });
}
const axisYear = first.getUTCFullYear();

// ── 分組：有日期的依年月，沒有單一日期的自成一組 ──────────────────
// 月份與年份分開排（月份大、年份小）。各自單獨格式化，中日韓才會帶上「月」「年」。
const dtf = (opts: Intl.DateTimeFormatOptions) => {
  try {
    return new Intl.DateTimeFormat(lang, {
      ...opts,
      timeZone: 'UTC',
      numberingSystem: 'latn',
    });
  } catch {
    return new Intl.DateTimeFormat(lang, { ...opts, timeZone: 'UTC' });
  }
};
const groupMonthFmt = dtf({ month: 'long' });
const groupYearFmt = dtf({ year: 'numeric' });
const groupFullFmt = dtf({ year: 'numeric', month: 'long' });

interface Group {
  id: string;
  /** 有日期的組：年與月分開排（月份大、年份小） */
  year?: string;
  month?: string;
  /** 有日期的組的完整名稱（例如「2026年3月」），給輔助科技念 */
  full?: string;
  /** 沒有單一日期的組：直接用那一則的日期字串 */
  span?: string;
  datetime?: string;
  undated: boolean;
  items: TimelineEntry[];
}
const groups: Group[] = [];
for (const e of entries) {
  if (!e.date) {
    groups.push({
      id: `tl-g-${e.key}`,
      span: tk(`about.timeline.${e.key}.date`),
      undated: true,
      items: [e],
    });
    continue;
  }
  const ym = e.date.slice(0, 7);
  const last = groups[groups.length - 1];
  if (last && !last.undated && last.datetime === ym) {
    last.items.push(e);
    continue;
  }
  const d = new Date(toMs(`${ym}-01`));
  groups.push({
    id: `tl-g-${ym}`,
    year: groupYearFmt.format(d),
    month: groupMonthFmt.format(d),
    full: groupFullFmt.format(d),
    datetime: ym,
    undated: false,
    items: [e],
  });
}

// 本文：一個 HTML 段落裡用兩個 <br/> 隔開的，拆成真的段落，段距才讀得出來
const splitParas = (html: string) =>
  html
    .split(/<br\s*\/?>\s*<br\s*\/?>/i)
    .map((x) => x.trim())
    .filter(Boolean);
const bodyOf = (e: TimelineEntry) => e.body ?? ['desc.html'];
const k = (e: TimelineEntry, part: string) => `about.timeline.${e.key}.${part}`;
---

<div class="ab-ms" data-ab-ms>
  <!-- 比例軸：看疏密用，不能點。補翻前退英文的只有這段圖說，
       所以 data-fallback-en 只標在這裡，不讓下面已翻好的時間軸跟著改排方向 -->
  <figure
    class="ab-ms__axis-wrap"
    data-fallback-en={fallbackEn ? '' : undefined}
  >
    <div
      class="ab-ms__axis"
      role="img"
      aria-label={s('about.milestones.caption')}
    >
      <span class="ab-ms__year">{axisYear}</span>
      {
        months.map((m) => (
          <span class="ab-ms__month" style={`--x:${m.left}%`}>
            {m.label}
          </span>
        ))
      }
      <span class="ab-ms__line"></span>
      {
        dated.map((e) => (
          <span class="ab-ms__tick" style={`--x:${pos(toMs(e.date))}%`} />
        ))
      }
      {
        milestones.map((e) => (
          <span class="ab-ms__dot" style={`--x:${pos(toMs(e.date))}%`} />
        ))
      }
      <span class="ab-ms__now" style="--x:100%"></span>
    </div>
    <figcaption class="ab-ms__caption">
      {s('about.milestones.caption')}
    </figcaption>
  </figure>

  <!-- 完整時間軸：27 則全部直接排出來 -->
  <div class="tl">
    {
      groups.map((g) => (
        <section
          class:list={['tl-group', g.undated && 'tl-group--undated']}
          aria-labelledby={g.id}
        >
          <h3 class="tl-rail" id={g.id}>
            {g.undated ? (
              <span class="tl-rail__span">
                <span dir="auto">{g.span}</span>
              </span>
            ) : (
              <time class="tl-rail__when" datetime={g.datetime}>
                <span class="tl-rail__month" aria-hidden="true">
                  {g.month}
                </span>
                <span class="tl-rail__year" aria-hidden="true">
                  {g.year}
                </span>
                <span class="tl-sr">{g.full}</span>
              </time>
            )}
          </h3>
          <ol class="tl-list">
            {g.items.map((e) => (
              <li
                class:list={[
                  'tl-item',
                  e.milestone && 'tl-item--milestone',
                  e.key === 'ongoing' && 'tl-item--now',
                ]}
                id={`tl-${e.key}`}
              >
                <span class="tl-item__dot" aria-hidden="true" />
                {!g.undated && (
                  <p class="tl-item__date">
                    <time datetime={e.date ?? undefined} dir="auto">
                      {tk(k(e, 'date'))}
                    </time>
                  </p>
                )}
                <h4 class="tl-item__title">{tk(k(e, 'title'))}</h4>
                <div class="tl-item__body">
                  {bodyOf(e).map((part) =>
                    Array.isArray(part) ? (
                      <ul class="tl-item__list">
                        {part.map((li) => (
                          <li>{tk(k(e, li))}</li>
                        ))}
                      </ul>
                    ) : part.endsWith('.html') ? (
                      splitParas(tk(k(e, part))).map((html) => (
                        <p set:html={html} />
                      ))
                    ) : (
                      <p>{tk(k(e, part))}</p>
                    ),
                  )}
                </div>
                {e.press && e.press.length > 0 && (
                  <ul class="tl-press">
                    {e.press.map((p) => (
                      <li>
                        <a
                          class="tl-press__link"
                          href={p.href}
                          target="_blank"
                          rel="noopener"
                        >
                          <span class="tl-press__source">{p.source}</span>
                          <span class="tl-press__title">{p.title}</span>
                        </a>
                      </li>
                    ))}
                  </ul>
                )}
                {e.related && (
                  <p class="tl-item__more">
                    <a
                      class="tl-item__related"
                      href={e.related.href}
                      data-ga-section="about_origin"
                      data-ga-label={`related_${e.key}`}
                    >
                      <span dir="auto">{e.related.label}</span>
                      <span class="tl-item__arrow" aria-hidden="true">
                        →
                      </span>
                    </a>
                  </p>
                )}
              </li>
            ))}
          </ol>
        </section>
      ))
    }
  </div>
</div>

<style>
  .ab-ms {
    --ms-dot: 0.75rem;
    --ms-line: var(--ab-rule-strong);
  }

  /* ── 比例軸 ─────────────────────────────────────────────── */
  .ab-ms__axis-wrap {
    margin: 0 0 var(--ab-gap-l);
  }
  .ab-ms__axis {
    position: relative;
    block-size: 3.75rem;
  }
  .ab-ms__year,
  .ab-ms__month {
    position: absolute;
    inset-block-start: 0;
    font-family: var(--font-interface);
    font-size: 0.6875rem;
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.04em;
    line-height: 1;
    color: var(--color-ink-soft);
    white-space: nowrap;
  }
  .ab-ms__year {
    inset-inline-start: 0;
    font-weight: 700;
    color: var(--color-ink);
  }
  .ab-ms__month {
    inset-block-start: 1.125rem;
    inset-inline-start: var(--x);
    padding-inline-start: 0.375rem;
  }
  .ab-ms__month::before {
    content: '';
    position: absolute;
    inset-inline-start: 0;
    inset-block-start: -0.125rem;
    inline-size: 1px;
    block-size: 2.25rem;
    background: var(--ab-rule);
  }
  .ab-ms__line {
    position: absolute;
    inset-inline: 0;
    inset-block-end: 0.75rem;
    block-size: 1px;
    background: var(--ms-line);
  }
  .ab-ms__tick {
    position: absolute;
    inset-inline-start: var(--x);
    inset-block-end: calc(0.75rem - 0.375rem);
    inline-size: 1px;
    block-size: 0.75rem;
    background: var(--color-ink-soft);
    opacity: 0.7;
  }
  .ab-ms__dot,
  .ab-ms__now {
    position: absolute;
    inset-inline-start: var(--x);
    inset-block-end: calc(0.75rem - var(--ms-dot) / 2);
    inline-size: var(--ms-dot);
    block-size: var(--ms-dot);
    margin-inline-start: calc(var(--ms-dot) / -2);
    border-radius: 50%;
    background: var(--ab-brand);
    box-shadow: 0 0 0 2px var(--ab-section-bg);
  }
  .ab-ms__now {
    background: var(--ab-section-bg);
    box-shadow:
      inset 0 0 0 2px var(--ab-brand),
      0 0 0 2px var(--ab-section-bg);
  }
  .ab-ms__caption {
    margin: 0.625rem 0 0;
    max-inline-size: 60%;
    font-family: var(--font-interface);
    font-size: 0.75rem;
    line-height: 1.6;
    color: var(--color-ink-soft);
  }

  /* ── 時間軸 ─────────────────────────────────────────────── */
  .tl {
    /* 月份欄寬、欄距、線的位置（從正文欄的起始邊往回量） */
    --tl-rail: 9.5rem;
    --tl-gap: 2.75rem;
    --tl-indent: 2rem;
    --tl-line-x: 0.4375rem;
    --tl-dot: 0.625rem;
    --tl-dot-ms: 0.9375rem;
    --tl-body: color-mix(in srgb, var(--color-ink) 82%, var(--ab-section-bg));
    position: relative;
    max-inline-size: calc(var(--tl-rail) + var(--tl-gap) + 44rem);
    margin-inline: auto;
  }
  /* 一條不斷的線，貫穿所有月份 */
  .tl::before {
    content: '';
    position: absolute;
    inset-block: 0.75rem 0;
    inset-inline-start: calc(var(--tl-rail) + var(--tl-gap) + var(--tl-line-x));
    inline-size: 1px;
    background: linear-gradient(
      to bottom,
      var(--ab-rule-strong),
      var(--ab-rule-strong) calc(100% - 6rem),
      transparent
    );
  }

  .tl-group {
    display: grid;
    grid-template-columns: var(--tl-rail) minmax(0, 1fr);
    column-gap: var(--tl-gap);
    padding-block-end: var(--space-7);
  }
  .tl-group:last-child {
    padding-block-end: 0;
  }

  /* 月份欄：跟著這一組黏在畫面上，這一組讀完就離開 */
  .tl-rail {
    position: sticky;
    inset-block-start: calc(var(--header-h, 57px) + var(--space-5));
    align-self: start;
    margin: 0;
    padding-block-start: 0.125rem;
    text-align: end;
    font-family: var(--font-interface);
    letter-spacing: 0;
    color: var(--ab-heading);
  }
  .tl-rail__when {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 0.25rem;
  }
  .tl-rail__month {
    font-family: var(--font-reading);
    font-size: 1.625rem;
    font-weight: 700;
    line-height: 1.15;
  }
  .tl-rail__year {
    font-size: 0.8125rem;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.08em;
    color: var(--color-ink-soft);
  }
  .tl-rail__span {
    display: block;
    font-size: 0.9375rem;
    font-weight: 700;
    font-variant-numeric: tabular-nums;
    line-height: 1.4;
    letter-spacing: 0.02em;
  }
  /* 日期字串自己排方向（右到左頁面不把「2026 / 02 — 03」倒過來），
     外層照頁面方向對齊，才會貼著那條線 */
  .tl-rail__span > span {
    unicode-bidi: isolate;
  }
  .tl-sr {
    position: absolute;
    inline-size: 1px;
    block-size: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  .tl-list {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .tl-item {
    position: relative;
    padding-inline-start: var(--tl-indent);
    padding-block-end: var(--space-6);
    /* 站頭的高度全站已經用 scroll-padding-top 讓開了，這裡只多留一點呼吸 */
    scroll-margin-block-start: var(--space-4);
  }
  .tl-item:last-child {
    padding-block-end: 0;
  }

  /* 圓點：一般條目空心小點，里程碑實心大點，「持續進行中」是一圈 */
  .tl-item__dot {
    position: absolute;
    inset-inline-start: calc(var(--tl-line-x) - var(--tl-dot) / 2 + 0.5px);
    inset-block-start: 0.4rem;
    inline-size: var(--tl-dot);
    block-size: var(--tl-dot);
    border-radius: 50%;
    background: var(--ab-section-bg);
    box-shadow:
      inset 0 0 0 1.5px var(--ab-brand),
      0 0 0 4px var(--ab-section-bg);
  }
  .tl-item--milestone .tl-item__dot {
    inset-inline-start: calc(var(--tl-line-x) - var(--tl-dot-ms) / 2 + 0.5px);
    inset-block-start: 0.3rem;
    inline-size: var(--tl-dot-ms);
    block-size: var(--tl-dot-ms);
    background: var(--ab-brand);
    box-shadow: 0 0 0 4px var(--ab-section-bg);
  }
  .tl-item--now .tl-item__dot {
    inset-inline-start: calc(var(--tl-line-x) - var(--tl-dot-ms) / 2 + 0.5px);
    inline-size: var(--tl-dot-ms);
    block-size: var(--tl-dot-ms);
    background: var(--ab-section-bg);
    box-shadow:
      inset 0 0 0 2px var(--ab-brand),
      inset 0 0 0 4px var(--ab-section-bg),
      inset 0 0 0 8px var(--ab-brand),
      0 0 0 4px var(--ab-section-bg);
  }
  .tl-group--undated .tl-item__dot {
    inset-block-start: 0.45rem;
  }

  .tl-item__date {
    margin: 0 0 0.375rem;
    font-family: var(--font-interface);
    font-size: 0.8125rem;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.04em;
    line-height: 1.5;
    color: var(--ab-brand);
  }
  .tl-item__date time {
    unicode-bidi: isolate;
  }

  .tl-item__title {
    margin: 0 0 0.75rem;
    font-family: var(--font-reading);
    font-size: 1.1875rem;
    font-weight: 600;
    line-height: 1.55;
    letter-spacing: 0;
    color: var(--color-ink);
    text-wrap: pretty;
  }
  .tl-item--milestone .tl-item__title,
  .tl-item--now .tl-item__title {
    font-size: 1.375rem;
    font-weight: 700;
    line-height: 1.45;
  }

  .tl-item__body {
    max-inline-size: 40rem;
    font-family: var(--font-reading);
    font-size: 1.0625rem;
    line-height: 1.85;
    color: var(--tl-body);
  }
  .tl-item__body p {
    margin: 0;
    font-size: inherit;
    line-height: inherit;
    color: inherit;
  }
  .tl-item__body p + p,
  .tl-item__body p + .tl-item__list,
  .tl-item__list + p {
    margin-block-start: 0.875rem;
  }
  .tl-item__list {
    margin: 0;
    padding-inline-start: 1.25rem;
    color: inherit;
  }
  .tl-item__list li {
    padding-block: 0.125rem;
  }
  .tl-item__list li::marker {
    color: var(--ab-brand);
  }
  .tl-item__body :global(strong) {
    font-weight: 600;
    color: var(--color-ink);
  }
  .tl-item__body :global(a) {
    color: var(--ab-brand);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.2em;
    text-decoration-color: color-mix(in srgb, currentColor 40%, transparent);
    border: 0;
  }
  .tl-item__body :global(a:hover) {
    color: var(--color-ink);
    text-decoration-color: currentColor;
  }

  /* 媒體報導：兩欄的小方塊，手機一欄 */
  .tl-press {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.625rem;
    max-inline-size: 40rem;
    margin: var(--space-4) 0 0;
    padding: 0;
    list-style: none;
  }
  .tl-press__link {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    block-size: 100%;
    min-block-size: 44px;
    padding: 0.75rem 0.875rem;
    border: 1px solid var(--ab-rule);
    border-radius: 10px;
    background: var(--ab-surface);
    color: inherit;
    text-decoration: none;
    transition: border-color 0.2s ease;
  }
  .tl-press__link:hover {
    border-color: var(--ab-brand);
  }
  .tl-press__link:focus-visible,
  .tl-item__related:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
    border-radius: 10px;
  }
  .tl-press__source {
    font-family: var(--font-interface);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    color: var(--ab-brand);
  }
  .tl-press__title {
    font-family: var(--font-reading);
    font-size: 0.875rem;
    font-weight: 500;
    line-height: 1.5;
    color: var(--color-ink);
  }

  /* 延伸閱讀 */
  .tl-item__more {
    margin: 0.5rem 0 0;
  }
  .tl-item__related {
