---
/**
 * AboutWhy — 「為什麼需要 Taiwan.md？」（2026-11-19 關於頁進化）。
 *
 * 首頁原本的四張價值卡搬來這裡，改成兩欄的說明式版面：左邊是標題與兩個去處，
 * 右邊是四條理由。文字抄自 home.ts 的 home.features.*（13 語都有），鍵在
 * about.ts 的 about.why.*。兩個數字是活的：語言數來自語言設定，領域數來自分類設定。
 */
import type { Lang } from '../../types';
import { useAboutStrings } from './strings';

interface Props {
  lang: Lang;
  languageCount: number;
  domainCount: number;
  graphHref: string;
  ssotHref: string;
}
const { lang, languageCount, domainCount, graphHref, ssotHref } = Astro.props;
const s = useAboutStrings(lang);

const reasons = [
  {
    title: s('about.why.curated.title'),
    desc: s('about.why.curated.desc'),
  },
  {
    title: s('about.why.ai.title'),
    desc: s('about.why.ai.desc'),
  },
  {
    title: s('about.why.languages.title', { count: languageCount }),
    desc: s('about.why.languages.desc'),
  },
  {
    title: s('about.why.complete.title'),
    desc: s('about.why.complete.desc', { domains: domainCount }),
  },
];
---

<div class="ab-why">
  <div class="ab-why__lead">
    <h2 class="ab-why__title">{s('about.why.title')}</h2>
    <ul class="ab-why__links">
      <li>
        <a
          class="ab-why__link"
          href={graphHref}
          data-ga-section="about_why"
          data-ga-label="graph"
        >
          {s('about.why.cta.graph')}
        </a>
      </li>
      <li>
        <a
          class="ab-why__link no-external-icon"
          href={ssotHref}
          target="_blank"
          rel="noopener noreferrer"
          data-ga-section="about_why"
          data-ga-label="ssot"
        >
          {s('about.why.cta.ssot')}
        </a>
      </li>
    </ul>
  </div>

  <ol class="ab-why__list">
    {
      reasons.map((r, i) => (
        <li class="ab-why__item">
          <span class="ab-why__num" aria-hidden="true">
            {String(i + 1).padStart(2, '0')}
          </span>
          <div class="ab-why__body">
            <h3 class="ab-why__item-title">{r.title}</h3>
            <p class="ab-why__item-desc">{r.desc}</p>
          </div>
        </li>
      ))
    }
  </ol>
</div>

<style>
  .ab-why {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    column-gap: var(--space-8);
    align-items: start;
  }

  .ab-why__title {
    margin: 0 0 var(--ab-gap-m);
    font-size: clamp(1.75rem, 3.4vw, 2.5rem);
    font-weight: 900;
    line-height: 1.25;
    color: var(--ab-heading);
    text-wrap: balance;
  }

  .ab-why__links {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.25rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .ab-why__link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-block-size: 44px;
    padding: 0;
    border: 0;
    font-family: var(--font-interface);
    font-size: 0.9375rem;
    font-weight: 600;
    line-height: 1.4;
    color: var(--ab-brand);
    text-decoration: none;
  }
  .ab-why__link:hover {
    color: var(--color-ink);
  }

  .ab-why__list {
    margin: 0;
    padding: 0;
    list-style: none;
    border-block-start: 1px solid var(--ab-rule);
  }

  .ab-why__item {
    display: grid;
    grid-template-columns: 3rem minmax(0, 1fr);
    column-gap: var(--space-4);
    padding: 1.125rem 0;
    border-block-end: 1px solid var(--ab-rule);
  }

  .ab-why__num {
    padding-block-start: 0.3rem;
    font-family: var(--font-interface);
    font-size: 0.8125rem;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.06em;
    color: var(--ab-brand);
  }

  .ab-why__item-title {
    margin: 0 0 0.375rem;
    font-family: var(--font-reading);
    font-size: 1.25rem;
    font-weight: 700;
    line-height: 1.4;
    letter-spacing: 0;
    color: var(--color-ink);
  }

  .ab-why__item-desc {
    margin: 0;
    max-width: 34em;
    font-size: 1.0625rem;
    line-height: 1.8;
    color: var(--color-ink-soft);
  }

  @media (max-width: 860px) {
    .ab-why {
      grid-template-columns: minmax(0, 1fr);
      row-gap: var(--ab-gap-m);
    }
    .ab-why__title {
      margin-block-end: var(--ab-gap-s);
    }
    .ab-why__item {
      grid-template-columns: 2.25rem minmax(0, 1fr);
      column-gap: 0.75rem;
    }
    .ab-why__item-title {
      font-size: 1.125rem;
    }
    .ab-why__item-desc {
      font-size: 1rem;
    }
  }
</style>
