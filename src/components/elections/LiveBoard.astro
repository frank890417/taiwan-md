---
/**
 * LiveBoard.astro — 2026 選舉主頁的開票專區（2026-11-28 開票夜）。
 *
 * 架構（reports/election-night-live-plan-2026-11-28.md）：
 *   - 這個元件只部署一次，是「殼」：地圖形狀、候選人名冊、字串在建置時寫進 HTML。
 *   - 票數不走整站部署。瀏覽器每兩分鐘去抓 `election-live` 分支上的兩份 JSON：
 *       results.json  票數（只有 scripts/tools/election-live/ 的程式寫，LLM 不碰）
 *       feed.json     消息、全貌摘要、事實查核（每則附來源）
 *   - 16:00 前沒有任何票數；狀態依瀏覽器當下的台北時間與 results.phase 切換。
 *   - 「當選」只在中選會標註後顯示；其餘一律寫「領先」。公投兩個門檻分開顯示，不自行宣布。
 *   - 資料超過 STALE_MIN 分鐘沒更新，頁面自己亮警示（轉錄迴圈停掉時不能看起來正常）。
 *
 * 地圖形狀來自 public/assets/geo/taiwan-country.topo.json（同 CountyMap.astro，
 * 不手繪台灣形狀，REFLEXES #61）。投影程式與 CountyMap 重複一份，是開票夜的時間取捨，
 * 選後可抽成共用 util。
 *
 * 顏色：開票結果需要辨識政黨，這個元件用政黨色（--lb-kmt 等），是 elections.css
 * 「圖表不用政黨色」的明確例外；每個色塊旁都有文字，不讓顏色成為唯一資訊。
 */
import { readFileSync } from 'node:fs';
import { join } from 'node:path';
import { geoArea, geoMercator, geoPath } from 'd3';
import copyRaw from '../../data/elections-2026-live-copy.json';

interface Race {
  area: string;
  label: string;
  group: string;
  candidates: Array<{
    number: number | null;
    name: string;
    party: string;
    partyLabel: string;
  }>;
}
interface Props {
  lang: string;
  races: Race[];
  referendumQuestion: string;
  referendumHref: string;
}
const { lang, races, referendumQuestion, referendumHref } = Astro.props;
const allCopy = copyRaw as unknown as Record<string, Record<string, unknown>>;
const copy = (allCopy[lang] ?? allCopy.en) as Record<string, any>;

const DATA_BASE =
  'https://raw.githubusercontent.com/frank890417/taiwan-md/election-live/';
const CEC_LOCAL = 'https://vote.cec.gov.tw/2026-local/zh-TW/indexP.html';
const CEC_REF = 'https://vote.cec.gov.tw/2026-ref/zh-TW/indexP.html';

// ── TopoJSON → SVG path（與 CountyMap.astro 同一套解法）──
type Topo = {
  transform: { scale: [number, number]; translate: [number, number] };
  arcs: Array<Array<[number, number]>>;
  objects: {
    map: {
      geometries: Array<{
        type: 'Polygon' | 'MultiPolygon';
        arcs: number[][] | number[][][];
        properties: { id: string; name: string };
      }>;
    };
  };
};
const topo: Topo = JSON.parse(
  readFileSync(
    join(process.cwd(), 'public/assets/geo/taiwan-country.topo.json'),
    'utf8',
  ),
);
const {
  scale: [sx, sy],
  translate: [tx, ty],
} = topo.transform;
const arcs = topo.arcs.map((arc) => {
  let x = 0;
  let y = 0;
  return arc.map(([dx, dy]) => {
    x += dx;
    y += dy;
    return [x * sx + tx, y * sy + ty] as [number, number];
  });
});
const arcPoints = (i: number) => (i >= 0 ? arcs[i] : [...arcs[~i]].reverse());
const ring = (ids: number[]) =>
  ids.flatMap((i, k) => (k === 0 ? arcPoints(i) : arcPoints(i).slice(1)));
type Feature = {
  type: 'Feature';
  properties: { name: string };
  geometry:
    | { type: 'Polygon'; coordinates: [number, number][][] }
    | { type: 'MultiPolygon'; coordinates: [number, number][][][] };
};
const features = new Map<string, Feature>();
for (const g of topo.objects.map.geometries) {
  const feature: Feature =
    g.type === 'Polygon'
      ? {
          type: 'Feature',
          properties: { name: g.properties.name },
          geometry: {
            type: 'Polygon',
            coordinates: (g.arcs as number[][]).map(ring),
          },
        }
      : {
          type: 'Feature',
          properties: { name: g.properties.name },
          geometry: {
            type: 'MultiPolygon',
            coordinates: (g.arcs as number[][][]).map((p) => p.map(ring)),
          },
        };
  if (geoArea(feature as never) > 2 * Math.PI) {
    const reverse = (r: [number, number][]) => r.reverse();
    if (feature.geometry.type === 'Polygon')
      feature.geometry.coordinates.forEach(reverse);
    else feature.geometry.coordinates.forEach((p) => p.forEach(reverse));
  }
  features.set(g.properties.name, feature);
}
const missing = races.filter((r) => !features.has(r.area));
if (missing.length > 0) {
  throw new Error(
    `LiveBoard: 縣市名稱對不上 TopoJSON（${missing.map((c) => c.area).join('、')}）`,
  );
}
// 版面（2026-11-28 哲宇：本島大一點、離島小一點）：直式畫布，本島撐滿高度；
// 金門、連江縮成左上角兩個小框。投影只對「每個縣市面積最大的那一塊」取範圍，
// 遠方的小島（宜蘭縣的釣魚臺列嶼等）照畫，但不再把本島擠小，落在畫布外就不顯示。
const W = 400;
const H = 540;
const insets = [
  { area: '連江縣', box: [6, 6, 84, 78] as const },
  { area: '金門縣', box: [6, 90, 84, 66] as const },
];
const insetAreas = new Set(insets.map((i) => i.area));
const largestPart = (f: Feature) => {
  if (f.geometry.type === 'Polygon') return f;
  let best = f.geometry.coordinates[0];
  let bestA = -1;
  for (const poly of f.geometry.coordinates) {
    const a = geoArea({ type: 'Polygon', coordinates: poly } as never);
    if (a > bestA) {
      bestA = a;
      best = poly;
    }
  }
  return {
    type: 'Feature',
    properties: f.properties,
    geometry: { type: 'Polygon', coordinates: best },
  } as Feature;
};
const mainProjection = geoMercator().fitExtent(
  [
    [10, 10],
    [W - 10, H - 10],
  ],
  {
    type: 'FeatureCollection',
    features: races
      .filter((r) => !insetAreas.has(r.area))
      .map((r) => largestPart(features.get(r.area)!)),
  } as never,
);
const mainPath = geoPath(mainProjection).digits(1);
const insetPaths = new Map(
  insets.map(({ area, box: [x, y, w, h] }) => {
    const f = features.get(area)!;
    const projection = geoMercator().fitExtent(
      [
        [x + 6, y + 18],
        [x + w - 6, y + h - 5],
      ],
      f as never,
    );
    return [area, geoPath(projection).digits(1)(f as never) ?? ''];
  }),
);
const insetProj = new Map(
  insets.map(({ area, box: [x, y, w, h] }) => [
    area,
    geoMercator().fitExtent(
      [
        [x + 6, y + 18],
        [x + w - 6, y + h - 5],
      ],
      features.get(area)! as never,
    ),
  ]),
);
// 北部幾個縣市擠在一起，標籤手動挪開（單位是 viewBox 座標）
const NUDGE: Record<string, [number, number]> = {
  基隆市: [20, -10],
  臺北市: [-2, -6],
  新北市: [16, 14],
  新竹市: [-20, -2],
  嘉義市: [-20, 2],
  桃園市: [-10, -2],
};
const labelAt = (area: string): [number, number] => {
  const f = features.get(area)!;
  const proj = insetAreas.has(area) ? insetProj.get(area)! : mainProjection;
  // MultiPolygon 取面積最大的那一塊，免得被離島拉走
  let geom: unknown = f;
  if (f.geometry.type === 'MultiPolygon') {
    let best = f.geometry.coordinates[0];
    let bestA = -1;
    for (const poly of f.geometry.coordinates) {
      const a = geoArea({ type: 'Polygon', coordinates: poly } as never);
      if (a > bestA) {
        bestA = a;
        best = poly;
      }
    }
    geom = {
      type: 'Feature',
      geometry: { type: 'Polygon', coordinates: best },
    };
  }
  const [cx, cy] = geoPath(proj).centroid(geom as never);
  const [dx, dy] = NUDGE[area] ?? [0, 0];
  return [Math.round(cx + dx), Math.round(cy + dy)];
};
const shapes = races.map((r) => ({
  at: labelAt(r.area),
  area: r.area,
  label: r.label,
  inset: insetAreas.has(r.area),
  d: insetAreas.has(r.area)
    ? insetPaths.get(r.area)!
    : (mainPath(features.get(r.area)! as never) ?? ''),
}));

const boot = {
  lang,
  copy,
  races,
  dataBase: DATA_BASE,
  cecLocal: CEC_LOCAL,
  cecRef: CEC_REF,
  closeAt: '2026-11-28T16:00:00+08:00',
  staleMin: 25,
  pollMs: 75000,
};
---

<section
  class="lb"
  id="live"
  aria-labelledby="lb-title"
  data-lb
  data-lb-state="pre"
>
  <div class="el-wrap lb-wrap">
    <!-- 儀表板：電腦版一個畫面看完（左地圖、右 22 縣市＋公投），票數只用中選會官方數字 -->
    <div class="lb-dash">
      <header class="lb-dtop">
        <div class="lb-dtitle">
          <h2 id="lb-title" class="lb-title">{copy.title}</h2>
          <p class="lb-dsub">{copy.dashSub}</p>
        </div>
        <div class="lb-dstatus" role="status" aria-live="polite">
          <p class="lb-status-line">
            <span class="lb-dot" aria-hidden="true"></span>
            <span class="lb-status-text" data-lb-status>{copy.statusPre}</span>
          </p>
          <dl class="lb-meta" data-lb-meta hidden>
            <div>
              <dt>{copy.updatedAt}</dt>
              <dd data-lb-updated>—</dd>
            </div>
            <div data-lb-stations-wrap hidden>
              <dt>{copy.stations}</dt>
              <dd data-lb-stations>—</dd>
            </div>
          </dl>
          <div class="lb-total" data-lb-total hidden aria-hidden="true">
            <span data-lb-total-fill></span>
          </div>
        </div>
        <div class="lb-tabs" role="tablist" data-lb-tabs>
          <button
            type="button"
            role="tab"
            class="lb-tab is-on"
            data-lb-tab="mayor"
            aria-selected="true">{copy.tabMayor}</button
          >
          <button
            type="button"
            role="tab"
            class="lb-tab"
            data-lb-tab="council"
            aria-selected="false">{copy.tabCouncil}</button
          >
        </div>
        <ul class="lb-dtally" data-lb-dtally aria-label={copy.scoreTitle}></ul>
        <p class="lb-links">
          <a
            href={CEC_LOCAL}
            class="no-external-icon"
            target="_blank"
            rel="noopener noreferrer">{copy.cecLink} ↗</a
          >
        </p>
      </header>
      <p class="lb-status-hint" data-lb-hint>{copy.statusPreHint}</p>
      <div class="lb-dbody">
        <figure class="lb-map">
          <svg
            viewBox={`0 0 ${W} ${H}`}
            role="group"
            aria-label={copy.mapTitle}
            class="lb-svg"
          >
            {
              insets.map(({ area, box: [x, y, w, h] }) => (
                <g aria-hidden="true">
                  <rect
                    class="lb-inset"
                    x={x}
                    y={y}
                    width={w}
                    height={h}
                    rx="6"
                  />
                  <text class="lb-inset-label" x={x + 8} y={y + 15}>
                    {races.find((r) => r.area === area)?.label}
                  </text>
                </g>
              ))
            }
            {
              shapes.map((s) => (
                <a
                  href={`#lb-race-${s.area}`}
                  class="lb-map-link"
                  data-lb-map={s.area}
                  aria-label={s.label}
                >
                  <path
                    d={s.d}
                    class={`lb-c${s.inset ? ' lb-c-small' : ''}`}
                    data-party="none"
                  />
                  <title>{s.label}</title>
                </a>
              ))
            }
            {
              shapes.map((s) => (
                <text
                  class="lb-map-pct"
                  x={s.at[0]}
                  y={s.at[1]}
                  data-lb-map-pct={s.area}
                  aria-hidden="true"
                />
              ))
            }
          </svg>
          <figcaption class="lb-map-cap">
            <span class="lb-map-ramp" aria-hidden="true"
              ><i></i><i></i><i></i><i></i></span
            >
            <span class="lb-map-leg-mayor">{copy.mapLegend}</span>
            <span class="lb-map-leg-council">{copy.mapLegendCouncil}</span>
          </figcaption>
        </figure>
        <ol class="lb-dgrid" data-lb-dgrid></ol>
      </div>
      <!-- 新聞輪播列：一次一則，每六秒換一則；有新消息時跳到那一則並亮一下 -->
      <a class="lb-ticker" data-lb-ticker href="#lb-feed" hidden>
        <span class="lb-ticker-tag">{copy.latest}</span>
        <span class="lb-ticker-body" data-lb-ticker-body aria-live="off"></span>
      </a>
    </div>

    <!-- 議員：選了縣市之後，這裡列出各選舉區 -->
    <div class="lb-cdetail" id="lb-council-detail" data-lb-cdetail hidden>
      <h3 class="lb-h3" data-lb-cdetail-title></h3>
      <p class="lb-note">{copy.councilNote}</p>
      <div class="lb-cdistricts" data-lb-cdistricts></div>
    </div>

    <p class="lb-alert" data-lb-alert hidden></p>
    <noscript><p class="lb-alert">{copy.noscript}</p></noscript>

    <!-- 22 縣市目前領先者：官方票數追上媒體計票的縣市用官方，其餘先用媒體計票（非官方）。
         全部追上後這塊自動收掉，不需要再部署。 -->
    <details class="lb-fold" data-lb-media hidden>
      <summary>
        {copy.media}
        <span class="lb-tag lb-tag-unofficial">{copy.unofficial}</span>
      </summary>
      <div class="lb-score lb-media">
        <h3 class="lb-h3">
          {copy.bestTitle}
          <span class="lb-best-tags" data-lb-best-tags></span>
          <span class="lb-media-time" data-lb-media-time></span>
        </h3>
        <div
          class="lb-score-bar"
          data-lb-media-bar
          role="img"
          aria-label={copy.bestTitle}
        >
        </div>
        <ul class="lb-score-legend el-reset" data-lb-media-legend></ul>
        <ul class="lb-mgrid" data-lb-media-grid></ul>
        <p class="lb-note">{copy.bestNote}</p>
        <p class="lb-note" data-lb-media-note></p>
        <p class="lb-note">{copy.mediaWhy}</p>
      </div>
    </details>

    <!-- 各黨領先縣市數（中選會官方） -->
    <div class="lb-score" data-lb-score-wrap>
      <p class="lb-kicker">{copy.officialTitle}</p>
      <h3 class="lb-h3">{copy.scoreTitle}</h3>
      <div
        class="lb-score-bar"
        data-lb-score-bar
        role="img"
        aria-label={copy.scoreTitle}
      >
      </div>
      <ul class="lb-score-legend el-reset" data-lb-score-legend></ul>
      <p class="lb-note">{copy.scoreNote} {copy.earlyNote}</p>
      <nav class="lb-jump" aria-label={copy.jump}>
        <p class="lb-jump-label">{copy.jump}</p>
        <ul class="lb-chips" data-lb-chips>
          {
            races.map((r) => (
              <li>
                <a
                  href={`#lb-race-${r.area}`}
                  class="lb-chip-link"
                  data-lb-chip={r.area}
                  data-party="none"
                >
                  <span class="lb-chip" aria-hidden="true" />
                  {r.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </div>

    <div class="lb-overview" data-lb-overview hidden>
      <h3 class="lb-h3">{copy.overviewTitle}</h3>
      <div class="lb-overview-body" data-lb-overview-body></div>
    </div>

    <div class="lb-grid lb-grid-solo">
      <!-- 六都 -->
      <div class="lb-major">
        <h3 class="lb-h3">{copy.municipal}</h3>
        <div class="lb-cards lb-cards-major" data-lb-cards="municipal"></div>
      </div>
    </div>

    <!-- 公投 -->
    <div class="lb-ref" id="lb-ref" data-lb-ref>
      <div class="lb-ref-head">
        <h3 class="lb-h3">{copy.refTitle}</h3>
        <p class="lb-ref-q">
          <a href={referendumHref}>{referendumQuestion}</a>
        </p>
      </div>
      <div class="lb-ref-body" data-lb-ref-body></div>
      <p class="lb-note">
        {copy.refRuleNote}
        <a
          href={CEC_REF}
          class="no-external-icon"
          target="_blank"
          rel="noopener noreferrer">{copy.cecRefLink} ↗</a
        >
      </p>
    </div>

    <div class="lb-minor">
      <h3 class="lb-h3">{copy.county}</h3>
      <div class="lb-cards lb-cards-minor" data-lb-cards="county"></div>
    </div>

    <!-- 消息＋查核 -->
    <div class="lb-feed-grid" id="lb-feed">
      <div class="lb-feed">
        <h3 class="lb-h3">{copy.feedTitle}</h3>
        <p class="lb-note">{copy.feedLead}</p>
        <ol class="lb-items el-reset" data-lb-items>
          <li class="lb-empty">{copy.feedEmpty}</li>
        </ol>
      </div>
      <div class="lb-fact">
        <h3 class="lb-h3">{copy.factTitle}</h3>
        <p class="lb-note">{copy.factLead}</p>
        <ol class="lb-items el-reset" data-lb-facts>
          <li class="lb-empty">{copy.factEmpty}</li>
        </ol>
      </div>
    </div>

    <details class="lb-method">
      <summary>{copy.methodTitle}</summary>
      <p>{copy.method}</p>
      <p class="lb-credits-title" data-lb-credits-title hidden>
        {copy.photoCredit}
      </p>
      <ul class="lb-credits" data-lb-credits></ul>
    </details>
  </div>

  <script
    type="application/json"
    data-lb-boot
    set:html={JSON.stringify(boot)}
  />
</section>

<script>
  type Cand = {
    number: number | null;
    name: string;
    party: string;
    partyLabel?: string;
    votes?: number;
    pct?: number;
    elected?: boolean;
  };
  const root = document.querySelector<HTMLElement>('[data-lb]');
  const bootEl = root?.querySelector('[data-lb-boot]');
  if (root && bootEl) {
    const B = JSON.parse(bootEl.textContent || '{}');
    const C = B.copy;
    const $ = <T extends Element = HTMLElement>(s: string) =>
      root.querySelector<T>(s);
    const esc = (s: unknown) =>
      String(s ?? '').replace(
        /[&<>"']/g,
        (c) =>
          ({
            '&': '&amp;',
            '<': '&lt;',
            '>': '&gt;',
            '"': '&quot;',
            "'": '&#39;',
          })[c]!,
      );
    const fill = (tpl: string, v: Record<string, string | number>) =>
      tpl.replace(/\{(\w+)\}/g, (_, k) => String(v[k] ?? ''));
    const nf = new Intl.NumberFormat(B.lang === 'zh-TW' ? 'zh-TW' : B.lang);
    const num = (n: unknown) =>
      typeof n === 'number' && isFinite(n) ? nf.format(n) : '—';
    const norm = (s: string) =>
      String(s || '')
        .replace(/\s+/g, '')
        .replace(/温/g, '溫')
        .replace(/啓/g, '啟')
        .replace(/台/g, '臺');
    const partyKey = (p: string) => {
      const s = String(p || '');
      if (s.includes('國民黨')) return 'kmt';
      if (s.includes('民主進步黨') || s.includes('民進黨')) return 'dpp';
      if (s.includes('民眾黨')) return 'tpp';
      if (s.includes('無黨') || s === '無' || s === '') return 'ind';
      return 'other';
    };
    const SEP = B.lang === 'zh-TW' || B.lang === 'ja' ? '、' : ', ';
    const safeUrl = (u: unknown) =>
      typeof u === 'string' && /^https?:\/\//.test(u) ? u : '';
    const timeFmt = (iso: string) => {
      const d = new Date(iso);
      if (isNaN(d.getTime())) return '';
      return new Intl.DateTimeFormat(B.lang === 'zh-TW' ? 'zh-TW' : B.lang, {
        timeZone: 'Asia/Taipei',
        hour: '2-digit',
        minute: '2-digit',
        hour12: false,
      }).format(d);
    };

    // 本機預覽專用：?lbbase=/lbmock/ 改讀假資料並略過 16:00 的時間閘（正式站不生效）
    if (location.hostname === 'localhost') {
      const q = new URLSearchParams(location.search).get('lbbase');
      if (q && q.startsWith('/')) {
        B.dataBase = q;
        B.closeAt = '2000-01-01T00:00:00+08:00';
      }
    }
    let results: any = null;
    let feed: any = null;
    let media: any = null;
    let council: any = null;
    let tab: 'mayor' | 'council' = 'mayor';
    let councilArea = '';
    let avatars: any = null;
    let avatarBase = '';
    /**
     * 某縣市的媒體計票（依票數排序，政黨從名冊對回來；不採用媒體標的「當選」）。
     * 回傳 null 表示這個縣市「不用媒體計票」，三種情況：
     *   1. 來源那張圖表超過 40 分鐘沒更新（逐縣市看來源的更新時間，不看我們抓取的時間：
     *      來源停更時我們每分鐘照抓，抓取時間永遠是新的）；
     *   2. 中選會的票數已經追上媒體計票（官方不再落後，就用官方）；
     *   3. 中選會已標當選，或全部開完。
     */
    const MEDIA_MAX_AGE = 40 * 60000;
    function mediaView(race: any) {
      const m = media?.races?.[race.area];
      if (!m || !Array.isArray(m.candidates)) return null;
      // 整個來源停更：22 張圖表裡最新的一張也超過 40 分鐘 → 全部不用。
      // 單一縣市：小縣市媒體很早就計完、不再更新，所以單張放寬到 120 分鐘。
      const stamps = Object.values(media?.races || {})
        .map((r: any) => Date.parse(r?.updatedAt || ''))
        .filter((n) => isFinite(n));
      const newest = stamps.length ? Math.max(...stamps) : NaN;
      if (!isFinite(newest) || Date.now() - newest > MEDIA_MAX_AGE) return null;
      const stamp = Date.parse(m.updatedAt || '');
      if (!isFinite(stamp) || Date.now() - stamp > 3 * MEDIA_MAX_AGE)
        return null;
      const off = results?.mayors?.[race.area];
      const offCands: any[] = Array.isArray(off?.candidates)
        ? off.candidates
        : [];
      const offTotal = offCands.reduce((a, c) => a + (c.votes || 0), 0);
      const medTotal = m.candidates.reduce(
        (a: number, c: any) => a + (typeof c.votes === 'number' ? c.votes : 0),
        0,
      );
      if (
        results?.phase === 'final' ||
        offCands.some((c) => c.elected === true) ||
        (medTotal > 0 && offTotal >= medTotal)
      )
        return null;
      const byName = new Map(
        race.candidates.map((c: Cand) => [norm(c.name), c] as const),
      );
      const list = m.candidates
        .map((c: any) => {
          const b: any = byName.get(norm(c.name));
          return b && typeof c.votes === 'number' && c.votes > 0
            ? {
                name: b.name,
                party: b.party,
                partyLabel: b.partyLabel,
                votes: c.votes,
              }
            : null;
        })
        .filter(Boolean)
        .sort((x: any, y: any) => y.votes - x.votes);
      return list.length ? { list, updatedAt: m.updatedAt } : null;
    }
    let resultsFailed = false;

    /** 把名冊跟票數合起來；票數檔沒有的縣市就只有名冊。 */
    function raceView(race: any) {
      const r = results?.mayors?.[race.area];
      const base: Cand[] = race.candidates.map((c: Cand) => ({ ...c }));
      let cands: Cand[] = base;
      let hasVotes = false;
      if (r && Array.isArray(r.candidates) && r.candidates.length) {
        const byName = new Map(base.map((c) => [norm(c.name), c]));
        cands = r.candidates.map((c: Cand) => {
          const b = byName.get(norm(c.name));
          return {
            number: c.number ?? b?.number ?? null,
            name: b?.name ?? c.name,
            party: b?.party ?? c.party ?? '',
            partyLabel: b?.partyLabel ?? c.party ?? '',
            votes: typeof c.votes === 'number' ? c.votes : 0,
            pct: typeof c.pct === 'number' ? c.pct : undefined,
            elected: c.elected === true,
          };
        });
        const total = cands.reduce((a, c) => a + (c.votes || 0), 0);
        hasVotes = total > 0;
        if (hasVotes) {
          cands.forEach((c) => {
            if (c.pct === undefined) c.pct = ((c.votes || 0) / total) * 100;
          });
          cands.sort((a, b) => (b.votes || 0) - (a.votes || 0));
        }
      }
      const leader = hasVotes ? cands[0] : null;
      const second = hasVotes && cands.length > 1 ? cands[1] : null;
      const winner = cands.find((c) => c.elected) || null;
      // 回報不到 5% 投開票所：只開了幾所，領先者還不能代表這個縣市
      const early =
        !winner &&
        hasVotes &&
        typeof r?.reported === 'number' &&
        typeof r?.total === 'number' &&
        r.total > 0 &&
        r.reported / r.total < 0.05;
      return {
        early,
        race,
        cands,
        hasVotes,
        leader,
        second,
        winner,
        reported: r?.reported,
        total: r?.total,
      };
    }

    function cardHtml(v: ReturnType<typeof raceView>) {
      const head = v.winner || v.leader;
      const tag = v.winner
        ? `<span class="lb-tag lb-tag-win" title="${esc(C.electedNote)}">${esc(C.elected)}</span>`
        : v.leader
          ? `<span class="lb-tag${v.early ? ' lb-tag-early' : ''}">${esc(v.early ? C.early : C.leading)}</span>`
          : '';
      const prog =
        typeof v.reported === 'number' &&
        typeof v.total === 'number' &&
        v.total > 0
          ? `<p class="lb-card-prog"><span class="lb-prog-track"><span class="lb-prog-fill" style="width:${Math.min(100, (v.reported / v.total) * 100).toFixed(1)}%"></span></span><span class="lb-prog-text">${esc(fill(C.reported, { a: num(v.reported), b: num(v.total) }))}</span></p>`
          : '';
      const margin =
        v.leader && v.second && !v.early
          ? `<span class="lb-margin">${esc(fill(C.margin, { n: num((v.leader.votes || 0) - (v.second.votes || 0)) }))}</span>`
          : '';
      const rowHtml = (c: Cand) => {
        const k = partyKey(c.party);
        const isHead = head && c === head;
        const pct = v.hasVotes ? (c.pct || 0).toFixed(2) + '%' : '';
        const no =
          c.number != null
            ? `<span class="lb-no">${esc(C.numberPrefix)}${c.number}${esc(C.numberSuffix)}</span>`
            : '';
        return `<li class="lb-row${isHead ? ' is-head' : ''}" data-party="${k}">
            <div class="lb-row-top">
              <span class="lb-name">${esc(c.name)}${c.elected ? ` <span class="lb-tag lb-tag-win">${esc(C.elected)}</span>` : ''}</span>
              <span class="lb-pct">${pct}</span>
            </div>
            <div class="lb-row-sub">
              <span class="lb-party"><span class="lb-chip" aria-hidden="true"></span>${esc(c.partyLabel || c.party)}</span>${no}
              <span class="lb-votes">${v.hasVotes ? num(c.votes) + ' ' + esc(C.votes) : ''}</span>
            </div>
            <div class="lb-bar" aria-hidden="true"><span style="width:${v.hasVotes ? Math.min(100, c.pct || 0).toFixed(2) : 0}%"></span></div>
          </li>`;
      };
      const KEEP = 3;
      const top = v.cands.slice(0, KEEP).map(rowHtml).join('');
      const rest = v.cands.slice(KEEP);
      const rows =
        `<ol class="lb-rows">${top}</ol>` +
        (rest.length
          ? `<details class="lb-more"><summary>${esc(fill(C.more, { n: rest.length }))}</summary><ol class="lb-rows">${rest.map(rowHtml).join('')}</ol></details>`
          : '');
      return `<article class="lb-card${v.early ? ' is-early' : ''}" id="lb-race-${esc(v.race.area)}" data-party="${head ? partyKey(head.party) : 'none'}">
        <header class="lb-card-head">
          <h4 class="lb-card-title">${esc(v.race.label)}</h4>
          <span class="lb-card-tags">${tag}${margin}</span>
        </header>
        ${rows}
        ${prog}
        ${mediaLine(v.race)}
      </article>`;
    }

    function mediaLine(race: any) {
      const mv = mediaView(race);
      if (!mv) return '';
      const items = mv.list
        .slice(0, 2)
        .map(
          (c: any) =>
            `<span class="lb-ml-c" data-party="${partyKey(c.party)}"><span class="lb-chip" aria-hidden="true"></span>${esc(c.name)} <b>${num(c.votes)}</b></span>`,
        )
        .join('');
      return `<p class="lb-ml"><span class="lb-ml-head">${esc(C.media)} <span class="lb-tag lb-tag-unofficial">${esc(C.unofficial)}</span> <time>${esc(timeFmt(mv.updatedAt))}</time></span>${items}</p>`;
    }

    // ── 動畫：數字更新時跑動，領先與落後互換時兩列交換位置並亮一下 ──
    // 使用者設定「減少動態效果」時全部關掉。
    const REDUCE =
      typeof matchMedia === 'function' &&
      matchMedia('(prefers-reduced-motion: reduce)').matches;
    const lastNum = new Map<string, number>();
    function tweenNumbers(scope: Element) {
      scope.querySelectorAll<HTMLElement>('[data-n][data-k]').forEach((el) => {
        const key = el.dataset.k!;
        const to = Number(el.dataset.n);
        const from = lastNum.has(key) ? lastNum.get(key)! : 0;
        lastNum.set(key, to);
        if (REDUCE || !isFinite(to) || from === to) return;
        const isPct = el.dataset.f === 'pct';
        const fmt = (x: number) =>
          isPct ? x.toFixed(1) + '%' : nf.format(Math.round(x));
        const t0 = performance.now();
        const dur = 900;
        el.classList.add('is-tick');
        const step = (now: number) => {
          if (!el.isConnected) return;
          const k = Math.min(1, (now - t0) / dur);
          const e = 1 - Math.pow(1 - k, 3);
          el.textContent = fmt(from + (to - from) * e);
          if (k < 1) requestAnimationFrame(step);
          else {
            el.textContent = fmt(to);
            el.classList.remove('is-tick');
          }
        };
        requestAnimationFrame(step);
      });
    }
    function animateDash(
      grid: Element,
      before: Map<string, number>,
      prevLead: Map<string, string>,
    ) {
      tweenNumbers(grid);
      if (REDUCE) return;
      // 兩列交換位置：從舊位置滑到新位置
      grid.querySelectorAll<HTMLElement>('[data-row]').forEach((el) => {
        const old = before.get(el.dataset.row!);
        if (old === undefined) return;
        // 第一次拿到票數時（原本照號次排）不滑動，只有票數之間的名次互換才滑
        const area = el.closest<HTMLElement>('[data-cell]')?.dataset.cell;
        if (!area || !prevLead.get(area)) return;
        const dy = old - el.getBoundingClientRect().top;
        if (Math.abs(dy) > 2)
          el.animate(
            [{ transform: `translateY(${dy}px)` }, { transform: 'none' }],
            { duration: 650, easing: 'cubic-bezier(0.2, 0.8, 0.2, 1)' },
          );
      });
      // 領先者換人：整格亮一下，新的第一名旁邊短暫出現箭頭，地圖上那個縣市也閃一下
      grid.querySelectorAll<HTMLElement>('[data-cell]').forEach((el) => {
        const area = el.dataset.cell!;
        const was = prevLead.get(area);
        const now = el.dataset.lead || '';
        if (!was || !now || was === now) return;
        el.classList.add('is-flip');
        setTimeout(() => el.classList.remove('is-flip'), 2600);
        const path = root!.querySelector<SVGElement>(
          `[data-lb-map="${CSS.escape(area)}"] path`,
        );
        path?.classList.add('is-flip');
        setTimeout(() => path?.classList.remove('is-flip'), 2600);
      });
    }

    /** 候選人頭像：有授權清楚的照片就用照片，沒有就用姓氏加政黨色。 */
    function avatarHtml(c: Cand) {
      const k = partyKey(c.party);
      const a = avatars?.people?.[c.name];
      const file =
        typeof a?.file === 'string' && /^avatars\/[\w.-]+$/.test(a.file)
          ? a.file
          : '';
      return file && avatarBase
        ? `<span class="lb-av has-photo" data-party="${k}" style="background-image:url('${esc(avatarBase + file)}')" aria-hidden="true"></span>`
        : `<span class="lb-av" data-party="${k}" aria-hidden="true">${esc(Array.from(c.name)[0] || '')}</span>`;
    }

    /** 儀表板：22 縣市各一格（前兩名）＋公投一格＋各黨領先數。只用中選會官方數字。 */
    function renderDash() {
      if (tab === 'council') return renderCouncil();
      const cd = $('[data-lb-cdetail]');
      if (cd) cd.hidden = true;
      const grid = $('[data-lb-dgrid]');
      if (!grid) return;
      const views = B.races.map(raceView);
      const cells = views.map((v: any) => {
        const head = v.winner || v.leader;
        const pctOpen =
          typeof v.reported === 'number' &&
          typeof v.total === 'number' &&
          v.total > 0
            ? (v.reported / v.total) * 100
            : null;
        const top = v.cands.slice(0, 2);
        const rows = top
          .map(
            (c: Cand) =>
              `<span class="lb-dc-row${head && c === head ? ' is-head' : ''}" data-party="${partyKey(c.party)}" data-row="${esc(v.race.area + '|' + c.name)}" style="--w:${v.hasVotes ? Math.min(100, c.pct || 0).toFixed(1) : 0}%">${avatarHtml(c)}<span class="lb-dc-n">${esc(c.name)}</span><span class="lb-dc-p"${v.hasVotes ? ` data-n="${(c.pct || 0).toFixed(1)}" data-f="pct" data-k="${esc('p|' + v.race.area + '|' + c.name)}"` : ''}>${v.hasVotes ? (c.pct || 0).toFixed(1) + '%' : ''}</span><span class="lb-dc-v"${v.hasVotes ? ` data-n="${c.votes || 0}" data-f="int" data-k="${esc('v|' + v.race.area + '|' + c.name)}"` : ''}>${v.hasVotes ? num(c.votes) : esc(c.partyLabel || c.party)}</span></span>`,
          )
          .join('');
        const bar = v.hasVotes
          ? `<span class="lb-dc-bar" aria-hidden="true">${top.map((c: Cand) => `<i data-party="${partyKey(c.party)}" style="width:${Math.min(100, c.pct || 0).toFixed(2)}%"></i>`).join('')}</span>`
          : `<span class="lb-dc-bar" aria-hidden="true"></span>`;
        const tag = v.winner
          ? `<span class="lb-tag lb-tag-win">${esc(C.elected)}</span>`
          : v.early
            ? `<span class="lb-tag lb-tag-early">${esc(C.early)}</span>`
            : '';
        return `<li><a class="lb-dc${v.early ? ' is-early' : ''}${v.winner ? ' is-won' : ''}" href="#lb-race-${esc(v.race.area)}" data-cell="${esc(v.race.area)}" data-lead="${esc(v.hasVotes && top[0] ? top[0].name : '')}" data-party="${head && !v.early ? partyKey(head.party) : 'none'}"><span class="lb-dc-h"><b>${esc(v.race.label)}</b>${tag}<span class="lb-dc-r">${pctOpen === null ? '' : esc(fill(C.openedPct, { p: pctOpen.toFixed(pctOpen < 10 ? 1 : 0) }))}</span></span>${rows}${bar}</a></li>`;
      });
      // 公投一格
      const r = results?.referendum;
      const agree = typeof r?.agree === 'number' ? r.agree : 0;
      const dis = typeof r?.disagree === 'number' ? r.disagree : 0;
      const has = agree + dis > 0;
      const pa = has ? (agree / (agree + dis)) * 100 : 0;
      const refOpen =
        typeof r?.reported === 'number' &&
        typeof r?.total === 'number' &&
        r.total > 0
          ? (r.reported / r.total) * 100
          : null;
      const need =
        typeof r?.eligible === 'number' && r.eligible > 0
          ? Math.ceil(r.eligible / 4)
          : null;
      cells.push(
        `<li class="lb-dc-wide"><a class="lb-dc lb-dc-ref" href="#lb-ref"><span class="lb-dc-h"><b>${esc(C.refTitle)}</b><span class="lb-dc-r">${refOpen === null ? '' : esc(fill(C.openedPct, { p: refOpen.toFixed(refOpen < 10 ? 1 : 0) }))}</span></span><span class="lb-dc-refrow"><span class="is-agree">${esc(C.refAgree)} <b${has ? ` data-n="${pa.toFixed(1)}" data-f="pct" data-k="ref|pa"` : ''}>${has ? pa.toFixed(1) + '%' : '—'}</b> <i${has ? ` data-n="${agree}" data-f="int" data-k="ref|a"` : ''}>${has ? num(agree) : ''}</i></span><span class="is-dis">${esc(C.refDisagree)} <b${has ? ` data-n="${(100 - pa).toFixed(1)}" data-f="pct" data-k="ref|pd"` : ''}>${has ? (100 - pa).toFixed(1) + '%' : '—'}</b> <i${has ? ` data-n="${dis}" data-f="int" data-k="ref|d"` : ''}>${has ? num(dis) : ''}</i></span></span><span class="lb-ref-split" aria-hidden="true"><span class="is-agree" style="width:${has ? pa.toFixed(2) : 50}%"></span><span class="is-dis" style="width:${has ? (100 - pa).toFixed(2) : 50}%"></span></span>${need && has ? `<span class="lb-dc-thresh">${esc(fill(C.refRule2Progress, { a: num(agree), b: num(need) }))}</span>` : ''}</a></li>`,
      );
      // 動畫第一步：換內容前，記下每一列現在在畫面上的位置，以及每個縣市目前誰排第一
      const before = new Map<string, number>();
      const prevLead = new Map<string, string>();
      if (!REDUCE) {
        grid.querySelectorAll<HTMLElement>('[data-row]').forEach((el) => {
          before.set(el.dataset.row!, el.getBoundingClientRect().top);
        });
        grid.querySelectorAll<HTMLElement>('[data-cell]').forEach((el) => {
          prevLead.set(el.dataset.cell!, el.dataset.lead || '');
        });
      }
      grid.innerHTML = cells.join('');
      animateDash(grid, before, prevLead);
      // 各黨領先數（開票初期不算）
      const order = ['kmt', 'dpp', 'tpp', 'ind', 'other'];
      const n: Record<string, number> = {};
      let early = 0;
      let won = 0;
      views.forEach((v: any) => {
        const head = v.winner || v.leader;
        if (!head) return;
        if (v.early) return void early++;
        if (v.winner) won++;
        const k = partyKey(head.party);
        n[k] = (n[k] || 0) + 1;
      });
      const tally = $('[data-lb-dtally]');
      if (tally)
        tally.innerHTML =
          order
            .filter((k) => n[k])
            .map(
              (k) =>
                `<li data-party="${k}"><span class="lb-chip" aria-hidden="true"></span>${esc(C.party[k])} <b>${n[k]}</b></li>`,
            )
            .join('') +
          (early
            ? `<li data-party="early">${esc(C.early)} <b>${early}</b></li>`
            : '') +
          (won
            ? `<li class="is-won">${esc(C.elected)} <b>${won}</b></li>`
            : '');
    }

    /** 議員儀表板：22 縣市各一格，政黨暫時席次的色條與數字；點縣市在下面列出各選舉區。 */
    const ORDER = ['kmt', 'dpp', 'tpp', 'ind', 'other'];
    function seatsByKey(obj: any) {
      const n: Record<string, number> = {};
      Object.entries(obj || {}).forEach(([p, v]) => {
        const k = partyKey(p);
        n[k] = (n[k] || 0) + (Number(v) || 0);
      });
      return n;
    }
    function renderCouncil() {
      const grid = $('[data-lb-dgrid]');
      if (!grid) return;
      const nat: Record<string, number> = {};
      let natWon = 0;
      const cells = B.races.map((race: any) => {
        const c = council?.counties?.[race.area];
        const seats = c?.seats || 0;
        const lead = seatsByKey(c?.leading);
        const won = Object.values(c?.elected || {}).reduce(
          (a: number, v: any) => a + (Number(v) || 0),
          0,
        ) as number;
        natWon += won;
        ORDER.forEach((k) => (nat[k] = (nat[k] || 0) + (lead[k] || 0)));
        const top = ORDER.filter((k) => lead[k]).sort(
          (a, b) => lead[b] - lead[a],
        )[0];
        const open =
          typeof c?.reported === 'number' &&
          typeof c?.total === 'number' &&
          c.total > 0
            ? (c.reported / c.total) * 100
            : null;
        const early = open !== null && open < 5;
        // 地圖
        const path = root!.querySelector(
          `[data-lb-map="${CSS.escape(race.area)}"] path`,
        );
        path?.setAttribute('data-party', top && !early ? top : 'none');
        (path as SVGElement | null)?.style.setProperty(
          '--k',
          String(
            top && !early && seats
              ? Math.min(
                  1,
                  Math.max(0.5, 0.5 + ((lead[top] / seats - 0.3) / 0.35) * 0.5),
                )
              : 0,
          ),
        );
        path?.toggleAttribute('data-early', false);
        path?.toggleAttribute('data-media', false);
        const lab = root!.querySelector(
          `[data-lb-map-pct="${CSS.escape(race.area)}"]`,
        );
        if (lab) lab.textContent = top ? String(lead[top]) : '';
        const bar = ORDER.filter((k) => lead[k])
          .map((k) => `<i data-party="${k}" style="flex:${lead[k]}"></i>`)
          .join('');
        const chips = ORDER.filter((k) => lead[k])
          .map(
            (k) =>
              `<span class="lb-cc" data-party="${k}"><span class="lb-chip" aria-hidden="true"></span>${esc(C.party[k])} <b data-n="${lead[k]}" data-f="int" data-k="${esc('c|' + race.area + '|' + k)}">${lead[k]}</b></span>`,
          )
          .join('');
        return `<li><a class="lb-dc lb-dc-council${early ? ' is-early' : ''}${councilArea === race.area ? ' is-sel' : ''}" href="#lb-council-detail" data-council="${esc(race.area)}" data-party="${top && !early ? top : 'none'}"><span class="lb-dc-h"><b>${esc(race.label)}</b><span class="lb-dc-seats">${esc(fill(C.seatsN, { n: seats || '—' }))}</span>${won ? `<span class="lb-tag lb-tag-win">${esc(C.elected)} ${won}</span>` : ''}<span class="lb-dc-r">${open === null ? '' : esc(fill(C.openedPct, { p: open.toFixed(open < 10 ? 1 : 0) }))}</span></span><span class="lb-cbar" aria-hidden="true">${bar}</span><span class="lb-ccs">${chips || esc(C.noData)}</span></a></li>`;
      });
      grid.innerHTML = cells.join('');
      tweenNumbers(grid);
      const tally = $('[data-lb-dtally]');
      if (tally)
        tally.innerHTML =
          ORDER.filter((k) => nat[k])
            .map(
              (k) =>
                `<li data-party="${k}"><span class="lb-chip" aria-hidden="true"></span>${esc(C.party[k])} <b data-n="${nat[k]}" data-f="int" data-k="cn|${k}">${nat[k]}</b></li>`,
            )
            .join('') +
          `<li class="lb-dtally-of">/ ${num(council?.totalSeats || 919)}</li>` +
          (natWon
            ? `<li class="is-won">${esc(C.elected)} <b>${natWon}</b></li>`
            : '');
      if (tally) tweenNumbers(tally);
      renderCouncilDetail();
    }
    function renderCouncilDetail() {
      const box = $('[data-lb-cdetail]');
      const list = $('[data-lb-cdistricts]');
      const title = $('[data-lb-cdetail-title]');
      if (!box || !list || !title) return;
      const race = B.races.find((r: any) => r.area === councilArea);
      const c = council?.counties?.[councilArea];
      box.hidden = tab !== 'council' || !race || !c;
      if (box.hidden) return;
      title.textContent = fill(C.districtTitle, { area: race.label });
      list.innerHTML = (c.districts || [])
        .map((d: any) => {
          const rows = (d.candidates || [])
            .filter((x: any) => x.inTop || x.elected)
            .map(
              (x: any) =>
                `<li data-party="${partyKey(x.party)}"><span class="lb-chip" aria-hidden="true"></span><span class="lb-cd-n">${esc(x.name)}${x.elected ? ` <span class="lb-tag lb-tag-win">${esc(C.elected)}</span>` : ''}</span><span class="lb-cd-p">${esc(x.party)}</span><span class="lb-cd-v">${num(x.votes)}</span></li>`,
            )
            .join('');
          const rest = (d.candidates || []).filter(
            (x: any) => !x.inTop && !x.elected,
          );
          const restRows = rest
            .map(
              (x: any) =>
                `<li data-party="${partyKey(x.party)}"><span class="lb-chip" aria-hidden="true"></span><span class="lb-cd-n">${esc(x.name)}</span><span class="lb-cd-p">${esc(x.party)}</span><span class="lb-cd-v">${num(x.votes)}</span></li>`,
            )
            .join('');
          const prog =
            typeof d.reported === 'number' &&
            typeof d.total === 'number' &&
            d.total > 0
              ? esc(fill(C.reported, { a: num(d.reported), b: num(d.total) }))
              : '';
          return `<section class="lb-cd"><h4>${esc(d.name)} <span>${esc(fill(C.seatsShort, { n: d.seats }))}</span><span class="lb-cd-prog">${prog}</span></h4><ol>${rows}</ol>${rest.length ? `<details class="lb-more"><summary>${esc(fill(C.more, { n: rest.length }))}</summary><ol>${restRows}</ol></details>` : ''}</section>`;
        })
        .join('');
    }

    function renderCredits() {
      const ul = $('[data-lb-credits]');
      const tt = $('[data-lb-credits-title]');
      const ppl = avatars?.people || {};
      const names = Object.keys(ppl);
      if (!ul || !tt) return;
      tt.hidden = names.length === 0;
      ul.innerHTML = names
        .map((n) => {
          const a = ppl[n] || {};
          const u = safeUrl(a.source);
          const who = String(a.author || '')
            .replace(/<[^>]*>/g, '')
            .slice(0, 60);
          return `<li>${esc(n)} · ${esc(a.license || '')}${who ? ' · ' + esc(who) : ''}${u ? ` · <a href="${esc(u)}" class="no-external-icon" target="_blank" rel="noopener noreferrer">${esc(C.source)} ↗</a>` : ''}</li>`;
        })
        .join('');
    }

    // ── 新聞輪播列 ──
    let tickIdx = 0;
    let tickIds: string[] = [];
    function tickerItems() {
      const list = Array.isArray(feed?.items) ? feed.items.slice() : [];
      list.sort((a: any, b: any) =>
        String(b.time).localeCompare(String(a.time)),
      );
      return list.slice(0, 12);
    }
    function showTick(flash = false) {
      const el = $('[data-lb-ticker]');
      const body = $('[data-lb-ticker-body]');
      const list = tickerItems();
      if (!el || !body) return;
      el.hidden = list.length === 0;
      if (!list.length) return;
      const it = list[tickIdx % list.length];
      body.innerHTML = `<time>${esc(timeFmt(it.time))}</time><span class="lb-badge" data-kind="${esc(it.kind)}">${esc(C.kind[it.kind] || '')}</span><span class="lb-ticker-title">${esc(it.title)}</span>`;
      if (!REDUCE) {
        body.classList.remove('is-in');
        void (body as HTMLElement).offsetWidth;
        body.classList.add('is-in');
        if (flash) {
          el.classList.add('is-new');
          setTimeout(() => el.classList.remove('is-new'), 2400);
        }
      }
    }
    function syncTicker() {
      const ids = tickerItems().map((i: any) => String(i.id));
      const fresh =
        tickIds.length > 0 && ids.length > 0 && !tickIds.includes(ids[0]);
      tickIds = ids;
      if (fresh) tickIdx = 0;
      showTick(fresh);
    }
    setInterval(() => {
      if (document.hidden) return;
      tickIdx++;
      showTick();
    }, 6000);

    // ── 分頁與議員縣市選擇 ──
    root.querySelector('[data-lb-tabs]')?.addEventListener('click', (e) => {
      const b = (e.target as HTMLElement).closest<HTMLElement>('[data-lb-tab]');
      if (!b) return;
      tab = b.dataset.lbTab === 'council' ? 'council' : 'mayor';
      root.setAttribute('data-lb-tab-on', tab);
      root.querySelectorAll<HTMLElement>('[data-lb-tab]').forEach((x) => {
        const on = x === b;
        x.classList.toggle('is-on', on);
        x.setAttribute('aria-selected', String(on));
      });
      renderAll();
      if (tab === 'council' && !council) refresh(true);
    });
    root.querySelector('[data-lb-dgrid]')?.addEventListener('click', (e) => {
      const a = (e.target as HTMLElement).closest<HTMLElement>(
        '[data-council]',
      );
      if (!a) return;
      councilArea = a.dataset.council || '';
      renderCouncil();
    });

    /** 每個縣市取「目前最好的來源」：官方追上了用官方，否則用媒體計票；都沒有就是空。 */
    function bestView(race: any) {
      const mv = mediaView(race);
      if (mv) {
        const total = mv.list.reduce((a: number, c: any) => a + c.votes, 0);
        return {
          race,
          src: 'media',
          leader: mv.list[0],
          gap:
            total > 0
              ? ((mv.list[0].votes - (mv.list[1]?.votes || 0)) / total) * 100
              : 0,
          at: String(mv.updatedAt || ''),
        };
      }
      const v = raceView(race);
      const head = v.winner || (!v.early ? v.leader : null);
      if (!head) return { race, src: 'none', leader: null, gap: 0, at: '' };
      const second = v.cands.find((c: Cand) => c !== head);
      return {
        race,
        src: 'cec',
        leader: head,
        gap: (head.pct || 0) - (second?.pct || 0),
        won: !!v.winner,
        at: '',
      };
    }

    function renderMedia() {
      const box = $('[data-lb-media]');
      if (!box) return;
      const views = B.races.map(bestView);
      const nMedia = views.filter((x: any) => x.src === 'media').length;
      const nCec = views.filter((x: any) => x.src === 'cec').length;
      // 沒有任何縣市還在用媒體計票時，這塊收掉（下面的官方計票就是全部）
      box.hidden = nMedia === 0;
      if (nMedia === 0) return;
      const order = ['kmt', 'dpp', 'tpp', 'ind', 'other'];
      const count: Record<string, string[]> = {};
      order.forEach((k) => (count[k] = []));
      let latest = '';
      views.forEach((x: any) => {
        if (!x.leader) return;
        count[partyKey(x.leader.party)].push(x.race.label);
        if (x.at > latest) latest = x.at;
      });
      const none = views.filter((x: any) => x.src === 'none').length;
      const bar = $('[data-lb-media-bar]');
      if (bar)
        bar.innerHTML =
          order
            .filter((k) => count[k].length)
            .map(
              (k) =>
                `<span class="lb-seg" data-party="${k}" style="flex:${count[k].length}"><b>${count[k].length}</b></span>`,
            )
            .join('') +
          (none > 0
            ? `<span class="lb-seg" data-party="none" style="flex:${none}"><b>${none}</b></span>`
            : '');
      const legend = $('[data-lb-media-legend]');
      if (legend)
        legend.innerHTML = order
          .filter((k) => count[k].length)
          .map(
            (k) =>
              `<li data-party="${k}"><span class="lb-chip" aria-hidden="true"></span><span class="lb-leg-name">${esc(C.party[k])}</span><span class="lb-leg-n">${count[k].length}</span><span class="lb-leg-areas">${esc(count[k].join(SEP))}</span></li>`,
          )
          .join('');
      const grid = $('[data-lb-media-grid]');
      if (grid)
        grid.innerHTML = views
          .map((x: any) =>
            x.leader
              ? `<li><a class="lb-mcell${x.src === 'media' ? ' is-media' : ''}${x.gap < 5 ? ' is-close' : ''}" href="#lb-race-${esc(x.race.area)}" data-party="${partyKey(x.leader.party)}"><span class="lb-mcell-area">${esc(x.race.label)}<span class="lb-mcell-src">${esc(x.src === 'media' ? C.media : x.won ? C.elected : C.officialShort)}</span></span><span class="lb-mcell-name"><span class="lb-chip" aria-hidden="true"></span>${esc(x.leader.name)}</span><span class="lb-mcell-gap">+${x.gap.toFixed(1)}</span></a></li>`
              : `<li><a class="lb-mcell is-none" href="#lb-race-${esc(x.race.area)}" data-party="none"><span class="lb-mcell-area">${esc(x.race.label)}</span><span class="lb-mcell-name">${esc(C.noData)}</span></a></li>`,
          )
          .join('');
      const tags = $('[data-lb-best-tags]');
      if (tags)
        tags.innerHTML = `<span class="lb-tag">${esc(C.officialShort)} ${nCec}</span><span class="lb-tag lb-tag-unofficial">${esc(C.media)} ${nMedia} · ${esc(C.unofficial)}</span>`;
      const t = $('[data-lb-media-time]');
      if (t) t.textContent = timeFmt(latest);
      const note = $('[data-lb-media-note]');
      const u = safeUrl(media?.sourceUrl);
      if (note)
        note.innerHTML = esc(C.mediaNote).replace(
          '{src}',
          u
            ? `<a href="${esc(u)}" class="no-external-icon" target="_blank" rel="noopener noreferrer">${esc(media.sourceName || u)} ↗</a>`
            : esc(media?.sourceName || ''),
        );
    }

    function renderRaces() {
      const views = B.races.map(raceView);
      for (const group of ['municipal', 'county']) {
        const box = $(`[data-lb-cards="${group}"]`);
        if (!box) continue;
        box.innerHTML = views
          .filter((v: any) =>
            group === 'municipal'
              ? v.race.group === 'municipal'
              : v.race.group !== 'municipal',
          )
          .map(cardHtml)
          .join('');
      }
      if (tab === 'council') return;
      // 地圖：中選會還在開票初期（或沒資料）的縣市，先用媒體計票上色並在圖說標明
      let usedMedia = false;
      views.forEach((v: any) => {
        const a = root!.querySelector(
          `[data-lb-map="${CSS.escape(v.race.area)}"]`,
        );
        const path = a?.querySelector('path');
        const head = v.winner || v.leader;
        if (!a || !path) return;
        // 2026-11-28 18:25 哲宇：票數以中選會為主 → 地圖只用官方數字，媒體計票收在下面的摺疊區
        const mv: any = null;
        path.setAttribute(
          'data-party',
          mv
            ? partyKey(mv.list[0].party)
            : head
              ? partyKey(head.party)
              : 'none',
        );
        path.toggleAttribute('data-early', !!v.early && !mv);
        path.toggleAttribute('data-media', !!mv);
        const lab = root!.querySelector(
          `[data-lb-map-pct="${CSS.escape(v.race.area)}"]`,
        );
        const second2 = v.cands.find((c: Cand) => c !== head);
        const gap =
          head && v.hasVotes ? (head.pct || 0) - (second2?.pct || 0) : 0;
        // 顏色深淺＝領先幅度：差 0 點最淺、差 25 點以上最深；開票初期一律最淺
        (path as SVGElement).style.setProperty(
          '--k',
          String(
            !head ? 0 : v.early ? 0.3 : Math.min(1, 0.5 + (gap / 22) * 0.5),
          ),
        );
        if (lab)
          lab.textContent =
            head && v.hasVotes ? `+${gap.toFixed(gap < 10 ? 1 : 0)}` : '';
        if (mv) usedMedia = true;
        const chip = root!.querySelector(
          `[data-lb-chip="${CSS.escape(v.race.area)}"]`,
        );
        chip?.setAttribute('data-party', head ? partyKey(head.party) : 'none');
        chip?.toggleAttribute('data-early', !!v.early);
        const text = mv
          ? `${C.media} · ${C.unofficial} · ${mv.list[0].name} · ${mv.list[0].partyLabel || mv.list[0].party}`
          : head
            ? `${v.winner ? C.elected : v.early ? C.early : C.leading} ${head.name} · ${head.partyLabel || head.party} · ${(head.pct || 0).toFixed(1)}%`
            : C.noData;
        a.setAttribute(
          'aria-label',
          fill(C.mapAria, { area: v.race.label, text }),
        );
        const t = a.querySelector('title');
        if (t) t.textContent = fill(C.mapAria, { area: v.race.label, text });
      });
      const ms = $('[data-lb-map-src]');
      if (ms) ms.hidden = !usedMedia;
      // 各黨領先縣市數
      const order = ['kmt', 'dpp', 'tpp', 'ind', 'other'];
      const count: Record<
        string,
        { lead: number; won: number; areas: string[] }
      > = {};
      order.forEach((k) => (count[k] = { lead: 0, won: 0, areas: [] }));
      let none = 0;
      let earlyN = 0;
      const earlyAreas: string[] = [];
      views.forEach((v: any) => {
        const head = v.winner || v.leader;
        if (!head) return void none++;
        if (v.early) {
          earlyN++;
          earlyAreas.push(v.race.label);
          return;
        }
        const k = partyKey(head.party);
        count[k].lead++;
        if (v.winner) count[k].won++;
        count[k].areas.push(v.race.label);
      });
      $('[data-lb-score-wrap]')?.classList.toggle(
        'is-empty',
        none === views.length,
      );
      const bar = $('[data-lb-score-bar]');
      const legend = $('[data-lb-score-legend]');
      if (bar && legend) {
        const segs = order
          .filter((k) => count[k].lead > 0)
          .map(
            (k) =>
              `<span class="lb-seg" data-party="${k}" style="flex:${count[k].lead}"><b>${count[k].lead}</b></span>`,
          );
        if (earlyN > 0)
          segs.push(
            `<span class="lb-seg" data-party="early" style="flex:${earlyN}"><b>${earlyN}</b></span>`,
          );
        if (none > 0)
          segs.push(
            `<span class="lb-seg" data-party="none" style="flex:${none}"><b>${none === views.length ? '' : none}</b></span>`,
          );
        bar.innerHTML = segs.join('');
        legend.innerHTML =
          none === views.length
            ? `<li class="lb-empty">${esc(C.scoreEmpty)}</li>`
            : order
                .filter((k) => count[k].lead > 0)
                .map(
                  (k) =>
                    `<li data-party="${k}"><span class="lb-chip" aria-hidden="true"></span><span class="lb-leg-name">${esc(C.party[k])}</span><span class="lb-leg-n">${count[k].lead}</span>${count[k].won ? `<span class="lb-leg-won">${esc(C.elected)} ${count[k].won}</span>` : ''}<span class="lb-leg-areas">${esc(count[k].areas.join(SEP))}</span></li>`,
                )
                .join('') +
              (earlyN > 0
                ? `<li data-party="early"><span class="lb-chip" aria-hidden="true"></span><span class="lb-leg-name">${esc(C.early)}</span><span class="lb-leg-n">${earlyN}</span><span class="lb-leg-areas">${esc(earlyAreas.join(SEP))}</span></li>`
                : '') +
              (none > 0
                ? `<li data-party="none"><span class="lb-chip" aria-hidden="true"></span><span class="lb-leg-name">${esc(C.noData)}</span><span class="lb-leg-n">${none}</span></li>`
                : '');
      }
    }

    function renderRef() {
      const box = $('[data-lb-ref-body]');
      if (!box) return;
      const r = results?.referendum;
      const agree = typeof r?.agree === 'number' ? r.agree : null;
      const dis = typeof r?.disagree === 'number' ? r.disagree : null;
      const has = agree !== null && dis !== null && agree + dis > 0;
      const tot = has ? agree! + dis! : 0;
      const pa = has ? (agree! / tot) * 100 : 0;
      const pd = has ? (dis! / tot) * 100 : 0;
      const eligible =
        typeof r?.eligible === 'number' && r.eligible > 0 ? r.eligible : null;
      const need = eligible ? Math.ceil(eligible / 4) : null;
      const refEarly =
        has &&
        typeof r?.reported === 'number' &&
        typeof r?.total === 'number' &&
        r.total > 0 &&
        r.reported / r.total < 0.05;
      const st = (ok: boolean | null) =>
        refEarly
          ? `<span class="lb-rule-st is-pending lb-tag-early">${esc(C.early)}</span>`
          : ok === null
            ? `<span class="lb-rule-st is-pending">${esc(C.pending)}</span>`
            : ok
              ? `<span class="lb-rule-st is-met">${esc(C.met)}</span>`
              : `<span class="lb-rule-st is-not">${esc(C.notMet)}</span>`;
      const prog =
        typeof r?.reported === 'number' &&
        typeof r?.total === 'number' &&
        r.total > 0
          ? `<p class="lb-card-prog"><span class="lb-prog-track"><span class="lb-prog-fill" style="width:${Math.min(100, (r.reported / r.total) * 100).toFixed(1)}%"></span></span><span class="lb-prog-text">${esc(fill(C.reported, { a: num(r.reported), b: num(r.total) }))}</span></p>`
          : '';
      box.innerHTML = `
        <div class="lb-ref-bars">
          <div class="lb-ref-side is-agree"><span class="lb-ref-label">${esc(C.refAgree)}</span><span class="lb-ref-pct">${has ? pa.toFixed(2) + '%' : '—'}</span><span class="lb-ref-votes">${has ? num(agree) + ' ' + esc(C.votes) : ''}</span></div>
          <div class="lb-ref-side is-dis"><span class="lb-ref-label">${esc(C.refDisagree)}</span><span class="lb-ref-pct">${has ? pd.toFixed(2) + '%' : '—'}</span><span class="lb-ref-votes">${has ? num(dis) + ' ' + esc(C.votes) : ''}</span></div>
        </div>
        <div class="lb-ref-split" aria-hidden="true"><span class="is-agree" style="width:${has ? pa.toFixed(2) : 50}%"></span><span class="is-dis" style="width:${has ? pd.toFixed(2) : 50}%"></span></div>
        <ul class="lb-rules el-reset">
          <li><span class="lb-rule-text">${esc(C.refRule1)}</span>${st(has ? agree! > dis! : null)}</li>
          <li><span class="lb-rule-text">${esc(C.refRule2)}${need && has ? `<span class="lb-rule-sub">${esc(fill(C.refRule2Progress, { a: num(agree), b: num(need) }))}</span>` : ''}
            ${need ? `<span class="lb-thresh" aria-hidden="true"><span style="width:${has ? Math.min(100, (agree! / need) * 100).toFixed(1) : 0}%"></span></span>` : ''}</span>${st(has && need ? agree! >= need : null)}</li>
        </ul>
        ${eligible ? `<p class="lb-ref-elig">${esc(C.refEligible)} ${num(eligible)}</p>` : ''}
        ${prog}`;
    }

    function itemHtml(it: any, isFact: boolean) {
      const srcs = (Array.isArray(it.sources) ? it.sources : [])
        .map((s: any) => {
          const u = safeUrl(s?.url);
          return u
            ? `<a href="${esc(u)}" class="no-external-icon" target="_blank" rel="noopener noreferrer">${esc(s.name || u)} ↗</a>`
            : esc(s?.name || '');
        })
        .filter(Boolean)
        .join(SEP);
      const badge = isFact
        ? `<span class="lb-badge" data-verdict="${esc(it.verdict)}">${esc(C.verdict[it.verdict] || it.verdict || '')}</span>`
        : `<span class="lb-badge" data-kind="${esc(it.kind)}">${esc(C.kind[it.kind] || it.kind || '')}</span>`;
      return `<li class="lb-item">
        <p class="lb-item-meta"><time datetime="${esc(it.time)}">${esc(timeFmt(it.time))}</time>${badge}</p>
        <p class="lb-item-title">${esc(isFact ? it.claim : it.title)}</p>
        ${it.body ? `<p class="lb-item-body">${esc(it.body)}</p>` : ''}
        ${srcs ? `<p class="lb-item-src">${esc(C.source)} ${srcs}</p>` : ''}
      </li>`;
    }

    function renderFeed() {
      const items = $('[data-lb-items]');
      const facts = $('[data-lb-facts]');
      const ov = $('[data-lb-overview]');
      const ovb = $('[data-lb-overview-body]');
      const list = Array.isArray(feed?.items) ? feed.items.slice() : [];
      list.sort((a: any, b: any) =>
        String(b.time).localeCompare(String(a.time)),
      );
      if (items)
        items.innerHTML = list.length
          ? list.map((i: any) => itemHtml(i, false)).join('')
          : `<li class="lb-empty">${esc(C.feedEmpty)}</li>`;
      const fl = Array.isArray(feed?.factchecks) ? feed.factchecks.slice() : [];
      fl.sort((a: any, b: any) => String(b.time).localeCompare(String(a.time)));
      if (facts)
        facts.innerHTML = fl.length
          ? fl.map((i: any) => itemHtml(i, true)).join('')
          : `<li class="lb-empty">${esc(C.factEmpty)}</li>`;
      if (ov && ovb) {
        const paras = Array.isArray(feed?.overview) ? feed.overview : [];
        ov.hidden = paras.length === 0;
        ovb.innerHTML =
          paras.map((p: string) => `<p>${esc(p)}</p>`).join('') +
          (feed?.overviewAt
            ? `<p class="lb-note">${esc(C.updatedAt)} ${esc(timeFmt(feed.overviewAt))}</p>`
            : '');
      }
    }

    function renderStatus() {
      const now = Date.now();
      const closed = now >= Date.parse(B.closeAt);
      const phase = results?.phase;
      let state = 'pre';
      if (phase === 'final') state = 'final';
      else if (phase === 'counting') state = 'counting';
      else if (closed) state = 'waiting';
      root!.setAttribute('data-lb-state', state);
      const status = $('[data-lb-status]');
      const hint = $('[data-lb-hint]');
      const meta = $('[data-lb-meta]');
      const alertEl = $('[data-lb-alert]');
      if (status)
        status.textContent =
          state === 'pre'
            ? C.statusPre
            : state === 'waiting'
              ? C.statusWaiting
              : state === 'counting'
                ? C.statusCounting
                : C.statusFinal;
      if (hint) {
        const t =
          state === 'pre'
            ? C.statusPreHint
            : state === 'waiting'
              ? C.statusWaitingHint
              : state === 'final'
                ? C.statusFinalHint
                : '';
        hint.textContent = t;
        hint.hidden = !t;
      }
      const showMeta =
        !!results?.updatedAt &&
        (state === 'counting' || state === 'final' || state === 'waiting');
      if (meta) meta.hidden = !showMeta;
      if (showMeta) {
        const u = $('[data-lb-updated]');
        if (u) u.textContent = timeFmt(results.updatedAt) || '—';
        const sw = $('[data-lb-stations-wrap]');
        const s = $('[data-lb-stations]');
        const st = results.stations;
        const ok =
          st &&
          typeof st.reported === 'number' &&
          typeof st.total === 'number' &&
          st.total > 0;
        if (sw) sw.hidden = !ok;
        const tb = $('[data-lb-total]');
        const tf = $('[data-lb-total-fill]');
        if (tb) tb.hidden = !ok;
        if (tf && ok)
          tf.style.width = `${Math.max(0.6, (st.reported / st.total) * 100).toFixed(2)}%`;
        if (s && ok)
          s.innerHTML = `<span data-n="${st.reported}" data-f="int" data-k="st|rep">${num(st.reported)}</span> / ${num(st.total)}（${((st.reported / st.total) * 100).toFixed(st.reported / st.total < 0.01 ? 2 : 1)}%）`;
        if (s && ok) tweenNumbers(s);
      }
      if (alertEl) {
        let msg = '';
        if (state === 'counting') {
          const age = (now - Date.parse(results.updatedAt)) / 60000;
          if (isFinite(age) && age > B.staleMin)
            msg = fill(C.stale, { n: Math.floor(age) });
        } else if (state === 'waiting' && resultsFailed) msg = C.unavailable;
        if (
          !msg &&
          results?.notice &&
          (state === 'counting' || state === 'final')
        )
          msg = String(results.notice);
        alertEl.textContent = msg;
        alertEl.hidden = !msg;
      }
    }

    function renderAll() {
      renderStatus();
      renderDash();
      renderMedia();
      renderRaces();
      renderRef();
      renderFeed();
      renderCredits();
      syncTicker();
    }

    // 資料分支的檔案走 raw.githubusercontent.com，分支網址固定快取五分鐘，查詢字串也繞不過。
    // 所以先問 GitHub API 目前最新的提交碼（快取一分鐘、允許跨網域），再用「提交碼網址」取檔：
    // 提交碼網址的內容不會變，沒有舊快取的問題。API 匿名額度是每個 IP 每小時 60 次，
    // 這裡最多每 70 秒問一次；問不到（超過額度、斷線）就退回分支網址，只是會慢幾分鐘。
    const SHA_API =
      'https://api.github.com/repos/frank890417/taiwan-md/commits/election-live';
    const RAW_ROOT = 'https://raw.githubusercontent.com/frank890417/taiwan-md/';
    let shaBase = '';
    let shaAskedAt = 0;
    async function dataBase() {
      if (!B.dataBase.startsWith('https://raw.githubusercontent.com/'))
        return B.dataBase; // 本機假資料
      const now = Date.now();
      if (now - shaAskedAt < 70000) return shaBase || B.dataBase;
      shaAskedAt = now;
      try {
        const r = await fetch(SHA_API, {
          headers: { Accept: 'application/vnd.github.sha' },
          cache: 'no-store',
        });
        const t = r.ok ? (await r.text()).trim() : '';
        shaBase = /^[0-9a-f]{40}$/.test(t) ? `${RAW_ROOT}${t}/` : '';
      } catch {
        shaBase = '';
      }
      return shaBase || B.dataBase;
    }
    async function getJson(name: string, base: string) {
      const pinned = base !== B.dataBase;
      const res = await fetch(
        pinned
          ? `${base}${name}`
          : `${base}${name}?t=${Math.floor(Date.now() / 60000)}`,
        pinned ? {} : { cache: 'no-store' },
      );
      if (!res.ok) throw new Error(`HTTP ${res.status}`);
      return res.json();
    }
    async function refresh(force?: unknown) {
      // 背景分頁不抓：掛著不看的分頁會吃掉同一個 IP 的 API 額度；回到前景時 visibilitychange 會補抓
      if (document.hidden && force !== true) return;
      // 16:00 前不抓票數檔，殼上不會出現任何數字
      const closed = Date.now() >= Date.parse(B.closeAt);
      const base = await dataBase();
      const jobs: Promise<void>[] = [
        getJson('feed.json', base)
          .then((j) => void (feed = j))
          .catch(() => {}),
      ];
      jobs.push(
        getJson('avatars.json', base)
          .then((j) => {
            avatars = j;
            avatarBase = base;
          })
          .catch(() => {}),
      );
      if (closed && tab === 'council')
        jobs.push(
          getJson('council.json', base)
            .then((j) => void (council = j))
            .catch(() => {}),
        );
      if (closed)
        jobs.push(
          getJson('media.json', base)
            .then((j) => void (media = j))
            .catch(() => {}),
        );
      if (closed)
        jobs.push(
          getJson('results.json', base)
            .then((j) => {
              results = j;
              resultsFailed = false;
            })
            .catch(() => {
              resultsFailed = true;
            }),
        );
      await Promise.all(jobs);
      renderAll();
    }
    // 本機預覽專用：window.__lb.patch(fn) 可以改票數後重畫，用來看動畫（正式站不生效）
    if (location.hostname === 'localhost')
      (window as any).__lb = {
        patch(fn: (r: any) => void) {
          fn(results);
          renderAll();
        },
      };
    renderAll();
    refresh();
    setInterval(refresh, B.pollMs);
    setInterval(renderStatus, 30000);
    document.addEventListener('visibilitychange', () => {
      if (!document.hidden) refresh();
    });
  }
</script>

