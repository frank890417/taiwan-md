  .lb-card-title {
    margin: 0;
    font-family: var(--el-serif);
    font-size: 19px;
  }
  .lb-card-tags {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 6px;
    font-size: 12px;
    color: var(--el-ink-3);
  }
  .lb-tag {
    padding: 1px 7px;
    border: 1px solid var(--el-border-strong);
    border-radius: 999px;
    font-size: 12px;
    font-weight: 600;
    color: var(--el-ink-2);
    white-space: nowrap;
  }
  .lb-tag-win {
    border-color: var(--el-positive);
    background: var(--el-positive-soft);
    color: var(--el-positive);
  }
  .lb-rows {
    display: grid;
    gap: 9px;
  }
  .lb-row-top {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 8px;
  }
  .lb-name {
    font-size: 16px;
    font-weight: 600;
    overflow-wrap: anywhere;
  }
  .lb-row.is-head .lb-name {
    font-size: 18px;
    font-weight: 800;
  }
  .lb-pct {
    font-size: 16px;
    font-weight: 700;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }
  .lb-row.is-head .lb-pct {
    font-size: 20px;
  }
  .lb-row-sub {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 2px 8px;
    font-size: 12.5px;
    color: var(--el-ink-2);
  }
  .lb-party {
    display: inline-flex;
    align-items: center;
    gap: 5px;
  }
  .lb-no {
    color: var(--el-ink-3);
  }
  .lb-votes {
    margin-inline-start: auto;
    font-variant-numeric: tabular-nums;
  }
  .lb-bar {
    height: 6px;
    margin-top: 4px;
    border-radius: 3px;
    background: var(--el-rule);
    overflow: hidden;
  }
  .lb-bar > span {
    display: block;
    height: 100%;
    background: var(--p);
    border-radius: 3px;
    transition: width 0.6s ease;
  }
  .lb-row:not(.is-head) .lb-bar > span {
    opacity: 0.7;
  }
  .lb-card-prog {
    display: flex;
    align-items: center;
    gap: 8px;
    margin: 12px 0 0;
    font-size: 12px;
    color: var(--el-ink-3);
  }
  .lb-prog-track {
    flex: 1;
    height: 4px;
    border-radius: 2px;
    background: var(--el-rule);
    overflow: hidden;
  }
  .lb-prog-fill {
    display: block;
    height: 100%;
    background: var(--el-ink-3);
  }
  .lb-prog-text {
    white-space: nowrap;
    font-variant-numeric: tabular-nums;
  }
  /* 公投 */
  .lb-ref {
    margin-bottom: 28px;
    padding: 18px;
    background: var(--el-card);
    border: 1px solid var(--el-border);
    border-radius: 14px;
  }
  .lb-ref-q {
    margin: 0 0 14px;
    font-size: 16px;
    line-height: 1.6;
  }
  .lb-ref-bars {
    display: flex;
    justify-content: space-between;
    gap: 16px;
  }
  .lb-ref-side {
    display: grid;
    gap: 2px;
  }
  .lb-ref-side.is-dis {
    text-align: end;
  }
  .lb-ref-label {
    font-size: 14px;
    font-weight: 700;
  }
  .lb-ref-side.is-agree .lb-ref-label,
  .lb-ref-side.is-agree .lb-ref-pct {
    color: var(--lb-agree);
  }
  .lb-ref-side.is-dis .lb-ref-label,
  .lb-ref-side.is-dis .lb-ref-pct {
    color: var(--lb-dis);
  }
  .lb-ref-pct {
    font-size: clamp(26px, 5vw, 38px);
    font-weight: 800;
    font-variant-numeric: tabular-nums;
    line-height: 1.1;
  }
  .lb-ref-votes {
    font-size: 13px;
    color: var(--el-ink-2);
    font-variant-numeric: tabular-nums;
  }
  .lb-ref-split {
    display: flex;
    height: 14px;
    margin: 10px 0 14px;
    border-radius: 7px;
    overflow: hidden;
    background: var(--el-rule);
  }
  .lb-ref-split .is-agree {
    background: var(--lb-agree);
  }
  .lb-ref-split .is-dis {
    background: var(--lb-dis);
  }
  .lb-ref-split span {
    transition: width 0.6s ease;
  }
  .lb[data-lb-state='pre'] .lb-ref-split span,
  .lb[data-lb-state='waiting'] .lb-ref-split span {
    background: var(--el-rule);
  }
  .lb-rules {
    display: grid;
    gap: 10px;
  }
  .lb-rules li {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 12px;
    padding-top: 10px;
    border-top: 1px solid var(--el-rule);
    font-size: 14.5px;
    line-height: 1.5;
  }
  .lb-rule-text {
    flex: 1;
  }
  .lb-rule-sub {
    display: block;
    font-size: 13px;
    color: var(--el-ink-2);
    font-variant-numeric: tabular-nums;
  }
  .lb-thresh {
    display: block;
    height: 6px;
    margin-top: 6px;
    border-radius: 3px;
    background: var(--el-rule);
    overflow: hidden;
  }
  .lb-thresh > span {
    display: block;
    height: 100%;
    background: var(--lb-agree);
  }
  .lb-rule-st {
    padding: 2px 9px;
    border-radius: 999px;
    font-size: 12.5px;
    font-weight: 700;
    white-space: nowrap;
    border: 1px solid var(--el-border-strong);
    color: var(--el-ink-2);
  }
  .lb-rule-st.is-met {
    border-color: var(--el-positive);
    color: var(--el-positive);
    background: var(--el-positive-soft);
  }
  .lb-rule-st.is-not {
    border-color: var(--lb-dis);
    color: var(--lb-dis);
  }
  .lb-ref-elig {
    margin: 10px 0 0;
    font-size: 13px;
    color: var(--el-ink-2);
  }
  /* 消息與查核 */
  .lb-feed-grid {
    display: grid;
    gap: 24px;
    margin-bottom: 20px;
  }
  @media (min-width: 900px) {
    .lb-feed-grid {
      grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr);
      align-items: start;
    }
  }
  .lb-feed,
  .lb-fact {
    padding: 18px;
    background: var(--el-card);
    border: 1px solid var(--el-border);
    border-radius: 14px;
  }
  .lb-overview {
    margin-bottom: 24px;
    padding: 18px 20px;
    border-inline-start: 3px solid var(--el-accent);
    background: var(--el-card);
    border-start-end-radius: 14px;
    border-end-end-radius: 14px;
  }
  .lb-more {
    margin-top: 9px;
  }
  .lb-more summary {
    cursor: pointer;
    font-size: 12.5px;
    color: var(--el-ink-3);
  }
  .lb-more[open] summary {
    margin-bottom: 9px;
  }
  .lb-overview-body p {
    margin: 0 0 8px;
    max-width: 46em;
    font-size: 17px;
    line-height: 1.75;
  }
  .lb-items {
    display: grid;
    gap: 0;
    margin-top: 12px;
  }
  .lb-item {
    padding: 12px 0;
    border-top: 1px solid var(--el-rule);
  }
  .lb-item-meta {
    display: flex;
    align-items: center;
    gap: 8px;
    margin: 0 0 4px;
    font-size: 12.5px;
    color: var(--el-ink-3);
    font-variant-numeric: tabular-nums;
  }
  .lb-badge {
    padding: 1px 7px;
    border-radius: 4px;
    background: var(--el-slate);
    color: var(--el-slate-ink);
    font-size: 12px;
    font-weight: 700;
  }
  .lb-badge[data-kind='official'],
  .lb-badge[data-verdict='true'] {
    background: var(--el-positive-soft);
    color: var(--el-positive);
  }
  .lb-badge[data-kind='camp'],
  .lb-badge[data-verdict='unverified'],
  .lb-badge[data-verdict='context'],
  .lb-badge[data-verdict='partly'] {
    background: var(--el-warn-soft);
    color: var(--el-accent-2);
  }
  .lb-badge[data-verdict='false'],
  .lb-badge[data-kind='correction'] {
    background: var(--el-accent-soft);
    color: var(--el-accent);
  }
  .lb-item-title {
    margin: 0;
    font-size: 16px;
    font-weight: 700;
    line-height: 1.5;
  }
  .lb-item-body {
    margin: 4px 0 0;
    font-size: 14.5px;
    line-height: 1.7;
    color: var(--el-ink-2);
  }
  .lb-item-src {
    margin: 4px 0 0;
    font-size: 12.5px;
    color: var(--el-ink-3);
    overflow-wrap: anywhere;
  }
  .lb-method {
    font-size: 13.5px;
    color: var(--el-ink-2);
  }
  .lb-method summary {
    cursor: pointer;
    font-weight: 600;
  }
  .lb-method p {
    margin: 8px 0 0;
    max-width: 52em;
    line-height: 1.7;
  }

  /* ── 儀表板：電腦版一個畫面看完 ───────────────────────────── */
  .lb-dash {
    margin-bottom: 28px;
  }
  .lb-dtop {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px 22px;
    margin-bottom: 10px;
  }
  .lb-dtitle {
    display: flex;
    align-items: baseline;
    gap: 12px;
  }
  .lb-dtop .lb-title {
    margin: 0;
    font-size: clamp(26px, 3vw, 38px);
    line-height: 1;
  }
  .lb-dsub {
    margin: 0;
    font-size: 12.5px;
    color: var(--el-ink-3);
  }
  .lb-dstatus {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px 16px;
    padding: 6px 12px;
    background: var(--el-card);
    border: 1px solid var(--el-border-strong);
    border-radius: 10px;
  }
  .lb-dstatus .lb-status-line {
    font-size: 15px;
  }
  .lb-dstatus .lb-meta {
    display: flex;
    gap: 16px;
    margin: 0;
  }
  .lb-dstatus .lb-meta > div {
    display: flex;
    align-items: baseline;
    gap: 6px;
  }
  .lb-dstatus .lb-meta dd {
    margin: 0;
    font-size: 15px;
  }
  .lb-dstatus .lb-total {
    flex: 1 1 100%;
    margin-top: 0;
    height: 4px;
  }
  .lb-dtally {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  .lb-dtally li {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 4px 10px;
    border: 1px solid var(--el-border-strong);
    border-radius: 999px;
    font-size: 13.5px;
    white-space: nowrap;
  }
  .lb-dtally b {
    font-size: 17px;
    font-variant-numeric: tabular-nums;
  }
  .lb-dtally li[data-party='early'] {
    border-style: dashed;
    color: var(--el-ink-2);
    background: none;
  }
  .lb-dtally li.is-won {
    border-color: var(--el-positive);
    color: var(--el-positive);
  }
  .lb-dtop .lb-links {
    margin: 0 0 0 auto;
    font-size: 13px;
  }
  .lb-dash > .lb-status-hint {
    margin: 0 0 10px;
  }
  .lb-dbody {
    display: grid;
    gap: 12px;
  }
  .lb-dbody .lb-map {
    padding: 8px;
    position: static;
  }
  .lb-dgrid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 6px;
  }
  .lb-dgrid > li {
    min-width: 0;
    display: flex;
  }
  .lb-dgrid > li.lb-dc-wide {
    grid-column: span 2;
  }
  .lb .lb-dc {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 3px;
    width: 100%;
    min-width: 0;
    padding: 6px 9px 7px;
    background: var(--el-card);
    border: 1px solid var(--el-border);
    border-top: 3px solid var(--p);
    border-radius: 9px;
    color: var(--el-ink);
    text-decoration: none;
  }
  .lb .lb-dc[data-party='none'] {
    border-top-color: var(--el-border-strong);
  }
  .lb .lb-dc.is-early {
    border-top-style: dashed;
  }
  .lb .lb-dc:hover,
  .lb .lb-dc:focus-visible {
    border-color: var(--el-ink-2);
    border-top-color: var(--p);
  }
  .lb-dc-h {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 13.5px;
    line-height: 1.2;
  }
  .lb-dc-h b {
    font-family: var(--el-serif);
    font-size: 15px;
  }
  .lb-dc-h .lb-tag {
    padding: 0 6px;
    font-size: 11px;
  }
  .lb-dc-r {
    margin-inline-start: auto;
    font-size: 11.5px;
    color: var(--el-ink-3);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }
  .lb-dc-row {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    grid-template-rows: auto auto;
    column-gap: 7px;
    align-items: center;
    line-height: 1.15;
  }
  .lb-av {
    grid-row: 1 / span 2;
    display: inline-grid;
    place-items: center;
    width: 30px;
    height: 30px;
    border-radius: 50%;
    border: 2px solid var(--p);
    background: color-mix(in srgb, var(--p) 22%, #1a1714) center / cover
      no-repeat;
    color: var(--el-ink);
    font-family: var(--el-serif);
    font-size: 14px;
    font-weight: 700;
    flex: none;
  }
  .lb-dc-n {
    font-size: 14px;
    font-weight: 600;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .lb-dc-row.is-head .lb-dc-n {
    font-weight: 800;
  }
  .lb-dc-p {
    font-size: 15px;
    font-weight: 700;
    font-variant-numeric: tabular-nums;
    text-align: end;
  }
  .lb-dc-row.is-head .lb-dc-p {
    font-size: 16.5px;
  }
  .lb-dc-row:not(.is-head) .lb-dc-p {
    color: var(--el-ink-2);
  }
  .lb-dc-v {
    grid-column: 2 / span 2;
    font-size: 12.5px;
    color: var(--el-ink-2);
    font-variant-numeric: tabular-nums;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .lb-dc-bar {
    display: flex;
    height: 5px;
    border-radius: 3px;
    background: var(--el-rule);
    overflow: hidden;
  }
  .lb-dc-bar i {
    display: block;
    height: 100%;
    background: var(--p);
    transition: width 0.6s ease;
  }
  .lb-dc.is-early .lb-dc-bar i {
    opacity: 0.45;
  }
  .lb .is-tick {
    color: var(--el-accent-2);
  }
  .lb-dc-row {
    will-change: transform;
  }
  .lb .lb-dc.is-flip {
    animation: lb-flip 2.6s ease-out;
  }
  .lb .lb-dc.is-flip .lb-dc-row.is-head .lb-dc-n::after {
    content: ' ▲';
    color: var(--el-accent-2);
    font-size: 0.8em;
  }
  @keyframes lb-flip {
    0% {
      box-shadow:
        0 0 0 3px var(--el-accent-2),
        0 0 26px 4px var(--p);
      background: color-mix(in srgb, var(--p) 26%, var(--el-card));
    }
    100% {
      box-shadow: 0 0 0 0 transparent;
      background: var(--el-card);
    }
  }
  .lb-c.is-flip {
    animation: lb-map-flip 0.65s ease-in-out 4;
  }
  @keyframes lb-map-flip {
    50% {
      fill-opacity: 0.35;
      stroke: #fff;
      stroke-width: 2.4;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .lb .lb-dc.is-flip,
    .lb-c.is-flip {
      animation: none;
    }
  }
  .lb-dc-refrow {
    display: flex;
    justify-content: space-between;
    gap: 10px;
    font-size: 13px;
  }
  .lb-dc-refrow b {
    font-size: 18px;
    font-variant-numeric: tabular-nums;
  }
  .lb-dc-refrow i {
    font-style: normal;
    font-size: 11.5px;
    color: var(--el-ink-3);
    font-variant-numeric: tabular-nums;
  }
  .lb-dc-refrow .is-agree b,
  .lb-dc-refrow .is-agree {
    color: var(--lb-agree);
  }
  .lb-dc-refrow .is-dis b,
  .lb-dc-refrow .is-dis {
    color: var(--lb-dis);
  }
  .lb-dc-ref .lb-ref-split {
    height: 7px;
    margin: 0;
  }
  .lb-dc-thresh {
    font-size: 11.5px;
    color: var(--el-ink-3);
    font-variant-numeric: tabular-nums;
  }
  @media (min-width: 720px) {
    .lb-dgrid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  /* 電腦版：整個儀表板剛好一個畫面（扣掉站台表頭），左地圖、右四欄六列 */
  @media (min-width: 1100px) and (min-height: 660px) {
    .el-surface .lb {
      padding-top: 12px;
    }
    .lb .lb-wrap {
      max-width: 1680px;
    }
    .lb-dash {
      display: flex;
      flex-direction: column;
      height: calc(100dvh - 92px);
      min-height: 560px;
    }
    .lb-dbody {
      flex: 1;
      min-height: 0;
      grid-template-columns: minmax(300px, 0.5fr) minmax(0, 1fr);
    }
    .lb-dbody .lb-map {
      display: flex;
      flex-direction: column;
      min-height: 0;
    }
    .lb-dbody .lb-svg {
      flex: 1;
      min-height: 0;
      max-width: none;
      width: 100%;
      height: 100%;
    }
    .lb-dgrid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      grid-auto-rows: minmax(0, 1fr);
      min-height: 0;
    }
    .lb .lb-dc {
      overflow: hidden;
    }
    /* 右下角有站台的浮動按鈕（字級、.md），公投那格右邊留白避開 */
    .lb .lb-dc-ref {
      padding-inline-end: 132px;
    }
  }
  /* 半個螢幕寬（視窗靠左放）：一樣一個畫面看完，格子改成單行、三欄八列 */
  @media (min-width: 760px) and (max-width: 1099px) and (min-height: 660px) {
    .el-surface .lb {
      padding-top: 10px;
    }
    .lb-dash {
      display: flex;
      flex-direction: column;
      height: calc(100dvh - 86px);
      min-height: 560px;
    }
    .lb-dtop {
      gap: 6px 12px;
      margin-bottom: 6px;
    }
    .lb-dsub,
    .lb-dtop .lb-links {
      display: none;
    }
    .lb-dbody {
      flex: 1;
      min-height: 0;
      grid-template-columns: minmax(200px, 0.42fr) minmax(0, 1fr);
      gap: 8px;
    }
    .lb-dbody .lb-map {
      display: flex;
      flex-direction: column;
      min-height: 0;
      padding: 4px;
    }
    .lb-dbody .lb-svg {
      flex: 1;
      min-height: 0;
      max-width: none;
      width: 100%;
      height: 100%;
    }
    .lb-dgrid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      grid-auto-rows: minmax(0, 1fr);
      min-height: 0;
      gap: 4px;
    }
    .lb .lb-dc {
      overflow: hidden;
      padding: 4px 6px;
      gap: 1px;
    }
    .lb-dc-bar {
      display: none;
    }
    .lb-dc-row {
      grid-template-columns: auto minmax(0, 1fr) auto auto;
      grid-template-rows: auto;
      column-gap: 5px;
    }
    .lb-av {
      grid-row: auto;
      width: 22px;
      height: 22px;
      font-size: 11px;
      border-width: 1.5px;
    }
    .lb-dc-n {
      font-size: 13px;
    }
    .lb-dc-v {
      grid-column: auto;
      grid-row: 1;
      order: 2;
      font-size: 11px;
    }
    .lb-dc-p,
    .lb-dc-row.is-head .lb-dc-p {
      order: 3;
      font-size: 13.5px;
      min-width: 3.2em;
    }
    .lb-dc-h b {
      font-size: 13.5px;
    }
    .lb-map-cap {
      display: none;
    }
  }
  @media (max-width: 759px) {
    .lb-dbody .lb-svg {
      max-height: 46vh;
    }
  }
  @media (min-width: 1500px) and (min-height: 660px) {
    .lb-dgrid {
      grid-template-columns: repeat(6, minmax(0, 1fr));
    }
  }
  .lb-fold {
    margin-bottom: 24px;
  }
  .lb-fold > summary {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    cursor: pointer;
    padding: 8px 12px;
    border: 1px dashed var(--el-border-strong);
    border-radius: 10px;
    font-size: 14px;
    color: var(--el-ink-2);
  }
  .lb-fold[open] > summary {
    margin-bottom: 12px;
  }
  .lb-grid-solo {
