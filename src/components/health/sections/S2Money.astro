---
/** §2 錢：健保收支、安全準備、醫療保健支出占 GDP。 */
import LineChart from '../../budget/LineChart.astro';
import { healthCtx } from '../../../utils/health/pageContext';
import RelatedChips from '../RelatedChips.astro';
import type { RelItem } from '../../../utils/health/related';
interface Props {
  lang: string;
  related: RelItem[];
}
const { lang, related } = Astro.props;
const { t, r, p, zh, topic } = healthCtx(lang);
const fin = topic.finance.rows;
const finA = fin.filter((x) => x.income !== null);
const nhe = topic.nhe.rows;
---

<section class="bp-section" id="s2">
  <div class="bp-wrap">
    <blockquote class="bp-kicker">{t('s2.kicker')}</blockquote>
    <h2 class="bp-h2">{t('s2.h2')}</h2>
    <p class="bp-lede">{t('s2.lede')}</p>
    <div class="bp-two bp-two-charts">
      <LineChart
        id="c-fin"
        title={p('s2.c1.title')}
        subtitle={p('s2.c1.sub')}
        years={finA.map((x) => x.year)}
        lang={lang}
        height={320}
        series={[
          {
            id: 'income',
            label: t('s2.series.income'),
            values: finA.map((x) => x.income),
            cls: 'bg-s0',
          },
          {
            id: 'cost',
            label: t('s2.series.cost'),
            values: finA.map((x) => x.cost),
            cls: 'bg-s2',
          },
        ]}
        source={zh
          ? '健保署《全民健康保險統計動向》2013、2023 年版（權責基礎審定決算數）'
          : 'NHIA, NHI Statistical Trends, 2013 and 2023 editions (audited accrual accounts)'}
      />
      <LineChart
        id="c-reserve"
        title={p('s2.c2.title')}
        subtitle={p('s2.c2.sub')}
        years={fin.map((x) => x.year)}
        lang={lang}
        height={320}
        series={[
          {
            id: 'reserve',
            label: t('s2.series.reserve'),
            values: fin.map((x) => Math.max(0, x.reserve)),
            cls: 'bg-s1',
            area: true,
          },
        ]}
        annots={[
          { year: 2016, seriesId: 'reserve', text: '2,474', dir: 'up' },
          { year: 2021, seriesId: 'reserve', text: '936', dir: 'down' },
        ]}
        source={zh
          ? '同左；2024、2025 年為全民健康保險基金決算審定本。2010、2011 年餘額為負（-397、-55 億元），圖上以 0 表示，數字見資料表'
          : 'As left; 2024 and 2025 from audited NHI fund accounts. The 2010 and 2011 balances were negative (-397 and -55) and are drawn as 0'}
      />
    </div>
    <div class="bp-prose">
      <p set:html={r('s2.p1')} />
      <p set:html={r('s2.p2')} />
    </div>
    <LineChart
      id="c-nhe"
      title={p('s2.c3.title')}
      subtitle={p('s2.c3.sub')}
      years={nhe.map((x) => x.year)}
      lang={lang}
      unit="%"
      yMax={10}
      height={290}
      series={[
        {
          id: 'nhe',
          label: t('s2.series.nhe'),
          values: nhe.map((x) => x.gdpPct),
          cls: 'bg-s0',
        },
      ]}
      source={zh
        ? '衛福部《中華民國 113 年國民醫療保健支出》表 1（2026 年 2 月）；2007 年起含長期照顧服務支出'
        : 'MOHW, National Health Expenditure 2024, Table 1 (February 2026); includes long-term care spending from 2007'}
    />
    <div class="bp-prose">
      <p set:html={r('s2.p3')} />
    </div>
    <p class="bp-note" set:html={r('s2.note')} />
    <RelatedChips
      items={related}
      label={t('related.h')}
      pendingLabel={t('pending')}
    />
  </div>
</section>
