---
/**
 * CategoryStrip — 首頁的分類入口，收斂成一排小卡。2026-11-19 首頁第二期。
 *
 * 首頁原本用全站的 CategoryGrid（13 張有漸層表頭的大卡，瀑布流），佔兩個螢幕。
 * 大廳有了四展廳入口之後，分類在首頁的工作只剩「讓知道自己要找什麼的人一步到」，
 * 所以改成 13 個緊湊的入口：圖示、名稱、篇數。CategoryGrid 本身沒有動，
 * /explore 等頁照舊用它。
 *
 * 13 個分類的連結一個都沒少，順序、連結、追蹤標記（data-ga-section="category_grid"、
 * data-ga-label={分類代碼}）與無障礙標籤都跟 CategoryGrid 一樣，前後數據接得上。
 * 篇數的算法也是同一個（數 knowledge/ 底下的檔）。
 */
import Icon from '../Icon.astro';
import {
  useTranslations,
  getLangFromUrl,
  useTranslatedPath,
} from '../../i18n/utils';
import { categoryIcons, icons } from '../../icons/taiwan-icons.mjs';
import { getCategoryConfigs } from '../../utils/categoryConfig';
import { countCategoryArticles } from './home-data';
import { formatCount } from './home-i18n';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);
const configs = getCategoryConfigs(t) as Record<string, { name: string }>;

const categories = Object.entries(categoryIcons)
  .filter(([slug]) => slug !== 'about')
  .map(([slug, icon]) => ({
    slug,
    icon: icon as keyof typeof icons,
    name: configs[slug]?.name,
    count: countCategoryArticles(lang, slug),
  }));
---

<ul class="cat-strip" aria-label={t('CategoryGrid.aria-section')}>
  {
    categories.map((c) => (
      <li>
        <a
          href={translatePath(`/${c.slug}`)}
          class="cat-chip"
          style={`--chip-color:var(--cat-${c.slug})`}
          data-ga-section="category_grid"
          data-ga-label={c.slug}
          aria-label={`${t('CategoryGrid.aria-explore')} ${c.name}${t('CategoryGrid.aria-explore-suffix')}`}
        >
          <span class="cat-chip-icon" aria-hidden="true">
            <Icon name={c.icon} />
          </span>
          <span class="cat-chip-name">{c.name}</span>
          <span class="cat-chip-count">{formatCount(c.count, lang)}</span>
        </a>
      </li>
    ))
  }
</ul>

<style>
  .cat-strip {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .cat-chip {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    min-block-size: 48px;
    border: 1px solid var(--home-rule);
    border-radius: var(--radius-chip);
    background: var(--color-surface);
    padding: 0.5rem 1rem 0.5rem 0.85rem;
    font-family: var(--font-interface);
    color: var(--color-ink);
    text-decoration: none;
    transition:
      border-color 0.2s ease,
      transform 0.2s ease,
      box-shadow 0.2s ease;
  }

  .cat-chip:hover {
    border-color: var(--home-rule-strong);
    color: var(--color-ink);
    transform: translateY(-2px);
    box-shadow: var(--shadow-soft);
  }

  .cat-chip-icon {
    display: inline-flex;
    font-size: 1.25rem;
    color: var(--chip-color, var(--home-accent));
  }

  /* 分類色是為亮底調的深色；深色模式往字色靠，才看得清楚 */
  :global(:root[data-theme='dark']) .cat-chip-icon {
    color: color-mix(
      in srgb,
      var(--chip-color, var(--home-accent)) 40%,
      var(--color-ink)
    );
  }

  .cat-chip-name {
    font-size: 1rem;
    font-weight: 700;
    line-height: 1.3;
  }

  .cat-chip-count {
    font-size: 0.82rem;
    font-variant-numeric: tabular-nums;
    color: var(--color-ink-soft);
  }

  @media (max-width: 640px) {
    .cat-strip {
      gap: 0.5rem;
    }
    .cat-chip {
      gap: 0.45rem;
      padding-inline: 0.7rem 0.8rem;
    }
    .cat-chip-name {
      font-size: 0.95rem;
    }
  }
</style>
