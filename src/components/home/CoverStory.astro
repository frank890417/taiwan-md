---
/**
 * CoverStory — 「如何理解台灣？」八個時代的聲音。
 *
 * 2026-11-19 首頁第一期：從一條 2.2 個螢幕高的直向清單，改成一條有年代刻度的
 * 橫向時間線（桌機一個螢幕內看完）。八句引語、出處、標題、導語、結語的文字
 * 都是原味，一個字沒動，仍然從 home.ts 的同一批鍵讀。
 *
 * 版面有兩種，同一份 DOM：
 *   - 直向（手機、或沒有 JavaScript）：八句全部展開，由上往下讀。
 *   - 橫向（寬度 1100px 以上且腳本跑起來）：八個年代排在一條線上，點、滑過或用
 *     方向鍵移到哪個年代，下面就顯示那一句。八句疊在同一格裡，所以切換時高度
 *     不會跳。
 *
 * 刻度怎麼畫：八個點是等距的（各語言的年代標籤長短差很多，照真實年份排的話
 * 2013、當代、2026 會疊在一起）。時間的疏密改用兩點之間的小刻度表示，一格
 * 25 年：1584 到 1697 之間有四格，1697 到 1920 年代之間有九格。沒有確切年份的
 * 兩端（原住民族的口傳、當代）不畫刻度，原住民族那一段用虛線。
 */
import {
  useTranslations,
  getLangFromUrl,
  useTranslatedPath,
} from '../../i18n/utils';
import { useHomeT } from './home-i18n';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const th = useHomeT(lang);
const translatePath = useTranslatedPath(lang);

const rawQuotes = [
  {
    eraKey: 'home.cover.era.indigenous' as const,
    quoteKey: 'home.cover.quote.indigenous' as const,
    citeKey: 'home.cover.cite.indigenous' as const,
    year: null,
  },
  {
    era: '1584',
    quoteKey: 'home.cover.quote.1584' as const,
    citeKey: 'home.cover.cite.1584' as const,
    year: 1584,
  },
  {
    era: '1697',
    quoteKey: 'home.cover.quote.1697' as const,
    citeKey: 'home.cover.cite.1697' as const,
    year: 1697,
  },
  {
    // era 寫 '1920s' 不是年份：這句「勇士當為義鬥爭」原本掛在賴和〈覺悟下的犧牲〉
    // 名下、標 1926，但讀者 marcsie（issue #1897）指出它出自〈吾人〉——站上自己的
    // `People/賴和.md` 早就寫〈吾人〉，首頁跟我們自己的條目對不上。查證後作品名確定
    // 是〈吾人〉（四個獨立指向：本庫條目、讀者、七言律詩的句式、2017 年引用紀錄），
    // 但**發表年份查不到**：維基文庫只給 1918–1943 區間，本庫條目的「《台灣民報》
    // 1925」自己也沒有可開的出處，讀者說 1924 也沒附來源。1926 本來是另一首詩的年份，
    // 留著就是替〈吾人〉編一個年份，所以降級成查得住的「1920s」（治警事件 1923、
    // 《台灣民報》1923 創刊，這首的脈絡在那幾年）。
    // ⚠️ 翻譯鍵仍叫 `.1926`（鍵名只是識別字，改名要動十三個語言區塊而讀者看不到
    // 任何差別）。鍵名跟顯示值從此不一致，查「1926」的人請看這段。
    // 年份一旦查到（《賴和全集》或賴和文教基金會），把 era 改回四位數並同步
    // `knowledge/People/賴和.md` 的 `[^1]`。
    // `year: 1925` 只拿來算刻度（1920 年代的中點，一格 25 年的粗細下不影響格數），
    // 不會顯示在頁面上。
    era: '1920s',
    quoteKey: 'home.cover.quote.1926' as const,
    citeKey: 'home.cover.cite.1926' as const,
    year: 1925,
  },
  {
    era: '1946',
    quoteKey: 'home.cover.quote.1946' as const,
    citeKey: 'home.cover.cite.1946' as const,
    year: 1946,
  },
  {
    era: '2013',
    quoteKey: 'home.cover.quote.2013' as const,
    citeKey: 'home.cover.cite.2013' as const,
    year: 2013,
  },
  {
    eraKey: 'home.cover.era.contemporary' as const,
    quoteKey: 'home.cover.quote.contemporary' as const,
    citeKey: 'home.cover.cite.contemporary' as const,
    year: null,
  },
  // 2026-05-27 Wave 3 / A3: Taiwan.md self-positioning entry (8th timeline
  // entry). Echoes MANIFESTO §主權的巴別塔 — 不寫成宣傳，寫成共生宣言。
  // 編輯紀律 per report §A3：避免自我吹捧 / 跟既有 7 條同樣 first-person 口吻。
  {
    eraKey: 'home.cover.era.taiwanmd' as const,
    quoteKey: 'home.cover.quote.taiwanmd' as const,
    citeKey: 'home.cover.cite.taiwanmd' as const,
    year: 2026,
  },
];

const TICK_YEARS = 25;

const quotes = rawQuotes.map((q, i) => {
  const next = rawQuotes[i + 1];
  // 這個點到下一個點之間的小刻度位置（0–100，沿著線段的百分比）
  let ticks: number[] = [];
  if (next && q.year !== null && next.year !== null) {
    const span = next.year - q.year;
    const count = Math.floor(span / TICK_YEARS);
    ticks = Array.from(
      { length: count },
      (_, k) => (((k + 1) * TICK_YEARS) / span) * 100,
    ).filter((p) => p < 97);
  }
  return {
    ...q,
    label: 'eraKey' in q && q.eraKey ? t(q.eraKey) : (q.era as string),
    ticks,
    // 口傳文學沒有起點：到下一個點之間用虛線
    openStart: i === 0 && q.year === null,
    isLast: i === rawQuotes.length - 1,
  };
});
---

<section class="cover-story" data-quote-timeline>
  <div class="cs-inner">
    <h2 class="home-title cs-heading">{t('home.cover.heading')}</h2>
    <p class="cs-lead">
      {t('home.cover.lead')}<br />
      {t('home.cover.lead2')}
    </p>

    <div
      class="cs-axis"
      role="tablist"
      aria-label={th('home.cover.axis.aria')}
      aria-orientation="horizontal"
    >
      {
        quotes.map((q, i) => (
          <>
            <button
              type="button"
              class:list={['cs-node', { 'is-self': q.isLast }]}
              role="tab"
              id={`cs-tab-${i}`}
              aria-controls={`cs-voice-${i}`}
              aria-selected={i === 0 ? 'true' : 'false'}
              tabindex={i === 0 ? 0 : -1}
              data-index={i}
              data-ga-section="cover_story"
              data-ga-label={`voice_${i + 1}`}
            >
              <span class="cs-node-label">{q.label}</span>
              <span class="cs-node-dot" aria-hidden="true" />
            </button>
            {i < quotes.length - 1 && (
              <span
                class:list={['cs-seg', { 'is-open': q.openStart }]}
                aria-hidden="true"
              >
                {q.ticks.map((p) => (
                  <i
                    class="cs-tick"
                    style={`inset-inline-start:${p.toFixed(1)}%`}
                  />
                ))}
              </span>
            )}
          </>
        ))
      }
    </div>

    <p class="cs-scale">{th('home.cover.axis.scale')}</p>

    <ol class="cs-voices">
      {
        quotes.map((q, i) => (
          <li
            class:list={[
              'cs-voice',
              { 'is-active': i === 0, 'is-self': q.isLast },
            ]}
            id={`cs-voice-${i}`}
            data-index={i}
          >
            <span class="cs-voice-era">{q.label}</span>
            <blockquote class="cs-quote">
              {t(q.quoteKey)}
              <cite class="cs-cite">{t(q.citeKey)}</cite>
            </blockquote>
          </li>
        ))
      }
    </ol>

    <div class="cs-closing">
      <p>{t('home.cover.closing1')}</p>
      <p>
        <strong>{t('home.cover.closing2')}</strong>
        {t('home.cover.closing3')}
      </p>
      <a
        href={translatePath('/about')}
        data-ga-section="cover_story"
        data-ga-label="read_full"
        class="home-link">{t('home.cover.link')}</a
      >
    </div>
  </div>
</section>

<script>
  // 橫向時間線的互動。沒有這段腳本時，八句引語照直向清單全部展開。
  const WIDE = '(min-width: 1100px)';

  function setup(root: HTMLElement) {
    const tabs = Array.from(
      root.querySelectorAll<HTMLButtonElement>('.cs-node'),
    );
    const voices = Array.from(root.querySelectorAll<HTMLElement>('.cs-voice'));
    if (tabs.length === 0 || tabs.length !== voices.length) return;
    const mq = window.matchMedia(WIDE);
    let current = 0;

    function select(index: number, focus = false) {
      current = (index + tabs.length) % tabs.length;
      tabs.forEach((tab, i) => {
        const on = i === current;
        tab.setAttribute('aria-selected', on ? 'true' : 'false');
        tab.tabIndex = on ? 0 : -1;
      });
      voices.forEach((voice, i) => {
        voice.classList.toggle('is-active', i === current);
      });
      if (focus) tabs[current].focus();
    }

    function applyMode() {
      const wide = mq.matches;
      root.toggleAttribute('data-enhanced', wide);
      voices.forEach((voice, i) => {
        if (wide) {
          voice.setAttribute('role', 'tabpanel');
          voice.setAttribute('aria-labelledby', `cs-tab-${i}`);
        } else {
          voice.removeAttribute('role');
          voice.removeAttribute('aria-labelledby');
        }
      });
    }

    tabs.forEach((tab, i) => {
      tab.addEventListener('click', () => select(i));
      tab.addEventListener('pointerenter', (e) => {
        if (e.pointerType === 'mouse') select(i);
      });
      tab.addEventListener('focus', () => select(i));
      tab.addEventListener('keydown', (e) => {
        const rtl = getComputedStyle(root).direction === 'rtl';
        const step =
          e.key === 'ArrowRight'
            ? rtl
              ? -1
              : 1
            : e.key === 'ArrowLeft'
              ? rtl
                ? 1
                : -1
              : 0;
        if (step !== 0) {
          e.preventDefault();
          select(current + step, true);
        } else if (e.key === 'Home') {
          e.preventDefault();
          select(0, true);
        } else if (e.key === 'End') {
          e.preventDefault();
          select(tabs.length - 1, true);
        }
      });
    });

    mq.addEventListener('change', applyMode);
    applyMode();
  }

  document
    .querySelectorAll<HTMLElement>('[data-quote-timeline]')
    .forEach(setup);
</script>

<style>
  .cover-story {
    background: var(--color-bg-soft);
    padding-block: var(--space-7) var(--space-8);
    padding-inline: var(--home-gutter);
  }
  .cs-inner {
    margin-inline: auto;
    max-width: 1040px;
  }
  .cs-heading {
    text-align: center;
  }
  .cs-lead {
    margin: 1rem auto 0;
    max-width: 38em;
    text-align: center;
    font-family: var(--font-reading);
    font-size: 1.05rem;
    font-weight: 500;
    line-height: 1.9;
    color: var(--color-ink-soft);
  }

  /* ── 直向（預設）：年代線不出現，八句由上往下排 ───────────────── */
  .cs-axis {
    display: none;
  }
  .cs-voices {
    list-style: none;
    margin: var(--home-gap-md) auto 0;
    max-width: 38rem;
    padding: 0;
  }
  .cs-voice {
    position: relative;
    padding-block-end: var(--space-5);
    padding-inline-start: 1.75rem;
  }
  /* 左側的軌道與節點 */
  .cs-voice::before {
    content: '';
    position: absolute;
    inset-block: 0.55rem 0;
    inset-inline-start: 0.28rem;
    width: 1px;
    background: var(--home-rule-strong);
  }
  .cs-voice:last-child::before {
    display: none;
  }
  .cs-voice::after {
    content: '';
    position: absolute;
    inset-block-start: 0.4rem;
    inset-inline-start: 0;
    width: 0.6rem;
    height: 0.6rem;
    border-radius: 50%;
    border: 1.5px solid var(--color-ink-soft);
    background: var(--color-bg-soft);
  }
  .cs-voice.is-self::after {
    border-color: var(--home-mark);
    background: var(--home-mark);
  }
  .cs-voice-era {
    display: block;
    margin-block-end: 0.4rem;
    font-family: var(--font-interface);
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: var(--color-ink-soft);
  }
  .cs-quote {
    margin: 0;
    font-family: var(--font-quote);
    font-size: 1.2rem;
    font-weight: 400;
    line-height: 1.75;
    color: var(--color-ink);
  }
  .cs-cite {
    display: block;
    margin-block-start: 0.5rem;
    font-family: var(--font-interface);
    font-size: 0.82rem;
    font-style: normal;
    font-weight: 400;
    line-height: 1.6;
    letter-spacing: 0;
    color: var(--color-ink-soft);
  }
  .cs-scale {
    display: none;
  }

  .cs-closing {
    margin: var(--space-6) auto 0;
    max-width: 38em;
    text-align: center;
    font-family: var(--font-reading);
    font-size: 1.02rem;
    line-height: 1.9;
    color: var(--color-ink-soft);
  }
  .cs-closing p {
    margin: 0 0 0.75rem;
  }
  .cs-closing strong {
    color: var(--color-ink);
  }

  /* ── 橫向：寬度夠、腳本也跑起來了 ──────────────────────────────── */
  @media (min-width: 1100px) {
    [data-enhanced] .cs-axis {
      display: flex;
      align-items: flex-end;
      margin-block-start: var(--space-6);
      padding-inline: 4.5rem;
    }
    /* 節點：44px 寬的可點範圍，用負邊距抵掉自己的寬度，八個點才會剛好落在
       等距的位置上（線段平分剩下的空間）。 */
    [data-enhanced] .cs-node {
      position: relative;
      z-index: 1;
      flex: 0 0 auto;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 0.6rem;
      width: 2.75rem;
      min-height: 44px;
      margin-inline: -1.375rem;
      border: 0;
      background: none;
      padding: 0;
      cursor: pointer;
      color: var(--color-ink-soft);
    }
    /* 標籤寬度收在兩點的間距以內，長的（Indigenous Peoples、2026 — Taiwan.md）
       往上折成兩行，不會壓到隔壁 */
    [data-enhanced] .cs-node-label {
      position: relative;
      width: max-content;
      max-width: 6rem;
      text-align: center;
      font-family: var(--font-interface);
      font-size: 0.78rem;
      font-weight: 600;
      line-height: 1.3;
      letter-spacing: 0.03em;
      overflow-wrap: break-word;
      hyphens: auto;
      transition: color 0.2s ease;
    }
    [data-enhanced] .cs-node-dot {
      position: relative;
      z-index: 1;
      width: 0.7rem;
      height: 0.7rem;
      flex-shrink: 0;
      border-radius: 50%;
      border: 1.5px solid var(--color-ink-soft);
      background: var(--color-bg-soft);
      transform: translateY(50%);
      transition:
        transform 0.2s ease,
        background-color 0.2s ease,
        border-color 0.2s ease;
    }
    [data-enhanced] .cs-node.is-self .cs-node-dot {
      border-color: var(--home-mark);
    }
    [data-enhanced] .cs-node[aria-selected='true'] {
      color: var(--color-ink);
    }
    [data-enhanced] .cs-node[aria-selected='true'] .cs-node-dot {
      border-color: var(--color-ink);
      background: var(--color-ink);
      transform: translateY(50%) scale(1.45);
    }
    [data-enhanced] .cs-node.is-self[aria-selected='true'] .cs-node-dot {
      border-color: var(--home-mark);
      background: var(--home-mark);
    }
    [data-enhanced] .cs-node:focus-visible {
      outline: none;
    }
    [data-enhanced] .cs-node:focus-visible .cs-node-label {
      outline: 2px solid var(--home-accent);
      outline-offset: 4px;
      border-radius: 2px;
    }

    [data-enhanced] .cs-seg {
      position: relative;
      flex: 1 1 0;
      height: 1px;
      background: var(--home-rule-strong);
    }
    [data-enhanced] .cs-seg.is-open {
      background: repeating-linear-gradient(
        to right,
        var(--home-rule-strong) 0 4px,
        transparent 4px 9px
      );
    }
    [data-enhanced] .cs-tick {
      position: absolute;
      inset-block-start: -3px;
      width: 1px;
      height: 7px;
      background: var(--home-rule-strong);
    }

    [data-enhanced] .cs-voices {
      display: grid;
      max-width: 46rem;
      margin-block-start: var(--space-6);
    }
    [data-enhanced] .cs-voice {
      grid-area: 1 / 1;
      display: flex;
      flex-direction: column;
      justify-content: center;
      padding: 0;
      text-align: center;
      visibility: hidden;
      opacity: 0;
      transform: translateY(6px);
      transition:
        opacity 0.3s ease,
        transform 0.3s ease,
        visibility 0s linear 0.3s;
    }
    [data-enhanced] .cs-voice.is-active {
      visibility: visible;
      opacity: 1;
      transform: none;
      transition:
        opacity 0.3s ease,
        transform 0.3s ease,
        visibility 0s;
    }
    [data-enhanced] .cs-voice::before,
    [data-enhanced] .cs-voice::after,
    [data-enhanced] .cs-voice-era {
      display: none;
    }
    [data-enhanced] .cs-quote {
      font-size: clamp(1.4rem, 2.35vw, 1.95rem);
      font-weight: 300;
      line-height: 1.65;
      text-wrap: balance;
    }
    [data-enhanced] .cs-cite {
      margin-block-start: 1rem;
      font-size: 0.88rem;
    }
    [data-enhanced] .cs-scale {
      display: block;
      margin: 1.1rem 0 0;
      padding-inline: 4.5rem;
      text-align: end;
      font-family: var(--font-interface);
      font-size: 0.72rem;
      letter-spacing: 0.04em;
      color: var(--color-ink-soft);
    }
  }
</style>
