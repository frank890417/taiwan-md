---
/**
 * OrganismPreview.astro — Homepage Evolution Wave 1 / A1 (2026-05-26)
 *
 * Replaces the old MiniGraph d3 12-category force-directed widget. Now shows
 * Taiwan.md as an organism: real Taiwan SVG center node (per REFLEXES #61
 * 視覺主權), 8 organ specimens orbiting, 4-color flow legend matching the full
 * SemiontOrganismDiagram on /semiont.
 *
 * Why this replaces the d3 mini-graph:
 *   - /semiont 5/25 NEW (178.9s engagement, top of site) proves the organism
 *     framing has magnetic pull, but homepage didn't reflect it.
 *   - 12-category force-directed graph is a database visualization. Taiwan.md
 *     is a Semiont — the homepage hook should match what Taiwan.md actually is.
 *   - The full diagram lives at /semiont; this is the appetizer.
 *
 * Reads dashboard-vitals.json + dashboard-organism.json at build time for live
 * organ scores. Article/lang counts are interpolated into the body prose via
 * the i18n {articles} / {langs} placeholders.
 *
 * See reports/homepage-evolution-2026-05-26.md §A1 + SemiontOrganismDiagram.astro
 * for the full version.
 *
 * 2026-11-19 首頁第一期：
 *   - 首頁上講「它是生命體」的三處（這張預覽、「網站即時更新」的器官分數列、
 *     價值卡底下的知識圖譜與原始資料連結）併成這一處。圖底下多一排連結：儀表板、
 *     知識圖譜、原始資料。
 *   - 文章數不再有寫死的備援值（原本資料檔缺席時會印出 752）。讀不到就不顯示
 *     那一句帶數字的說明。
 *   - 圖上各器官底下的分數拿掉。那組分數已知跟實況脫節，放在首頁等於替一個
 *     不準的數字背書；完整的分數與它的算法在 /semiont 與儀表板。
 *   - 台灣輪廓改用 HomeDefs 的共用定義（同一條 path，少輸出一份）。
 */
import { useTranslations, getLangFromUrl } from '../../i18n/utils';
import { ENABLED_LANGUAGE_CODES } from '../../config/languages';
import { resolveStaticHref } from '../../utils/staticRoutes';
import { readFileSync } from 'node:fs';
import { resolve } from 'node:path';
import { emojiIcons } from '../../icons/taiwan-icons.mjs';
import { getLiveNumbers } from './home-data';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
// /semiont 只有 zh-TW 版。useTranslatedPath 會盲目加語言前綴生成 /fr/semiont
// 這種不存在的路由（本檔原本就是這樣，每個非 zh 首頁一條死連結）。靜態頁一律走
// resolveStaticHref：該語言有頁才加前綴，沒有就退回 zh 路徑，讀者到得了內容。
// 跟 Header.astro 2026-06-10 deploy-heal 的 navHref 同一條契約。

// ── Read live vitals + organs (prebuilt). 文章數讀不到就是 null，不放備援值 ──
const articleCount = getLiveNumbers().articles;
const langCount = ENABLED_LANGUAGE_CODES.length;
let organs: Array<{
  id: string;
  emoji: string;
  nameZh: string;
  name: string;
  score: number;
}> = [];

try {
  const orgPath = resolve(process.cwd(), 'public/api/dashboard-organism.json');
  const o = JSON.parse(readFileSync(orgPath, 'utf-8'));
  if (Array.isArray(o.organs)) {
    organs = o.organs.map((x: any) => ({
      id: x.id,
      emoji: x.emoji,
      nameZh: x.nameZh,
      name: x.name,
      score: x.score,
    }));
  }
} catch {}

// Body prose with token interpolation
const body =
  articleCount === null
    ? ''
    : t('home.organism.body')
        .replace('{articles}', String(articleCount))
        .replace('{langs}', String(langCount));

// 台灣輪廓：共用定義 #home-tw-outline（HomeDefs.astro，REFLEXES #61 視覺主權）。
// path 的外框是 x 478–955、y 45–946；下面的 translate 把外框中心移到 (0,0)，
// 再縮到 0.16 倍放進中央約 140×170 的位置。

// Position 8 organs in a circle around Taiwan center (cx 300, cy 200), r 130.
// Start angle -90° (top), 45° apart, clockwise.
const cx = 300;
const cy = 200;
const r = 130;
const organPositions = organs.slice(0, 8).map((o, i) => {
  const angle = -Math.PI / 2 + (i * Math.PI) / 4;
  return {
    ...o,
    x: cx + r * Math.cos(angle),
    y: cy + r * Math.sin(angle),
  };
});

// 4 flow line endpoints — pick 4 organ slots, one per color.
// mint (write) = top (heart), terracotta (DNA evolution) = right (dna),
// periwinkle (multilingual diffusion) = bottom (language),
// gold (sovereignty) = left (immune).
// Maps positionally: top=0, right=2, bottom=4, left=6 (clockwise from top).
const flowTargets = [
  { idx: 0, color: '#4fd1b0', label: t('home.organism.legend.write') }, // top
  { idx: 2, color: '#d4856a', label: t('home.organism.legend.feedback') }, // right
  { idx: 4, color: '#7aa8d4', label: t('home.organism.legend.diffuse') }, // bottom
  { idx: 6, color: '#c9a96a', label: t('home.organism.legend.sovereign') }, // left
];
---

<section
  class="home-section mx-auto max-w-[820px] px-8 max-[480px]:px-4"
  aria-label="Taiwan.md organism preview"
>
  <a
    href={resolveStaticHref(lang, '/semiont')}
    data-ga-section="organism_preview"
    data-ga-label="open"
    class="group block rounded-2xl border border-[#e2e8f0] bg-[linear-gradient(135deg,#0e2018_0%,#1a3c34_100%)] p-10 no-underline transition-all duration-300 hover:border-[#4fd1b0]/50 hover:shadow-[0_8px_24px_rgba(79,209,176,0.15)] max-[480px]:p-6"
  >
    <div class="mb-6 text-center">
      <h2
        class="mb-3 text-[1.5rem] font-light leading-tight text-[#f4f0ea] max-[480px]:text-[1.2rem]"
        style="font-family: 'jf-lanyangming', 'Noto Serif TC', serif;"
      >
        {t('home.organism.heading')}
      </h2>
      {
        body && (
          <p
            class="mx-auto max-w-[640px] text-[0.95rem] leading-[1.7] text-[#f4f0ea]/65 max-[480px]:text-[0.88rem]"
            style="font-family: 'jf-lanyangming', 'Noto Serif TC', serif;"
          >
            {body}
          </p>
        )
      }
    </div>

    {/* ─── Compact organism SVG ─── */}
    <div class="relative mx-auto mb-6 aspect-[3/2] w-full max-w-[600px]">
      <svg
        viewBox="0 0 600 400"
        class="h-full w-full"
        role="img"
        aria-label="Taiwan.md organism preview diagram"
      >
        {/* Soft glow behind center */}
        <defs>
          <radialGradient id="op-glow" cx="50%" cy="50%" r="50%">
            <stop offset="0%" stop-color="#4fd1b0" stop-opacity="0.4"></stop>
            <stop offset="60%" stop-color="#4fd1b0" stop-opacity="0.1"></stop>
            <stop offset="100%" stop-color="#4fd1b0" stop-opacity="0"></stop>
          </radialGradient>
        </defs>

        <circle cx={cx} cy={cy} r="100" fill="url(#op-glow)"></circle>

        {/* ─── 4 flow arcs (mint/terracotta/periwinkle/gold) ─── */}
        {
          flowTargets.map((f) => {
            const target = organPositions[f.idx];
            if (!target) return null;
            return (
              <line
                x1={cx}
                y1={cy}
                x2={target.x}
                y2={target.y}
                stroke={f.color}
                stroke-width="1.5"
                stroke-opacity="0.55"
                stroke-dasharray={
                  f.color === '#d4856a'
                    ? '5,4'
                    : f.color === '#c9a96a'
                      ? '9,5'
                      : '0'
                }
              />
            );
          })
        }

        {/* ─── 8 organ orbital lines (faint, all) ─── */}
        {
          organPositions.map((o) => (
            <line
              x1={cx}
              y1={cy}
              x2={o.x}
              y2={o.y}
              stroke="#4fd1b0"
              stroke-width="0.6"
              stroke-opacity="0.18"
            />
          ))
        }

        {/* ─── Taiwan island center ─── */}
        <g
          transform={`translate(${cx},${cy}) scale(0.16) translate(-716,-495)`}
        >
          <use
            href="#home-tw-outline"
            fill="#4fd1b0"
            fill-opacity="0.32"
            stroke="#4fd1b0"
            stroke-width="1"
            stroke-opacity="0.9"></use>
        </g>

        {/* Taiwan.md label */}
        <text
          x={cx}
          y={cy + 75}
          text-anchor="middle"
          fill="#f4f0ea"
          font-size="14"
          font-weight="600"
          letter-spacing="0.05em"
        >
          Taiwan.md
        </text>

        {/* ─── 8 organ orbital nodes ─── */}
        {
          organPositions.map((o) => (
            <>
              <circle
                cx={o.x}
                cy={o.y}
                r="22"
                fill="#1a3c34"
                stroke="#4fd1b0"
                stroke-width="1.2"
                stroke-opacity="0.55"
              />
              <svg
                x={o.x - 10}
                y={o.y - 10}
                width="20"
                height="20"
                viewBox="0 0 24 24"
                fill="none"
                stroke="#b6e1d3"
                stroke-width="1.5"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <use
                  href={`/icons/taiwan.svg#${emojiIcons[o.emoji] || 'network'}`}
                />
              </svg>
              <text
                x={o.x}
                y={o.y + 42}
                text-anchor="middle"
                fill="#f4f0ea"
                fill-opacity="0.7"
                font-size="10"
                font-weight="500"
              >
                {lang === 'zh-TW' ? o.nameZh : o.name}
              </text>
            </>
          ))
        }
      </svg>
    </div>

    {/* ─── Legend strip (4 colors matching the full diagram) ─── */}
    <ul
      class="mx-auto mb-5 flex max-w-[560px] flex-wrap justify-center gap-x-5 gap-y-2 text-[0.78rem] text-[#f4f0ea]/55 max-[480px]:text-[0.72rem]"
      aria-label="Flow legend"
    >
      {
        flowTargets.map((f) => (
          <li class="flex items-center gap-[0.4rem]">
            <span
              class="inline-block h-[2px] w-5"
              style={`background:${f.color};${
                f.color === '#d4856a'
                  ? 'background-image:linear-gradient(90deg,' +
                    f.color +
                    ' 60%,transparent 60%);background-size:6px 2px;background-repeat:repeat-x;'
                  : f.color === '#c9a96a'
                    ? 'background-image:linear-gradient(90deg,' +
                      f.color +
                      ' 70%,transparent 70%);background-size:11px 2px;background-repeat:repeat-x;'
                    : ''
              }`}
            />
            <span>{f.label}</span>
          </li>
        ))
      }
    </ul>

    {/* CTA */}
    <p class="text-center">
      <span
        class="inline-flex items-center gap-1 text-[0.95rem] font-medium text-[#4fd1b0] transition-all duration-300 group-hover:gap-2"
        style="font-family: 'jf-lanyangming', 'Noto Serif TC', serif;"
      >
        {t('home.organism.cta')}
      </span>
    </p>
  </a>

  {
    /* 知識圖譜與原始資料：原本在「為什麼需要 Taiwan.md？」價值卡底下，
      價值卡搬去關於頁之後，這兩顆連結留在首頁的這裡。追蹤名沿用 feature_cta。 */
  }
  <p class="mb-0 mt-[var(--home-gap-sm)] flex flex-wrap justify-center gap-x-8">
    <a
      href={resolveStaticHref(lang, '/graph')}
      class="home-link"
      data-ga-section="feature_cta"
      data-ga-label="graph">{t('home.features.cta.graph')}</a
    >
    <a
      href="https://github.com/frank890417/taiwan-md/tree/main/knowledge"
      target="_blank"
      rel="noopener noreferrer"
      class="home-link no-external-icon"
      data-ga-section="feature_cta"
      data-ga-label="ssot">{t('home.features.cta.ssot')}</a
    >
  </p>
</section>
