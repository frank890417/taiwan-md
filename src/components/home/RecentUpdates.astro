---
/**
 * RecentUpdates — 「最近」：最近新進的四篇文章。
 *
 * 2026-11-19 首頁第一期重寫。原本叫「網站即時更新」，放的是器官分數與最近五筆
 * commit；線上實測那五筆全是翻譯批次的 commit，旁邊的器官分數又已知跟實況脫節
 * （報告 §5 第 5 項）。讀者在乎的是「這幾天多了什麼可以讀」，所以改成文章：
 *
 *   - 四篇，用全站共用的 ArticleCard（detailed，跟 /latest 同一款），資料也跟
 *     /latest 同一個來源
 *     （getLatestArticles：文章索引 × content-dates.json 的上線時間）。
 *   - 中文首頁顯示寫的人：git-info.json 裡這篇文章的第一位人類貢獻者。其他語言的
 *     git 貢獻者是翻譯批次，不是作者，所以只顯示日期。
 *   - 不放器官分數，不放 commit 清單。底下一行小字連到最新文章、更新紀錄與儀表板
 *     （原本這一區的三個去處都還在）。
 *
 * 規格裡的右欄「最近改好的讀者勘誤」沒有做：目前沒有一個資料來源能自動列出
 * 「讀者回報、已經改好」的項目，照規格的備案先只放文章。
 *
 * 區塊的 data-ga-view 沿用 `recent_updates`（由樣板掛），前後數據才接得上。
 */
import { resolve } from 'node:path';
import ArticleCard from '../ArticleCard.astro';
import {
  getLangFromUrl,
  useTranslations,
  useTranslatedPath,
} from '../../i18n/utils';
import { getLatestArticles } from '../../utils/articles-index';
import { getCategoryConfigs } from '../../utils/categoryConfig';
import { getCategoryDirMap } from '../../utils/staticRoutes';
import { buildGitInfoCache } from '../../utils/contributors';
import { useHomeT } from './home-i18n';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const th = useHomeT(lang);
const translatePath = useTranslatedPath(lang);
const isZh = lang === 'zh-TW';
const langPrefix = isZh ? '' : `/${lang}`;

const articles = await getLatestArticles(lang, 4);
const cats = getCategoryConfigs(t) as Record<
  string,
  { name: string; icon: string; color: string }
>;

// 寫的人（只有中文首頁）：git-info 的第一位人類貢獻者
const dirMap = isZh ? getCategoryDirMap() : {};
const gitInfo = isZh ? buildGitInfoCache('knowledge/') : null;
function authorOf(a: { category: string; slug: string }): string {
  if (!gitInfo) return '';
  const dir = dirMap[a.category];
  if (!dir) return '';
  const key = resolve(
    process.cwd(),
    'knowledge',
    dir,
    `${a.slug}.md`,
  ).normalize('NFC');
  const human = gitInfo
    .get(key)
    ?.contributors.find((c) => c.role !== 'ai-maintainer' && c.name);
  return human?.name || '';
}

function dateLabel(iso: string): string {
  const d = new Date(iso);
  if (Number.isNaN(d.getTime())) return '';
  if (isZh) {
    const parts = new Intl.DateTimeFormat('zh-TW', {
      timeZone: 'Asia/Taipei',
      month: 'numeric',
      day: 'numeric',
    }).formatToParts(d);
    const m = parts.find((p) => p.type === 'month')?.value;
    const day = parts.find((p) => p.type === 'day')?.value;
    return `${m}/${day}`;
  }
  try {
    return new Intl.DateTimeFormat(lang === 'ar' ? 'en' : lang, {
      timeZone: 'Asia/Taipei',
      month: 'short',
      day: 'numeric',
    }).format(d);
  } catch {
    return iso.slice(5, 10);
  }
}
---

{
  articles.length > 0 && (
    <section class="home-section" aria-labelledby="recent-heading">
      <div class="home-wrap">
        <header class="home-head">
          <p class="home-eyebrow">{th('home.recent.eyebrow')}</p>
          <h2 id="recent-heading" class="home-title">
            {th('home.recent.heading')}
          </h2>
        </header>

        <div class="grid grid-cols-2 gap-5 max-[900px]:grid-cols-1 max-[640px]:gap-4">
          {articles.map((a) => {
            const cfg = cats[a.category] || ({} as (typeof cats)[string]);
            const author = authorOf(a);
            const date = dateLabel(a.date);
            return (
              <ArticleCard
                density="detailed"
                href={`${langPrefix}/${a.category}/${encodeURIComponent(a.slug)}`}
                title={a.title}
                description={a.description}
                categoryLabel={cfg.name}
                categoryIcon={cfg.icon}
                categoryColor={cfg.color}
                coverImage={a.image || undefined}
                footnotes={a.footnotes}
                date={[date, author].filter(Boolean).join(' · ')}
                readingTime={
                  a.readingTime
                    ? `${a.readingTime} ${t('latest.minRead')}`
                    : undefined
                }
                curation={a.curation}
                curationReason={a.curationReason}
                titleTag="h3"
                openIn="same-tab"
                extraClass="home-recent-item"
                dataAttrs={{
                  'data-ga-section': 'recent_updates',
                  'data-ga-label': 'article',
                }}
              />
            );
          })}
        </div>

        <p class="recent-more">
          <a
            href={translatePath('/latest')}
            class="home-link"
            data-ga-section="recent_updates"
            data-ga-label="latest_articles"
          >
            {t('nav.latest')}
          </a>
          <a
            href={translatePath('/changelog')}
            class="home-link"
            data-ga-section="recent_updates"
            data-ga-label="view_all"
          >
            {t('home.updates.viewAll')}
          </a>
          <a
            href={translatePath('/dashboard')}
            class="home-link"
            data-ga-section="recent_updates"
            data-ga-label="heartbeat_strip"
          >
            {t('home.heartbeat.viewMore')}
          </a>
        </p>
      </div>
    </section>
  )
}

<style>
  /* ── 深色模式 ──
     ArticleCard 的顏色是寫死的亮色，各頁的深色覆寫在 dark-polish.css 裡是「每個
     頁面包一層」的寫法（.latest-page、.explore-page…），首頁沒有那一層。另外
     dark-polish 有一條全站規則會替所有 class 名帶 card 的元素鋪一層半透明底，
     卡片裡每個子元素都中，疊起來會變成一塊一塊的。這裡只針對首頁這四張卡補齊，
     配方跟 /latest 的同一套（surface、ink、ink-soft、accent）。 */
  :global(
    :root[data-theme='dark']
      .home-page
      .home-section
      .article-card.is-detailed.home-recent-item
  ) {
    background: var(--color-surface);
    border-color: var(--color-border);
  }
  :global(
    :root[data-theme='dark']
      .home-page
      .home-section
      .article-card.is-detailed.home-recent-item:hover
  ) {
    border-color: color-mix(in srgb, var(--color-accent) 45%, transparent);
  }
  :global(
    :root[data-theme='dark']
      .home-page
      .home-section
      .article-card.is-detailed.home-recent-item
      :is(
        .article-card-body,
        .article-card-toprow,
        .article-card-toprow-left,
        .article-card-title,
        .article-card-desc,
        .article-card-foot,
        .article-card-tags,
        .article-card-tag,
        .article-card-stats,
        .article-card-stat,
        .article-card-updated
      )
  ) {
    background-color: transparent;
    border-color: var(--color-border);
  }
  :global(
    :root[data-theme='dark']
      .home-page
      .home-section
      .article-card.is-detailed.home-recent-item
      .article-card-title
  ) {
    color: var(--color-ink);
  }
  :global(
    :root[data-theme='dark']
      .home-page
      .home-section
      .article-card.is-detailed.home-recent-item
      :is(
        .article-card-desc,
        .article-card-updated,
        .article-card-stat,
        .article-card-tag
      )
  ) {
    color: var(--color-ink-soft);
  }
  :global(
    :root[data-theme='dark']
      .home-page
      .home-section
      .article-card.is-detailed.home-recent-item
      .article-card-stage
  ) {
    border-color: color-mix(in srgb, var(--color-accent) 40%, transparent);
    background: color-mix(in srgb, var(--color-accent) 14%, transparent);
    color: var(--color-ink);
  }

  /* 首頁只放四張，摘要收在三行內；完整摘要在 /latest */
  :global(
    .home-page .article-card.is-detailed.home-recent-item .article-card-desc
  ) {
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 3;
    overflow: hidden;
  }
  /* 手機上沒有封面圖的卡不放那塊大字佔位圖，四張卡才不會疊成三個螢幕高 */
  @media (max-width: 768px) {
    :global(.home-page .article-card.home-recent-item .article-card-thumb-ph) {
      display: none;
    }
  }
  .recent-more {
    display: flex;
    flex-wrap: wrap;
    gap: 0 2rem;
    margin: var(--home-gap-sm) 0 0;
  }
</style>
