---
/**
 * DotRows — 每列一個類別，在 0–100% 刻度上放幾個時點的點，並標出規範上限（短槓）。
 * 用在「央行管制前後，銀行實際放款成數往下掉了多少」。點用不同形狀加不同明度區分，不靠紅綠。
 * 數字與標籤由呼叫端傳入；元件不含自然語言。
 */
import FigureShell from './FigureShell.astro';
import {
  scaleLinear,
  estTextW,
  fitText,
  CHART_WIDTHS,
} from '../../../utils/budgetViz';
import type { SourceRef } from '../../../utils/housing/data';

export interface DotRow {
  id: string;
  label: string;
  /** 與 points 同序；null＝沒有資料 */
  values: (number | null)[];
  cap?: number | null;
  highlight?: boolean;
  note?: string;
}
export interface DotSeries {
  id: string;
  label: string;
}
interface Props {
  title: string;
  subtitle?: string;
  lang: string;
  series: DotSeries[];
  rows: DotRow[];
  sources: SourceRef[];
  note?: string;
  capLabel: string;
  itemHeader: string;
  noDataLabel: string;
  id?: string;
}
const {
  title,
  subtitle,
  lang,
  series,
  rows,
  sources,
  note,
  capLabel,
  itemHeader,
  noDataLabel,
  id,
} = Astro.props;

const ticks = [0, 20, 40, 60, 80, 100];
const fmt = (v: number | null) => (v === null ? noDataLabel : `${v}%`);
const colon = lang === 'zh-TW' ? '：' : ': ';

function layout(W: number, narrow: boolean) {
  const rowH = narrow ? 36 : 32;
  const longest = Math.max(0, ...rows.map((r) => estTextW(r.label, 12, 6.5)));
  const lw = Math.min(narrow ? 100 : 190, longest + 20);
  const M = { l: lw, r: 14, t: 28, b: 56 };
  const iw = W - M.l - M.r;
  const x = scaleLinear(0, 100, M.l, M.l + iw);
  let lx = M.l;
  let ly = M.t + rows.length * rowH + 20;
  const items = [
    ...series.map((s, i) => ({ k: `p${i}`, label: s.label })),
    { k: 'cap', label: capLabel },
  ];
  const legend = items.map((s) => {
    const w = 18 + estTextW(s.label, 11, 6) + 14;
    if (lx + w > W - 4 && lx > M.l) {
      lx = M.l;
      ly += 17;
    }
    const it = { ...s, x: lx, y: ly };
    lx += w;
    return it;
  });
  const H = Math.max(M.t + rows.length * rowH + M.b, ly + 8);
  return { W, H, M, iw, x, rowH, legend, narrow, lw };
}
const variants = CHART_WIDTHS.map((c) => layout(c.W, c.key === 'narrow'));
---

<FigureShell
  title={title}
  subtitle={subtitle}
  lang={lang}
  sources={sources}
  note={note}
  id={id}
  kind="dots"
>
  {
    variants.map((L) => (
      <svg
        viewBox={`0 0 ${L.W} ${L.H}`}
        role="img"
        aria-label={title}
        class={`hs-svg ${L.narrow ? 'is-narrow' : 'is-wide'}`}
        preserveAspectRatio="xMidYMid meet"
      >
        <title>{title}</title>
        {ticks.map((t) => (
          <g class="hs-grid">
            <line
              x1={L.x(t)}
              x2={L.x(t)}
              y1={L.M.t - 6}
              y2={L.M.t + rows.length * L.rowH}
            />
            <text
              x={L.x(t)}
              y={L.M.t - 10}
              text-anchor="middle"
              class="hs-tick"
            >
              {t}%
            </text>
          </g>
        ))}
        {rows.map((r, i) => {
          const cy = L.M.t + i * L.rowH + L.rowH / 2;
          const f = fitText(r.label, L.lw - 14, 12, 10);
          const have = r.values.filter((v): v is number => v !== null);
          const lo = have.length ? Math.min(...have) : null;
          const hi = have.length ? Math.max(...have) : null;
          return (
            <g class={`hs-row ${r.highlight ? 'is-hi' : ''}`} data-id={r.id}>
              <text
                x={L.M.l - 8}
                y={cy + 4}
                text-anchor="end"
                class="hs-rowlab"
                style={`font-size:${f.size}px`}
              >
                {f.text}
              </text>
              {lo !== null && hi !== null && hi > lo && (
                <line
                  x1={L.x(lo)}
                  x2={L.x(hi)}
                  y1={cy}
                  y2={cy}
                  class="hs-dotlink"
                />
              )}
              {r.cap != null && (
                <line
                  x1={L.x(r.cap)}
                  x2={L.x(r.cap)}
                  y1={cy - 10}
                  y2={cy + 10}
                  class="hs-capmark"
                >
                  <title>{`${r.label} · ${capLabel}${colon}${r.cap}%`}</title>
                </line>
              )}
              {r.values.map((v, k) =>
                v === null ? null : k === 0 ? (
                  <circle cx={L.x(v)} cy={cy} r={5} class="hs-dot p0">
                    <title>{`${r.label} · ${series[k].label}${colon}${v}%`}</title>
                  </circle>
                ) : k === 1 ? (
                  <rect
                    x={L.x(v) - 4.5}
                    y={cy - 4.5}
                    width={9}
                    height={9}
                    class="hs-dot p1"
                  >
                    <title>{`${r.label} · ${series[k].label}${colon}${v}%`}</title>
                  </rect>
                ) : (
                  <path
                    d={`M${L.x(v)},${cy - 6} L${L.x(v) + 6},${cy} L${L.x(v)},${cy + 6} L${L.x(v) - 6},${cy} Z`}
                    class="hs-dot p2"
                  >
                    <title>{`${r.label} · ${series[k].label}${colon}${v}%`}</title>
                  </path>
                ),
              )}
            </g>
          );
        })}
        {L.legend.map((g) => (
          <g class="hs-leg" transform={`translate(${g.x}, ${g.y})`}>
            {g.k === 'p0' && <circle cx={6} cy={-4} r={5} class="hs-dot p0" />}
            {g.k === 'p1' && (
              <rect x={1.5} y={-8.5} width={9} height={9} class="hs-dot p1" />
            )}
            {g.k === 'p2' && (
              <path d="M6,-10 L12,-4 L6,2 L0,-4 Z" class="hs-dot p2" />
            )}
            {g.k === 'cap' && (
              <line x1={6} x2={6} y1={-10} y2={2} class="hs-capmark" />
            )}
            <text x={18} y={0} class="hs-tick">
              {g.label}
            </text>
          </g>
        ))}
      </svg>
    ))
  }
  <table slot="table">
    <thead>
      <tr>
        <th>{itemHeader}</th>
        {series.map((s) => <th class="num">{s.label}</th>)}
        <th class="num">{capLabel}</th>
      </tr>
    </thead>
    <tbody>
      {
        rows.map((r) => (
          <tr>
            <td>
              {r.label}
              {r.note && <small class="hs-note"> {r.note}</small>}
            </td>
            {r.values.map((v) => (
              <td class="num">{fmt(v)}</td>
            ))}
            <td class="num">{r.cap == null ? '—' : `${r.cap}%`}</td>
          </tr>
        ))
      }
    </tbody>
  </table>
</FigureShell>
