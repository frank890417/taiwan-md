---
/**
 * HousingTimeline — 住宅發展時間軸（HTML + CSS，無 JS）。
 * 主頁用精簡版（compact：只列傳入的事件，事件內文收進 <details>），
 * 之後 /housing/history/ 子頁用完整版（compact=false：內文、數字、來源全展開）。
 *
 * Props 與資料形狀照 src/data/housing/timeline.json：eras[{id,from,to,title,lede}]、
 * events[{date,precision,era,kind,title,body,figures?,sources[],articles[]}]。
 * 來源分兩種：kind=primary（官方機關或當事團體自己的網站）與 reported（媒體或學術轉述），
 * 兩種在畫面上用不同標記區分。
 */
import { housingHome } from '../../../i18n/housing-home';
import { fmtPeriod } from '../../../utils/housing/data';

interface Loc {
  zh: string;
  en: string;
}
interface Ev {
  date: string;
  precision?: string;
  era: string;
  kind: string;
  title: Loc;
  body: Loc;
  figures?: { label: Loc; value: string }[];
  featured?: boolean;
  sources?: { title: string; publisher: string; url: string; kind: string }[];
}
interface Era {
  id: string;
  from: number;
  to: number;
  title: Loc;
  lede: Loc;
}
interface Props {
  events: Ev[];
  eras?: Era[];
  compact?: boolean;
  lang: string;
}
const { events, eras = [], compact = false, lang } = Astro.props;
const T = housingHome(lang);
const L = lang === 'zh-TW' ? 'zh' : 'en';
const pick = (o: Loc) => o[L] ?? o.en ?? o.zh;
const byEra = (id: string) =>
  events
    .filter((e) => e.era === id)
    .sort((a, b) => a.date.localeCompare(b.date));
const groups = eras.length
  ? eras.map((e) => ({ era: e as Era | null, list: byEra(e.id) }))
  : [
      {
        era: null as Era | null,
        list: [...events].sort((a, b) => a.date.localeCompare(b.date)),
      },
    ];
const kindLabel = (k: string) =>
  (T.timeline.kinds as Record<string, string>)[k] ?? k;
const dateLabel = (d: string) => fmtPeriod(d, lang);
---

<div class:list={['hs-tl', compact && 'is-compact']}>
  {
    groups.map(({ era, list }) => (
      <section class="hs-tl-era" data-era={era?.id}>
        {era && (
          <header class="hs-tl-era-h">
            <span class="hs-tl-years">
              {era.from}–{era.to}
            </span>
            <h4 class="hs-tl-era-t">{pick(era.title)}</h4>
            <p class="hs-tl-lede">{pick(era.lede)}</p>
          </header>
        )}
        {list.length > 0 && (
          <ol class="hs-tl-list">
            {list.map((e) => (
              <li class={`hs-tl-ev k-${e.kind}`}>
                <time class="hs-tl-date" datetime={e.date}>
                  {dateLabel(e.date)}
                </time>
                <div class="hs-tl-main">
                  <p class="hs-tl-title">
                    <span class="hs-chip">{kindLabel(e.kind)}</span>
                    <strong>{pick(e.title)}</strong>
                  </p>
                  {compact ? (
                    <details class="hs-tl-more">
                      <summary>{T.timeline.more}</summary>
                      <p class="hs-tl-body">{pick(e.body)}</p>
                      {e.sources && e.sources.length > 0 && (
                        <p class="hs-tl-src">
                          {e.sources.slice(0, 3).map((s) => (
                            <a
                              href={s.url}
                              target="_blank"
                              rel="noopener"
                              class="no-external-icon"
                              title={s.title}
                            >
                              {s.publisher}
                              <span class="hs-tag">
                                {s.kind === 'primary'
                                  ? T.ui.primary
                                  : T.ui.reported}
                              </span>
                            </a>
                          ))}
                        </p>
                      )}
                    </details>
                  ) : (
                    <>
                      <p class="hs-tl-body">{pick(e.body)}</p>
                      {e.figures?.map((f) => (
                        <p class="hs-tl-fig">
                          <b>{pick(f.label)}</b>
                          {f.value}
                        </p>
                      ))}
                      {e.sources && e.sources.length > 0 && (
                        <p class="hs-tl-src">
                          {e.sources.map((s) => (
                            <a
                              href={s.url}
                              target="_blank"
                              rel="noopener"
                              class="no-external-icon"
                              title={s.title}
                            >
                              {s.publisher}
                              <span class="hs-tag">
                                {s.kind === 'primary'
                                  ? T.ui.primary
                                  : T.ui.reported}
                              </span>
                            </a>
                          ))}
                        </p>
                      )}
                    </>
                  )}
                </div>
              </li>
            ))}
          </ol>
        )}
      </section>
    ))
  }
</div>
