---
/**
 * ChainFlow — 一條供應鏈的環節流程圖（graph.md §二「流向」；語意 HTML，無 SVG 形狀）。
 *
 * 桌機：環節由左到右排成一列，可橫向捲動；手機：直排。每個環節是一張卡：
 * 編號、名稱、這一環做什麼、台灣公司清單（名稱、代號、角色、出處）、這一環台灣缺什麼。
 * 全部內容預設可見（graph.md §三.9），不靠 hover。公司有榜單列或站內文章時名稱是連結。
 * 另附一張完整資料表。
 */
export interface ChainCompany {
  name: string;
  ticker?: string;
  role: string;
  hq?: string;
  /** 站內連結：/companies#c-2330 或文章網址 */
  href?: string;
  sourceUrl?: string;
}
export interface ChainStage {
  id: string;
  name: string;
  what: string;
  companies: ChainCompany[];
  foreignNote?: string;
  foreignSourceUrl?: string;
}
interface Props {
  id: string;
  title: string;
  lede?: string;
  stages: ChainStage[];
  labels: {
    stage: string;
    company: string;
    role: string;
    hq: string;
    gap: string;
    source: string;
    table: string;
  };
}
const { id, title, lede, stages, labels } = Astro.props;
---

<section class="ip-chain" id={id} aria-labelledby={`${id}-h`}>
  <h3 class="bp-h3 ip-chain-h" id={`${id}-h`}>{title}</h3>
  {lede && <p class="ip-chain-lede">{lede}</p>}
  <ol class="ip-chain-flow">
    {
      stages.map((s, i) => (
        <li class="ip-stage" id={`${id}-${s.id}`}>
          <div class="ip-stage-head">
            <span class="ip-stage-n">{i + 1}</span>
            <h4 class="ip-stage-name">{s.name}</h4>
          </div>
          <p class="ip-stage-what">{s.what}</p>
          <ul class="ip-stage-list">
            {s.companies.map((c) => (
              <li
                class="ip-node"
                data-node={`${c.name} ${c.ticker ?? ''}`.toLowerCase()}
              >
                <span class="ip-node-head">
                  {c.href ? (
                    <a href={c.href} class="ip-node-name">
                      {c.name}
                    </a>
                  ) : (
                    <span class="ip-node-name">{c.name}</span>
                  )}
                  {c.ticker && <span class="ip-node-ticker">{c.ticker}</span>}
                  {c.sourceUrl && (
                    <a
                      class="bp-src no-external-icon"
                      aria-label={labels.source}
                      href={c.sourceUrl}
                      target="_blank"
                      rel="noopener"
                    >
                      ↗
                    </a>
                  )}
                </span>
                <span class="ip-node-role">{c.role}</span>
              </li>
            ))}
          </ul>
          {s.foreignNote && (
            <p class="ip-stage-gap">
              <b>{labels.gap}</b>
              {s.foreignNote}
              {s.foreignSourceUrl && (
                <a
                  class="bp-src no-external-icon"
                  aria-label={labels.source}
                  href={s.foreignSourceUrl}
                  target="_blank"
                  rel="noopener"
                >
                  ↗
                </a>
              )}
            </p>
          )}
        </li>
      ))
    }
  </ol>
  <details class="bg-table">
    <summary>{labels.table}</summary>
    <div class="bg-table-wrap">
      <table>
        <thead>
          <tr>
            <th>{labels.stage}</th>
            <th>{labels.company}</th>
            <th>{labels.role}</th>
            <th>{labels.hq}</th>
          </tr>
        </thead>
        <tbody>
          {
            stages.flatMap((s, i) =>
              s.companies.map((c) => (
                <tr>
                  <td>
                    {i + 1}. {s.name}
                  </td>
                  <td>
                    {c.name}
                    {c.ticker ? `（${c.ticker}）` : ''}
                  </td>
                  <td>{c.role}</td>
                  <td>{c.hq ?? '—'}</td>
                </tr>
              )),
            )
          }
        </tbody>
      </table>
    </div>
  </details>
</section>
