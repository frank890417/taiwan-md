---
/**
 * IndustryTimeline — 產業時間軸工具（契約 v1 第 4 節 (a)）。
 * 1953 到 2026 年，政策、企業、資本市場、國際四條線；可只看一條線，狀態同步到 ?track=。
 * 沒有 JS 時全部事件都看得到。同一頁可放多個實例（不用 id，靠根節點 data 屬性查詢）。
 * 內容：src/data/industry/content/timeline.json；文字走 src/i18n/industry。
 */
import '../../../styles/industry.css';
import { useIndustryT } from '../../../i18n/industry';
import { relatedList } from '../../../utils/industry/related';
import timeline from '../../../data/industry/content/timeline.json';

interface Props {
  lang: string;
  variant?: 'inline' | 'page' | 'embed';
}
const { lang, variant = 'inline' } = Astro.props;
const ti = useIndustryT(lang);
const TL = timeline as any;
const tracks = ['policy', 'company', 'market', 'world'];
const byEra = TL.eras.map((era: any) => ({
  era,
  events: TL.events
    .filter((e: any) => e.era === era.id)
    .sort((a: any, b: any) => a.date.localeCompare(b.date)),
}));
// 內嵌板不連站內文章（iframe 裡點開會在別人的網站裡換頁）
const articles = new Map<string, string>();
if (variant !== 'embed') {
  for (const e of TL.events) {
    if (!e.article) continue;
    const [r] = await relatedList(lang, [e.article]);
    if (r) articles.set(e.id, r.href);
  }
}
---

<div class="ind-tool ind-tl-tool" data-ind-timeline data-variant={variant}>
  <div class="ind-tl-filter" data-filter hidden>
    <button type="button" data-track="all" aria-pressed="true">
      {ti('tl.all')}
    </button>
    {
      tracks.map((k) => (
        <button type="button" data-track={k} aria-pressed="false">
          <span class={`ind-tl-dot ind-track-${k}`} aria-hidden="true" />
          {ti(`tl.track.${k}`)}
        </button>
      ))
    }
  </div>
  <p class="ind-tl-count" data-count aria-live="polite"></p>
  {
    byEra.map(({ era, events }: any) => (
      <div class="ind-era-block" data-era>
        <h4 class="ind-era">
          {ti(`timeline.eras.${era.id}.t`)}
          <small>{era.span}</small>
        </h4>
        <ol class="ind-tl">
          {events.map((e: any) => (
            <li class={`ind-tl-item is-${e.track}`} data-track={e.track}>
              <div class="ind-tl-date">{e.date}</div>
              <div>
                <div class="ind-tl-title">
                  <span class="ind-tl-tag">{ti(`tl.track.${e.track}`)}</span>
                  {ti(`timeline.events.${e.id}.t`)}
                  <a
                    class="ind-src no-external-icon"
                    aria-label={ti('label.source')}
                    href={e.url}
                    target="_blank"
                    rel="noopener"
                  >
                    ↗
                  </a>
                </div>
                {e.f && (
                  <p class="ind-tl-fact">
                    {ti(`timeline.events.${e.id}.f`)}
                    {articles.get(e.id) && (
                      <a class="ind-tl-more" href={articles.get(e.id)}>
                        {ti('label.readmore')} →
                      </a>
                    )}
                  </p>
                )}
              </div>
            </li>
          ))}
        </ol>
      </div>
    ))
  }
</div>

<script>
  import { parseTrack, TRACKS } from '../../../utils/industry/toolState';

  for (const root of document.querySelectorAll<HTMLElement>(
    '[data-ind-timeline]',
  )) {
    const filter = root.querySelector<HTMLElement>('[data-filter]');
    const count = root.querySelector<HTMLElement>('[data-count]');
    if (!filter) continue;
    const items = Array.from(
      root.querySelectorAll<HTMLElement>('[data-track]'),
    ).filter((el) => el.tagName === 'LI');
    const blocks = Array.from(root.querySelectorAll<HTMLElement>('[data-era]'));
    const buttons = Array.from(filter.querySelectorAll('button'));
    const apply = (track: string, push: boolean) => {
      for (const b of buttons)
        b.setAttribute('aria-pressed', String(b.dataset.track === track));
      let n = 0;
      for (const li of items) {
        li.hidden = track !== 'all' && li.dataset.track !== track;
        if (!li.hidden) n++;
      }
      for (const b of blocks)
        b.hidden = !b.querySelector('li[data-track]:not([hidden])');
      if (count) count.textContent = `${n} / ${items.length}`;
      if (push) {
        const u = new URL(location.href);
        if (track === 'all') u.searchParams.delete('track');
        else u.searchParams.set('track', track);
        history.replaceState(null, '', u);
      }
    };
    filter.hidden = false;
    filter.addEventListener('click', (e) => {
      const btn = (e.target as HTMLElement).closest('button');
      if (btn?.dataset.track) apply(btn.dataset.track, true);
    });
    apply(parseTrack(location.search, TRACKS), false);
  }
</script>
