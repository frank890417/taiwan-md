  "votingInfo": [
    {
      "id": "when",
      "links": [
        {
          "kind": "announcement",
          "url": "https://web.cec.gov.tw/central/article/63625"
        }
      ],
      "zh-TW": {
        "q": "什麼時候投票？",
        "a": "2026 年 11 月 28 日星期六，上午 8 點到下午 4 點。同一天、同一時段也舉行全國性公投第 22 案的投票。"
      },
      "en": {
        "q": "When is voting day?",
        "a": "Saturday, November 28, 2026, from 8 a.m. to 4 p.m. National Referendum Case No. 22 is voted on the same day during the same hours."
      },
      "ja": {
        "q": "投票日はいつ？",
        "a": "2026年11月28日（土）、午前8時から午後4時までです。同じ日の同じ時間帯に、全国公民投票第22案の投票も行われます。"
      },
      "ko": {
        "q": "투표일은 언제인가요?",
        "a": "2026년 11월 28일 토요일, 오전 8시부터 오후 4시까지입니다. 같은 날 같은 시간에 전국 국민투표 제22안 투표도 함께 진행됩니다."
      },
      "fr": {
        "q": "Quand a lieu le scrutin ?",
        "a": "Le samedi 28 novembre 2026, de 8 h à 16 h. Le référendum national n° 22 est voté le même jour, aux mêmes horaires."
      },
      "es": {
        "q": "¿Cuándo se vota?",
        "a": "El sábado 28 de noviembre de 2026, de 8:00 a 16:00. El referéndum nacional n.º 22 se vota el mismo día y en el mismo horario."
      }
    },
    {
      "id": "eligibility",
      "links": [
        {
          "kind": "law",
          "url": "https://law.moj.gov.tw/LawClass/LawAll.aspx?pcode=D0020010"
        }
      ],
      "zh-TW": {
        "q": "誰可以投地方選舉？",
        "a": "年滿 20 歲、在選舉區繼續住滿 4 個月以上的國民，年齡和居住期間都算到投票日前一天。8 月 20 日選舉公告發布後才把戶籍遷進選舉區的人，這次沒有投票權。"
      },
      "en": {
        "q": "Who can vote in the local elections?",
        "a": "Citizens aged 20 or older who have lived in the electoral district continuously for at least four months, with both counted up to the day before voting day. Anyone who moved their household registration into the district after the election announcement of August 20 cannot vote in this election."
      },
      "ja": {
        "q": "地方選挙で投票できるのは？",
        "a": "満20歳以上で、選挙区に4か月以上続けて住んでいる国民です。年齢と居住期間はどちらも投票日の前日までで数えます。8月20日の選挙公告の後に選挙区へ戸籍を移した人は、今回は投票できません。"
      },
      "ko": {
        "q": "지방선거에는 누가 투표할 수 있나요?",
