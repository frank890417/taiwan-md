        '_setFont',
        'jf-lanyanghei-extraheavy',
        'alias',
        'jf-lanyanghei',
      ]);
      _jf.push(['_setFont', 'jf-lanyanghei-extraheavy', 'weight', 920]);
      _jf.push(['_setFont', 'jf-lanyangming-book', 'css', 'main blockquote']);
      _jf.push(['_setFont', 'jf-lanyangming-book', 'alias', 'jf-lanyangming']);
      _jf.push(['_setFont', 'jf-lanyangming-book', 'weight', 300]);
      _jf.push(['_setFont', 'jf-kamabit', 'css', '.jf-food h1']);
      _jf.push(['_setFont', 'jf-kamabit', 'alias', 'jf-kamabit']);
      _jf.push(['_setFont', 'jf-kamabit', 'weight', 700]);
      // rixingsong-semibold: applied to .hero-title (site-wide hero titles)
      // AND .jf-history h1 (history articles). Status as of 2026-05-04:
      // justfont's rixingsong subsetter is **character-set dependent broken**:
      //   ✅ /history/二二八事件 → loaded
      //   ✅ /history/19世紀的樟腦戰爭：世界要的香氣，藏在原住民的山 → loaded
      //   ❌ /nature/黃魚鴞:六公里溪流養一對,1,800 公尺烏心石上的夜行猛禽
