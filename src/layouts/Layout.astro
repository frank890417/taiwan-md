  </head>
  <body class={jfClass}>
    <!-- Skip-to-content link — first focusable element in <body> so keyboard /
         screen-reader users can bypass the header nav. Visually hidden until
         focused (.skip-link in global.css). 2026-07-06 design-audit §2.9-1. -->
    <a href="#main-content" class="skip-link">{skipLinkLabel}</a>

    <Header />

    <script
      is:inline
      define:vars={{
        _i18nSearchHintEmpty: t('nav.search-modal.type-to-search'),
        _i18nSearchHintNone: t('nav.search-modal.no-results'),
        _i18nSearchLoading: t('nav.search-modal.loading'),
        _i18nSearchMoreTemplate: t('nav.search-modal.more-results'),
        _i18nSearchLangBadgeZh: t('nav.search-modal.lang-badge-zh'),
        _i18nSearchViewAll: t('nav.search-modal.view-all' as any),
