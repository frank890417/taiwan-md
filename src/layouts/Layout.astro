---
import '../styles/global.css';
import '../styles/icons.css';
import '../styles/shot-mode.css';
import '../styles/dark-polish.css';
import '../styles/article-modules.css';
import SEO from '../components/SEO.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import BrandMark from '../components/BrandMark.astro';
import ReaderSettings from '../components/ReaderSettings.astro';
import FeedbackWidget from '../components/FeedbackWidget.astro';
import HeadInlineScripts from '../components/HeadInlineScripts.astro';
import EventTracker from '../components/EventTracker.astro';

import type { Lang } from '../config/languages';
import {
  ENABLED_LANGUAGE_CODES,
  DEFAULT_LANGUAGE,
  getLanguage,
} from '../config/languages';
import { useTranslations } from '../i18n/utils';
import {
  getCategoryDirMap,
  getTranslatedHubPresence,
  NON_DEFAULT_LANGS,
} from '../utils/staticRoutes';

interface Props {
  title: string;
  description?: string;
  lang?: Lang;
  image?: string;
  type?: 'website' | 'article';
  datePublished?: string;
  dateModified?: string;
  content?: string;
  tags?: string[];
  category?: string;
  slug?: string;
  categorySlug?: string;
  /** Passthrough to SEO's CollectionPage JSON-LD (see SEO.astro props). */
  collectionItems?: { name: string; url: string }[];
  collectionTotal?: number;
  noindex?: boolean;
  /**
   * Opt this surface into the floating ReaderSettings panel
   * (light/auto/dark theme + text-size + plain-text link) and
   * the FOUC-safe pre-paint theme init script.
   *
   * Contract for opting in: the surface MUST be dark-mode tested.
   * Per-surface dark polish lives in `src/styles/dark-polish.css`
   * scoped under the surface's <main class="..."> hook (e.g.
   * `main.article-page`, `main.category-page`). Don't enable
   * this on a surface that hasn't been visually audited dark —
   * the panel will toggle data-theme on <html> globally and a
   * surface without dark coverage will look broken.
   *
   * Default: false. Article + category-hub templates opt in.
   */
  readerSettings?: boolean;
  /**
   * Opt this surface into the floating reader FeedbackWidget
   * (correction / bug / new-topic → managed backend → cron → GitHub issue).
   * Self-gates on PUBLIC_FEEDBACK_MODE (off/github-only/mock/supabase); when
   * unconfigured it degrades to a static "report on GitHub" button, so it is
   * always safe to leave on. Default: true (every surface that uses Layout).
   * Pass feedback={false} to opt a surface out (e.g. embed/raw views).
   */
  feedback?: boolean;
  /**
   * GA4 page_type dimension for the engagement tracker (EventTracker is mounted
   * once here for EVERY page). Optional — when omitted it's derived from the
   * URL + category/slug props, so every surface gets a sensible page_type with
   * zero per-page wiring. Pass explicitly to override (e.g. pageType="home").
   */
  pageType?: string;
}

const { lang = 'zh-TW' } = Astro.props;
const t = useTranslations(lang);
// Text direction — read from the LANGUAGES registry (SSOT: src/config/languages.ts
// `dir` field). Every language defaults to 'ltr' unless the registry marks it
// 'rtl' (2026-07-25: ar is the site's first RTL language). Keeping this a
// registry lookup instead of a hardcoded list means a future RTL language
// (e.g. he/fa) only needs the one `dir: 'rtl'` line in languages.ts.
const dir = getLanguage(lang)?.dir ?? 'ltr';
const {
  title,
  description = lang === 'zh-TW'
    ? '讓全世界完整認識台灣'
    : 'Open-source knowledge base about Taiwan',
  image,
  type,
  datePublished,
  dateModified,
  content,
  tags,
  category,
  slug,
  categorySlug: propCategorySlug,
  collectionItems,
  collectionTotal,
  noindex,
  readerSettings = false,
  feedback = true,
  pageType: pageTypeProp,
} = Astro.props;

// Search index now loaded via /api/search-index.json (fetch API)
const isEn = lang === 'en';
// categorySlug: prefer the English URL slug passed explicitly (e.g. 'food',
// 'history') so the body's `jf-{slug}` class matches the English selectors
// the justfont SDK config below uses (`.jf-food h1`, `.jf-history h1`).
// Pre-2026-05-04 this took `category?.toLowerCase()` which ALSO captured the
// localized display name (`自然`, `美食`) and produced classes like `jf-自然`
// that no SDK selector matched — the category-specific font rules were dead
// in production. Falling back to the old behavior for callers that don't
// pass categorySlug (utility pages still get `jf-${category}` like before).
const categorySlug =
  propCategorySlug?.toLowerCase() || category?.toLowerCase() || '';
const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';
const nonDefaultLanguagePrefixes = new Set(
  ENABLED_LANGUAGE_CODES.filter((code) => code !== DEFAULT_LANGUAGE.code).map(
    (code) => `/${code}`,
  ),
);
const pageTypeSegments = currentPath.split('/').filter(Boolean);
const pageTypePathSegments = nonDefaultLanguagePrefixes.has(
  `/${pageTypeSegments[0]}`,
)
  ? pageTypeSegments.slice(1)
  : pageTypeSegments;

// ── page_type for the engagement tracker (EventTracker, mounted once below) ──
// Explicit prop wins; else derived: an article sets `slug`, a category hub sets
// `category` (no slug); everything else maps to its first URL segment (lang
// prefix stripped) so /about → about, /dashboard → dashboard, / → home.
const pageType =
  pageTypeProp ||
  (slug
    ? 'article'
    : category
      ? 'category'
      : pageTypePathSegments[0] || 'home');
const homePaths = new Set(
  ENABLED_LANGUAGE_CODES.map((code) =>
    code === DEFAULT_LANGUAGE.code ? '/' : `/${code}`,
  ),
);
const isHome = homePaths.has(currentPath);
// Feedback widget page-kind (v2): drives context-aware category set + inline
// text-selection annotation on articles. Derived from page type + path.
const fbPageKind =
  type === 'article'
    ? 'article'
    : currentPath.includes('/dashboard')
      ? 'dashboard'
      : currentPath.includes('/semiont')
        ? 'semiont'
        : isHome
          ? 'home'
          : propCategorySlug
            ? 'category'
            : 'other';
// justfont: only put the body font class on <body> to avoid rate-limit.
// Other font classes go on specific elements (h1-h6, blockquote, nav, etc.)
const jfClass = [
  'jf-jinxuanlatte-regular',
  isHome ? 'page-home' : 'page-default',
  categorySlug ? `jf-${categorySlug}` : '',
]
  .filter(Boolean)
  .join(' ');

// Skip-to-content link label, localized by the Layout's lang prop
// (2026-07-06 design-audit §2.9-1)。⚠️ 這張表是元件私有的第三套翻譯系統，
// 新語言出生時不會自動出現在這裡——vi/id/pt/hi 出生一週都掉回 zh 沒人發現，
// ar/ru 開站日（2026-07-25）才被抓到。加語言記得同步 ReaderSettings.astro。
const skipLinkLabels: Record<string, string> = {
  'zh-TW': '跳到主要內容',
  en: 'Skip to content',
  ja: '本文へスキップ',
  ko: '본문으로 건너뛰기',
  es: 'Saltar al contenido',
  fr: 'Aller au contenu',
  vi: 'Bỏ qua đến nội dung chính',
  id: 'Langsung ke konten utama',
  pt: 'Ir para o conteúdo',
  hi: 'मुख्य सामग्री पर जाएँ',
  ar: 'الانتقال إلى المحتوى الرئيسي',
  ru: 'Перейти к основному содержимому',
  de: 'Zum Hauptinhalt springen',
};
const skipLinkLabel = skipLinkLabels[lang] ?? skipLinkLabels['zh-TW'];
---

<!doctype html>
<html lang={lang} dir={dir}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <!-- Apple touch icons: 2026-04-11 fix. Cloudflare logs showed 130 req/day
         404 on /apple-touch-icon.png + /apple-touch-icon-precomposed.png.
         iOS/macOS Safari auto-probes these paths. -->
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link
      rel="apple-touch-icon-precomposed"
      href="/apple-touch-icon-precomposed.png"
    />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <!-- Taiwan Typography System -->
    <!-- Google Fonts: Noto Sans/Serif TC for fallback -->
    <link
      href="https://fonts.googleapis.com/css2?family=Noto+Sans+TC:wght@300;400;500;600;700;800;900&family=Noto+Serif+TC:wght@400;600;700;900&display=swap"
      rel="preload"
      as="style"
      onload="this.onload=null;this.rel='stylesheet'"
    />
    <!-- justfont 蘭陽明體 已透過 justfont SDK 載入，無需額外 import -->
    <!-- Fallback for critical text -->
    <noscript>
      <link
        href="https://fonts.googleapis.com/css2?family=Noto+Sans+TC:wght@300;400;500;600;700;800;900&family=Noto+Serif+TC:wght@400;600;700;900&display=swap"
        rel="stylesheet"
      />
    </noscript>
    <title>{title} | Taiwan.md</title>
    <link
      rel="alternate"
      type="application/rss+xml"
      title="Taiwan.md RSS"
      href="/rss.xml"
    />
    <SEO
      title={title}
      description={description}
      lang={lang}
      image={image}
      type={type}
      datePublished={datePublished}
      dateModified={dateModified}
      content={content}
      tags={tags}
      category={category}
      slug={slug}
      categorySlug={propCategorySlug}
      collectionItems={collectionItems}
      collectionTotal={collectionTotal}
    />
    <!-- FOUC fix: hide <html> until fonts loaded (2026-05-11 picked up from
         tboydar-agent PR #1012 / fixes #401). Combined with shot-mode +
         reader-settings init below for complete pre-paint FOUC prevention.

         ⚠️ 這個閘門把「整頁可見」綁在字型事件上，所以它必須自己有出口。
         2026-09-04 (#1666) 之前它一個出口都沒有：`fonts-loaded` 只有
         `document.fonts.ready` 會加，沒有逾時、沒有 rejection 處理，
         JS 關掉時也沒有任何東西會解除 `visibility: hidden`——字型來源慢、
         被擋、或 JS 沒跑，整站就是一片空白，而且是永遠。
         下面那條 800ms 的 fallback 管的是 justfont 的 `jf-loading`（body
         opacity），跟這道閘門是兩回事，接不住它。
         現在三條出口：字型事件 / 逾時 / noscript。字型用 display=swap，
         逾時揭開時本來就有 fallback 字可讀，字型到齊後自然換上。 -->
    <style>
      html {
        visibility: hidden;
      }
      html.fonts-loaded {
        visibility: visible;
      }
    </style>
    <noscript>
      <style>
        /* JS 關掉時沒有任何腳本會加 .fonts-loaded — 這裡直接解除閘門，
           否則整站對 no-JS 讀者是空白頁。 */
        html {
          visibility: visible;
        }
      </style>
    </noscript>
    <script is:inline>
      (function () {
        var reveal = function () {
          document.documentElement.classList.add('fonts-loaded');
        };
        // 出口 2：逾時。跟下面 justfont 的 fallback 用同一個 800ms，
        // 站上只留一個數字，不要兩套各自漂移的逾時。
        setTimeout(reveal, 800);
        if (document.fonts && document.fonts.ready) {
          document.fonts.ready.then(reveal).catch(reveal);
        } else {
          // fallback for older browsers
          reveal();
        }
      })();
    </script>
    <!-- Pre-paint inline scripts: shot-mode + reader-settings FOUC init.
         2026-05-03 sleepy-colden Tier 2.6: 抽到 src/components/HeadInlineScripts.astro
         讓 Layout 主結構乾淨。原本 ~150 行 inline 邏輯都在這裡。 -->
    <HeadInlineScripts readerSettings={readerSettings} />
    <script
      is:inline
      async
      src="https://www.googletagmanager.com/gtag/js?id=G-JGC5W00N7T"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        dataLayer.push(arguments);
      }
      gtag('js', new Date());
      gtag('config', 'G-JGC5W00N7T');
    </script>
    <!-- FOUC fallback (#401): if justfont takes > 800ms, reveal body anyway -->
    <script is:inline>
      (function () {
        setTimeout(function () {
          var html = document.documentElement;
          if (html.classList.contains('jf-loading')) {
            html.classList.remove('jf-loading');
            html.classList.add('jf-inactive');
          }
        }, 800);
      })();
    </script>
    <!-- justfont Webfont (Production) -->
    <script is:inline>
