      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 480px) {
    .section-title {
      font-size: 1.75rem;
    }

    .timeline {
      padding-left: 1.5rem;
    }

    .timeline-item {
      padding-left: 1rem;
    }

    .founder-links-inline {
      flex-direction: column;
      align-items: center;
    }
  }

  .faq-list {
    margin-top: 2rem;
  }

  .faq-item {
    border-bottom: 1px solid #e5e7eb;
  }

  .faq-item[open] {
    padding-bottom: 1.5rem;
  }

  .faq-question {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1.25rem 0;
    font-size: 1.1rem;
    font-weight: 600;
    color: #1f2937;
    cursor: pointer;
    list-style: none;
    line-height: 1.5;
  }

  .faq-question::-webkit-details-marker {
    display: none;
  }

  .faq-question::after {
    content: '+';
    font-size: 1.4rem;
    font-weight: 300;
    color: #9ca3af;
    transition: transform 0.2s ease;
    flex-shrink: 0;
    margin-left: 1rem;
  }

  .faq-item[open] .faq-question::after {
    content: '−';
    color: #2d5016;
  }

  .faq-question:hover {
    color: #2d5016;
  }

  .faq-answer {
    padding: 0 0 0.5rem;
    animation: faqFadeIn 0.2s ease;
  }

  .faq-answer p {
    font-size: 1rem;
    line-height: 1.8;
    color: #4b5563;
  }

  .faq-answer a {
    color: #2563eb;
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .faq-answer a:hover {
    color: #1d4ed8;
  }

  .faq-answer strong {
    color: #1f2937;
    font-weight: 600;
  }

  .faq-answer code {
    background: #f3f4f6;
    padding: 0.15em 0.4em;
    border-radius: 4px;
    font-size: 0.9em;
    color: #1f2937;
  }

  @keyframes faqFadeIn {
    from {
      opacity: 0;
      transform: translateY(-4px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (max-width: 768px) {
    .faq-section {
      padding: 3rem 1rem;
    }
    .faq-question {
      font-size: 1rem;
      padding: 1rem 0;
    }
  }

  /* ══════════════════════════════════════════════════════════════════
   * 2026-11-19 關於頁進化（reports/design-homepage-about-implementation-2026-11-19.md §4）
   *
   * 以下規則寫在既有樣式之後，同名規則以這裡為準。
   *
   * 顏色：新寫的一律從 tokens.css 的 --color-* 與 --cat-geography 混出來，
   *       深色模式跟著 --color-* 翻面（不夠亮的在最下面的深色段補）。
   * 間距：三級，--ab-gap-l（區塊之間）／--ab-gap-m（區塊內分組）／--ab-gap-s（元素之間）。
   * 方向：新寫的一律用邏輯屬性（inline / block），阿拉伯文不用另外處理。
   * ══════════════════════════════════════════════════════════════════ */
  .about-page {
    --ab-heading: color-mix(
      in srgb,
      var(--cat-geography) 55%,
      var(--color-ink)
    );
    --ab-brand: color-mix(in srgb, var(--cat-geography) 78%, var(--color-ink));
    --ab-brand-soft: color-mix(
      in srgb,
      var(--cat-geography) 8%,
      var(--color-bg)
    );
    --ab-rule: var(--color-border);
    --ab-rule-strong: color-mix(in srgb, var(--color-ink) 22%, transparent);
    --ab-surface: var(--color-surface);
    --ab-section-bg: var(--color-bg);
    --ab-gap-l: calc((var(--space-7) + var(--space-8)) / 2);
    --ab-gap-m: var(--space-5);
    --ab-gap-s: calc(var(--space-4) / 2);
    --ab-inner-pad: var(--space-5);
  }

  /* 錨點跳轉：站頭的高度全站已經用 scroll-padding-top 讓開了，
     這裡只再讓出貼在站頭下面的那一排章節列 */
  .about-page :is(section[id], div[id], details[id]) {
    scroll-margin-block-start: 3.25rem;
  }

  /* ── 區塊節奏 ─────────────────────────────────────────────────── */
  .ab-sec {
    padding-block: var(--ab-gap-l);
  }
  .section-inner {
    padding: 0 var(--ab-inner-pad);
  }
  .section-title {
    margin-bottom: var(--ab-gap-s);
    font-size: clamp(1.75rem, 3.4vw, 2.5rem);
    line-height: 1.25;
    color: var(--ab-heading);
    text-wrap: balance;
  }
  .section-subtitle {
    max-width: 46em;
    margin: 0 auto var(--ab-gap-m);
    font-size: 1.0625rem;
    line-height: 1.7;
    color: var(--color-ink-soft);
  }

  /* ── 2 三十秒版 ── */
  .ab-sec--brief {
    padding-block: var(--ab-gap-s) var(--ab-gap-l);
  }

  /* ── 名字的由來：三張卡＋活的數字＋願景 ── */
  .ab-sec--naming {
    padding-block-start: 0;
  }
  .ab-sec--naming .section-title {
    margin-bottom: var(--space-4);
  }
  .naming-grid {
    margin: 0 0 var(--space-4);
  }
  .naming-card {
    background: var(--color-bg-soft);
    border-color: var(--ab-rule);
    border-radius: var(--radius-chip);
  }
  .naming-card h3 {
    margin-bottom: 0.5rem;
    font-family: var(--font-reading);
    font-size: 1.05rem;
    font-weight: 600;
    letter-spacing: 0;
    color: var(--color-ink);
  }
  .naming-card p {
    color: var(--color-ink-soft);
  }
  .project-stats {
    gap: var(--space-5) var(--space-7);
    margin-bottom: var(--space-4);
  }
  .stat-number {
    font-family: var(--font-interface);
    font-variant-numeric: tabular-nums;
    letter-spacing: -0.02em;
    color: var(--ab-heading);
  }
  .vision-block {
    margin-top: 0;
    padding: var(--space-5);
    border-radius: var(--radius-chip);
  }
  .vision-block p {
    max-width: 40em;
    margin-bottom: var(--ab-gap-s);
  }

  /* ── 3 人 ── */
  .ab-sec--people {
    background: var(--color-bg-soft);
    border-block: 1px solid var(--ab-rule);
  }
  /* 引語：襯線大字，不裝框 */
  .standalone-quote {
    max-width: 34em;
    margin: 0 auto var(--ab-gap-m);
    padding: 0;
    border: 0;
    border-radius: 0;
    background: none;
    font-size: clamp(1.2rem, 2.1vw, 1.5rem);
    font-style: normal;
    line-height: 1.85;
    color: var(--color-ink);
    text-wrap: pretty;
  }
  .founder-quote cite {
    margin-top: var(--ab-gap-s);
    font-family: var(--font-interface);
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--ab-brand);
  }
  .founder-card {
    grid-template-columns: 13.5rem minmax(0, 1fr);
    gap: var(--space-7);
    max-width: 54rem;
    margin: 0 auto var(--ab-gap-m);
  }
  .founder-photo {
    position: static;
  }
  .founder-image {
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 5;
    border-radius: var(--radius-chip);
    box-shadow: var(--shadow-card);
  }
  .founder-info h3 {
    color: var(--color-ink);
  }
  .name-en {
    margin-inline-start: 0.35rem;
    font-family: var(--font-reading);
    color: var(--color-ink-soft);
  }
  .founder-tagline {
    margin-bottom: var(--ab-gap-s);
    color: var(--ab-brand);
  }
  .founder-bio p {
    max-width: 36em;
    color: var(--color-ink-soft);
  }
  .founder-links-inline {
    flex-wrap: wrap;
    justify-content: flex-start;
    gap: 0.5rem;
    margin: var(--ab-gap-s) 0 0;
  }
  .link-inline {
    min-height: 44px;
    border-color: var(--ab-rule);
    background: var(--ab-surface);
  }
  .link-inline:hover {
    border-color: var(--ab-brand);
    box-shadow: none;
    transform: none;
  }
  .link-inline .link-text {
    color: var(--color-ink);
  }

  .team-grid {
    gap: var(--space-4);
    margin-bottom: var(--space-4);
  }
  .team-card {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    column-gap: 1rem;
    align-content: start;
    padding: var(--space-5);
    border-color: var(--ab-rule);
    border-radius: var(--radius-chip);
    background: var(--ab-surface);
    box-shadow: none;
  }
  .team-card:hover {
    transform: none;
    box-shadow: var(--shadow-soft);
  }
  .team-icon {
    grid-row: 1 / span 2;
    align-self: center;
    margin: 0;
    font-size: 2.25rem;
    line-height: 1;
  }
  /* MonoLab 標誌：橫式字標，字高跟旁邊 Muse 的圖示差不多（約 2.25rem 的方塊裡
     字母約佔一半高），所以標誌寬 6rem、高約 1.6rem */
  .team-icon--logo {
    display: flex;
    align-items: center;
    inline-size: 6rem;
    color: var(--color-ink);
  }
  .team-icon--logo :global(svg) {
    display: block;
    inline-size: 100%;
    block-size: auto;
  }
  .team-card h3 {
    align-self: end;
    margin: 0;
    font-family: var(--font-reading);
    font-size: 1.25rem;
    letter-spacing: 0;
    text-align: start;
    color: var(--color-ink);
  }
  .team-role {
    margin: 0;
    font-size: 0.9375rem;
    text-align: start;
    color: var(--ab-brand);
  }
  .team-description {
    grid-column: 1 / -1;
    margin: var(--space-4) 0 var(--ab-gap-s);
  }
  .team-description p {
    color: var(--color-ink-soft);
  }
  .team-link {
    grid-column: 1 / -1;
    justify-self: start;
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-weight: 600;
    color: var(--ab-brand);
  }
  .team-link:hover {
    color: var(--color-ink);
  }

  /* 貢獻者牆：每個人都在，排緊一點 */
  .contributors-in-team {
    padding: var(--space-5);
    border-color: var(--ab-rule);
    border-radius: var(--radius-chip);
    background: var(--ab-surface);
  }
  .contributors-in-team h3 {
    font-family: var(--font-reading);
    font-size: 1.25rem;
    letter-spacing: 0;
    color: var(--color-ink);
  }
  .contributors-desc {
    margin-bottom: var(--space-4);
    font-size: 0.875rem;
    color: var(--color-ink-soft);
  }
  .contributors-grid {
    grid-template-columns: repeat(auto-fill, minmax(4rem, 1fr));
    gap: 0.25rem;
    margin: 0;
  }
  .contributor-card {
    gap: 0.25rem;
    min-height: 44px;
    padding: 0.375rem 0.125rem;
  }
  .contributor-card:hover {
    transform: none;
    background: var(--ab-brand-soft);
  }
  .contributor-avatar {
    width: 44px;
    height: 44px;
  }
  .contributor-name {
    max-width: 100%;
    font-size: 0.6875rem;
    color: var(--color-ink-soft);
  }
  .contributor-types {
    font-size: 0.75rem;
  }
  .contributors-cta {
    margin: var(--space-4) 0 0;
    color: var(--color-ink-soft);
  }
  .contributors-cta :global(a) {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    border: 0;
    font-weight: 600;
    color: var(--ab-brand);
  }
  .contributors-cta :global(a:hover) {
    color: var(--color-ink);
  }

  /* ── 4 為什麼需要 ── */
  .ab-sec--why {
    background: var(--ab-brand-soft);
  }

  /* ── 6 誕生 ── */
  .ab-sec--origin {
    --ab-section-bg: var(--color-bg-soft);
    background: var(--color-bg-soft);
    border-block: 1px solid var(--ab-rule);
  }

  /* 「看完整的時間軸」：收合的 <details>，內容一直在原始碼裡 */
  .timeline-full {
    margin-top: var(--ab-gap-m);
    border-block-start: 1px solid var(--ab-rule);
  }
  .timeline-full__summary {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.625rem;
    min-height: 56px;
    font-family: var(--font-interface);
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--ab-brand);
    cursor: pointer;
    list-style: none;
  }
  .timeline-full__summary::-webkit-details-marker {
    display: none;
  }
  .timeline-full__summary:hover {
    color: var(--color-ink);
  }
  .timeline-full__summary:focus-visible,
  .supporters-more__summary:focus-visible,
  .organism-more__summary:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
    border-radius: 8px;
  }
  .timeline-full__chevron,
  .supporters-more__chevron,
  .organism-more__chevron {
    inline-size: 0.5rem;
    block-size: 0.5rem;
    margin-block-start: -0.25rem;
    border-inline-end: 2px solid currentColor;
    border-block-end: 2px solid currentColor;
    rotate: 45deg;
    transition: rotate 0.2s ease;
  }
  .timeline-full[open] .timeline-full__chevron,
  .supporters-more[open] .supporters-more__chevron,
  .organism-more[open] .organism-more__chevron {
    margin-block-start: 0.25rem;
    rotate: -135deg;
  }

  /* 完整時間軸本身：版面照舊，位置改用邏輯屬性（阿拉伯文線會在右邊），
     強調色跟著這一頁的品牌綠 */
  .timeline {
    max-width: 48rem;
    margin: var(--ab-gap-m) auto 0;
    padding-left: 0;
    padding-inline-start: 2rem;
    padding-block-end: var(--ab-gap-s);
  }
  .timeline::before {
    left: auto;
    inset-inline-start: 7px;
    background: linear-gradient(
      to bottom,
      var(--ab-heading),
      var(--ab-brand),
      var(--ab-rule-strong)
    );
  }
  .timeline-item {
    padding-left: 0;
    padding-inline-start: 1.5rem;
    scroll-margin-block-start: 4rem;
  }
  .timeline-marker {
    left: auto;
    inset-inline-start: -2rem;
    background: var(--ab-brand);
    border-color: var(--ab-section-bg);
    box-shadow: 0 0 0 2px var(--ab-brand);
  }
  .timeline-marker.pulse {
    background: var(--ab-section-bg);
    box-shadow: 0 0 0 2px var(--ab-brand);
    animation: none;
  }
  .timeline-date {
    font-family: var(--font-interface);
    font-variant-numeric: tabular-nums;
    color: var(--ab-brand);
  }
  .timeline-content h3 {
    color: var(--color-ink);
  }
  .timeline-content p,
  .timeline-list {
    color: var(--color-ink-soft);
  }
  .timeline-content :global(a) {
    color: var(--ab-brand);
  }
  .timeline-content :global(a:hover) {
    color: var(--color-ink);
  }
  .timeline-link {
    color: var(--ab-brand);
  }
  .press-card-mini {
    background: var(--ab-surface);
    border-color: var(--ab-rule);
  }
  .press-card-mini:hover {
    border-color: var(--ab-brand);
    box-shadow: none;
  }
  .press-card-mini .press-source {
    color: var(--ab-brand);
  }
  .press-card-mini .press-title {
    font-family: var(--font-reading);
    letter-spacing: 0;
    color: var(--color-ink);
  }
  /* 從里程碑卡跳過來的那一則：標出來 */
  .timeline-item:global(.is-target) .timeline-content {
    margin: -0.75rem -1rem;
    padding: 0.75rem 1rem;
    border-radius: 12px;
    background: var(--ab-brand-soft);
  }

  /* ── 7 是活的（深色的一帶；顏色從這一帶自己的字色推）── */
  .organism-section {
    padding-block: var(--ab-gap-l);
  }
  .organism-section .section-subtitle {
    color: color-mix(in srgb, currentColor 70%, transparent);
  }
  .organism-intro {
    margin-bottom: var(--ab-gap-m);
  }
  .organism-more {
    max-width: 45rem;
    margin: 0 auto var(--ab-gap-m);
    border-block: 1px solid color-mix(in srgb, currentColor 16%, transparent);
  }
  .organism-more__summary {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.625rem;
    min-height: 56px;
    font-family: var(--font-interface);
    font-size: 0.9375rem;
    font-weight: 600;
    color: color-mix(in srgb, currentColor 82%, transparent);
    cursor: pointer;
    list-style: none;
  }
  .organism-more__summary::-webkit-details-marker {
    display: none;
  }
  .organism-more__summary:hover {
    color: inherit;
  }
  .organism-more__body {
    padding-block: var(--ab-gap-m) var(--ab-gap-s);
  }
  .organism-quote {
    padding: 0;
    border: 0;
  }
  .organism-dashboard-cta {
    margin-top: var(--ab-gap-m);
    padding-top: 0;
    border: 0;
  }
  .organism-cta-row {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--ab-gap-s);
  }
  .dashboard-btn {
    min-height: 48px;
    border-color: color-mix(in srgb, currentColor 28%, transparent);
    background: color-mix(in srgb, currentColor 8%, transparent);
    color: inherit;
    transition:
      background-color 0.2s ease,
      border-color 0.2s ease;
  }
  .dashboard-btn:hover {
    border-color: color-mix(in srgb, currentColor 55%, transparent);
    background: color-mix(in srgb, currentColor 14%, transparent);
    box-shadow: none;
    transform: none;
  }
  .dashboard-btn:hover .dashboard-btn-arrow {
    transform: none;
  }
  .dashboard-btn-desc {
    margin-inline: auto;
  }

  /* 再往裡面看一層：併進這一帶，四張卡一列 */
  .site-guide {
    margin-top: var(--ab-gap-m);
    padding-top: var(--ab-gap-m);
    border-block-start: 1px solid
      color-mix(in srgb, currentColor 16%, transparent);
  }
  .guide-heading {
    margin: 0 0 var(--ab-gap-s);
    font-size: clamp(1.4rem, 2.6vw, 1.75rem);
    font-weight: 800;
    text-align: center;
    color: inherit;
  }
  .guide-subtitle {
    max-width: 38em;
    margin: 0 auto var(--ab-gap-m);
    text-align: center;
    line-height: 1.7;
    color: color-mix(in srgb, currentColor 72%, transparent);
  }
  .guide-grid {
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--space-4);
    margin-top: 0;
  }
  .organism-section .guide-card {
    padding: var(--space-4);
    border-color: color-mix(in srgb, currentColor 16%, transparent);
    border-radius: var(--radius-chip);
    background: color-mix(in srgb, currentColor 6%, transparent);
    color: inherit;
  }
  .organism-section .guide-card:hover {
    border-color: color-mix(in srgb, currentColor 45%, transparent);
    background: color-mix(in srgb, currentColor 10%, transparent);
    box-shadow: none;
    transform: none;
  }
  .organism-section .guide-icon {
    font-size: 1.5rem;
  }
  .organism-section .guide-card-title {
    font-family: var(--font-reading);
    font-size: 1.0625rem;
    letter-spacing: 0;
    color: inherit;
  }
  .organism-section .guide-card-desc {
    font-size: 0.875rem;
    color: color-mix(in srgb, currentColor 72%, transparent);
  }
  .organism-section .guide-card-cta {
    font-size: 0.875rem;
    color: inherit;
  }

  /* ── 8 支持 ── */
  .sponsors-inner {
    max-width: 1100px;
    padding: 0 var(--ab-inner-pad);
  }
  .sponsors-inner h2 {
    font-size: clamp(1.75rem, 3.4vw, 2.5rem);
  }
  .sponsors-desc {
    margin-bottom: var(--ab-gap-m);
    color: var(--color-ink-soft);
  }
  /* 每一級一橫列：左邊是這一級的說明，右邊是夥伴 */
  .sponsor-tiers {
    gap: 0;
    margin-bottom: var(--ab-gap-m);
    border-block-end: 1px solid var(--ab-rule-strong);
  }
  .tier {
    display: grid;
    grid-template-columns: 16.5rem minmax(0, 1fr);
    grid-template-rows: auto auto 1fr;
    column-gap: var(--space-7);
    align-items: start;
    padding: var(--space-4) 0;
    border: 0;
    border-block-start: 1px solid var(--ab-rule-strong);
    border-radius: 0;
    background: none;
  }
  .tier-name {
    margin: 0 0 0.375rem;
    font-family: var(--font-reading);
    font-size: 1.0625rem;
    letter-spacing: 0;
    line-height: 1.5;
  }
  .tier-desc {
    margin-bottom: 0.5rem;
    line-height: 1.7;
    color: var(--color-ink-soft);
  }
  .tier-perks {
    margin: 0;
    line-height: 1.6;
    color: var(--color-ink-soft);
    opacity: 0.8;
  }
  .tier-logos {
    grid-column: 2;
    grid-row: 1 / span 3;
    gap: var(--space-4);
  }
  .sponsor-card {
    padding: 0;
  }
  .sponsor-card-logo a {
    display: flex;
    align-items: center;
    min-height: 44px;
  }
  .sponsor-contribution-title {
    color: var(--color-ink);
  }
  .sponsor-contribution {
    color: var(--color-ink-soft);
  }
  .logo-placeholder {
    border-color: var(--ab-rule-strong);
    border-radius: 12px;
    color: var(--color-ink-soft);
  }
  /* 個人支持者那一級：名單需要整個寬度，說明放上面，名單預設收合 */
  .tier--wide {
    grid-template-columns: minmax(0, 1fr);
    grid-template-rows: none;
  }
  /* 具名支持者：名牌一排，後面接一句匿名人數 */
  .sup-names {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.625rem 0.75rem;
    margin-block-start: var(--space-4);
  }
  .sup-names__list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.625rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .sup-names__item {
    display: inline-flex;
    align-items: center;
    gap: 0.625rem;
    min-block-size: 44px;
    padding-block: 0.3125rem;
    padding-inline: 0.3125rem 1rem;
    border: 1px solid var(--ab-rule);
    border-radius: 999px;
    background: var(--ab-surface);
  }
  .sup-names__initial {
    display: grid;
    place-items: center;
    inline-size: 2.125rem;
    block-size: 2.125rem;
    border-radius: 50%;
    background: var(--ab-brand-soft);
    font-family: var(--font-interface);
    font-size: 0.9375rem;
    font-weight: 700;
    line-height: 1;
    color: var(--ab-heading);
  }
  .sup-names__name {
    font-size: 1rem;
    font-weight: 600;
    line-height: 1.3;
    color: var(--color-ink);
    unicode-bidi: isolate;
  }
  .sup-names__tier {
    font-family: var(--font-interface);
    font-size: 0.8125rem;
    line-height: 1.3;
    color: var(--color-ink-soft);
    unicode-bidi: isolate;
  }
  .sup-names__anon {
    margin: 0;
    padding-inline-start: 0.25rem;
    font-size: 0.9375rem;
    color: var(--color-ink-soft);
  }
  .supporters-more {
    margin-top: var(--ab-gap-s);
  }
  .supporters-more__summary {
    display: inline-flex;
    align-items: center;
    gap: 0.625rem;
    min-height: 48px;
    font-family: var(--font-interface);
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--ab-brand);
    cursor: pointer;
    list-style: none;
  }
  .supporters-more__summary::-webkit-details-marker {
    display: none;
  }
  .supporters-more__summary:hover {
    color: var(--color-ink);
  }
  .supporters-more[open] .supporters-more__summary {
    margin-bottom: var(--ab-gap-s);
  }
  /* 行動區（2026-11-19 v2）：標題置中；底下兩欄同一個結構「短標 → 說明 → 按鈕」。
     兩欄用 subgrid 共用列線：短標、說明、按鈕各自對齊，按鈕貼齊欄底、在同一條水平線上。
     說明靠起始側對齊（右到左語言自動靠右），行長約 30 字。 */
  .scta {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    grid-template-rows: auto auto 1fr auto;
    column-gap: 0;
    padding: var(--space-6) var(--space-6) var(--space-5);
    border: 1px solid var(--ab-rule);
    border-radius: var(--radius-chip);
    background: var(--ab-surface);
    text-align: start;
  }
  .scta__title {
    grid-column: 1 / -1;
    margin: 0 0 var(--space-5);
    font-family: var(--font-title);
    font-size: clamp(1.375rem, 2.4vw, 1.625rem);
    line-height: 1.4;
    text-align: center;
    text-wrap: balance;
    color: var(--color-ink);
  }
  .scta__col {
    grid-row: 2 / span 3;
    display: grid;
    grid-template-rows: subgrid;
    align-items: start;
    padding-inline-end: var(--space-6);
  }
  .scta__col + .scta__col {
    padding-inline: var(--space-6) 0;
    border-inline-start: 1px solid var(--ab-rule);
  }
  .scta__lead {
    margin: 0 0 0.625rem;
    font-size: 1.0625rem;
    font-weight: 600;
    line-height: 1.6;
    color: var(--color-ink);
  }
  .scta__body {
    max-inline-size: 32em;
    margin: 0 0 var(--space-4);
    font-size: 0.9375rem;
    line-height: 1.85;
    color: var(--color-ink-soft);
  }
  .scta__btn {
    align-self: end;
    justify-self: start;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    min-block-size: 48px;
    min-inline-size: 13rem;
    padding: 0 1.5rem;
    border: 1.5px solid var(--ab-heading);
    border-radius: 10px;
    font-family: var(--font-interface);
    font-size: 0.9375rem;
    font-weight: 600;
    line-height: 1.3;
    text-decoration: none;
    transition:
      background-color 0.2s ease,
      color 0.2s ease,
      border-color 0.2s ease;
  }
  .scta__btn--primary {
    background: var(--ab-heading);
    color: var(--color-bg);
  }
  .scta__btn--primary:hover {
    border-color: var(--ab-brand);
    background: var(--ab-brand);
    color: var(--color-bg);
  }
  .scta__btn--secondary {
    background: transparent;
    color: var(--ab-heading);
  }
  .scta__btn--secondary:hover {
    background: var(--ab-brand-soft);
    color: var(--ab-heading);
  }
  .scta__btn:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 3px;
  }
  .scta__arrow {
    display: inline-block;
  }
  :global([dir='rtl']) .scta__arrow {
    scale: -1 1;
  }

  /* 按鈕：跟著品牌綠，深色模式自己翻面 */
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.4rem;
    min-height: 44px;
    border-radius: 10px;
  }
  .btn-primary {
    background: var(--ab-heading);
    color: var(--color-bg);
  }
  .btn-primary:hover {
    background: var(--ab-brand);
    box-shadow: none;
    transform: none;
  }
  .btn-outline {
    border: 1.5px solid var(--ab-heading);
    background: transparent;
    color: var(--ab-heading);
  }
  .btn-outline:hover {
    background: var(--ab-heading);
    color: var(--color-bg);
    transform: none;
  }

  /* ── 9 問答與聯繫 ── */
  /* 寬螢幕排兩欄：先由上而下排滿左欄，再排右欄（列數由樣板的 --faq-rows 給） */
  .faq-list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    grid-template-rows: repeat(var(--faq-rows, 5), auto);
    grid-auto-flow: column;
    column-gap: var(--space-7);
    align-items: start;
    margin-top: 0;
    border-block-start: 1px solid var(--ab-rule);
  }
  .faq-item {
    border-bottom-color: var(--ab-rule);
  }
  .faq-question {
    min-height: 56px;
    padding: 0.75rem 0;
    color: var(--color-ink);
  }
  .faq-question::after {
    margin-left: 0;
    margin-inline-start: 1rem;
    color: var(--color-ink-soft);
  }
  .faq-question:hover,
  .faq-item[open] .faq-question::after {
    color: var(--ab-brand);
  }
  .faq-question:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
    border-radius: 6px;
  }
  .faq-answer p {
    max-width: 40em;
    color: var(--color-ink-soft);
  }
  .faq-answer :global(a) {
    color: var(--ab-brand);
  }
  .faq-answer :global(a:hover) {
    color: var(--color-ink);
  }
  .faq-answer :global(strong) {
    color: var(--color-ink);
  }

  /* 問答與聯繫是同一章：聯繫緊接在問答後面，不另起一帶 */
  .ab-sec--contact {
    padding-block-start: 0;
  }
  .ab-sec--faq,
  .ab-sec--contact {
    background: var(--color-bg-soft);
  }
  .ab-sec--faq {
    border-block-start: 1px solid var(--ab-rule);
  }
  .contact-grid {
    gap: var(--space-4);
    margin-bottom: var(--space-4);
  }
  .contact-card {
    padding: var(--space-4);
    border-color: var(--ab-rule);
    border-radius: var(--radius-chip);
    background: var(--ab-surface);
  }
  .contact-icon {
    margin-bottom: 0.5rem;
    font-size: 1.5rem;
  }
  .contact-card h3 {
    margin-bottom: 0.25rem;
    font-family: var(--font-reading);
    font-size: 1rem;
    font-weight: 600;
    letter-spacing: 0;
    color: var(--color-ink);
  }
  .contact-card a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    border: 0;
    color: var(--ab-brand);
  }
  .contact-card a:hover {
    color: var(--color-ink);
  }
  .contact-note {
    margin-top: 0;
    color: var(--color-ink-soft);
  }
  .contact-cta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    padding: var(--space-4) var(--space-5);
    border-color: var(--ab-rule);
    border-radius: var(--radius-chip);
    background: var(--ab-surface);
    text-align: start;
  }
  .contact-cta p {
    flex: 1 1 20rem;
    margin: 0;
    color: var(--color-ink-soft);
  }
  .cta-buttons {
    flex-wrap: wrap;
    gap: var(--ab-gap-s);
  }

  /* ── 中等寬度 ─────────────────────────────────────────────────── */
  @media (max-width: 1024px) {
    .guide-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .faq-list {
      display: block;
    }
    .ab-sec--faq .section-inner {
      max-width: var(--container-prose);
    }
    .tier {
      grid-template-columns: 13rem minmax(0, 1fr);
      column-gap: var(--space-5);
    }
  }

  /* ── 手機 ─────────────────────────────────────────────────────── */
  @media (max-width: 768px) {
    .about-page {
      --ab-gap-l: var(--space-7);
      --ab-inner-pad: 1.25rem;
    }
    .section-title {
      font-size: clamp(1.6rem, 6.4vw, 2rem);
    }
    .section-subtitle {
      font-size: 1rem;
    }
    .naming-grid {
      grid-template-columns: 1fr;
      gap: 0.75rem;
    }
    .naming-card {
      display: grid;
      grid-template-columns: auto minmax(0, 1fr);
      column-gap: 0.875rem;
      padding: 1.125rem;
      text-align: start;
    }
    .naming-icon {
      grid-row: 1 / span 2;
      margin: 0;
      font-size: 1.5rem;
    }
    .project-stats {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: var(--space-4) 0.5rem;
    }
    .standalone-quote {
      text-align: start;
    }
    .founder-card {
      grid-template-columns: 1fr;
      gap: var(--space-4);
      justify-items: start;
    }
    .founder-photo {
      width: 9.5rem;
    }
    .founder-image {
      width: 100%;
      height: auto;
    }
    .founder-info {
      text-align: start;
    }
    .founder-links-inline {
      flex-direction: row;
      align-items: center;
      justify-content: flex-start;
      margin-top: var(--ab-gap-s);
    }
    .team-grid {
      grid-template-columns: 1fr;
      gap: var(--ab-gap-s);
    }
    .team-card,
    .contributors-in-team {
      padding: var(--space-4);
    }
    /* 貢獻者牆在手機上是橫向可滑的四列：每個人都在，不佔三個螢幕 */
    .contributors-grid {
      grid-template-columns: none;
      grid-template-rows: repeat(4, auto);
      grid-auto-flow: column;
      grid-auto-columns: 4.5rem;
      margin-inline: calc(var(--space-4) * -1);
      padding-inline: var(--space-4);
      overflow-x: auto;
      overscroll-behavior-x: contain;
      scrollbar-width: thin;
    }
    .ab-sec--brief {
      padding-block-start: var(--space-4);
    }
    .timeline {
      padding-inline-start: 1.5rem;
    }
    .timeline-item {
      padding-inline-start: 0.75rem;
    }
    .timeline-item:global(.is-target) .timeline-content {
      margin: -0.5rem -0.625rem;
      padding: 0.5rem 0.625rem;
    }
    .guide-grid {
      grid-template-columns: 1fr;
      gap: var(--ab-gap-s);
    }
    .organism-cta-row {
      flex-direction: column;
      align-items: stretch;
    }
    .dashboard-btn {
      justify-content: center;
    }
    .tier {
      grid-template-columns: minmax(0, 1fr);
      row-gap: 0;
      padding: var(--space-4) 0;
    }
    .tier-logos {
      grid-column: 1;
      grid-row: auto;
      margin-top: var(--space-4);
    }
    .sponsor-card {
      align-items: flex-start;
    }
    .sponsor-card-logo {
      align-self: flex-start;
      width: 8.75rem;
      max-width: 8.75rem;
    }
    /* 贊助卡：兩欄改上下兩塊，中間一條線；按鈕全寬 */
    .scta {
      grid-template-columns: minmax(0, 1fr);
      grid-template-rows: none;
      padding: var(--space-5) var(--space-4) var(--space-4);
    }
    .scta__title {
      margin-bottom: var(--space-4);
    }
    .scta__col,
    .scta__col + .scta__col {
      grid-row: auto;
      grid-template-rows: none;
      padding: 0;
      border: 0;
    }
