    border-color: #cbd5e1;
  }
  .sponsor-logo-img {
    height: 28px;
    width: auto;
  }
  .sponsor-card {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 1.5rem;
    padding: 1rem 0;
  }
  .sponsor-card-logo {
    flex: 0 0 25%;
    display: flex;
    align-items: center;
    justify-content: flex-start;
    min-width: 0;
  }
  .sponsor-card-logo a {
    display: block;
    width: 100%;
    max-width: 160px;
    text-decoration: none;
    /* 蓋掉 global.css main a:not(...) 加的 border-bottom + padding-bottom */
    border-bottom: none !important;
    padding-bottom: 0 !important;
  }
  /* 蓋掉全域 a[target=_blank]::after 的 ↗ — logo 不需要外連符號 */
  .sponsor-card-logo a::after {
    content: none !important;
  }
  .sponsor-card-logo img {
    display: block;
    width: 100%;
    max-width: 160px;
    height: auto;
    /* 蓋掉 global.css main img 的 object-fit:cover + border-radius:12px
       — logo 要顯示完整，不能裁切，不需圓角 */
    object-fit: contain !important;
    border-radius: 0 !important;
    max-height: none !important;
  }
  .sponsor-card-content {
    flex: 1;
    min-width: 0;
    text-align: left;
  }
  .sponsor-contribution-title {
    font-size: 0.95rem;
    font-weight: 600;
    color: #334155;
    margin-bottom: 0.4rem;
  }
  .sponsor-contribution {
    font-size: 0.85rem;
    color: #64748b;
    line-height: 1.7;
  }
  .tier-perks {
    font-size: 0.78rem;
    color: #94a3b8;
    margin-top: -0.3rem;
    margin-bottom: 0.8rem;
  }
  .logo-placeholder {
    padding: 1.25rem 1.5rem;
    border: 2px dashed #d1d5db;
    border-radius: 8px;
    text-align: center;
    color: #94a3b8;
    font-size: 0.85rem;
    font-style: italic;
  }
  .logo-placeholder.sm {
    padding: 0.75rem 1rem;
  }
  .sponsor-cta {
    text-align: center;
    background: white;
    padding: 2rem;
    border-radius: 16px;
    border: 1px solid #e2e8f0;
  }
  .sponsor-cta h3 {
    margin-bottom: 0.5rem;
  }
  .sponsor-cta p {
    color: #475569;
    margin-bottom: 1rem;
    font-size: 0.95rem;
  }
  .sponsor-contact {
    display: flex;
    gap: 1rem;
    justify-content: center;
    flex-wrap: wrap;
  }
  .sponsor-note {
    font-size: 0.8rem;
    color: #94a3b8;
    margin-top: 1rem;
  }
  .sponsor-note a {
    color: #3b82f6;
  }

  .supporter-link {
    display: inline-block;
    padding: 0.75rem 1.25rem;
    color: #15803d;
    text-decoration: none;
    font-size: 0.95rem;
