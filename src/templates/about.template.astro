<script>
  // 關於頁的兩件小事（2026-11-19）：
  //  1. 追蹤：每一區（data-ga-view）裡還沒標的連結，補上 data-ga-section＝那一區的名字。
  //     時間軸、常見問題等文字是 i18n 的 HTML 字串，連結沒辦法在樣板裡逐一加屬性。
  //     EventTracker 在點擊當下才讀屬性，所以載入後補就來得及。
  //  2. 錨點：連到收合的 <details> 裡面（#tl-…）時，先展開再捲過去。
  function initAboutPage() {
    const page = document.querySelector<HTMLElement>('.about-page');
    if (!page) return;

    page.querySelectorAll<HTMLElement>('[data-ga-view]').forEach((sec) => {
      const name = sec.getAttribute('data-ga-view') || '';
      sec
        .querySelectorAll<HTMLAnchorElement>('a[href]:not([data-ga-section])')
        .forEach((a) => {
          if (a.closest('[data-ga-view]') === sec) {
            a.setAttribute('data-ga-section', name);
          }
        });
    });

    const reduce = () =>
      window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    const reveal = (hash: string, smooth: boolean): boolean => {
      if (!hash || hash.length < 2) return false;
      let el: HTMLElement | null = null;
      try {
        el = document.getElementById(decodeURIComponent(hash.slice(1)));
      } catch {
        return false;
      }
      if (!el || !page.contains(el)) return false;
      let opened = false;
      let d = el.closest('details');
      while (d) {
        if (!d.open) {
          d.open = true;
          opened = true;
        }
        d = d.parentElement ? d.parentElement.closest('details') : null;
      }
      if (el.classList.contains('timeline-item')) {
        page
          .querySelectorAll('.timeline-item.is-target')
          .forEach((x) => x.classList.remove('is-target'));
        el.classList.add('is-target');
      }
      if (opened || smooth) {
        const target = el;
        requestAnimationFrame(() => {
          target.scrollIntoView({
            behavior: smooth && !reduce() ? 'smooth' : 'auto',
            block: 'start',
          });
        });
      }
      return true;
    };

    page.addEventListener('click', (e) => {
      const a = (e.target as HTMLElement).closest<HTMLAnchorElement>(
        'a[href^="#tl-"]',
      );
      if (!a) return;
      const hash = a.getAttribute('href') || '';
      if (reveal(hash, true)) {
        e.preventDefault();
        history.replaceState(null, '', hash);
      }
    });
    window.addEventListener('hashchange', () => reveal(location.hash, false));

    // 帶著 #tl-… 直接進站：展開之後，字體與圖片載入還會把版面往下推，
    // 所以載入完成前後各再對一次位置；讀者自己動了捲軸就不再搶。
    if (location.hash && reveal(location.hash, false)) {
      let userMoved = false;
      const stop = () => {
        userMoved = true;
      };
      ['wheel', 'touchstart', 'keydown', 'pointerdown'].forEach((type) =>
        window.addEventListener(type, stop, { once: true, passive: true }),
      );
      const settle = () => {
        if (userMoved) return;
        let el: HTMLElement | null = null;
        try {
          el = document.getElementById(
            decodeURIComponent(location.hash.slice(1)),
          );
        } catch {
          return;
        }
        if (el) el.scrollIntoView({ behavior: 'auto', block: 'start' });
      };
      window.addEventListener('load', () => {
        settle();
        setTimeout(settle, 400);
        setTimeout(settle, 1200);
      });
      if (document.readyState === 'complete') {
        setTimeout(settle, 400);
        setTimeout(settle, 1200);
      }
    }
  }
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initAboutPage);
  } else {
    initAboutPage();
  }
</script>

