  }
  .portaly-link:hover {
    transform: translateY(-1px);
    box-shadow: 0 4px 14px rgba(21, 128, 61, 0.28);
    background: linear-gradient(135deg, #166534 0%, #14532d 100%);
  }
  .portaly-note {
    font-size: 0.82rem;
    color: #64748b;
    margin: 0.85rem auto 0;
    line-height: 1.65;
    max-width: 32em;
  }
  .supporter-link {
    display: inline-block;
    padding: 0.75rem 1.25rem;
    color: #15803d;
    text-decoration: none;
    font-size: 0.95rem;
    transition: color 0.2s;
  }
  .supporter-link:hover {
    color: #166534;
    text-decoration: underline;
  }

  /* ===== Responsive ===== */
  @media (max-width: 768px) {
    .section-title {
      font-size: 2rem;
    }

    .naming-section .section-title {
      font-size: 2.25rem;
    }

    .naming-grid {
      grid-template-columns: 1fr;
      gap: 1rem;
    }

    .founder-card {
      grid-template-columns: 1fr;
      gap: 2rem;
      justify-items: center;
    }

    .founder-photo {
      position: static;
    }

    .founder-image {
      width: 180px;
      height: 220px;
    }

    .team-grid {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }

    .team-card {
      padding: 2rem;
    }

    .contact-grid {
      grid-template-columns: 1fr;
    }

    .cta-buttons {
      flex-direction: column;
      align-items: center;
    }
    .sponsor-tiers {
      gap: 1.5rem;
    }
    .sponsor-card {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.85rem;
    }
    .sponsor-card-logo {
      flex: 0 0 auto;
      width: 160px;
      max-width: 160px;
      align-self: center;
    }
    .sponsor-contact {
      flex-direction: column;
      align-items: center;
    }

    .vision-block {
      padding: 1.75rem;
    }

    .founder-motivation {
      padding: 1.75rem;
    }

    .highlight-tags {
      justify-content: center;
    }

    .founder-info {
      text-align: center;
    }

    .founder-works ul {
      text-align: left;
    }

    .founder-quote {
      text-align: left;
    }

    .founder-links-inline {
      flex-wrap: wrap;
      justify-content: center;
      margin-top: 1.5rem;
    }

