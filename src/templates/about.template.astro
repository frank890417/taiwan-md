---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import ProticoScript from '../components/ProticoScript.astro';
import SupporterGrid from '../components/SupporterGrid.astro';
import NewsletterSection from '../components/home/NewsletterSection.astro';
import AboutChapterNav from '../components/about/AboutChapterNav.astro';
import AboutBrief from '../components/about/AboutBrief.astro';
import AboutWhy from '../components/about/AboutWhy.astro';
import AboutTrust from '../components/about/AboutTrust.astro';
import AboutMilestones from '../components/about/AboutMilestones.astro';
import type { TimelineEntry } from '../components/about/AboutMilestones.astro';
import { useAboutStrings } from '../components/about/strings';
import {
  getLangFromUrl,
  useTranslations,
  useTranslatedPath,
} from '../i18n/utils';
import { ENABLED_LANGUAGE_CODES } from '../config/languages';
import { categoryList } from '../utils/categoryConfig';
// 2026-06-13 contributors SSOT：grid 改 data-driven，吃 public/api/contributors.json
// 的完整名單（generate-contributors-data.js 從 GitHub /contributors API 每次
// prebuild 刷新）。取代原本 57 個手動硬編碼 card（易漏易過時）。
// 刻意 import JSON 而非 sed 改本檔 — update-stats.sh 註解記載 sed 改本 grid
// 曾破壞鄰近 Sponsors/Contact section 三次，data-driven 一勞永逸避開。
import contributorsData from '../../public/api/contributors.json';
// 2026-06-13 data-driven 統一（哲宇 directive：dashboard 生成器產唯一 SSOT，
// consumer 頁面延伸）。about hero 三個數字全吃 dashboard 資料層的 tracked JSON：
// dashboard-vitals.json（totalArticles + stars + contributors，generate-dashboard-data
// 產，stars soft-fail preserve 永不 None）+ contributors.json（per-person 名單 + totals）。
// 不再 import stats.json — 它由 update-stats.sh 的 gh CLI 產，CI 無 auth 時 set -e 中止
// 留 None，about hero 顯示「0+」的 regression 根因（2026-06-13 修）。
import vitalsData from '../../public/api/dashboard-vitals.json';
// 2026-11-19 關於頁進化：「有人看過」的篇數在 dashboard-organism.json 的
// immune.metrics.humanReviewedCount（同一支 generate-dashboard-data 產）。
import organismData from '../../public/api/dashboard-organism.json';
// 個人支持者人數（收合名單的標題用）；同 SupporterGrid 讀的那一份。
import supportersData from '../../public/api/about-supporters.json';
// MonoLab 官方標誌（2026-11-19 哲宇：團隊卡用 MonoLab 的 logo）。行內輸出，
// 根元素 fill="currentColor"，淺色與深色模式都跟著文字顏色。
import monolabLogo from '../assets/monolab-logo.svg?raw';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
// 新區塊的字串（缺翻譯時先退英文，見 components/about/strings.ts）
const s = useAboutStrings(lang);
const tp = useTranslatedPath(lang);
const _c = contributorsData as {
  allContributors?: Array<{
    login: string;
    avatarUrl: string;
    profileUrl: string;
    types?: string[];
  }>;
  totals?: { contributors?: number };
};
const _v = vitalsData as {
  totalArticles?: number;
  stars?: number;
  contributors?: number;
  humanReviewedPercent?: number;
};
const allContributors = _c.allContributors || [];
const contributorCount =
  _c.totals?.contributors || _v.contributors || allContributors.length;
const totalArticles = _v.totalArticles || 0;
const starCount = _v.stars || 0;

// Section 2.6「再往裡面看一層」— 把解釋這個站怎麼運作的三篇經典 meta 文聚一起。
// 文案走正式 i18n（about.ts 的 about.guide.*，6 語齊全）；icon 與連結語言中性，留在本檔。
// 連結指向 zh-TW canonical：三篇翻完五語後可改走 useTranslatedPath 指向各語版。
const siteGuideCards = [
  {
    icon: '📝',
    href: '/about/文章如何誕生',
    title: t('about.guide.born.title'),
    desc: t('about.guide.born.desc'),
  },
  {
    icon: '📊',
    href: '/about/視覺化模組型錄',
    title: t('about.guide.viz.title'),
    desc: t('about.guide.viz.desc'),
  },
  {
    icon: '🧬',
    href: '/about/taiwan-md',
    title: t('about.guide.meta.title'),
    desc: t('about.guide.meta.desc'),
  },
  {
    icon: '🕰️',
    href: '/about/比國家還大的演算藝術',
    title: t('about.guide.founder.title'),
    desc: t('about.guide.founder.desc'),
  },
];

// ── 2026-11-19 關於頁進化 ─────────────────────────────────────────────
// 「有人看過的文章」：比例來自 dashboard-vitals.json 的 humanReviewedPercent，
// 篇數來自 dashboard-organism.json（沒有就用比例回推）。資料缺席 → null →
// 頁面上不顯示數字（三十秒版與可信度兩處都吃這一組）。
const _reviewPct = _v.humanReviewedPercent;
const reviewedPercent =
  typeof _reviewPct === 'number' && _reviewPct > 0 && totalArticles > 0
    ? _reviewPct
    : null;
const _immune = (
  organismData as {
    organs?: Array<{ id?: string; metrics?: { humanReviewedCount?: number } }>;
  }
).organs?.find((o) => o.id === 'immune')?.metrics;
const reviewedCount =
  reviewedPercent === null
    ? null
    : typeof _immune?.humanReviewedCount === 'number'
      ? _immune.humanReviewedCount
      : Math.round((reviewedPercent / 100) * totalArticles);

// 贊助卡右欄：cta.desc.html 在第一個 <br /> 處分成「短標」與「說明」兩段（文字不變）。
// 沒有 <br /> 的語言（hi／ru）整段放說明，短標那一列留空，按鈕照樣對齊。
const _ctaParts = t('about.sponsors.cta.desc.html').split(/<br\s*\/?>/i);
const ctaLead = _ctaParts.length > 1 ? _ctaParts[0].trim() : '';
const ctaBody = (_ctaParts.length > 1 ? _ctaParts.slice(1) : _ctaParts)
  .join(' ')
  .trim();

// 個人支持者（2026-11-19 哲宇：名字要露在外面）。收合前就列出所有「不匿名」的人，
// 順序跟展開後的 SupporterGrid 一致（依 tier_config 的等級順序，同一級照資料檔順序）；
// 匿名的只在外面說一句「另有 N 位」，完整名單（含匿名與留言）在展開後。
// 判斷一律看 anonymous 欄位，不比對名字。
type _Sup = {
  display_name: string;
  anonymous: boolean;
  tier: { id: string; emoji: string; label: string; label_en: string } | null;
};
const _supData = supportersData as {
  tier_config?: Array<{ id: string }>;
  supporters?: _Sup[];
};
const _supAll = _supData.supporters || [];
const _tierOrder = (_supData.tier_config || []).map((c) => c.id);
const namedSupporters = _tierOrder
  .flatMap((id) => _supAll.filter((x) => x.tier?.id === id))
  .filter((x) => !x.anonymous && x.display_name);
const anonSupporterCount = _supAll.filter((x) => x.anonymous).length;
const supInitial = (name: string) => Array.from(name.trim())[0] || '';
const supTierLabel = (x: _Sup) =>
  x.tier ? (lang === 'zh-TW' ? x.tier.label : x.tier.label_en) : '';

const supporterCount =
  (supportersData as { supporter_count?: number }).supporter_count || 0;

const languageCount = ENABLED_LANGUAGE_CODES.length;
// 「領域」＝內容分類（不含 about 這個講專案自己的分類）
const domainCount = categoryList.filter((c) => c !== 'about').length;

// 站內去處。contribute / dashboard / changelog / graph 13 語都有頁面；
// /semiont/ 只有中文與英文；「關於」分類的長文比照 siteGuideCards 指向中文版。
const hrefContribute = tp('/contribute/');
const hrefDashboard = tp('/dashboard/');
const hrefChangelog = tp('/changelog/');
const hrefGraph = tp('/graph/');
const hrefSemiont = lang === 'en' ? '/en/semiont/' : '/semiont/';
const hrefNewsroom = '/semiont/newsroom/';

// 章節錨點（順序＝頁面順序）
const chapters = [
  { id: 'brief', label: s('about.nav.brief') },
  { id: 'naming', label: s('about.nav.naming') },
  { id: 'team', label: s('about.nav.people') },
  { id: 'why', label: s('about.nav.why') },
  { id: 'trust', label: s('about.nav.trust') },
  { id: 'origin', label: s('about.nav.origin') },
  { id: 'organism', label: s('about.nav.alive') },
  { id: 'sponsors', label: s('about.nav.support') },
  { id: 'faq', label: s('about.nav.faq') },
];

// 時間軸全部條目（順序＝下面完整時間軸的順序）。milestone: true 的預設顯示成
// 里程碑卡；其餘只在比例軸上是一條細線。挑選原則：對外看得見的事。
const timelineEntries: TimelineEntry[] = [
  { key: '2024-2025', date: null },
  { key: '2026-02-03', date: null },
  { key: '2026-03-11', date: '2026-03-11' },
  {
    key: '2026-03-17',
    date: '2026-03-17',
    milestone: true,
    related: {
      href: '/about/緣起故事',
      label: s('about.milestones.related.origin'),
    },
  },
  { key: '2026-03-18-1', date: '2026-03-18' },
  { key: '2026-03-18-2', date: '2026-03-18', milestone: true },
  { key: '2026-03-19', date: '2026-03-19' },
  { key: '2026-03-20', date: '2026-03-20' },
  { key: '2026-03-22', date: '2026-03-22' },
  { key: '2026-03-22b', date: '2026-03-22', milestone: true },
  { key: '2026-03-24', date: '2026-03-24' },
  { key: '2026-03-27', date: '2026-03-27', milestone: true },
  { key: '2026-03-31', date: '2026-03-31' },
  {
    key: '2026-04-03',
    date: '2026-04-03',
    milestone: true,
    related: { href: '/about/taiwan-md', label: t('about.guide.meta.title') },
  },
  { key: '2026-04-08', date: '2026-04-08' },
  { key: '2026-04-19', date: '2026-04-19' },
  {
    key: '2026-05-02',
    date: '2026-05-02',
    milestone: true,
    related: {
      href: '/about/為什麼台灣需要自己的知識庫',
      label: s('about.milestones.related.why'),
    },
  },
  { key: '2026-05-10', date: '2026-05-10' },
  { key: '2026-05-19', date: '2026-05-19', milestone: true },
  { key: '2026-06-01', date: '2026-06-01', milestone: true },
  { key: '2026-06-13', date: '2026-06-13' },
  {
    key: '2026-06-27',
    date: '2026-06-27',
    milestone: true,
    related: {
      href: '/about/比國家還大的演算藝術',
      label: t('about.guide.founder.title'),
    },
  },
  { key: '2026-07-16', date: '2026-07-16' },
  { key: '2026-07-26', date: '2026-07-26', milestone: true },
  { key: '2026-08-11', date: '2026-08-11' },
  { key: '2026-11-07', date: '2026-11-07', milestone: true },
  { key: 'ongoing', date: null },
];
const today = new Date().toISOString().slice(0, 10);
---

<Layout
  lang={lang}
  title={t('about.meta.title')}
  description={t('about.meta.description')}
  readerSettings={true}
>
  <div class="about-page">
    {
      /*
        2026-11-19 關於頁進化（reports/design-homepage-about-implementation-2026-11-19.md §4）
        順序：頭 → 三十秒版 → 名字 → 人 → 為什麼需要 → 可信度 → 誕生（里程碑＋完整時間軸）
              → 是活的 → 支持 → 問答與聯繫（含訂閱）
        既有區塊只搬位置，文字不動；新區塊在 src/components/about/。
        每一區有 data-ga-view="about_*"；頁面類型由 Layout 從網址推成 about。
      */
    }

    {/* 1 頭：為什麼叫 Taiwan.md？ */}
    <section id="story" data-ga-view="about_head">
      <PageHero
        containerWidth="wide"
        padding="compact"
        titleColor="#1a3c34"
        title={t('about.naming.title')}
        subtitle={t('about.naming.subtitle')}
      />
    </section>

    <AboutChapterNav label={s('about.nav.label')} chapters={chapters} />

    {/* 2 三十秒版 */}
    <section id="brief" class="ab-sec ab-sec--brief" data-ga-view="about_brief">
      <div class="section-inner">
        <AboutBrief
          lang={lang}
          totalArticles={totalArticles}
          languageCount={languageCount}
          contributorCount={contributorCount}
          reviewedCount={reviewedCount}
          reviewedPercent={reviewedPercent}
          hrefs={{
            naming: '#naming',
            people: '#team',
            how: '/about/文章如何誕生',
            trust: '#trust',
            contribute: hrefContribute,
          }}
        />
      </div>
    </section>

    {/* 頭的後半：名字的由來（三張卡）＋活的數字＋願景 */}
    <section
      id="naming"
      class="ab-sec ab-sec--naming"
      data-ga-view="about_naming"
    >
      <div class="section-inner">
        <h2 class="section-title" dir="auto">{s('about.naming.heading')}</h2>
        <div class="naming-grid">
          <div class="naming-card">
            <div class="naming-icon">{t('about.naming.tech.icon')}</div>
            <h3>{t('about.naming.tech.title')}</h3>
            <div>
              <code>.md</code> = Markdown
              <p
                style="display:inline"
                set:html={t('about.naming.tech.desc.html')}
              />
            </div>
          </div>
          <div class="naming-card">
            <div class="naming-icon">{t('about.naming.symbol.icon')}</div>
            <h3>{t('about.naming.symbol.title')}</h3>
            <div>
              <code>.md</code>
              <p
                style="display:inline"
                set:html={t('about.naming.symbol.desc.html')}
              />
            </div>
          </div>
          <div class="naming-card">
            <div class="naming-icon">{t('about.naming.lucky.icon')}</div>
            <h3>{t('about.naming.lucky.title')}</h3>
            <p>{t('about.naming.lucky.desc')}</p>
          </div>
        </div>

        <div class="project-stats">
          <div class="stat-item">
            <span class="stat-number">{totalArticles}+</span>
            <span class="stat-label">{t('about.stats.pages.label')}</span>
          </div>
          <div class="stat-item">
            <span class="stat-number">{t('about.stats.countries.number')}</span>
            <span class="stat-label">{t('about.stats.countries.label')}</span>
          </div>
          <div class="stat-item">
            <span class="stat-number">{starCount}+</span>
            <span class="stat-label">{t('about.stats.stars.label')}</span>
          </div>
          <div class="stat-item">
            <span class="stat-number">{contributorCount}+</span>
            <span class="stat-label">{t('about.stats.contributors.label')}</span
            >
          </div>
          <div class="stat-item">
            <span class="stat-number">{t('about.stats.users.number')}</span>
            <span class="stat-label">{t('about.stats.users.label')}</span>
          </div>
        </div>

        {/* Vision */}
        <div class="vision-block">
          <p>{t('about.vision.p1')}</p>
          <p>{t('about.vision.p2')}</p>
          <p class="vision-emphasis" set:html={t('about.vision.p3.html')} />
        </div>
      </div>
    </section>

    {/* 3 人：創辦人與協作團隊 */}
    <section
      class="ab-sec ab-sec--people"
      id="team"
      data-ga-view="about_people"
    >
      <div class="section-inner">
        <h2 class="section-title">{t('about.team.title')}</h2>
        <p class="section-subtitle">{t('about.team.subtitle')}</p>

        <blockquote class="founder-quote standalone-quote">
          {t('about.team.founder.quote')}
          <cite>{t('about.team.founder.quote.cite')}</cite>
        </blockquote>

        <div class="founder-card">
          <div class="founder-photo">
            <img
              src="https://cheyuwu.com/static/img/CheYu-0401-crop.jpg"
              alt={`${t('about.team.founder.name')} ${t('about.team.founder.name.en')}`}
              class="founder-image"
            />
          </div>

          <div class="founder-info">
            <h3>
              {t('about.team.founder.name')}
              <span class="name-en">{t('about.team.founder.name.en')}</span>
            </h3>
            <p class="founder-tagline">{t('about.team.founder.tagline')}</p>

            <div class="founder-bio">
              <p>{t('about.team.founder.bio')}</p>
            </div>

            <div class="founder-links-inline">
              <a href="https://cheyuwu.com" target="_blank" class="link-inline">
                <span class="link-icon">🌐</span>
                <span class="link-text"
                  >{t('about.team.founder.link.website')}</span
                >
              </a>
              <a
                href="https://github.com/frank890417"
                target="_blank"
                class="link-inline"
              >
                <span class="link-icon">💻</span>
                <span class="link-text"
                  >{t('about.team.founder.link.github')}</span
                >
              </a>
              <a
                href="https://instagram.com/cheyuwu345"
                target="_blank"
                class="link-inline"
              >
                <span class="link-icon">📷</span>
                <span class="link-text"
                  >{t('about.team.founder.link.instagram')}</span
                >
              </a>
            </div>
          </div>
        </div>

        <div class="team-grid">
          <div class="team-card">
            <div class="team-icon">{t('about.team.muse.icon')}</div>
            <h3>{t('about.team.muse.name')}</h3>
            <p class="team-role">{t('about.team.muse.role')}</p>
            <div class="team-description">
              <p>{t('about.team.muse.desc')}</p>
            </div>
            <a
              href="https://muse.cheyuwu.com"
              target="_blank"
              class="team-link"
            >
              {t('about.team.muse.link')}
            </a>
          </div>

          <div class="team-card">
            {
              /* MonoLab 官方標誌（src/assets/monolab-logo.svg，填色跟著文字色走） */
            }
            <div
              class="team-icon team-icon--logo"
              role="img"
              aria-label="MonoLab"
              set:html={monolabLogo.replace(
                '<svg ',
                '<svg aria-hidden="true" focusable="false" ',
              )}
            />
            <h3>{t('about.team.monolab.name')}</h3>
            <p class="team-role">{t('about.team.monolab.role')}</p>
            <div class="team-description">
              <p>{t('about.team.monolab.desc')}</p>
            </div>
            <a href="https://monolab.world" target="_blank" class="team-link">
              {t('about.team.monolab.link')}
            </a>
          </div>
        </div>

        {/* 整合貢獻者到協作團隊section */}
        <div class="contributors-in-team">
          <h3>{t('about.team.contributors.title')}</h3>
          <p class="contributors-desc">{t('about.team.contributors.desc')}</p>
          <div class="contributors-grid">
            {
              allContributors.map((c) => (
                <a
                  href={c.profileUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="contributor-card"
                >
                  <img
                    src={c.avatarUrl}
                    alt={c.login}
                    class="contributor-avatar"
                    loading="lazy"
                  />
                  <span class="contributor-name">{c.login}</span>
                  {c.types && c.types.length > 0 && (
                    <span class="contributor-types">{c.types.join(' ')}</span>
                  )}
                </a>
              ))
            }
          </div>
          <p
            class="contributors-cta"
            set:html={t('about.team.contributors.cta.html')}
          />
        </div>
      </div>
    </section>

    {/* 4 為什麼需要：首頁搬來的四張價值卡，說明式版面 */}
    <section id="why" class="ab-sec ab-sec--why" data-ga-view="about_why">
      <div class="section-inner">
        <AboutWhy
          lang={lang}
          languageCount={languageCount}
          domainCount={domainCount}
          graphHref={hrefGraph}
          ssotHref="https://github.com/frank890417/taiwan-md/tree/main/knowledge"
        />
      </div>
    </section>

    {/* 5 可信度 */}
    <section id="trust" class="ab-sec ab-sec--trust" data-ga-view="about_trust">
      <div class="section-inner">
        <h2 class="section-title" dir="auto">{s('about.trust.title')}</h2>
        <p class="section-subtitle" dir="auto">{s('about.trust.subtitle')}</p>
        <AboutTrust
          lang={lang}
          totalArticles={totalArticles}
          reviewedCount={reviewedCount}
          reviewedPercent={reviewedPercent}
          hrefs={{
            dashboard: hrefDashboard,
            changelog: hrefChangelog,
            newsroom: hrefNewsroom,
          }}
        />
      </div>
    </section>

    {/* 6 誕生：里程碑時間線＋完整時間軸（收合，內容留在原始碼裡） */}
    <section
      id="origin"
      class="ab-sec ab-sec--origin"
      data-ga-view="about_origin"
    >
      <div class="section-inner">
        <h2 class="section-title">{t('about.origin.title')}</h2>
        <p class="section-subtitle">{t('about.origin.subtitle')}</p>

        <AboutMilestones lang={lang} entries={timelineEntries} today={today} />

        <details class="timeline-full" id="timeline-full">
          <summary
            class="timeline-full__summary"
            data-ga-section="about_origin"
            data-ga-label="timeline_toggle"
          >
            <span class="timeline-full__label" dir="auto">
              {
                s('about.timeline.full.summary', {
                  count: timelineEntries.length,
                })
              }
            </span>
