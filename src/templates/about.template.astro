  }
  .supporter-link:hover {
    color: #166534;
    text-decoration: underline;
  }

  .portaly-donate {
    margin-top: 1.5rem;
    padding-top: 1.5rem;
    border-top: 1px dashed #e2e8f0;
    text-align: center;
