  .tier-name.bronze,
  .tier-name.community-tier {
    color: #92400e;
  }
  .tier-name.community {
    color: #15803d;
  }
  .tier-desc {
    font-size: 0.85rem;
    color: #64748b;
    margin-bottom: 1rem;
  }
  .tier-logos {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .sponsor-logo-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 1rem 1.5rem;
    background: #f8fafc;
    border: 1px solid #e2e8f0;
