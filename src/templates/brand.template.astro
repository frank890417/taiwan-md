  return `<svg viewBox="${-p} ${-p} ${f(islandW + 2 * p + 560)} ${f(islandH + 2 * p)}" role="img" aria-label="標誌構造圖">
    ${rows.map((r) => `<line x1="${-p}" x2="${islandW + p}" y1="${f(r.y + r.h / 2)}" y2="${f(r.y + r.h / 2)}" stroke="var(--b-line)" stroke-width="2"/>`).join('')}
    ${rows.map((r) => `<rect x="${r.x}" y="${r.y}" width="${r.w}" height="${r.h}" fill="${r.t ? 'var(--b-brand)' : 'var(--b-ink-1)'}"/>`).join('')}
    <line x1="${-p}" x2="${islandW + p + 40}" y1="${f(cy)}" y2="${f(cy)}" stroke="var(--b-brand)" stroke-width="3" stroke-dasharray="14 10"/>
    ${lab(cy + 16, '23.4365°N', 'var(--b-brand)', 52)}
    ${lab(cy + 70, '北迴歸線')}
    ${lab(rows[0].y + 30, `${I.island.bounds.north.toFixed(2)}°N`)}
    ${lab(islandH, `${I.island.bounds.south.toFixed(2)}°N`)}
    ${lab(islandH * 0.22, `${I.spec.lines} 行`)}
    ${lab(islandH * 0.22 + 52, `行粗＝行距 × ${I.spec.weight}`)}
  </svg>`;
})();

