// ── 色彩換算：WCAG 對比與 OKLCH（只為了把數字印在色票上）────────────
const hexRgb = (h: string) => {
  const n = parseInt(h.slice(1), 16);
  return [(n >> 16) & 255, (n >> 8) & 255, n & 255];
};
const lin = (c: number) => {
  c /= 255;
  return c <= 0.04045 ? c / 12.92 : ((c + 0.055) / 1.055) ** 2.4;
};
const lum = (h: string) => {
  const [r, g, b] = hexRgb(h).map(lin);
  return 0.2126 * r + 0.7152 * g + 0.0722 * b;
};
const contrast = (a: string, b: string) => {
  const [x, y] = [lum(a), lum(b)].sort((p, q) => q - p);
  return (x + 0.05) / (y + 0.05);
};
const oklch = (h: string) => {
  const [r, g, b] = hexRgb(h).map(lin);
  const l = Math.cbrt(0.4122214708 * r + 0.5363325363 * g + 0.0514459929 * b);
  const m = Math.cbrt(0.2119034982 * r + 0.6806995451 * g + 0.1073969566 * b);
  const s = Math.cbrt(0.0883024619 * r + 0.2817188376 * g + 0.6299787005 * b);
  const L = 0.2104542553 * l + 0.793617785 * m - 0.0040720468 * s;
  const A = 1.9779984951 * l - 2.428592205 * m + 0.4505937099 * s;
  const B = 0.0259040371 * l + 0.7827717662 * m - 0.808675766 * s;
  const C = Math.hypot(A, B);
  const H = ((Math.atan2(B, A) * 180) / Math.PI + 360) % 360;
  return `${L.toFixed(3)} ${C.toFixed(3)} ${H.toFixed(0)}`;
};
const onColor = (bg: string) =>
  contrast(bg, '#ffffff') > 4.5 ? '#ffffff' : LT['ink-1'];

// ── SVG 小工具 ────────────────────────────────────────────────────────
const f = (n: number) => +n.toFixed(2);
const markSvg = (
  rects: Rect[],
  {
    ink = 'var(--b-ink-1)',
    acc = 'var(--b-brand)',
    pad = 0.12,
    title = 'Taiwan.md 標誌：行島',
  } = {},
) => {
  const p = islandW * pad;
  return `<svg viewBox="${-p} ${-p} ${f(islandW + 2 * p)} ${f(islandH + 2 * p)}" width="${f((islandW + 2 * p) / 10)}" height="${f((islandH + 2 * p) / 10)}" role="img" aria-label="${title}">${rects
    .map(
      (r) =>
        `<rect x="${r.x}" y="${r.y}" width="${r.w}" height="${r.h}" fill="${r.t ? acc : ink}"/>`,
    )
    .join('')}</svg>`;
};
const pixelSvg = (rects: Rect[], size: number, grid = false) =>
  `<svg viewBox="0 0 ${size} ${size}" shape-rendering="crispEdges" role="img" aria-label="${size} 像素版">${rects
    .map(
      (r) =>
        `<rect x="${r.x}" y="${r.y}" width="${r.w}" height="${r.h}" fill="${r.t ? 'var(--b-brand)' : 'var(--b-ink-1)'}"/>`,
    )
    .join('')}${
    grid
      ? `<g stroke="var(--b-line-strong)" stroke-width=".03" opacity=".7">${Array.from(
          { length: size + 1 },
          (_, i) =>
            `<line x1="${i}" x2="${i}" y1="0" y2="${size}"/><line y1="${i}" y2="${i}" x1="0" x2="${size}"/>`,
        ).join('')}</g>`
      : ''
  }</svg>`;
const LK = I.lockup;
const WM = I.wordmark;
const lockupSvg = ({
  zh = false,
  ink = 'var(--b-ink-1)',
  acc = 'var(--b-brand)',
  sub = 'var(--b-ink-2)',
  guides = false,
} = {}) => {
  const c = LK.clear;
  const top = Math.min(LK.markTop, -LK.capHeight) - c;
  const bottom =
    Math.max(
      LK.markTop + LK.markHeight,
      zh ? LK.zhBaseline + LK.capHeight * 0.12 : 0,
    ) + c;
  const width = LK.textX + Math.max(LK.wordWidth, zh ? LK.zhWidth : 0) + c * 2;
  const s = LK.markHeight / islandH;
  const mark = (I.master as Rect[])
    .map(
      (r) =>
        `<rect x="${f(r.x * s)}" y="${f(LK.markTop + r.y * s)}" width="${f(r.w * s)}" height="${f(r.h * s)}" fill="${r.t ? acc : ink}"/>`,
    )
    .join('');
  // 標準字外框只在頁首的 sprite 寫一次，這裡用 <use> 引用，顏色經 CSS 變數傳進去
  const words = `<use href="#b-word" style="--wi:${ink};--wa:${acc}"/>`;
  const zhp = zh ? `<use href="#b-zh" style="--ws:${sub}"/>` : '';
  const g = guides
    ? `<g fill="none" stroke="var(--b-signal)" stroke-width="12" opacity=".85">
        <rect x="${f(-c)}" y="${f(top)}" width="${f(width)}" height="${f(bottom - top)}" stroke-dasharray="36 24"/>
        <line x1="${f(-c)}" x2="${f(width - c)}" y1="0" y2="0"/>
        <line x1="${f(-c)}" x2="${f(width - c)}" y1="${f(-LK.capHeight)}" y2="${f(-LK.capHeight)}"/>
        <line x1="${LK.markWidth}" x2="${LK.markWidth}" y1="${f(top)}" y2="${f(bottom)}"/>
        <line x1="${LK.textX}" x2="${LK.textX}" y1="${f(top)}" y2="${f(bottom)}"/>
      </g>`
    : '';
  return `<svg viewBox="${f(-c)} ${f(top)} ${f(width)} ${f(bottom - top)}" width="${f(width / 10)}" height="${f((bottom - top) / 10)}" role="img" aria-label="Taiwan.md 標誌與標準字組合">${mark}<g transform="translate(${LK.textX} 0)">${words}${zhp}</g>${g}</svg>`;
};
// 標準字單獨展示：基線、x 字高、大寫高三條線
const wordGuideSvg = (() => {
  const cap = WM.capHeight;
  const xh = WM.xHeight;
  const w = WM.width;
  const lab = (y: number, t: string) =>
    `<text x="${w + 110}" y="${f(y + 38)}" font-size="112" fill="var(--b-ink-3)" font-family="IBM Plex Mono, monospace">${t}</text>`;
  const line = (y: number) =>
    `<line x1="-120" x2="${w + 60}" y1="${y}" y2="${y}" stroke="var(--b-line-strong)" stroke-width="3"/>`;
  return `<svg viewBox="-120 -900 ${w + 1240} 1060" role="img" aria-label="標準字的基線、x 字高與大寫高">${line(0)}${line(-xh)}${line(-cap)}<use href="#b-word" style="--wi:var(--b-ink-1);--wa:var(--b-brand)"/>${lab(-cap, `大寫高 ${cap}`)}${lab(-xh, `x 字高 ${xh}`)}${lab(0, '基線 0')}</svg>`;
})();
const ridgeSvg = ({
  stroke = 'var(--b-ink-1)',
  bg = 'var(--b-paper)',
  sw = 4.2,
} = {}) => {
  const pad = islandW * 0.08;
  const lift = islandH * 0.1;
  return `<svg viewBox="${-pad} ${f(-pad - lift)} ${f(islandW + 2 * pad)} ${f(islandH + 2 * pad + lift)}" role="img" aria-label="地形行：台灣本島 ${I.ridge.length} 行依真實高程抬升"><use href="#b-ridge" style="--rs:${stroke};--rb:${bg};--rw:${sw}"/></svg>`;
};
// 地形行與標準字外框各寫一次，頁面其他地方用 <use> 引用（同一份路徑出現十幾次，省下約 400 KB）
const sprite = `<svg width="0" height="0" style="position:absolute" aria-hidden="true"><defs>
<symbol id="b-ridge" overflow="visible">${(I.ridge as any[])
  .map((r) => {
    const last = r.d.match(/([\d.]+) [\d.]+$/)[1];
    const first = r.d.match(/^M([\d.]+)/)[1];
    return `<path d="${r.d}L${last} ${r.base}L${first} ${r.base}Z" style="fill:var(--rb)"/><path d="${r.d}" fill="none" style="stroke:${r.t ? 'var(--b-brand)' : 'var(--rs)'};stroke-width:var(--rw)" stroke-linejoin="round"/>`;
  })
  .join('')}</symbol>
<symbol id="b-word" overflow="visible">${(WM.paths as any[])
  .map(
    (p) =>
      `<path d="${p.d}" style="fill:var(${p.role === 'md' ? '--wa' : '--wi'})"/>`,
  )
  .join('')}</symbol>
<symbol id="b-zh" overflow="visible">${(WM.zh.paths as string[])
  .map((d) => `<path d="${d}" style="fill:var(--ws)"/>`)
  .join('')}</symbol>
</defs></svg>`;
