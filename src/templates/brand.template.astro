 * 圖示來自 src/icons/taiwan-icons.mjs。規範改了，改上游再重建，這頁跟著變。
 * 設計報告：reports/design-identity-system-2026-10-22.md（§十四是 v2.2 的審視與改版）
 */
import Layout from '../layouts/Layout.astro';
