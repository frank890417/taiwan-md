    border-bottom: 1px solid var(--b-line);
  }
  .b-blk-label h3 {
    font-size: 1rem;
    font-weight: 600;
    margin: 0;
    color: var(--b-ink-1);
  }
  .b-blk-label p {
    font-size: 0.86rem;
    line-height: 1.7;
    color: var(--b-ink-3);
    margin: 0.5rem 0 0;
    max-width: 22em;
  }
  .b-blk-body {
    min-width: 0;
  }
  .b-split {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(1.5rem, 3vw, 3rem);
    align-items: start;
  }
  .b-fig {
    border: 1px solid var(--b-line);
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .b-fig-pad {
    padding: clamp(1.25rem, 3vw, 2.5rem);
  }
  .b-fig-pad > :global(svg) {
    width: 100%;
    height: auto;
    max-height: 560px;
  }
  .b-p {
    font-size: 0.95rem;
    line-height: 1.85;
    color: var(--b-ink-2);
    max-width: 42em;
    margin: 1.25rem 0 0;
  }
  .b-small {
    font-size: 0.86rem;
    margin: 0.8rem 0 0;
  }

  /* 規格表：左欄名稱、右欄數值 */
  .b-spec {
    margin: 0;
    display: grid;
    grid-template-columns: 6rem minmax(0, 1fr);
    border-top: 1px solid var(--b-line);
  }
  .b-spec dt,
  .b-spec dd {
    padding: 0.7rem 0;
    border-bottom: 1px solid var(--b-line);
    font-size: 0.9rem;
    line-height: 1.65;
  }
  .b-spec dt {
    color: var(--b-ink-3);
  }
  .b-spec dd {
    margin: 0;
    color: var(--b-ink-1);
  }
  .b-spec-row {
    margin-top: 1.5rem;
  }

  /* 01 */
  .b-sizes {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
  }
  .b-size {
    aspect-ratio: 1;
    padding: 1.5rem;
  }
  .b-size :global(svg) {
    height: 100%;
    width: auto;
  }
  .b-size-px :global(svg) {
    height: 80%;
  }
  .b-actual {
    display: flex;
    align-items: flex-end;
    gap: 1.25rem;
    margin-top: 1.25rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--b-line);
  }
  .b-actual > :global(span) {
    display: block;
    flex: none;
  }
  .b-actual :global(svg) {
    width: 100%;
    height: 100%;
  }
  .b-actual-note {
    margin-left: auto;
    font-family: var(--b-mono);
    font-size: 0.72rem;
    color: var(--b-ink-3);
  }
  .b-monos {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 0.75rem;
  }
  .b-monos figure > div {
    aspect-ratio: 3 / 4;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--b-line);
  }
  .b-monos :global(svg) {
    height: 78%;
    width: auto;
  }

  /* 02 */
  .b-word > :global(svg) {
    max-height: 260px;
  }
  .b-lockups {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.75rem;
  }
  .b-lk {
    border: 1px solid var(--b-line);
    padding: clamp(1.5rem, 3vw, 2.75rem) clamp(1rem, 2.5vw, 2rem);
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .b-lk :global(svg) {
    width: 100%;
    max-width: 400px;
    height: auto;
  }

  /* 03 */
  .b-primaries {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1rem;
  }
  .b-pc-chip {
    aspect-ratio: 4 / 5;
    border: 1px solid var(--b-line);
    position: relative;
    padding: 1rem;
  }
  .b-pc-name {
    font-size: 1.1rem;
    font-weight: 600;
  }
  .b-pc-dark {
    position: absolute;
    right: 0;
    bottom: 0;
    width: 28%;
    aspect-ratio: 1;
    border-top: 1px solid var(--b-line);
    border-left: 1px solid var(--b-line);
  }
  .b-pc-meta {
    margin: 0.8rem 0 0;
    display: grid;
    grid-template-columns: 3.6rem minmax(0, 1fr);
    font-family: var(--b-mono);
    font-size: 0.74rem;
    line-height: 1.75;
  }
  .b-pc-meta dt {
    color: var(--b-ink-3);
  }
  .b-pc-meta dd {
    margin: 0;
    color: var(--b-ink-1);
  }
  .b-pc-use {
    font-size: 0.84rem;
    line-height: 1.6;
    color: var(--b-ink-2);
    margin: 0.6rem 0 0;
  }
  .b-area {
    display: flex;
    height: 56px;
    border: 1px solid var(--b-line);
  }
  .b-area span {
    display: flex;
    align-items: flex-end;
    padding: 0.4rem 0.5rem;
    font-size: 0.75rem;
    min-width: 0;
    overflow: hidden;
  }
  .b-area span + span {
    border-left: 1px solid var(--b-line);
  }
  .b-secondaries {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    column-gap: 2rem;
    border-top: 1px solid var(--b-line);
  }
  .b-sc {
    display: grid;
    grid-template-columns: 44px 1fr auto;
    grid-template-areas: 'chip name hex' 'chip use use';
    column-gap: 0.75rem;
    align-items: center;
    padding: 0.7rem 0;
    border-bottom: 1px solid var(--b-line);
  }
  .b-sc-chip {
    grid-area: chip;
    display: grid;
    grid-template-columns: 1fr 1fr;
    height: 36px;
    border: 1px solid var(--b-line);
  }
  .b-sc-name {
    grid-area: name;
    font-size: 0.9rem;
    font-weight: 600;
  }
  .b-sc code {
    grid-area: hex;
    font-size: 0.74rem;
    color: var(--b-ink-3);
  }
  .b-sc-use {
    grid-area: use;
    font-size: 0.8rem;
    color: var(--b-ink-3);
  }
  .b-pairs {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 0.75rem 1.5rem;
  }
  .b-pair {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0 0;
    row-gap: 0.4rem;
  }
  .b-pair-sample {
    padding: 0.7rem 0.8rem;
    font-size: 1rem;
    font-weight: 500;
    border: 1px solid var(--b-line);
  }
  .b-pair-sample + .b-pair-sample {
    border-left: 0;
  }
  .b-pair-name {
    font-size: 0.72rem !important;
    color: var(--b-ink-3);
  }
  .b-pair-val {
    font-size: 0.72rem !important;
    color: var(--b-ink-1);
    text-align: right;
  }
  .b-cats {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.6rem 1.5rem;
  }
  .b-cat {
    display: grid;
    grid-template-columns: 44px 1fr auto;
    align-items: center;
    gap: 0.7rem;
    font-size: 0.88rem;
  }
  .b-cat code {
    color: var(--b-ink-3);
    font-size: 0.72rem;
  }
  .b-cat-chip {
    display: grid;
    grid-template-columns: 1fr 1fr;
    height: 22px;
  }
  .b-seq-wrap {
    margin-top: 1.75rem;
  }
  .b-seq {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    height: 26px;
    margin-bottom: 0.3rem;
  }

  /* 04 */
  .b-specimen {
    border-top: 1px solid var(--b-line);
    padding: 1rem 0 1.4rem;
  }
  .b-specimen:first-child {
    border-top: 0;
    padding-top: 0;
  }
  .b-specimen-meta {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
    font-family: var(--b-mono);
    font-size: 0.72rem;
    color: var(--b-ink-3);
    margin: 0 0 0.6rem;
  }
  .b-specimen-sample {
    margin: 0;
    line-height: 1.25;
    color: var(--b-ink-1);
    overflow-wrap: anywhere;
  }
  .b-serif-lat {
    font-family: var(--b-lat);
    font-weight: 500;
    font-size: clamp(2rem, 4.4vw, 3.6rem);
    letter-spacing: -0.015em;
  }
  .b-serif-zh {
    font-family: 'Noto Serif TC', serif;
    font-weight: 700;
    font-size: clamp(1.8rem, 3.6vw, 2.8rem);
  }
  .b-sans {
    font-family: 'Noto Sans TC', sans-serif;
    font-weight: 400;
    font-size: clamp(1.15rem, 1.8vw, 1.5rem);
    line-height: 1.6;
  }
  .b-mono-sample {
    font-family: var(--b-mono);
    font-size: clamp(1.1rem, 1.8vw, 1.45rem);
  }
  .b-jf {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem 2rem;
  }
  .b-jf p:not(.b-label) {
    margin: 0;
    line-height: 1.45;
    color: var(--b-ink-1);
  }

  /* 05 */
  .b-gridfig > :global(svg) {
    max-width: 320px;
  }
  .b-icons {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(104px, 1fr));
    border-top: 1px solid var(--b-line);
    border-left: 1px solid var(--b-line);
  }
  .b-icon {
    border-right: 1px solid var(--b-line);
    border-bottom: 1px solid var(--b-line);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.3rem;
    padding: 1rem 0.3rem 0.7rem;
    color: var(--b-ink-1);
  }
  .b-icon:hover {
    color: var(--b-brand);
  }
  .b-icon-zh {
    font-size: 0.8rem;
    color: var(--b-ink-2);
    margin-top: 0.25rem;
  }
  .b-icon code {
    font-size: 0.66rem;
    color: var(--b-ink-3);
  }
  .b-icon-size {
    display: grid;
    grid-template-columns: 2.5rem minmax(0, 1fr) auto;
    align-items: end;
    gap: 1rem;
    padding: 0.8rem 0;
    border-bottom: 1px solid var(--b-line);
  }
  .b-icon-size:first-child {
    border-top: 1px solid var(--b-line);
  }
  .b-icon-size code {
    color: var(--b-ink-3);
  }
  .b-icon-row {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    align-items: flex-end;
    color: var(--b-ink-1);
    min-width: 0;
  }
  .b-icon-use {
    font-size: 0.8rem;
    color: var(--b-ink-3);
  }

  /* 06 */
  .b-states {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
  }
  .b-state {
    aspect-ratio: 1;
    padding: 2rem;
  }
  .b-state:has(use) {
    padding: 1rem;
  }
  .b-state :global(svg) {
    height: 100%;
    width: auto;
  }
  .b-gene {
    display: block;
    width: 100%;
    height: 12px;
    overflow: hidden;
    position: relative;
  }
  .b-gene img {
    position: absolute;
    left: 0;
    top: 50%;
    width: 100%;
    height: auto;
    transform: translateY(-50%) scaleY(400);
    transform-origin: 50% 50%;
    transition: transform 1s;
  }
  .b-gene-item:hover .b-gene img {
    transform: translateY(-38%) scaleY(400);
  }
  .b-gene-lg {
    height: 20px;
  }
  .b-gene-list {
    display: grid;
    gap: 0.75rem;
  }
  .b-gene-item {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 9rem;
    gap: 1rem;
    align-items: center;
    text-decoration: none;
    color: var(--b-ink-1) !important;
  }
  .b-gene-title {
    font-size: 0.88rem;
  }

  /* 07 */
  .b-widths div {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    border: 1px solid var(--b-line);
    padding: 0.55rem 0.7rem;
    margin-bottom: 0.4rem;
    font-size: 0.78rem;
    color: var(--b-ink-3);
  }
  .b-widths code {
    color: var(--b-ink-1);
  }
  .b-voice {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem 2rem;
  }
  .b-voice p {
    margin: 0;
    font-size: 1.05rem;
    line-height: 1.7;
    color: var(--b-ink-1);
  }
  .b-voice div:has(.is-no) p {
    color: var(--b-ink-3);
    text-decoration: line-through;
    text-decoration-color: var(--b-signal);
  }
  .b-label.is-yes {
    color: var(--b-brand);
  }
  .b-label.is-no {
    color: var(--b-signal);
  }

  /* 08 */
  .b-apps {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 2.5rem 1.5rem;
    padding-top: 2.5rem;
  }
  .b-app-wide {
    grid-column: 1 / -1;
  }
  .b-app-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    background: #ffffff;
    border: 1px solid var(--b-line);
    padding: 0.9rem 1.4rem;
    color: #13222a;
  }
  .b-app-lk :global(svg) {
    height: 30px;
    width: auto;
  }
  .b-app-nav {
    display: flex;
    gap: 1.4rem;
    font-size: 0.9rem;
    align-items: center;
  }
  .b-app-og {
    aspect-ratio: 1200 / 630;
    background: #0f1b1f;
    display: grid;
    grid-template-columns: 1.25fr 1fr;
    grid-template-rows: minmax(0, 1fr);
    overflow: hidden;
  }
  .b-app-og > * {
    min-height: 0;
  }
  .b-app-og-text {
    padding: 8% 6%;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    color: #e9f0ee;
  }
  .b-app-og-cat {
    font-size: 0.75rem;
    color: #45c2ab;
    display: flex;
    gap: 0.4rem;
    align-items: center;
  }
  .b-app-og-title {
    font-family: 'Noto Serif TC', serif;
    font-weight: 700;
    font-size: clamp(1.1rem, 2.2vw, 1.7rem);
    line-height: 1.3;
  }
  .b-app-og-lk :global(svg) {
    height: 24px;
    width: auto;
  }
  .b-app-og-ridge {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 6% 6% 0 0;
  }
  .b-app-og-ridge :global(svg) {
    height: 100%;
    width: auto;
  }
  .b-app-card {
    border: 1px solid var(--b-line);
    background: var(--b-paper);
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    padding-bottom: 1.1rem;
  }
  .b-app-card > img {
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
  }
  .b-app-card > .b-gene {
    margin-top: -0.6rem;
    height: 8px;
  }
  .b-app-card-cat,
  .b-app-card-title,
  .b-app-card-meta {
    padding: 0 1.1rem;
  }
  .b-app-card-cat {
    font-size: 0.8rem;
    color: var(--b-ink-3);
    display: flex;
    gap: 0.35rem;
    align-items: center;
  }
  .b-app-card-title {
    font-family: 'Noto Serif TC', serif;
    font-weight: 700;
    font-size: 1.1rem;
    line-height: 1.45;
  }
  .b-app-card-meta {
    font-family: var(--b-mono);
    color: var(--b-ink-3);
    font-size: 0.75rem;
  }
  .b-app-square {
    aspect-ratio: 1;
    background: #ffffff;
    border: 1px solid var(--b-line);
    position: relative;
    overflow: hidden;
    color: #13222a;
  }
  .b-app-square-ridge {
    position: absolute;
    right: -4%;
    top: 4%;
    height: 92%;
  }
  .b-app-square-ridge :global(svg) {
    height: 100%;
    width: auto;
  }
  .b-app-square-title {
    position: absolute;
    left: 7%;
    top: 8%;
    width: 48%;
    font-family: 'Noto Serif TC', serif;
    font-weight: 900;
    font-size: clamp(1.2rem, 2.4vw, 2rem);
    line-height: 1.3;
  }
  .b-app-square-lk {
    position: absolute;
    left: 7%;
    bottom: 7%;
  }
  .b-app-square-lk :global(svg) {
    height: 22px;
    width: auto;
  }
  .b-app-icons {
    border: 1px solid var(--b-line);
    aspect-ratio: 16 / 10;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 1.6rem;
  }
  .b-app-icons img {
    border-radius: 22px;
  }
  .b-app-tab {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    background: var(--b-paper);
    border: 1px solid var(--b-line);
    border-radius: 8px 8px 0 0;
    padding: 0.5rem 1rem;
    font-size: 0.85rem;
  }

  /* 09 */
  .b-rights {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 2rem;
  }
  .b-rights-h {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    font-weight: 600;
    margin: 0 0 0.7rem;
  }
  .b-rights ul {
    margin: 0;
    padding-left: 1.1rem;
    color: var(--b-ink-2);
    font-size: 0.88rem;
    line-height: 1.8;
  }
  .b-forkbar {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    border-top: 1px solid var(--b-line);
    border-bottom: 1px solid var(--b-line);
    padding: 0.6rem 0;
    font-size: 0.88rem;
    color: var(--b-ink-2);
  }
  .b-forkbar-mark {
    width: 12px;
    height: 22px;
    flex: none;
  }
  .b-forkbar-mark :global(svg) {
    width: 100%;
    height: 100%;
  }
  .b-misuse {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1.5rem 1rem;
  }
  .b-mis {
    aspect-ratio: 1;
    border: 1px solid var(--b-line);
    position: relative;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1.25rem;
  }
  .b-mis-x {
    position: absolute;
    top: 0.5rem;
    left: 0.5rem;
    color: var(--b-signal);
  }
  .b-mis-art {
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.4rem;
  }
  .b-mis-art :global(svg) {
    height: 100%;
    width: auto;
  }
  .is-stretch .b-mis-art :global(svg) {
    transform: scaleX(1.7);
  }
  .is-rot .b-mis-art :global(svg) {
    transform: rotate(-24deg);
  }
  .is-round :global(rect) {
    rx: 999px;
  }
  .is-flag .b-mis-art {
    font-size: 1.5rem;
    font-family: var(--b-lat);
    font-weight: 500;
  }
  .is-flag :global(.b-mis-word) {
    font-size: 1.15rem;
  }
  .is-busy {
    background:
      radial-gradient(circle at 30% 30%, #e6a23c 0 18%, transparent 19%),
      radial-gradient(circle at 70% 60%, #6fae5d 0 22%, transparent 23%),
      repeating-linear-gradient(45deg, #c9d8e0 0 8px, #f2e2c4 8px 16px);
  }
  .b-misuse figcaption b {
    display: block;
    margin: 0 0 0.15rem;
  }

  /* 10 */
  .b-dl-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
    gap: 1rem;
  }
  .b-dl {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    text-decoration: none;
    color: var(--b-ink-1) !important;
  }
  .b-dl-thumb {
    height: 110px;
    background: #ffffff;
    border: 1px solid var(--b-line);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0.9rem;
    overflow: hidden;
    color: #13222a;
    transition: border-color 0.2s;
  }
  .b-dl-thumb.is-dark {
    background: #0f1b1f;
  }
  .b-dl-thumb img {
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
  }
  .b-dl:hover .b-dl-thumb {
    border-color: var(--b-brand);
  }
  .b-dl-name {
    font-size: 0.84rem;
    font-weight: 600;
  }
  .b-dl > code {
    font-size: 0.68rem;
    color: var(--b-ink-3);
    word-break: break-all;
  }

  /* 版本與致謝 */
  .b-colophon {
    margin-top: clamp(5rem, 10vw, 8rem);
    padding-top: 1.5rem;
    border-top: 1px solid var(--b-ink-1);
