type Rect = { x: number; y: number; w: number; h: number; t: number };
const I = identity as any;
const LT = I.tokens.modes.light.tokens as Record<string, string>;
const DT = I.tokens.modes.dark.tokens as Record<string, string>;
const islandW: number = I.island.width;
const islandH: number = I.island.height;
