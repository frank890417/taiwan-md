      'taiwanmd-app-icon.svg',
      'taiwanmd-app-icon-512.png',
      'taiwanmd-app-icon-192.png',
      'taiwanmd-app-icon-180.png',
    ],
  },
  {
    title: '地形行與色彩',
    files: [
      'taiwanmd-ridge.svg',
      'taiwanmd-ridge-dark.svg',
      'taiwanmd-tokens.json',
    ],
  },
].map((g) => ({ ...g, files: g.files.filter((d) => downloads.includes(d)) }));
---

<Layout
  lang="zh-TW"
  title="識別手冊"
  description="Taiwan.md 識別手冊：台灣本島依真實高程掃描成十行，北迴歸線那一行用文化部臺灣青。標誌、標準字、色彩、字體、圖示、圖形元素的規格與下載。"
  readerSettings={true}
  pageType="brand"
>
  <link
    rel="stylesheet"
    href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500&family=Newsreader:opsz,wght@6..72,400..600&display=swap"
  />
  <div class="brand-page">
    <Fragment set:html={sprite} />

    <!-- ═══ 封面 ═══ -->
    <header class="b-cover">
      <div class="b-cover-bar">
        <span>Taiwan.md 識別手冊</span>
        <span>v{I.version} · {I.date}</span>
      </div>
      <div class="b-cover-main">
        <div class="b-cover-text">
          <div class="b-cover-lockup" set:html={lockupSvg({ zh: true })} />
          <h1 class="b-cover-title">
            台灣本島依真實高程掃描成 {I.spec.lines} 行，北迴歸線那一行用臺灣青。
          </h1>
        </div>
        <div class="b-cover-ridge" set:html={ridgeSvg({ sw: 3.2 })} />
      </div>
      <nav class="b-index" aria-label="手冊章節">
        {
          chapters.map(([id, name], i) => (
            <a href={`#${id}`}>
              <span class="b-index-no">{String(i + 1).padStart(2, '0')}</span>
              <span>{name}</span>
            </a>
          ))
        }
      </nav>
    </header>

    <div class="b-body">
      <!-- 01 標誌 -->
      <section id="mark" class="b-ch">
        <header class="b-ch-head">
          <span class="b-ch-no">{no('mark')}</span>
          <div>
            <h2>標誌</h2>
            <p class="b-ch-lede">
              行島：台灣本島切成 {I.spec.lines} 條緯線，每一條的兩端是真實的海岸線。
            </p>
          </div>
        </header>

        <div class="b-blk">
          <div class="b-blk-label">
            <h3>構造</h3>
          </div>
          <div class="b-blk-body b-split">
            <figure class="b-fig b-fig-pad" set:html={geoSvg} />
            <dl class="b-spec">
              <dt>資料</dt>
              <dd>
                Tilezen Terrain Tiles z9（約每像素 280
                公尺）。取最大的連通陸地：{islandH} 列 × {islandW} 欄，高寬比 {
                  I.island.aspect
                }。
              </dd>
              <dt>掃描</dt>
              <dd>
                本島高度均分 {I.spec.lines} 行，第 {tropicRow.master} 行的中心釘在北緯
                23.4365°。兩端取該段海岸的中位數，小凹凸不會讓行抖動。
              </dd>
              <dt>北迴歸線</dt>
              <dd>
                經過嘉義與花蓮瑞穗，玉山主峰在北緯約 {
                  peakLat
                }°。整個標誌只有這一行用臺灣青。
              </dd>
              <dt>行</dt>
              <dd>行粗為行距的 {I.spec.weight} 倍，兩端平切。</dd>
              <dt>範圍</dt>
              <dd>
                只畫本島。完整的領土資料在 <a href="/taiwan-shape">台灣形狀</a
                >。
              </dd>
              <dt>原始碼</dt>
              <dd>
                <code>docs/brand/source/</code>
              </dd>
            </dl>
          </div>
        </div>

        <div class="b-blk">
          <div class="b-blk-label">
            <h3>三種尺寸</h3>
            <p>行數隨尺寸減少，北迴歸線永遠在。</p>
          </div>
          <div class="b-blk-body">
            <div class="b-sizes">
              <figure>
                <div class="b-fig b-size" set:html={markSvg(I.master)} />
                <figcaption>
                  <b>{I.spec.lines} 行</b>48 px 以上
                </figcaption>
              </figure>
              <figure>
                <div class="b-fig b-size" set:html={markSvg(I.small)} />
                <figcaption>
                  <b>{I.spec.smallLines} 行</b>20–47 px，也是 island 圖示
                </figcaption>
              </figure>
              <figure>
                <div
                  class="b-fig b-size b-size-px"
                  set:html={pixelSvg(I.px16, 16, true)}
                />
                <figcaption>
                  <b>16 px</b>逐像素手排，第 {tropicRow.px16} 行是北迴歸線
                </figcaption>
              </figure>
            </div>
            <div class="b-actual">
              <span
                set:html={pixelSvg(I.px16, 16)}
                style="width:16px;height:16px"
              />
              <span
                set:html={markSvg(I.small)}
                style="width:24px;height:38px"
              />
              <span
                set:html={markSvg(I.master)}
                style="width:32px;height:54px"
              />
              <span
                set:html={markSvg(I.master)}
                style="width:48px;height:80px"
              />
              <span class="b-actual-note">實際大小 16 · 24 · 32 · 48</span>
            </div>
          </div>
        </div>

        <div class="b-blk">
          <div class="b-blk-label">
            <h3>色彩版本</h3>
            <p>單色時北迴歸線跟著同色，不挖空、不加框。</p>
          </div>
          <div class="b-blk-body">
            <div class="b-monos">
              <figure>
                <div
                  style={`background:${LT.paper}`}
                  set:html={markSvg(I.master, {
                    ink: LT['ink-1'],
                    acc: LT.brand,
                  })}
                />
                <figcaption>標準</figcaption>
              </figure>
              <figure>
                <div
                  style={`background:${DT.paper}`}
                  set:html={markSvg(I.master, {
                    ink: DT['ink-1'],
                    acc: DT.brand,
                  })}
                />
                <figcaption>深底</figcaption>
              </figure>
              <figure>
                <div
                  style={`background:${LT.paper}`}
                  set:html={markSvg(I.master, {
                    ink: LT['ink-1'],
                    acc: LT['ink-1'],
                  })}
                />
                <figcaption>單色</figcaption>
              </figure>
              <figure>
                <div
                  style={`background:${LT['ink-1']}`}
                  set:html={markSvg(I.master, {
                    ink: '#ffffff',
                    acc: '#ffffff',
                  })}
                />
                <figcaption>反白</figcaption>
              </figure>
              <figure>
                <div
                  style={`background:${LT.brand}`}
                  set:html={markSvg(I.master, {
                    ink: '#ffffff',
                    acc: '#ffffff',
                  })}
                />
                <figcaption>臺灣青底（只用於貼紙、旗幟）</figcaption>
              </figure>
            </div>
          </div>
        </div>
      </section>

      <!-- 02 標準字 -->
      <section id="wordmark" class="b-ch">
        <header class="b-ch-head">
          <span class="b-ch-no">{no('wordmark')}</span>
          <div>
            <h2>標準字</h2>
            <p class="b-ch-lede">九個字母用同一套字，.md 只換顏色。</p>
          </div>
        </header>

        <div class="b-blk">
          <div class="b-blk-label">
            <h3>字形</h3>
          </div>
          <div class="b-blk-body">
            <figure class="b-fig b-fig-pad b-word" set:html={wordGuideSvg} />
            <dl class="b-spec b-spec-row">
              <dt>字體</dt>
              <dd>Newsreader，光學尺寸 72，字重 500（OFL）</dd>
              <dt>字距</dt>
              <dd>
                整字收 {Math.abs(WM.kern.track)}／1000 em，字偶照字體內建
              </dd>
              <dt>交付</dt>
              <dd>全部轉成向量外框，不需要對方裝字</dd>
            </dl>
            <p class="b-p">
              Newsreader 是 Production Type 為 Google Fonts
              做的新聞閱讀襯線字，帶光學尺寸軸；標準字取最大的
              72，筆畫對比比內文版本鮮明。用開源字，fork
              的站才能合法重製自己的標準字。
            </p>
          </div>
        </div>

        <div class="b-blk">
          <div class="b-blk-label">
            <h3>組合比例</h3>
            <p>以大寫高 X（T 的高度）為單位，放大縮小都不走樣。</p>
          </div>
          <div class="b-blk-body b-split">
            <figure
              class="b-fig b-fig-pad"
              set:html={lockupSvg({ zh: true, guides: true })}
            />
            <dl class="b-spec">
              <dt>標誌高</dt>
              <dd>{I.spec.markToCap} X，垂直置中於大寫高</dd>
              <dt>標誌到字</dt>
              <dd>{I.spec.gapToCap} X</dd>
              <dt>淨空</dt>
              <dd>四周 {I.spec.clearToCap} X，裡面不放任何東西</dd>
              <dt>中文副標</dt>
              <dd>
                思源黑體 TC 500，字級 {zhSizeX} X，字距 0.14 em，基線在 Taiwan 基線下
                {zhBaseX} X，左緣對齊 T 的墨邊
              </dd>
              <dt>最小</dt>
              <dd>
                組合大寫高 10 px（整組約 {I.spec.minLockupPx} px 高）；更小只用標誌
              </dd>
            </dl>
          </div>
        </div>

        <div class="b-blk">
          <div class="b-blk-label">
            <h3>組合</h3>
            <p>中文副標用在讀者可能不認識 Taiwan.md 的場合。</p>
          </div>
          <div class="b-blk-body">
            <div class="b-lockups">
              <div
                class="b-lk"
                style={`background:${LT.paper}`}
                set:html={lockupSvg({ ink: LT['ink-1'], acc: LT.brand })}
              />
              <div
                class="b-lk"
                style={`background:${DT.paper}`}
                set:html={lockupSvg({ ink: DT['ink-1'], acc: DT.brand })}
              />
              <div
                class="b-lk"
                style={`background:${LT.paper}`}
                set:html={lockupSvg({
                  zh: true,
                  ink: LT['ink-1'],
                  acc: LT.brand,
                  sub: LT['ink-2'],
                })}
              />
              <div
                class="b-lk"
                style={`background:${DT.paper}`}
                set:html={lockupSvg({
                  zh: true,
                  ink: DT['ink-1'],
                  acc: DT.brand,
                  sub: DT['ink-2'],
                })}
              />
            </div>
          </div>
        </div>
      </section>

      <!-- 03 色彩 -->
      <section id="color" class="b-ch">
        <header class="b-ch-head">
          <span class="b-ch-no">{no('color')}</span>
          <div>
            <h2>色彩</h2>
            <p class="b-ch-lede">墨與紙佔版面九成，臺灣青只畫一行。</p>
          </div>
        </header>

        <div class="b-blk">
          <div class="b-blk-label">
            <h3>主色</h3>
          </div>
          <div class="b-blk-body">
            <div class="b-primaries">
              {
                primaries.map((c) => (
                  <div class="b-pc">
                    <div
                      class="b-pc-chip"
                      style={`background:${LT[c.key]};color:${onColor(LT[c.key])}`}
                    >
                      <span class="b-pc-name">{c.name}</span>
                      <span
                        class="b-pc-dark"
                        style={`background:${DT[c.key]}`}
                      />
                    </div>
                    <dl class="b-pc-meta">
                      <dt>HEX</dt>
                      <dd>{LT[c.key]}</dd>
                      <dt>RGB</dt>
                      <dd>{hexRgb(LT[c.key]).join(' ')}</dd>
                      <dt>OKLCH</dt>
                      <dd>{oklch(LT[c.key])}</dd>
                      <dt>深色</dt>
                      <dd>{DT[c.key]}</dd>
                      {c.pms && (
                        <>
                          <dt>PMS</dt>
                          <dd>{c.pms}</dd>
                        </>
                      )}
                    </dl>
                    <p class="b-pc-use">{c.use}</p>
                  </div>
                ))
              }
            </div>
          </div>
        </div>

        <div class="b-blk">
          <div class="b-blk-label">
            <h3>面積</h3>
            <p>綠會被讀成政黨色，原因在面積。臺灣青不超過版面的 10%。</p>
          </div>
          <div class="b-blk-body">
            <div class="b-area">
              {
                area.map((a) => (
                  <span style={`flex:${a.w};background:${a.bg};color:${a.fg}`}>
                    {a.n}
                  </span>
                ))
              }
            </div>
            <p class="b-p">
              臺灣青是文化部「臺灣三顏色」裡的 Formosan Green（Pantone 3295
              C），2007 年由國家文化總會發表，也是 Taiwan.md 一直在用的 .md
              顏色。九重葛取同一組三色裡臺灣紅那一系的洋紅，是常見政黨用色裡沒有人用的色相。
            </p>
          </div>
        </div>

        <div class="b-blk">
          <div class="b-blk-label">
            <h3>輔助色</h3>
            <p>狀態色一定配圖示與文字，不單靠顏色。</p>
          </div>
          <div class="b-blk-body">
            <div class="b-secondaries">
              {
                secondaries.map((c) => (
                  <div class="b-sc">
                    <span class="b-sc-chip">
                      <span style={`background:${LT[c.key]}`} />
                      <span style={`background:${DT[c.key]}`} />
                    </span>
                    <span class="b-sc-name">{c.name}</span>
                    <code>{LT[c.key]}</code>
                    <span class="b-sc-use">{c.use}</span>
                  </div>
                ))
              }
            </div>
          </div>
        </div>

        <div class="b-blk">
          <div class="b-blk-label">
            <h3>對比</h3>
            <p>
              門檻是 WCAG 正文 4.5:1。完整驗證跑
              <code>tokens-audit.mjs</code>，兩個模式全部通過。
            </p>
          </div>
          <div class="b-blk-body">
            <div class="b-pairs">
              {
                pairs.map((p) => (
                  <div class="b-pair">
                    <span
                      class="b-pair-sample"
                      style={`color:${LT[p.fg]};background:${LT[p.bg]}`}
                    >
                      台灣 Aa
                    </span>
                    <span
                      class="b-pair-sample"
                      style={`color:${DT[p.fg]};background:${DT[p.bg]}`}
                    >
                      台灣 Aa
                    </span>
                    <code class="b-pair-name">
                      {p.fg} / {p.bg}
                    </code>
                    <code class="b-pair-val">
                      {p.light.toFixed(1)} · {p.dark.toFixed(1)}
                    </code>
                  </div>
                ))
              }
            </div>
          </div>
        </div>

        <div class="b-blk">
          <div class="b-blk-label">
            <h3>資料用色</h3>
            <p>
              類別色固定順序、不循環。散佈圖與地圖一律加直接標籤，藍鵲藍與苦楝紫在紅綠色盲下分不清。
            </p>
          </div>
          <div class="b-blk-body">
            <div class="b-cats">
              {
                catNames.map((n, i) => (
                  <div class="b-cat">
                    <span class="b-cat-chip">
                      <span style={`background:${catLight[i]}`} />
                      <span style={`background:${catDark[i]}`} />
                    </span>
                    <span>{n}</span>
                    <code>{catLight[i]}</code>
                  </div>
                ))
              }
            </div>
            <div class="b-seq-wrap">
              <span class="b-label">序列 5 階</span>
              <div class="b-seq">
                {seqLight.map((c) => <span style={`background:${c}`} />)}
              </div>
              <div class="b-seq">
                {seqDark.map((c) => <span style={`background:${c}`} />)}
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- 04 字體 -->
      <section id="type" class="b-ch">
        <header class="b-ch-head">
          <span class="b-ch-no">{no('type')}</span>
          <div>
            <h2>字體</h2>
            <p class="b-ch-lede">
              基本字體全部開源；taiwan.md 網站上另用 justfont 贊助的字。
            </p>
          </div>
        </header>

        <div class="b-blk">
          <div class="b-blk-label">
            <h3>基本字體</h3>
            <p>SIL 開源授權，fork 的站零設定就有。中文依教育部標準字形。</p>
          </div>
          <div class="b-blk-body">
            <div class="b-specimen">
              <p class="b-specimen-meta">
                <span>拉丁標題、標準字</span>
                <span>Newsreader · 400–600</span>
              </p>
              <p class="b-specimen-sample b-serif-lat">
                Curated stories of an island
              </p>
            </div>
            <div class="b-specimen">
              <p class="b-specimen-meta">
                <span>中文標題</span>
                <span>Noto Serif TC／思源宋體 · 600–900</span>
              </p>
              <p class="b-specimen-sample b-serif-zh">策展島嶼的深度敘事</p>
            </div>
            <div class="b-specimen">
              <p class="b-specimen-meta">
                <span>介面、內文、中文副標</span>
                <span>Noto Sans TC／思源黑體 · 400–700</span>
              </p>
              <p class="b-specimen-sample b-sans">
                一九八八年，攝影師扛著機器走進雲林的鹽田。
              </p>
            </div>
            <div class="b-specimen">
              <p class="b-specimen-meta">
                <span>數字、腳註、程式碼</span>
                <span>IBM Plex Mono · 400–500</span>
              </p>
              <p class="b-specimen-sample b-mono-sample">
                [^12] 23.4365°N · 3,952 m
              </p>
            </div>
          </div>
        </div>

        <div class="b-blk">
          <div class="b-blk-label">
            <h3>網站用字</h3>
            <p>
              justfont 是 Taiwan.md 的字體贊助商，網頁授權只在 taiwan.md
              網域。每一支都有基本字體備援。
            </p>
          </div>
          <div class="b-blk-body b-jf">
            <div>
              <p class="b-label">內文 · 金萱那提</p>
              <p
                style="font-family:'jf-jinxuanlatte','Noto Sans TC';font-size:1.35rem"
              >
                金萱 2015 年由七千多人群眾募資。
              </p>
            </div>
            <div>
              <p class="b-label">小標 · 蘭陽黑體</p>
              <p
                style="font-family:'jf-lanyanghei','Noto Sans TC';font-size:1.6rem"
              >
                黑體也能寫出詩意
              </p>
            </div>
            <div>
              <p class="b-label">引言 · 蘭陽明體</p>
              <p
                style="font-family:'jf-lanyangming','Noto Serif TC';font-size:1.6rem"
              >
                從宜蘭的水看見字的可能
              </p>
            </div>
            <div>
              <p class="b-label">文章大標 · 日星宋體貳號</p>
              <p
                style="font-family:'rixingsong-semibold','Noto Serif TC';font-size:1.6rem"
              >
                台北太原路的鉛字
              </p>
            </div>
          </div>
        </div>
      </section>

      <!-- 05 圖示 -->
      <section id="icons" class="b-ch">
        <header class="b-ch-head">
          <span class="b-ch-no">{no('icons')}</span>
          <div>
            <h2>圖示</h2>
            <p class="b-ch-lede">
              {iconCount} 支行線圖示：線寬 1.75、平頭、尖角，有面積的地方畫行線不填滿。
            </p>
          </div>
        </header>

        <div class="b-blk">
          <div class="b-blk-label">
            <h3>文法</h3>
          </div>
          <div class="b-blk-body b-split">
            <figure class="b-fig b-fig-pad b-gridfig" set:html={gridDemoSvg} />
            <dl class="b-spec">
              <dt>格線</dt>
              <dd>24 格，圖形留在中間 20 格；座標用整數與 .5。</dd>
              <dt>行線</dt>
              <dd>最多兩條，行距至少 4 格；平行筆畫至少隔 3 格。</dd>
              <dt>台灣</dt>
              <dd>island 由海岸線算出，跟標誌同一套程式。</dd>
              <dt>顏色</dt>
              <dd>一律 currentColor，跟著文字走。</dd>
              <dt>無障礙</dt>
              <dd>裝飾用加 aria-hidden；只有圖示的按鈕才加 aria-label。</dd>
              <dt>名字</dt>
              <dd>英文小寫一個字，上線後不改名。</dd>
            </dl>
          </div>
        </div>

        {
          groups.map(([key, set]) => (
            <div class="b-blk">
              <div class="b-blk-label">
                <h3>{groupMeta[key]}</h3>
                <p>{Object.keys(set).length} 支</p>
              </div>
              <div class="b-blk-body">
                <div class="b-icons">
                  {Object.entries(set).map(([name, label]) => (
                    <div class="b-icon" title={name}>
                      <span set:html={iconSvgInline(name, 28)} />
                      <span class="b-icon-zh">{label}</span>
                      <code>{name}</code>
                    </div>
                  ))}
                </div>
              </div>
            </div>
          ))
        }

        <div class="b-blk">
          <div class="b-blk-label">
            <h3>尺寸</h3>
            <p>
              站上的 emoji 在建站時換成圖示，共 {emojiCount} 個對照；讀者留言與國旗保留原樣。
            </p>
          </div>
          <div class="b-blk-body">
            <div class="b-icon-sizes">
              {
                [16, 20, 24, 32, 48].map((s) => (
                  <div class="b-icon-size">
                    <code>{s}</code>
                    <span class="b-icon-row">
                      {[
                        'island',
                        'temple',
                        'search',
                        'book',
                        'scooter',
                        'lantern',
                      ].map((n) => (
                        <span set:html={iconSvgInline(n, s)} />
                      ))}
                    </span>
                    <span class="b-icon-use">{sizeUse[s]}</span>
                  </div>
                ))
              }
            </div>
          </div>
        </div>
      </section>

      <!-- 06 圖形元素 -->
      <section id="graphics" class="b-ch">
        <header class="b-ch-head">
          <span class="b-ch-no">{no('graphics')}</span>
          <div>
            <h2>圖形元素</h2>
            <p class="b-ch-lede">同一組行平放是標誌，依高程抬起就是地形行。</p>
          </div>
        </header>

        <div class="b-blk">
          <div class="b-blk-label">
            <h3>兩種狀態</h3>
          </div>
          <div class="b-blk-body">
            <div class="b-states">
              <figure>
                <div class="b-fig b-state" set:html={markSvg(I.master)} />
                <figcaption><b>平放</b>標誌，{I.spec.lines} 行</figcaption>
              </figure>
              <figure>
                <div class="b-fig b-state" set:html={ridgeSvg({ sw: 6 })} />
                <figcaption>
                  <b>抬起</b>地形行，{I.ridge.length} 行，每一點的高度取自真實高程
                </figcaption>
              </figure>
            </div>
          </div>
        </div>

        <div class="b-blk">
          <div class="b-blk-label">
            <h3>地形行</h3>
          </div>
          <div class="b-blk-body">
            <dl class="b-spec b-spec-row">
              <dt>用在</dt>
              <dd>首頁與分類的大面、OG 分享圖、孢子方圖、簡報封面</dd>
              <dt>不用在</dt>
              <dd>文章內文；也不當底紋鋪滿整面</dd>
              <dt>抬升</dt>
              <dd>最高點不超過版面高度的 15%</dd>
            </dl>
          </div>
        </div>

        <div class="b-blk">
          <div class="b-blk-label">
            <h3>基因條</h3>
            <p>
              文章卡的封面圖取一列像素拉成色帶，顏色全部來自文章自己。概念來自
              CHEYUWU 2023 規範手冊的基因條。
            </p>
          </div>
          <div class="b-blk-body">
            <div class="b-gene-list">
              {
                genes.map((g) => (
                  <a class="b-gene-item" href={g.href}>
                    <span class="b-gene b-gene-lg">
                      <img src={g.img} alt="" loading="lazy" />
                    </span>
                    <span class="b-gene-title">{g.title}</span>
                  </a>
                ))
              }
            </div>
          </div>
        </div>
      </section>

      <!-- 07 版面與語氣 -->
      <section id="layout" class="b-ch">
        <header class="b-ch-head">
          <span class="b-ch-no">{no('layout')}</span>
          <div>
            <h2>版面與語氣</h2>
            <p class="b-ch-lede">直角、細線、留白；說話像在跟朋友介紹台灣。</p>
          </div>
        </header>

        <div class="b-blk">
          <div class="b-blk-label">
            <h3>版心</h3>
            <p>數值在 <code>src/styles/tokens.css</code>。</p>
          </div>
          <div class="b-blk-body">
            <div class="b-widths">
              <div style="width:57.7%">
                <code>prose 900</code><span>首頁、關於、日記</span>
              </div>
              <div style="width:92.3%">
                <code>article 1440</code><span>文章雙欄</span>
              </div>
              <div style="width:100%">
                <code>wide 1560</code><span>列表、資料、時間軸</span>
              </div>
            </div>
            <dl class="b-spec b-spec-row">
              <dt>間距</dt>
              <dd>1.5 / 2 / 2.5 / 3 / 4 rem 五階</dd>
              <dt>圓角</dt>
              <dd>標誌與行直角；卡片 8 px；標籤 16 px；照片不加</dd>
              <dt>陰影</dt>
              <dd>只給浮在內容上的選單與彈出；卡片用 1 px 線</dd>
            </dl>
          </div>
        </div>

        <div class="b-blk">
          <div class="b-blk-label">
            <h3>語氣</h3>
            <p>可以有立場，但要有證據。書寫節制寫在 MANIFESTO §11。</p>
          </div>
          <div class="b-blk-body">
            <div class="b-voice">
              <div>
                <span class="b-label is-yes">這樣說</span>
                <p>一九八八年，攝影師扛著機器走進雲林的鹽田。</p>
              </div>
              <div>
                <span class="b-label is-no">不這樣說</span>
                <p>歡迎來到美麗的寶島台灣，讓我們一起探索⋯⋯</p>
              </div>
              <div>
                <span class="b-label is-yes">這樣說</span>
                <p>黃魚鴞一對要六公里的溪流才養得活。</p>
              </div>
              <div>
                <span class="b-label is-no">不這樣說</span>
                <p>為打造更美好的知識生態，持續精進中。</p>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- 08 應用 -->
      <section id="apps" class="b-ch">
        <header class="b-ch-head">
          <span class="b-ch-no">{no('apps')}</span>
          <div>
            <h2>應用</h2>
            <p class="b-ch-lede">頁首、分享圖、文章卡、孢子方圖、App 圖示。</p>
          </div>
        </header>
        <div class="b-apps">
          <figure class="b-app-wide">
            <div class="b-app-header">
              <span
                class="b-app-lk"
                set:html={lockupSvg({ ink: LT['ink-1'], acc: LT.brand })}
              />
              <span class="b-app-nav">
                <span>探索</span><span>地圖</span><span>資料室</span><span
                  >生命體</span
                ><span
                  class="b-app-search"
                  set:html={iconSvgInline('search', 18)}
                />
              </span>
            </div>
            <figcaption>網站頁首 · 組合大寫高 13 px</figcaption>
          </figure>
          <figure>
            <div class="b-app-og">
              <div class="b-app-og-text">
                <span class="b-app-og-cat">
                  <span set:html={iconSvgInline('leaf', 16)} /> 自然
                </span>
                <span class="b-app-og-title">黃魚鴞：六公里溪流養一對</span>
                <span
                  class="b-app-og-lk"
                  set:html={lockupSvg({ ink: DT['ink-1'], acc: DT.brand })}
                />
              </div>
              <div
                class="b-app-og-ridge"
                set:html={ridgeSvg({
                  stroke: DT['ink-2'],
                  bg: DT.paper,
                  sw: 5,
                })}
              />
            </div>
            <figcaption>OG 分享圖 1200 × 630</figcaption>
          </figure>
          <figure>
            <div class="b-app-card">
              <img src={genes[0].img} alt="" loading="lazy" />
              <span class="b-gene">
                <img src={genes[0].img} alt="" loading="lazy" />
              </span>
              <span class="b-app-card-cat">
                <span set:html={iconSvgInline('leaf', 14)} /> 自然
              </span>
              <span class="b-app-card-title">
                黃魚鴞：六公里溪流養一對，1,800 公尺烏心石上的夜行猛禽
              </span>
              <span class="b-app-card-meta">[^24] · 13 語</span>
            </div>
            <figcaption>文章卡 · 基因條</figcaption>
          </figure>
          <figure>
            <div class="b-app-square">
              <div
                class="b-app-square-ridge"
                set:html={ridgeSvg({
                  stroke: LT['ink-1'],
                  bg: LT.paper,
                  sw: 5,
                })}
              />
              <span class="b-app-square-title">兩萬家店賣著同一份早餐</span>
              <span
                class="b-app-square-lk"
                set:html={lockupSvg({ ink: LT['ink-1'], acc: LT.brand })}
              />
            </div>
            <figcaption>孢子方圖 1080 × 1080</figcaption>
          </figure>
          <figure>
            <div class="b-app-icons">
              <img
                src="/brand/taiwanmd-app-icon-192.png"
                alt="App 圖示"
                width="96"
                height="96"
              />
              <span class="b-app-tab">
                <span
                  set:html={pixelSvg(I.px16, 16)}
                  style="width:16px;height:16px;display:inline-block"
                />
                識別手冊｜Taiwan.md
              </span>
            </div>
            <figcaption>App 圖示與瀏覽器分頁</figcaption>
          </figure>
        </div>
      </section>

      <!-- 09 使用規範 -->
      <section id="use" class="b-ch">
        <header class="b-ch-head">
          <span class="b-ch-no">{no('use')}</span>
          <div>
            <h2>使用規範</h2>
            <p class="b-ch-lede">
              內容 CC BY-SA 4.0、程式碼 MIT，識別素材一樣開放；Taiwan.md
              這個名字要先問。
            </p>
          </div>
        </header>

        <div class="b-blk">
          <div class="b-blk-label">
            <h3>誰可以怎麼用</h3>
          </div>
          <div class="b-blk-body b-rights">
            <div>
              <p class="b-rights-h">
                <span set:html={iconSvgInline('check', 18)} /> 不用問
              </p>
              <ul>
                <li>報導、評論、教學、研究裡提到 Taiwan.md</li>
                <li>連到 taiwan.md 的按鈕、徽章、簡報頁</li>
                <li>原樣使用下載區的檔案</li>
                <li>行線圖示（MIT）</li>
              </ul>
            </div>
            <div>
              <p class="b-rights-h">
                <span set:html={iconSvgInline('pen', 18)} /> 註明出處
              </p>
              <ul>
                <li>Fork 的站沿用版型、圖示、地形行的產生方式</li>
                <li>用 docs/brand/source/ 替自己的土地生一個行島</li>
                <li>頁尾或 README 寫「Built on Taiwan.md」並連回來</li>
              </ul>
            </div>
            <div>
              <p class="b-rights-h">
                <span set:html={iconSvgInline('ban', 18)} /> 要先問
              </p>
              <ul>
                <li>暗示官方、背書或合作</li>
                <li>商品、募款、選舉或政治宣傳</li>
                <li>修改後仍叫 Taiwan.md</li>
              </ul>
              <p class="b-small">
                <a href="mailto:taiwanmd@monoame.com">taiwanmd@monoame.com</a>
              </p>
            </div>
          </div>
        </div>

        <div class="b-blk">
          <div class="b-blk-label">
            <h3>分支品牌列</h3>
            <p>
              給 fork
              的站放在最上方或頁尾。用自己的行島時，換成那塊土地自己的緯線。
            </p>
          </div>
          <div class="b-blk-body">
            <div class="b-forkbar">
              <span
                class="b-forkbar-mark"
                set:html={markSvg(I.small, { pad: 0.02 })}
              />
              <span>
                Japan.md 是基於 <a href="https://taiwan.md">Taiwan.md</a> 的開源知識庫架構
              </span>
            </div>
          </div>
        </div>

        <div class="b-blk">
          <div class="b-blk-label">
            <h3>錯誤用法</h3>
          </div>
          <div class="b-blk-body">
            <div class="b-misuse">
              {
                misuses.map((m) => (
                  <figure>
                    <div class={`b-mis ${m.cls ?? ''}`}>
                      <span
                        class="b-mis-x"
                        set:html={iconSvgInline('close', 16)}
                      />
                      <span class="b-mis-art" set:html={m.html} />
                    </div>
                    <figcaption>
                      <b>{m.t}</b>
                      {m.d}
                    </figcaption>
                  </figure>
                ))
              }
            </div>
          </div>
        </div>
      </section>

      <!-- 10 下載 -->
      <section id="downloads" class="b-ch">
        <header class="b-ch-head">
          <span class="b-ch-no">{no('downloads')}</span>
          <div>
            <h2>下載</h2>
            <p class="b-ch-lede">
              對外預設給「組合・淺底」與「組合・深底」兩張。SVG 的字都已轉外框。
            </p>
          </div>
        </header>
        {
          dlGroups.map((g) => (
            <div class="b-blk">
              <div class="b-blk-label">
                <h3>{g.title}</h3>
              </div>
              <div class="b-blk-body">
                <div class="b-dl-grid">
                  {g.files.map((d) => (
                    <a class="b-dl" href={`/brand/${d}`} download>
                      <span
                        class={`b-dl-thumb ${/dark|app-icon/.test(d) ? 'is-dark' : ''}`}
                      >
                        {d.endsWith('.json') ? (
                          <code>{'{ }'}</code>
                        ) : (
                          <img src={`/brand/${d}`} alt="" loading="lazy" />
                        )}
                      </span>
                      <span class="b-dl-name">{dlNote[d] ?? d}</span>
                      <code>{d.replace('taiwanmd-', '')}</code>
                    </a>
                  ))}
                </div>
              </div>
            </div>
          ))
        }
      </section>

      <footer class="b-colophon">
        <p class="b-colophon-h">Taiwan.md 識別手冊</p>
        <dl>
          <dt>v2.2 · 2026-10-23</dt>
          <dd>
            標準字改 Newsreader 單一家族、中文副標改思源黑體、標誌改 {
              I.spec.lines
            } 行。
          </dd>
          <dt>v2.0 · 2026-10-22</dt>
          <dd>行島標誌、色彩 tokens 兩模式、行線圖示、本手冊。</dd>
          <dt>v1.0 · 2026-08-25</dt>
          <dd>頁首 logo 第一次抽成可交付資產。</dd>
        </dl>
        <p>
          方法參考成大 ICID 知識庫的識別系統與 CHEYUWU 2023 規範手冊。設計研究：<a
            href={REPORT}
            target="_blank"
            rel="noopener">design-identity-system-2026-10-22</a
          >；原始碼與字體授權：<a
            href={`${REPO}/tree/main/docs/brand`}
            target="_blank"
            rel="noopener">docs/brand/</a
          >。
        </p>
      </footer>
    </div>
  </div>
</Layout>

<style>
  .brand-page {
    --b-paper: #ffffff;
    --b-paper-2: #f3f6f5;
