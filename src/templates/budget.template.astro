---
/**
 * budget.template.astro — /budget「總預算十年」策展頁（12 語共用 template）。
 *
 * 設計報告：reports/design-ly-budget-page-2026-08-17.md（EVOLVE Mode 4）
 * 資料 SSOT：src/data/ly-budget.json（scripts/tools/build-ly-budget.py 生成，單位億元）
 * 圖表：src/components/budget/*（SSR inline SVG + 資料表 fallback，無 D3）
 * 文案：src/i18n/budget.ts（zh-TW / en；其他語言 fallback → en）
 *
 * 八區節奏：一行詩句 kicker → 一句斷言 H2 → 圖 → 兩段。
 * 政治題：立體群像，雙方具名並排，評價詞只在引語內並歸屬說話者。
 */
import { existsSync } from 'node:fs';
import { resolve } from 'node:path';
import '../styles/budget.css';
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import LineChart from '../components/budget/LineChart.astro';
import StackedArea from '../components/budget/StackedArea.astro';
import RankBars from '../components/budget/RankBars.astro';
import SmallMultiples from '../components/budget/SmallMultiples.astro';
import ExecutionBars from '../components/budget/ExecutionBars.astro';
import SlopeChart from '../components/budget/SlopeChart.astro';
import CalendarStrip from '../components/budget/CalendarStrip.astro';
import {
  getLangFromUrl,
  useTranslations,
  useTranslatedPath,
} from '../i18n/utils';
import { getLangSwitchPath } from '../utils/getLangSwitchPath';
import { getArticlesIndex } from '../utils/articles-index';
import ly from '../data/ly-budget.json';
import { fmtYi, fmtPct } from '../utils/budgetViz';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);
const zh = lang === 'zh-TW';
const L = zh ? 'zh' : 'en';
const pick = (o: any) =>
  o && typeof o === 'object' && (o.zh || o.en) ? (o[L] ?? o.en ?? o.zh) : o;

// ── 年度序列 ─────────────────────────────────────────────────────────
// years 含最後一年的預算案（116 年度＝2027，尚未三讀，legal／final 為 null）；
// settled＝已有法定預算數的年度（105–115），英雄區、占比斜率、部會排名、刪減圖都以它為準，
// 只有「預算案」口徑的圖（十年河流、政事別堆疊）才畫到預算案那一年，且圖上標明 basis。
const years = ly.years;
const settled = years.filter((y) => y.legal != null);
const ce = years.map((y) => y.ce);
const ceSettled = settled.map((y) => y.ce);
const fyOf = (c: number) => String(c - 1911);
const latest = settled[settled.length - 1];
const first = years[0];
const fy116 = (ly as any).fy116;
const growth =
  latest.legal && first.legal
    ? ((latest.legal - first.legal) / first.legal) * 100
    : null;
const eras = ly.eras.map((e) => ({
  from: e.from,
  to: e.to,
  label: `${pick(e.president)}｜${pick(e.ly)}`,
  short: pick(e.ly),
  cls: e.cls,
}));
const erasShort = ly.eras.map((e) => ({
  from: e.from,
  to: e.to,
  label: pick(e.ly),
  cls: e.cls,
}));

// ── 政事別 ───────────────────────────────────────────────────────────
const fnCats = ly.functions.map((f, i) => ({
  id: f.id,
  label: pick(f),
  cls: i < 8 ? `bg-cat-${i}` : 'bg-cat-other',
}));
const fnValues = ly.functions.map((f) =>
  ce.map((c) => (ly.functionsByYear as any)[fyOf(c)]?.[f.id] ?? 0),
);
// 政事別占比 105 → 115（slope）：share = v / Σ 同年九類；強調社福／國防／教科文
const fnTotalOf = (fy: string) =>
  Object.values(
    (ly.functionsByYear as any)[fy] as Record<string, number>,
  ).reduce((a, b) => a + b, 0);
const fnSlopeRows = ly.functions.map((f, i) => ({
  id: f.id,
  label: pick(f),
  left:
    (((ly.functionsByYear as any)[fyOf(first.ce)][f.id] ?? 0) /
      fnTotalOf(fyOf(first.ce))) *
    100,
  right:
    (((ly.functionsByYear as any)[fyOf(latest.ce)][f.id] ?? 0) /
      fnTotalOf(fyOf(latest.ce))) *
    100,
  cls: i < 8 ? `bg-cat-${i}` : 'bg-cat-other',
  highlight: ['welfare', 'defense', 'edu'].includes(f.id),
}));
// 四大支出十年成長率：(v115 − v105) / v105；教科文強調（故事是「其中一個」）
const fnGrowthRows = ly.functions
  .filter((f) => ['welfare', 'edu', 'defense', 'econ'].includes(f.id))
  .map((f) => {
    const a = (ly.functionsByYear as any)[fyOf(first.ce)][f.id] as number;
    const b = (ly.functionsByYear as any)[fyOf(latest.ce)][f.id] as number;
    return {
      id: f.id,
      label: pick(f),
      now: ((b - a) / a) * 100,
      highlight: f.id === 'edu',
    };
  })
  .sort((a, b) => b.now - a.now);
// §4 八年窄帶：府會同黨九年（105–113 年度）刪減比例的上下界，從資料算不手抄
const bandVals = settled
  .filter((y) => y.fy <= 113 && y.cutPct != null)
  .map((y) => y.cutPct as number);
const bandLo = Math.min(...bandVals);
const bandHi = Math.max(...bandVals);

// ── 機關別 ───────────────────────────────────────────────────────────
const agMeta = ly.agencies as any[];
const agByYear = ly.agenciesByYear as Record<string, Record<string, number>>;
const yNow = fyOf(latest.ce);
const yThen = fyOf(first.ce);
const rankRows = agMeta
  .filter((a) => agByYear[yNow]?.[a.id] !== undefined && a.id !== 'reserve')
  .map((a) => ({
    id: a.id,
    label: pick(a),
    now: agByYear[yNow][a.id],
    then: agByYear[yThen]?.[a.id] ?? null,
    highlight: !!a.highlight,
    note: a.note ? pick(a.note) : undefined,
  }))
  .sort((a, b) => b.now - a.now);
const rankTop = rankRows.slice(0, 22);
// 小倍數：105 與 115 都有值的機關，index 105=100，取 115 年度最大的 16 個
const multiPanels = agMeta
  .filter(
    (a) =>
      agByYear[yThen]?.[a.id] && agByYear[yNow]?.[a.id] && a.id !== 'reserve',
  )
  .map((a) => {
    const base = agByYear[yThen][a.id];
    const values = ceSettled.map((c) => {
      const v = agByYear[fyOf(c)]?.[a.id];
      return v === undefined ? null : (v / base) * 100;
    });
    const last = agByYear[yNow][a.id];
    return {
      id: a.id,
      label: pick(a),
      values,
      endText: fmtPct(((last - base) / base) * 100, 0),
      highlight: !!a.highlight,
      note: a.note ? pick(a.note) : undefined,
      _now: last,
    };
  })
  .sort((a, b) => b._now - a._now)
  .filter((p, i, arr) => i < 15 || p.highlight)
  .slice(0, 16);

// ── 執行率 ───────────────────────────────────────────────────────────
// 有追加預算並已三讀的年度（114），分母＝法定＋追加（legalWithSupp），否則決算會超過「法定」而讀成超支
const execRows = settled.map((y: any) => ({
  label: String(y.ce),
  budget: (y.legalWithSupp ?? y.legal) as number,
  actual: y.final ?? null,
  rate: y.execRate ?? null,
}));

// ── 事件／刪凍／文化／聲音 ────────────────────────────────────────────
const events = [...ly.events].sort((a, b) => a.date.localeCompare(b.date));
const cuts114 = (ly.cuts as any)['114'];
const cuts115 = (ly.cuts as any)['115'];
const culture = ly.culture as any;
const voices = ly.voices as any;
const defense = ly.defenseNato2026 as any;
const special = ly.specialBudgets as any[];
const days = ly.days as any[];
const sources = (ly.meta as any).sources as any[];

// ── 延伸閱讀（存在才連；跨語走 lang-switch registry；另開分頁）───────
// 每一區底下一排站內相關文章 chip。zh 路徑當 key，其他語言用 lang-switch registry 找對應譯文，
// 沒譯文就退回 zh 頁；標題從該語言的 articles index 取。knowledge/ 檔不存在就不出現（例：文策院尚未推上 origin）。
type RelCard = { href: string; title: string; desc: string };
const _idx = await getArticlesIndex(lang);
const _idxZh = lang === 'zh-TW' ? _idx : await getArticlesIndex('zh-TW');
async function related(
  catDir: string,
  zhSlug: string,
): Promise<RelCard | null> {
  if (!existsSync(resolve(process.cwd(), 'knowledge', catDir, `${zhSlug}.md`)))
    return null;
  const cat = catDir.toLowerCase();
  const zhPath = `/${cat}/${zhSlug}`;
  const zhEntry = (_idxZh.get(cat) || []).find((a) => a.slug === zhSlug);
  let href = zhPath;
  let entry = zhEntry;
  try {
    const r = await getLangSwitchPath(zhPath);
    const e = (r.langs as any)[lang];
    if (e?.has && e.link) {
      href = e.link;
      const slug = decodeURIComponent(
        e.link.replace(/\/$/, '').split('/').pop() || '',
      );
      entry = (_idx.get(cat) || []).find((a) => a.slug === slug) || zhEntry;
    }
  } catch {
    /* registry 讀不到就退回 zh */
  }
  const full = entry?.title || zhSlug;
  // chip 只顯示主標（冒號前），完整標題與 description 放 title 屬性
  return {
    href,
    title: full.split(/[：:—–]/)[0].trim() || full,
    desc: `${full}${entry?.description ? ' — ' + entry.description : ''}`,
  };
}
async function relatedList(items: [string, string][]): Promise<RelCard[]> {
  const out = await Promise.all(items.map(([c, s]) => related(c, s)));
  return out.filter((x): x is RelCard => !!x);
}
const REL = {
  s0: await relatedList([
    ['Society', '台灣政治環境與選舉制度'],
    ['Technology', '開源社群與g0v'],
    ['Society', '公共政策網路參與平臺'],
  ]),
  s1: await relatedList([
    ['Economy', '發票'],
    ['Lifestyle', '台灣醫療與全民健保'],
  ]),
  s2: await relatedList([
    ['Society', '台灣長期照顧制度發展'],
    ['Society', '台灣少子化危機'],
    ['Lifestyle', '台灣醫療與全民健保'],
    ['Society', '台灣國防與軍事現代化'],
    ['Society', '台灣高等教育擴張與退場'],
  ]),
  s3: await relatedList([
    ['Society', '台灣邦交國與國際外交'],
    ['Society', '台灣體育發展與奧運'],
    ['Economy', '台灣農業現代化發展'],
    ['Lifestyle', '台灣的公車系統'],
    ['Society', '國宅與居住正義'],
  ]),
  s4: await relatedList([
    ['History', '大罷免'],
    ['Politics', '2026 九合一選舉'],
    ['Society', '台灣政治環境與選舉制度'],
  ]),
  s5: await relatedList([
    ['Society', '公視'],
    ['Economy', '文化內容策進院'],
    ['Society', '台灣媒體與新聞自由'],
    ['Society', '報導者'],
    ['History', '國家人權博物館'],
    ['History', '台灣轉型正義'],
    ['Society', '台灣設計研究院'],
  ]),
  s6: await relatedList([
    ['Technology', '雪山隧道'],
    ['Lifestyle', '台灣的公車系統'],
    ['Society', '台灣國防與軍事現代化'],
  ]),
  s7: await relatedList([
    ['Economy', '文化內容策進院'],
    ['Society', '公視'],
    ['History', '大罷免'],
    ['Society', '台灣政治環境與選舉制度'],
  ]),
};

const passedDate = cuts115.date as string;
const toc = [0, 1, 2, 3, 4, 5, 6, 7].map((n) => ({
  id: `s${n}`,
  label: t(`budget.toc.s${n}` as any),
  take: t(`budget.toc.s${n}.take` as any),
}));

// §5 日曆條：115 年度從院會通過到三讀。節點從 events（fy 115）依關鍵字取，取不到就不畫；年度開始＝曆年制 1/1。
const ev115 = events.filter((e) => e.fy === 115 || e.kind === 'pass');
const findEv = (re: RegExp, kind?: string) =>
  ev115.find((e) => (kind ? e.kind === kind : true) && re.test(e.zh));
const calMarkers = (
  [
    [findEv(/院會通過/), t('budget.s5.cal.approved'), 'plain'],
    [findEv(/送達立法院/), t('budget.s5.cal.sent'), 'plain'],
    [findEv(/預算法第 51 條期限/, 'key'), t('budget.s5.cal.deadline'), 'key'],
    [{ date: `${latest.ce}-01-01` }, t('budget.s5.cal.fystart'), 'plain'],
    [findEv(/交付委員會/), t('budget.s5.cal.referred'), 'plain'],
    [
      ev115.find((e) => e.kind === 'pass' && e.fy === 115),
      t('budget.s5.cal.passed'),
      'pass',
    ],
  ] as [any, string, 'plain' | 'key' | 'pass'][]
)
  .filter(([e]) => !!e)
  .map(([e, label, kind]) => ({ date: e.date as string, label, kind }));
const calStart = calMarkers.length
  ? calMarkers
      .map((m) => m.date)
      .sort()[0]
      .slice(0, 7) + '-01'
  : `${latest.ce - 1}-08-01`;
// 軸尾留 16 天呼吸，三讀標籤不貼邊；天數 bar 仍以三讀日為錨
const calEnd = new Date(Date.parse(`${passedDate}T00:00:00Z`) + 16 * 86400000)
  .toISOString()
  .slice(0, 10);
const calSpans = days.map((d) => ({
  days: d.n as number,
  label: pick(d.who) as string,
  quote: pick(d) as string,
}));
const kindLabel = (k: string) =>
  k === 'cut'
    ? t('budget.s4.kind.cut')
    : k === 'freeze'
      ? t('budget.s4.kind.freeze')
      : t('budget.s4.kind.kept');
const kindCls = (k: string) =>
  k === 'cut' ? 'is-cut' : k === 'freeze' ? 'is-freeze' : 'is-kept';
---

<Layout
  lang={lang}
  title={t('budget.meta.title')}
  description={t('budget.meta.description')}
  readerSettings={true}
>
  <main class="budget-page min-h-screen">
    <PageHero
      eyebrow={t('budget.hero.eyebrow')}
      title={t('budget.hero.title')}
      subtitle={t('budget.hero.subtitle')}
      titleSize="clamp"
      containerWidth="wide"
    >
      <blockquote class="bp-kicker bp-hero-verse">
        {t('budget.hero.verse')}
      </blockquote>
      <div class="bp-hero-stats">
        <div class="bp-stat">
          <div class="bp-stat-v">{fmtYi(latest.legal, lang)}</div>
          <div class="bp-stat-l">{t('budget.hero.stat.legal')}</div>
        </div>
        <div class="bp-stat is-warm">
          <div class="bp-stat-v">{passedDate}</div>
          <div class="bp-stat-l">
            {t('budget.hero.stat.passed')} · {t('budget.hero.stat.passed.sub')}
          </div>
        </div>
        <div class="bp-stat is-warm">
          <div class="bp-stat-v">
            {fmtYi(cuts115.cut, lang)}<small
              >{fmtPct(-cuts115.cut_pct, 2)}</small>
          </div>
          <div class="bp-stat-l">
            {t('budget.hero.stat.cut')} · {t('budget.hero.stat.cut.sub')}
          </div>
        </div>
        <div class="bp-stat is-cool">
          <div class="bp-stat-v">
            {growth === null ? '—' : fmtPct(growth, 0)}
          </div>
          <div class="bp-stat-l">
            {t('budget.hero.stat.growth')} · {t('budget.hero.stat.growth.sub')}
          </div>
        </div>
      </div>
      <!-- 116 年度預算案：已送立法院、尚未三讀。數字在內文，這裡只放狀態，避免英雄區的法定數與預算案數混讀 -->
      <p class="bp-hero-next">
        <b>{t('budget.hero.fy116.k')}</b>
        {t('budget.hero.fy116')}
        {
          fy116?.sources?.[0] && (
            <a
              class="bp-src no-external-icon"
              aria-label="source"
              href={fy116.sources[0]}
              target="_blank"
              rel="noopener"
            >
              ↗
            </a>
          )
        }
      </p>
      <!-- 三分鐘版：八句 takeaway，每句都是跳轉連結（資訊結構案 A：結論先行，流程仍在 §0） -->
      <nav class="bp-brief" aria-label={t('budget.hero.jump')}>
        <h2 class="bp-brief-h">{t('budget.hero.brief')}</h2>
        <ol class="bp-brief-list">
          {
            toc.map((s, i) => (
              <li>
                <a href={`#${s.id}`}>
                  <span class="bp-brief-n">{i}</span>
                  <span class="bp-brief-body">
                    <span class="bp-brief-label">{s.label}</span>
                    <span class="bp-brief-take">{s.take}</span>
                  </span>
                </a>
              </li>
            ))
          }
        </ol>
      </nav>
    </PageHero>

    <!-- 黏頂子導覽：純 anchor；JS 只加 scroll-spy 高亮 -->
    <nav class="bp-subnav" aria-label={t('budget.subnav.label')} id="bp-subnav">
      <div class="bp-subnav-in">
        {
          toc.map((s) => (
            <a href={`#${s.id}`} data-target={s.id}>
              {s.label}
            </a>
          ))
        }
      </div>
    </nav>

    <!-- §0 預算怎麼過（流程資訊圖表） -->
    <section class="bp-section" id="s0">
      <div class="bp-wrap">
        <blockquote class="bp-kicker">{t('budget.s0.kicker')}</blockquote>
        <h2 class="bp-h2">{t('budget.s0.h2')}</h2>
        <p class="bp-lede">{t('budget.s0.lede')}</p>
        <!-- 七站總覽：手機讀者先看到全貌，再往下讀七張卡（三色＝立法院審議前／中／後） -->
        <ol class="bp-flow-strip" aria-label={t('budget.s0.overview')}>
          {
            [1, 2, 3, 4, 5, 6, 7].map((n) => (
              <li
                class={
                  n <= 4 ? 'is-before' : n === 5 ? 'is-during' : 'is-after'
                }
              >
                <a href={`#flow-${n}`}>
                  <b>{n}</b> {t(`budget.s0.step${n}.title` as any)}
                </a>
              </li>
            ))
          }
        </ol>
        <ol class="bp-flow" aria-label={t('budget.s0.h2')}>
          {
            [1, 2, 3, 4, 5, 6, 7].map((n) => (
              <li
                class={`bp-flow-step ${n <= 4 ? 'is-before' : n === 5 ? 'is-during' : 'is-after'}`}
                id={`flow-${n}`}
              >
                <div class="bp-flow-num">{n}</div>
                <h3 class="bp-flow-title">
                  {t(`budget.s0.step${n}.title` as any)}
                </h3>
                <dl class="bp-flow-meta">
                  <div>
                    <dt>{t('budget.s0.col.actor')}</dt>
                    <dd>{t(`budget.s0.step${n}.actor` as any)}</dd>
                  </div>
                  <div>
                    <dt>{t('budget.s0.col.when')}</dt>
                    <dd>{t(`budget.s0.step${n}.when` as any)}</dd>
                  </div>
                </dl>
                <p class="bp-flow-what">
                  {t(`budget.s0.step${n}.what` as any)}
                </p>
                <p class="bp-flow-law">{t(`budget.s0.step${n}.law` as any)}</p>
                <p class="bp-flow-actual">
                  <span class="bp-flow-actual-k">
                    {t('budget.s0.col.actual')}
                  </span>
                  {t(`budget.s0.step${n}.actual` as any)}
                </p>
              </li>
            ))
          }
        </ol>
        <p class="bp-note">{t('budget.s0.note')}</p>
        {
          REL.s0.length > 0 && (
            <div class="bp-related is-inline">
              <span class="bp-related-k">{t('budget.s7.related.h')}</span>
              {REL.s0.map((r) => (
                <a href={r.href} target="_blank" rel="noopener" title={r.desc}>
                  {r.title}
                </a>
              ))}
            </div>
          )
        }
      </div>
    </section>

    <!-- §1 十年河流 -->
    <section class="bp-section" id="s1">
      <div class="bp-wrap">
        <blockquote class="bp-kicker">{t('budget.s1.kicker')}</blockquote>
        <h2 class="bp-h2">{t('budget.s1.h2')}</h2>
        <p class="bp-lede">{t('budget.s1.lede')}</p>
        <LineChart
          id="c-river"
          title={t('budget.s1.chart.title')}
          years={ce}
          lang={lang}
          eras={eras}
          series={[
            {
              id: 'proposed',
              label: t('budget.s1.series.proposed'),
              values: years.map((y) => y.proposed),
              cls: 'bg-mute',
              dashed: true,
            },
            {
              id: 'legal',
              label: t('budget.s1.series.legal'),
              values: years.map((y) => y.legal),
              cls: 'bg-s0',
            },
            {
              id: 'final',
              label: t('budget.s1.series.final'),
              values: years.map((y) => y.final),
              cls: 'bg-s1',
            },
          ]}
          gapBand={{
            upper: 'proposed',
            lower: 'legal',
            label: t('budget.s1.chart.gap'),
          }}
