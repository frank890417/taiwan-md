---
/**
 * category-hub.template.astro — 統一 [category]/index.astro template (6 langs 共用)
 *
 * 為什麼：6 個 [category]/index.astro 從 943~3006 行（總 ~9280 行）高度重複，
 * 各 lang copy-paste 了相同 hub layout / top picks / subcategory grouping 邏輯。
 * unification 預估 -82% 行數 + 消除 6 處改一個 pattern 的維護負擔。
 *
 * 對照 article.template.astro：
 *   src/pages/[category]/index.astro                  → thin wrapper getStaticPaths
 *   src/pages/{lang}/[category]/index.astro × 5       → thin wrappers
 *   src/templates/category-hub.template.astro (本檔)  → 全部 UI 邏輯
 *
 * 中文 zh-TW 是 SSOT canonical（含 Economy 特殊 dashboard 等 zh-only feature，
 * 條件 render 在 lang === 'zh-TW' && category === 'economy' 時才 load）。
 *
 * 2026-05-03 sleepy-colden P1 follow-up unification（在 article.template.astro 之後）。
 */
import { marked } from 'marked';
import Layout from '../layouts/Layout.astro';
import ArticleCard from '../components/ArticleCard.astro';
import FoodViz from '../components/FoodViz.astro';
import EconCharts from '../components/EconCharts.astro';
import { useTranslations } from '../i18n/utils';
import {
  categoryList as categories,
  getCategoryConfigs,
  type CategoryKey,
} from '../utils/categoryConfig';
import type { Lang } from '../config/languages';
import type { SubcategoryGroup } from '../utils/category-static-paths';
import subcatJson from '../data/subcategory-i18n.json';

interface ArticleSummary {
  slug: string;
  title: string;
  description: string;
  status: string;
  readingTime: number | null;
  date: string | null;
  featured: boolean;
  tags: string[];
  lang: string;
  image: string | null;
  imageAlt: string;
  imageCredit: string;
  subcategory: string;
  footnotes: number;
}

interface Props {
  category: string;
  hubContent: string;
  topPicks: ArticleSummary[];
  articles: ArticleSummary[];
  groups: SubcategoryGroup[];
  // categoryUpdated/essayMinutes: wired through for a later task (category
  // "last updated" badge + hub essay reading-time badge) — not consumed by
  // this pass yet.
  categoryUpdated: string | null;
  essayMinutes: number | null;
  lang: Lang;
}

const {
  category,
  hubContent,
  articles,
  topPicks,
  groups,
  categoryUpdated,
  essayMinutes,
  lang,
} = Astro.props;

// ── Lang-derived URL prefix (for cross-page links) ────────────────────────────
// zh-TW: '' (root URL convention)
// non-zh: '/{lang}' prefix
const langUrlPrefix = lang === 'zh-TW' ? '' : `/${lang}`;

// Load economic data for economy category
let taiexData: any[] = [];
let cpiData: any[] = [];
let salaryData: any[] = [];
let housingData: any[] = [];
// Economy dashboard 只在 zh-TW 顯示（Economy 系列數據是 zh-only feature；
// 其他 lang 沒對應翻譯資料源）。其他 lang 看到一般 hub markdown。
if (category === 'economy' && lang === 'zh-TW') {
  const [taiexJson, cpiJson, salaryJson, housingJson] = await Promise.all([
    import('../data/taiex-yearly.json'),
    import('../data/taiwan-cpi.json'),
    import('../data/taiwan-salary.json'),
    import('../data/taiwan-housing.json'),
  ]);
  taiexData = taiexJson.data;
  cpiData = cpiJson.data;
  salaryData = salaryJson.data;
  housingData = housingJson.data;
}

function resolveWikilinks(md: string, currentCategory: string) {
  if (!md) return md;

  function resolveOne(target: string, display?: string, bold = false) {
    const label = display || target;
    if (target.startsWith('_')) {
      const catName = target
        .replace(/^_/, '')
        .replace(/ Hub$/, '')
        .toLowerCase();
      return bold
        ? `<a class="topic-pill" href="${langUrlPrefix}/${catName}"><strong>${label}</strong></a>`
        : `<a class="topic-pill" href="${langUrlPrefix}/${catName}">${label}</a>`;
    }
    const matchArticle = articles.find(
      (a: any) =>
        a.title === target ||
        a.slug === target ||
        a.slug === encodeURIComponent(target),
    );
    if (matchArticle) {
      const url = `/${currentCategory}/${matchArticle.slug}`;
      return bold
        ? `<a class="topic-pill" href="${url}"><strong>${label}</strong></a>`
        : `<a class="topic-pill" href="${url}">${label}</a>`;
    }
    return bold ? `**${label}**` : label;
  }

  // First pass: **[[X]]** → [**resolved**](/url) (bold inside link for marked CJK compat)
  md = md.replace(
    /\*\*\[\[([^\]|]+?)(?:\|([^\]]+?))?\]\]\*\*/g,
    (_, target, display) => resolveOne(target, display, true),
  );
  // Second pass: remaining [[X]]
  md = md.replace(/\[\[([^\]|]+?)(?:\|([^\]]+?))?\]\]/g, (_, target, display) =>
    resolveOne(target, display),
  );
  return md;
}

const resolvedContent = hubContent
  ? resolveWikilinks(hubContent, category)
  : '';

// Build set of article URLs for topic-pill detection
const articleUrlSet = new Set(
  articles.map((a: any) => `/${category}/${a.slug}`),
);
// Also add cross-category hub URLs
const categoryKeys = Object.keys({
  history: 1,
  geography: 1,
  culture: 1,
  food: 1,
  art: 1,
  music: 1,
  technology: 1,
  nature: 1,
  people: 1,
  society: 1,
  economy: 1,
  lifestyle: 1,
  politics: 1,
});

// Broken image fallback + topic-pill link for hub pages
const hubRenderer = new marked.Renderer();
hubRenderer.image = ({ href, title, text }) => {
  const titleAttr = title ? ` title="${title}"` : '';
  const altText = text || '';
  return `<img src="${href}" alt="${altText}"${titleAttr} loading="lazy" onerror="this.onerror=null;this.classList.add('img-broken')" />`;
};
hubRenderer.link = ({ href, title, text }) => {
  const titleAttr = title ? ` title="${title}"` : '';
  const h = href || '';
  // Check if link points to an article or a hub category page
  const isArticleLink = articleUrlSet.has(decodeURIComponent(h));
  const isCategoryLink = categoryKeys.some(
    (k) => h === `/${k}` || h === `/${k}/`,
  );
  if (isArticleLink || isCategoryLink) {
    return `<a class="topic-pill" href="${h}"${titleAttr}>${text}</a>`;
  }
  return `<a href="${h}"${titleAttr}>${text}</a>`;
};
const rawHubHtml = resolvedContent
  ? marked.parse(resolvedContent, { renderer: hubRenderer, breaks: true })
  : '';

// Post-process: add callout/pull-quote classes to blockquotes
function enrichBlockquotes(html: string): string {
  if (!html) return html;
  const calloutMap: Record<string, string> = {
    '📝': 'callout-note',
    '⚠️': 'callout-warning',
    '💡': 'callout-tip',
    '📊': 'callout-data',
  };
  return (html as string).replace(
    /<blockquote>([\s\S]*?)<\/blockquote>/g,
    (match, inner) => {
      // Pull quote: contains ✦
      if (inner.includes('✦')) {
        return `<blockquote class="pull-quote">${inner}</blockquote>`;
      }
      // Callout: starts with emoji + bold
      for (const [emoji, cls] of Object.entries(calloutMap)) {
        if (inner.includes(emoji) && inner.includes('<strong>')) {
          return `<blockquote class="${cls}">${inner}</blockquote>`;
        }
      }
      return match;
    },
  );
}
const hubHtml = enrichBlockquotes(rawHubHtml as string);

// Split hub HTML into a short "hook" (shown in the header bar) and the full
// essay body. The two MUST be disjoint — the essay section below renders
// hubFull (essay minus hook), not hubHtml — otherwise the reader sees the
// opening paragraphs twice (2026-07-10 fix: hubFull was already computed
// pre-fix but the essay <section> ignored it and rendered raw hubHtml,
// silently duplicating the hook).
//
// Hook sizing is adaptive, not a fixed paragraph count — a fixed "always
// take the first 3 </p>" cut is essay-structure/lang dependent (e.g.
// /en/history/ has short paragraphs, so 3 of them totalled 1,885 chars of
// hook prose sitting in a compact header bar meant for a teaser):
//   1. Take the first paragraph only.
//   2. If its (tag-stripped) text is under 200 chars — too short to read
//      as a hook on its own — fold in the second paragraph too, but only
//      if doing so keeps the *cumulative* hook text at or under the
//      600-char hard cap. A hook never truncates mid-paragraph, so a
//      first paragraph that alone exceeds 600 chars is still used as-is.
//   3. Sanity guard kept from the original implementation: reject the cut
//      outright if it would eat >=70% of the whole essay (hubHook stays
//      '', hubFull falls back to the untouched hubHtml — same fallback
//      the original "no 3rd </p> found" case already had).
let hubHook = '';
let hubFull = hubHtml;
if (hubHtml) {
  // Strip leading headings (h1, h2) from the beginning. hubFull is sliced
  // from this stripped version too (see below), so a stripped leading
  // heading doesn't resurface duplicated under the essay's own "Curatorial
  // Reading" <h2> a few lines down in the render.
  let stripped = (hubHtml as string)
    .replace(/^(\s*<h[12][^>]*>[\s\S]*?<\/h[12]>\s*)+/i, '')
    .trim();

  const stripTags = (html: string) => html.replace(/<[^>]+>/g, '').trim();

  // End index (exclusive) of the Nth </p> close tag, 1-indexed; -1 if
  // fewer than N paragraphs exist in `stripped`.
  function pCloseEnd(n: number): number {
    const pCloseRegex = /<\/p>/gi;
    let count = 0;
    let m: RegExpExecArray | null;
    while ((m = pCloseRegex.exec(stripped)) !== null) {
      count++;
      if (count === n) return m.index + m[0].length;
    }
    return -1;
  }

  const firstEnd = pCloseEnd(1);
  let cutIndex = firstEnd;
  if (firstEnd > 0) {
    const firstText = stripTags(stripped.slice(0, firstEnd));
    if (firstText.length < 200) {
      const secondEnd = pCloseEnd(2);
      if (secondEnd > 0) {
        const secondText = stripTags(stripped.slice(0, secondEnd));
        if (secondText.length <= 600) {
          cutIndex = secondEnd;
        }
        // else: adding the 2nd paragraph would push the hook past the
        // 600-char hard cap — stop before it, cutIndex stays at the 1st.
      }
    }
  }

  if (cutIndex > 0 && cutIndex < stripped.length * 0.7) {
    hubHook = stripped.slice(0, cutIndex);
    hubFull = stripped.slice(cutIndex).trim();
  }
  // else: hook extraction failed the sanity guard (or the essay has no
  // paragraphs at all) — hubHook stays '', hubFull stays the untouched
  // hubHtml, matching the pre-2026-07-10 fallback behavior.
}

// Split hub HTML into sections at <h2> boundaries for chart injection (economy only)
//
// Known asymmetry (2026-07-10 hook/essay dedup fix): this deliberately still
// splits the FULL hubHtml, not the hook-truncated hubFull used by the
// non-economy essay branch below. chartAfter anchor-matching depends on
// literal zh-TW section header text ('從零到英雄' / '矽島的誕生' / ...)
// showing up inside hubHtml — feeding it hubFull instead would risk
// silently losing a chart anchor if that header text happened to fall
// inside the hook cut. The economy hub is zh-TW-only and its own header
// hook + essay were left duplicating each other on this pass; only the
// non-economy branch got the dedup fix here.
const isEconomy = category === 'economy' && lang === 'zh-TW';
type HubSection = { html: string; chartAfter?: string };
let hubSections: HubSection[] = [];
if (isEconomy && hubHtml) {
  const parts = (hubHtml as string).split(/(?=<h2>)/);
  hubSections = parts.map((part) => {
    let chartAfter: string | undefined;
    if (part.includes('從零到英雄')) chartAfter = 'cpi';
    else if (part.includes('矽島的誕生')) chartAfter = 'taiex';
    else if (part.includes('服務經濟')) chartAfter = 'salary';
    else if (part.includes('面向未來')) chartAfter = 'housing';
    return { html: part, chartAfter };
  });
}

// lang 已從 props 取得，不再從 URL derive
const t = useTranslations(lang);

// Subcategory group heading label — grouping key 本身永遠是 zh-TW 原始
// frontmatter 值（groups 來自 category-static-paths.ts，跨語言共用同一組
// key）。'__others__' 用固定 i18n 詞；zh-TW 頁直接顯示原始 key；其他語言查
// subcategory-i18n.json 顯示層對照表，查無對照則 fallback 回原始 key。
const subcatI18n = (subcatJson as any).map ?? {};
function groupLabel(key: string): string {
  if (key === '__others__') return t('category.others');
  if (lang !== 'zh-TW') return subcatI18n[key]?.[lang] ?? key;
  return key;
}

const categoryConfigs = getCategoryConfigs(t);
const categoryInfo = categoryConfigs[category];

// 其他分類（sidebar 跨分類導航用）
const otherCategories = categories
  .filter((cat) => cat !== category)
  .map((cat) => ({
    key: cat,
    ...categoryConfigs[cat as CategoryKey],
  }));
---

<Layout
  lang={lang}
  title={`${categoryInfo.name} - Taiwan.md`}
  description={categoryInfo.description}
  category={categoryInfo.name}
  categorySlug={category}
  dateModified={categoryUpdated || undefined}
  collectionTotal={articles.length}
  collectionItems={articles.slice(0, 100).map((a) => ({
    name: a.title,
    url: `${Astro.site?.href?.replace(/\/$/, '') ?? 'https://taiwan.md'}${langUrlPrefix}/${category}/${encodeURIComponent(a.slug)}`,
  }))}
  readerSettings
>
  <!--
    Phase 6 partial migration — [category]/index.astro (zh-TW)
    ──────────────────────────────────────────────────────────
    Same wrapper migration as en/ja [category]/index. zh-TW adds
    two extra conditional sections beyond what en/ja have:
    (1) Food visualization (when category === 'food') — sunburst
        + network d3 viz, keeps all .food-viz / .viz-* classes in
        the scoped <style> because they repeat and are animated
        by script/index.astro's d3 code.
    (2) Economy hub with inline charts (when isEconomy) — uses
        .econ-chart-* classes rendered inline around hubSections,
        also kept fully scoped.
  -->
  <main class="category-page">
    <!-- Category Header (compact bar + curatorial hook fused) -->
    <div
      class="bg-[var(--categoryColorLight)] pb-5 pt-3"
      style={`border-bottom: 2px solid ${categoryInfo.color};`}
    >
      <div class="mx-auto max-w-[var(--container-wide)] px-8 max-[768px]:px-4">
        <nav
          aria-label="breadcrumb"
          class="mb-1 flex items-center gap-2 text-[0.9rem] [&_a:hover]:underline [&_a]:font-medium [&_a]:no-underline"
        >
          <ol class="crumb-list m-0 flex list-none items-center gap-2 p-0">
            <li>
              <a
                href={langUrlPrefix === '' ? '/' : langUrlPrefix}
                style={`color: ${categoryInfo.color};`}>{t('article.home')}</a
              >
            </li>
            <li
              aria-current="page"
              class="font-semibold text-[var(--color-ink-soft)]"
            >
              {categoryInfo.name}
            </li>
          </ol>
        </nav>
        <div class="flex flex-wrap items-baseline gap-2">
          <span class="text-[1.5rem]">{categoryInfo.icon}</span>
          <h1
            class="m-0 text-[1.5rem] font-extrabold"
            style={`color: ${categoryInfo.color}`}
          >
            {categoryInfo.name}
          </h1>
          <span
            class="font-light text-[var(--color-ink-soft)] max-[768px]:hidden"
            >·</span
          >
          <span
            class="max-w-[50%] truncate text-[0.88rem] text-[var(--color-ink-soft)] max-[768px]:max-w-full max-[768px]:basis-full max-[768px]:text-[0.78rem]"
            >{categoryInfo.description}</span
          >
          <span
            class="ms-auto rounded-[12px] bg-[var(--color-bg-soft)] px-2 py-[0.15rem] text-[0.78rem] text-[var(--color-ink-soft)]"
            >{
              t('category.articleCount').replace('{n}', String(articles.length))
            }</span
          >
          {
            categoryUpdated && (
              <span class="header-updated max-[768px]:hidden">
                {t('category.updatedLabel')} {categoryUpdated.slice(0, 10)}
              </span>
            )
          }
        </div>
        {
          hubHook && (
            <div class="mt-3 max-w-[800px] text-[0.92rem] leading-[1.75] text-[var(--color-ink-soft)] max-[768px]:text-[0.85rem]">
              <div class="header-hook-prose" set:html={hubHook} />
              <a
                href="#hub-essay"
                class="mt-2 inline-block text-[0.82rem] font-semibold text-[var(--categoryColor)] no-underline transition-all duration-150 hover:underline"
              >
                {t('category.readGuide')}
              </a>
              {essayMinutes && (
                <span class="hook-minutes">
                  📖{' '}
                  {t('category.essayMinutes').replace(
                    '{n}',
                    String(essayMinutes),
                  )}
                </span>
              )}
            </div>
          )
        }
      </div>
    </div>

    <div
      class="mx-auto max-w-[var(--container-wide)] px-8 py-8 max-[768px]:px-4 max-[768px]:py-4"
    >
      {
        /* Main two-column layout: sidebar + content
           Sticky aside must keep content-height (`self-start` / `h-fit`) so
           the parent flex (= taller article column) provides the scroll
           context. Items-start on parent enforces that. */
      }
      {
        articles.length > 0 ? (
          <div class="mt-4 flex items-start gap-8 max-[768px]:flex-col max-[768px]:gap-0">
            <aside class="sticky top-[72px] w-[180px] flex-shrink-0 self-start max-[768px]:static max-[768px]:w-full max-[768px]:max-h-none max-[768px]:overflow-visible">
              {/* Subcategory nav */}
              {groups.length > 1 && (
                <nav class="flex flex-col gap-1 max-[768px]:flex-row max-[768px]:flex-wrap max-[768px]:gap-[0.3rem] max-[768px]:border-b max-[768px]:border-[var(--color-border)] max-[768px]:pb-4 max-[768px]:mb-4">
                  <span class="mb-[0.3rem] border-b border-[var(--color-border)] px-2 pb-[0.4rem] text-[0.7rem] font-bold uppercase tracking-[0.1em] text-[var(--color-ink-soft)] max-[768px]:hidden">
                    {t('category.topic')}
                  </span>
                  {groups.map((group) => (
                    <a
                      href={`#sub-${group.key}`}
                      data-sub-link={group.key}
                      class="subcat-nav-link flex items-center justify-between rounded border-s-2 border-transparent px-2 py-[0.35rem] text-[0.82rem] text-[var(--color-ink-soft)] no-underline transition-all duration-150 hover:bg-[rgba(45,80,22,0.06)] hover:text-[var(--categoryColor,#2d5016)] max-[768px]:rounded-2xl max-[768px]:border max-[768px]:border-[var(--color-border)] max-[768px]:bg-[var(--color-bg-soft)] max-[768px]:px-[0.6rem] max-[768px]:py-1 max-[768px]:text-[0.78rem]"
                    >
                      {groupLabel(group.key)}
                      <span class="min-w-[1.2rem] rounded-lg bg-[var(--color-bg-soft)] px-[0.35rem] py-[0.1rem] text-center text-[0.7rem] text-[var(--color-ink-soft)]">
                        {group.count}
                      </span>
                    </a>
                  ))}
                </nav>
              )}

              <div class="my-3 h-px bg-[var(--color-border)] max-[768px]:hidden" />

              {/* Essay anchor (2026-07-10) — jump link to the curatorial
                  essay further down the column, for readers who scrolled
                  past the header's own "read guide" link already.
                  Desktop only, same breakpoint as the cross-category nav
                  below it. */}
              {hubContent && (
                <>
                  <nav class="mb-1 flex flex-col gap-1 max-[768px]:hidden">
                    <a href="#hub-essay" class="sidebar-essay-link">
                      📖 {t('hub.essay.heading')}
                      {essayMinutes && (
                        <span class="muted">
                          {t('category.essayMinutes').replace(
                            '{n}',
                            String(essayMinutes),
                          )}
                        </span>
                      )}
                    </a>
                  </nav>
                  <div class="my-3 h-px bg-[var(--color-border)] max-[768px]:hidden" />
                </>
              )}

              {/* Cross-category nav (replaces bottom explore cards) */}
              <nav class="flex flex-col gap-1 max-[768px]:hidden">
                <span class="mb-[0.3rem] border-b border-[var(--color-border)] px-2 pb-[0.4rem] text-[0.7rem] font-bold uppercase tracking-[0.1em] text-[var(--color-ink-soft)]">
                  {t('category.otherTopics')}
                </span>
                {otherCategories.map((cat) => (
                  <a
                    href={`${langUrlPrefix}/${cat.key}`}
                    class="othercat-link flex items-center justify-between rounded px-2 py-[0.35rem] text-[0.78rem] text-[var(--color-ink-soft)] no-underline opacity-75 transition-all duration-150 hover:bg-[rgba(45,80,22,0.06)] hover:text-[var(--categoryColor,#2d5016)] hover:opacity-100"
                  >
                    <span>
                      {cat.icon} {cat.name}
                    </span>
                  </a>
                ))}
              </nav>
            </aside>

            <div class="min-w-0 flex-1">
              {/* Featured shelf — 3-card ArticleCard density="detailed" grid
                  (2026-07-10 replaces the old horizontal chip strip). */}
              {topPicks && topPicks.length > 0 && (
                <section
                  class="featured-shelf"
                  aria-label={t('category.featured')}
                >
                  <h2 class="shelf-heading">{t('category.featured')}</h2>
                  <ul class="shelf-grid" role="list">
                    {topPicks.slice(0, 3).map((article: any, i: number) => (
                      <li>
                        <ArticleCard
                          density="detailed"
                          titleTag="h3"
                          href={`${langUrlPrefix}/${category}/${encodeURIComponent(article.slug)}`}
                          title={article.title}
                          description={article.description}
                          categoryColor={categoryInfo.color}
                          coverImage={article.image || undefined}
                          imageLoading={i === 0 ? 'eager' : 'lazy'}
                          footnotes={article.footnotes}
                          readingTime={
                            article.readingTime
                              ? t('category.essayMinutes').replace(
                                  '{n}',
                                  String(article.readingTime),
                                )
                              : undefined
                          }
                          date={
                            article.updated
                              ? article.updated.slice(0, 7)
                              : undefined
                          }
                          openIn="same-tab"
                        />
                      </li>
                    ))}
                  </ul>
                </section>
              )}

              {/* Articles list */}
              <div class="articles-main min-w-0 flex-1" id="articlesGrid">
                <div class="hub-toolbar">
                  <div class="hub-search">
                    <label for="articleFilter" class="tw-sr-only">
                      {t('category.searchLabel')}
                    </label>
                    <input
                      type="text"
                      id="articleFilter"
                      placeholder={t('category.searchPlaceholder')}
                      autocomplete="off"
                      aria-label={t('category.searchLabel')}
                    />
                    <button
                      type="button"
                      id="filterClear"
                      aria-label={t('category.clearSearch')}
                      hidden
                    >
                      ×
                    </button>
                  </div>
                  <div
                    class="hub-sort"
                    role="group"
                    aria-label={t('category.sortLabel')}
                  >
                    <button
                      type="button"
                      class="sort-btn active"
                      data-sort="featured"
                    >
                      {t('category.sortFeatured')}
                    </button>
                    <button type="button" class="sort-btn" data-sort="updated">
                      {t('category.sortLatest')}
                    </button>
                    <button type="button" class="sort-btn" data-sort="fn">
                      {t('category.sortCited')}
                    </button>
                    <button type="button" class="sort-btn" data-sort="reading">
                      {t('category.sortTime')}
                    </button>
                  </div>
                </div>
                <p
                  id="filterStatus"
                  role="status"
                  aria-live="polite"
                  class="filter-status"
                  data-template={t('category.resultCount')}
                  hidden
                />

                {groups.map((group) => (
