                <a
                  href="https://github.com/frank890417/taiwan-md"
                  target="_blank"
                  class="inline-flex items-center gap-2 rounded-xl border-2 border-[var(--categoryColor)] bg-[var(--color-surface)] px-8 py-4 font-semibold text-[var(--categoryColor)] no-underline transition-all duration-300 hover:-translate-y-0.5 hover:bg-[var(--categoryColor)] hover:text-white"
                >
                  {t('category.contribute')}
                </a>
              </div>
            </div>
          </section>
        )
      }
    </div>
  </main>
</Layout>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const grid = document.getElementById('articlesGrid');
    const filterInput = document.getElementById(
      'articleFilter',
    ) as HTMLInputElement;
    const filterClear = document.getElementById(
      'filterClear',
    ) as HTMLButtonElement;
    const filterStatus = document.getElementById('filterStatus');
    if (!grid) return;

    const rows = Array.from(
      grid.querySelectorAll('li.hub-row'),
    ) as HTMLElement[];
    const sections = Array.from(
      grid.querySelectorAll('.subcategory-section'),
    ) as HTMLElement[];

    // Sort — re-orders each subcategory section's <ul> independently so
    // grouping never changes, only the order within a group.
    function sortRows(method: string) {
      sections.forEach((section) => {
        const list = section.querySelector('.hub-rows');
        if (!list) return;
        const items = Array.from(
          list.querySelectorAll('li.hub-row'),
        ) as HTMLElement[];
        const sorted = items.sort((a, b) => {
          if (method === 'featured') {
            const af = a.dataset.featured === '1' ? 1 : 0;
            const bf = b.dataset.featured === '1' ? 1 : 0;
            if (af !== bf) return bf - af;
            return (a.dataset.title || '').localeCompare(b.dataset.title || '');
          }
          if (method === 'updated') {
            // Date.parse, not string compare — content-dates.json timestamps
            // mix `Z` and `+08:00` offsets, which don't sort correctly as
            // plain strings. Missing/invalid dates fall back to epoch 0
            // (sink to the bottom of a "latest first" sort).
            const at = Date.parse(a.dataset.updated || '') || 0;
            const bt = Date.parse(b.dataset.updated || '') || 0;
            return bt - at;
          }
          if (method === 'fn') {
            return (
              parseInt(b.dataset.fn || '0', 10) -
              parseInt(a.dataset.fn || '0', 10)
            );
          }
          if (method === 'reading') {
            // 0/missing reading time sorts last in ascending order.
            const ar = parseInt(a.dataset.reading || '0', 10) || Infinity;
            const br = parseInt(b.dataset.reading || '0', 10) || Infinity;
            return ar - br;
          }
          return 0;
        });
        sorted.forEach((row) => list.appendChild(row));
      });
    }

    document.querySelectorAll('.sort-btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        document
          .querySelectorAll('.sort-btn')
          .forEach((b) => b.classList.remove('active'));
        btn.classList.add('active');
        sortRows((btn as HTMLElement).dataset.sort || 'featured');
      });
    });

    // Filter
    function applyFilter() {
      const query = filterInput?.value.toLowerCase() || '';
      let visible = 0;
      rows.forEach((row) => {
        const haystack = [
          row.dataset.title || '',
          row.dataset.desc || '',
          row.dataset.tags || '',
          row.dataset.subcategory || '',
        ]
          .join(' ')
          .toLowerCase();
        const show = !query || haystack.includes(query);
        row.hidden = !show;
        if (show) visible++;
      });
      // Hide subcategory sections with no visible rows
      sections.forEach((section) => {
        const sectionRows = section.querySelectorAll(
          'li.hub-row',
        ) as NodeListOf<HTMLElement>;
        const anyVisible = Array.from(sectionRows).some((r) => !r.hidden);
        section.hidden = !anyVisible;
      });
      if (filterClear) filterClear.hidden = !query;
      if (filterStatus) {
        if (query) {
          const template = filterStatus.dataset.template || '{n} / {m}';
          filterStatus.textContent = template
            .replace('{n}', String(visible))
            .replace('{m}', String(rows.length));
          filterStatus.hidden = false;
        } else {
          filterStatus.textContent = '';
          filterStatus.hidden = true;
        }
      }
    }

    filterInput?.addEventListener('input', () => {
      applyFilter();
    });
    filterClear?.addEventListener('click', () => {
      if (!filterInput) return;
      filterInput.value = '';
      filterInput.dispatchEvent(new Event('input'));
      filterInput.focus();
    });
  });
</script>

<style
  define:vars={{
