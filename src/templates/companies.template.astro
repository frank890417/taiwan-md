---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import {
  getLangFromUrl,
  useTranslations,
  useTranslatedPath,
} from '../i18n/utils';
import {
  COMPANIES_SNAPSHOT_DATE,
  getCompanyConfigs,
  getFellOffCompanies,
  localizeCompanyArticleUrls,
  sectorColors,
} from '../utils/dataConfig';
// 2026-11 產業專題：排行表抽成可重用的工具元件（專題頁、內嵌板共用同一張表），
// 另加專題入口與歷年年底前十名。原有的標題、英雄區、故事、泡泡圖、洞察卡、掉榜區、方法說明不動。
import { useIndustryT } from '../i18n/industry';
import CompanyRanking from '../components/industry/tools/CompanyRanking.astro';
import TopTenHistory from '../components/industry/charts/TopTenHistory.astro';
import industrySeries from '../data/industry/series.json';
import EmbedSnippet from '../components/tools/EmbedSnippet.astro';
import TopicNav from '../components/topics/TopicNav.astro';
import { getLanguage } from '../config/languages';
import { getTopic, localizePath, pickText } from '../utils/topics/registry';
import {
  buildFaqPageLd,
  buildWebApplicationLd,
  serializeJsonLd,
} from '../utils/tools/jsonld';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);

// Centralized SSOT — shared with the /data 企業地圖 teaser section
// articleUrl 在 SSOT 裡是 zh 網址；換成本語言讀得到的那個，沒有譯文就拿掉連結。
// 表格與泡泡圖吃的是同一個陣列（泡泡圖走下方 define:vars），所以兩邊一起修好。
const companies = localizeCompanyArticleUrls(getCompanyConfigs(t), lang);
const fellOff = getFellOffCompanies(t);
const sectors = [...new Set(companies.map((c) => c.sector))];

// Source data is denominated in 億 (10^8) TWD, the unit Taiwanese filings use.
// zh-TW readers keep it; everyone else gets billions, because the page used to
// print the 億 figure under a "B" label and overstated every company tenfold
// (#1317). The table and the bubble chart must use the same unit or a reader
// comparing them sees two different numbers for one company.
// zh-TW / ja / ko count in 億·억 natively, so they keep the source unit.
// Everyone else gets billions.
const MYRIAD_UNIT_LANGS = ['zh-TW', 'ja', 'ko'];
const isZhPage = MYRIAD_UNIT_LANGS.includes(lang);
// 標題的快照年月從資料檔的快照日期取（主查詢「市值排名」，2026-11-04 evolve）。
const [snapYear, snapMonth] = COMPANIES_SNAPSHOT_DATE.split('-');
const snapVars: Record<string, string> = {
  year: snapYear,
  month: snapMonth,
  monthShortEn: new Date(`${COMPANIES_SNAPSHOT_DATE}T00:00:00Z`).toLocaleString(
    'en-US',
    { month: 'short', timeZone: 'UTC' },
  ),
};
const metaTitle = t('data.companies.meta.title').replace(
  /\{(year|month|monthShortEn)\}/g,
  (_, k: string) => snapVars[k],
);
const money = (v: number) =>
  isZhPage
    ? v.toLocaleString()
    : (v / 10).toLocaleString(undefined, { maximumFractionDigits: 1 });

const ti = useIndustryT(lang);
// 歷年年底前十名（證交所歷史股數 × 收盤價；資料與 /industry 第五節同一份）
const mh = (industrySeries as any).marketHistory as any | undefined;
const mhCols = mh
  ? mh.years.filter((x: any) => (mh.pick as string[]).includes(x.label))
  : [];
const mhNames: Record<string, string> = {};
if (mh && lang !== 'zh-TW') {
  // 「Hon Hai Foxconn 鴻海」這種雙語名在窄欄裡只留拉丁字那一段
  for (const c of [...companies, ...fellOff])
    mhNames[c.ticker] =
      c.name.replace(/\s+[\u3400-\u9fff][\s\S]*$/, '') || c.name;
  for (const x of mh.years)
    for (const c of x.top)
      if (!mhNames[c.code] && ti(`mh.${c.code}`) !== `mh.${c.code}`)
        mhNames[c.code] = ti(`mh.${c.code}`);
}
// 這一頁同時是排行工具的單獨頁（專題共用契約 v1）：補常見問題、嵌入程式碼與結構化資料。
// 麵包屑不另加（Layout 的 SEO 元件已經有一份）。
const topic = getTopic('industry');
const rankTool = topic?.tools.find((x) => x.slug === 'company-ranking');
const faq = [1, 2, 3, 4, 5].map((n) => ({
  q: ti(`co.faq${n}.q`, { date: COMPANIES_SNAPSHOT_DATE }),
  a: ti(`co.faq${n}.a`, { date: COMPANIES_SNAPSHOT_DATE }),
}));
const toolLd = rankTool
  ? [
      buildWebApplicationLd({
        name: pickText(rankTool.title, lang as any),
        description: pickText(rankTool.description, lang as any),
        url: localizePath(rankTool.path, lang as any),
        inLanguage: getLanguage(lang)?.hreflang ?? lang,
        keywords: rankTool.keywords,
        dateModified: COMPANIES_SNAPSHOT_DATE,
        partOf: topic
          ? {
              name: pickText(topic.title, lang as any),
              url: localizePath(topic.path, lang as any),
            }
          : undefined,
      }),
      buildFaqPageLd(faq),
    ].filter(Boolean)
  : [];
const industryHref = translatePath('/industry/');
const chainsHref = translatePath('/industry/supply-chain-map/');
---

<Layout
  lang={lang}
  title={metaTitle}
  description={t('data.companies.meta.description')}
  readerSettings={true}
>
  <main
    class="companies-page min-h-screen bg-[image:var(--surface-panel-dark)] text-[#e2e8f0]"
  >
    <PageHero
      bgTone="dark"
      titleVariant="gradient"
      titleGradient="linear-gradient(135deg,#38bdf8,#818cf8,#c084fc)"
      titleSize="clamp"
      containerWidth="wide"
      title={t('data.companies.hero.title')}
      subtitle={t('data.companies.hero.subtitle')}
    >
      <p
        class="mx-auto mt-4 max-w-[640px] text-base leading-[1.7] text-[#cbd5e1]"
      >
        {t('data.companies.hero.description')}
      </p>
      <p
        class="mx-auto mt-3 max-w-[640px] text-[0.8rem] leading-[1.6] text-[#94a3b8]"
      >
        {t('data.companies.snapshot')}
      </p>
    </PageHero>

    <!-- Story: the AI repricing -->
    <section class="story-intro">
      <h2 class="section-title">{t('data.companies.story.title')}</h2>
      <div class="story-text">
        <p>{t('data.companies.story.p1')}</p>
        <p>{t('data.companies.story.p2')}</p>
      </div>
    </section>

    <!-- 專題入口：榜單的脈絡在 /industry -->
    <aside class="topic-entry" aria-label={ti('co.topic.h')}>
      <div class="topic-entry-body">
        <h2 class="topic-entry-h">{ti('co.topic.h')}</h2>
        <p>{ti('co.topic.p')}</p>
      </div>
      <div class="topic-entry-cta">
        <a href={industryHref} class="topic-entry-btn is-primary">
          {ti('co.topic.cta1')} →
        </a>
        <a href={chainsHref} class="topic-entry-btn">
          {ti('co.topic.cta2')} →
        </a>
      </div>
    </aside>

    <!-- Bubble chart controls -->
    <div
      class="mx-auto mb-6 flex max-w-[var(--container-wide)] flex-col gap-4 px-8"
    >
      <div
        class="flex flex-wrap items-center gap-2 [&>label]:text-[0.9rem] [&>label]:font-semibold [&>label]:text-[#94a3b8]"
      >
        <label>{t('data.enterprise.controls.sizeLabel')}</label>
        <button class="toggle-btn active" data-mode="marketCap">
          {t('data.enterprise.controls.marketCap')}
        </button>
        <button class="toggle-btn" data-mode="revenue">
          {t('data.enterprise.controls.revenue')}
        </button>
        <button class="toggle-btn" data-mode="employees">
          {t('data.enterprise.controls.employees')}
        </button>
      </div>
      <div class="flex flex-wrap gap-[0.4rem]">
        <button class="sector-btn active" data-sector="all">
          {t('data.enterprise.controls.filterAll')}
        </button>
        {
          sectors.map((s) => (
            <button
              class="sector-btn"
              data-sector={s}
              style={`--sector-color: ${sectorColors[s] || '#888'}`}
            >
              <span
                class="sector-dot"
                style={`background: ${sectorColors[s] || '#888'}`}
              />
              {t(`data.sector.${s}`)}
            </button>
          ))
        }
      </div>
    </div>

    <!-- Bubble chart -->
    <div id="bubble-chart"></div>

    <!-- Key insights -->
    <div class="insights">
      <h2 class="insights-heading">{t('data.companies.insights.heading')}</h2>
      <div class="insight-grid">
        <div class="insight-card">
          <div class="insight-number">
            {t('data.companies.insights.card1.number')}
          </div>
          <div class="insight-label">
            {t('data.companies.insights.card1.label')}
          </div>
          <div class="insight-detail">
            {t('data.companies.insights.card1.detail')}
          </div>
        </div>
        <div class="insight-card">
          <div class="insight-number">
            {t('data.companies.insights.card2.number')}
          </div>
          <div class="insight-label">
            {t('data.companies.insights.card2.label')}
          </div>
          <div class="insight-detail">
            {t('data.companies.insights.card2.detail')}
          </div>
        </div>
        <div class="insight-card">
          <div class="insight-number">
            {t('data.companies.insights.card3.number')}
          </div>
          <div class="insight-label">
            {t('data.companies.insights.card3.label')}
          </div>
          <div class="insight-detail">
            {t('data.companies.insights.card3.detail')}
          </div>
        </div>
        <div class="insight-card">
          <div class="insight-number">
            {t('data.companies.insights.card4.number')}
          </div>
          <div class="insight-label">
            {t('data.companies.insights.card4.label')}
          </div>
          <div class="insight-detail">
            {t('data.companies.insights.card4.detail')}
          </div>
        </div>
      </div>
    </div>

    <!-- Full ranking table — the machine-readable SSOT behind the bubbles -->
    <section class="table-section" id="rank">
      <h2 class="section-title">{t('data.companies.table.heading')}</h2>
      <div class="rank-disclaimer" role="note">
        <strong>{ti('co.disclaimer.h')}</strong>
      </div>
      <CompanyRanking lang={lang} variant="page" anchors dark />
    </section>

    <!-- Who fell off -->
    <section class="felloff-section">
      <h2 class="section-title">{t('data.companies.fellOff.title')}</h2>
      <div class="story-text felloff-intro">
        <p>{t('data.companies.fellOff.intro')}</p>
      </div>
      <div class="felloff-grid">
        {
          fellOff.map((c) => (
            <div class="felloff-card">
              <div class="felloff-head">
                <span class="felloff-name">{c.name}</span>
                <span class="ticker">{c.ticker}</span>
              </div>
              <div class="felloff-cap">
                <span class="felloff-cap-label">
                  {t('data.companies.fellOff.marketCapNow')}
                </span>
                <span class="felloff-cap-value">
                  {money(c.marketCapNow)}{' '}
                  <span class="felloff-cap-unit">{isZhPage ? '億' : 'B'}</span>
                </span>
              </div>
              <p class="felloff-reason">{c.reason}</p>
            </div>
          ))
        }
      </div>
    </section>

    <!-- 歷年年底前十名 -->
    {
      mh && (
        <section class="history-section" id="history">
          <h2 class="section-title">{ti('co.hist.h')}</h2>
          <div class="story-text felloff-intro">
            <p>{ti('co.hist.p')}</p>
          </div>
          <TopTenHistory
            cols={mhCols}
            names={mhNames}
            labels={{
              rank: ti('s5.hist.rank'),
              top10Share: ti('s5.hist.top10'),
              tsmcShare: ti('s5.hist.tsmc'),
              caption: ti('s5.hist.title'),
            }}
          />
          <p class="rank-note">{ti('s5.hist.note')}</p>
          <p class="rank-note">
            <a href={`${industryHref}#s5`} class="company-link">
              {ti('co.hist.more')} →
            </a>
          </p>
        </section>
      )
    }

    <!-- Method note -->
    <section class="method-section">
      <div class="method-box">
        <h3>{t('data.companies.method.heading')}</h3>
        <p>{t('data.companies.method.body')}</p>
      </div>
    </section>

    <!-- 常見問題與嵌入（排行工具的單獨頁） -->
    <section class="history-section" id="faq">
      <h2 class="section-title">{ti('co.faq.h')}</h2>
      <dl class="co-faq">
        {
          faq.map((f) => (
            <div>
              <dt>{f.q}</dt>
              <dd>{f.a}</dd>
            </div>
          ))
        }
      </dl>
      {
        rankTool && (
          <div class="co-embed">
            <h3>{ti('co.embed.h')}</h3>
            <EmbedSnippet
              embedPath={rankTool.embedPath}
              title={pickText(rankTool.title, lang as any)}
              lang={lang as any}
              height={820}
            />
          </div>
        )
      }
      <TopicNav lang={lang as any} topic="industry" />
    </section>
    {
      toolLd.map((ld) => (
        <script type="application/ld+json" set:html={serializeJsonLd(ld)} />
      ))
    }

    <!-- Related -->
    <footer class="related-footer">
      <h3 class="related-title">{t('data.companies.related')}</h3>
      <div class="related-links">
        <a href={translatePath('/data')} class="related-link">
          <span class="related-icon">📊</span>
          <span>{t('nav.data')}</span>
        </a>
        <a href={translatePath('/economy')} class="related-link">
          <span class="related-icon">📈</span>
          <span>{t('categoryConfig.economy')}</span>
        </a>
        <a href={translatePath('/graph')} class="related-link">
          <span class="related-icon">🕸️</span>
          <span>{t('nav.graph-view')}</span>
        </a>
      </div>
    </footer>
  </main>

  <!-- D3 Bubble Chart -->
  <script define:vars={{ companies, sectorColors, lang }}>
    const data = companies;
    const colors = sectorColors;
    const currentLang = lang;

    const script = document.createElement('script');
    script.src = 'https://d3js.org/d3.v7.min.js';
    script.onload = () => initBubbleChart(data, colors, currentLang);
    document.head.appendChild(script);

    function initBubbleChart(data, colors, lang) {
      const container = document.getElementById('bubble-chart');
      const width = container.clientWidth;
      const height = Math.max(560, window.innerHeight * 0.6);

      let currentMode = 'marketCap';
      let currentSector = 'all';

      const svg = d3
        .select('#bubble-chart')
        .append('svg')
        .attr('width', width)
        .attr('height', height)
        .attr('viewBox', `0 0 ${width} ${height}`);

      const tooltip = d3
        .select('#bubble-chart')
        .append('div')
        .attr('class', 'tooltip')
        .style('opacity', 0);

      function getValue(d) {
        return d[currentMode] || 0;
      }

      function getRadius(d) {
        const val = getValue(d);
        const maxVal = d3.max(data, getValue);
        const minR = 13;
        const maxR = Math.min(width, height) * 0.16;
        return minR + (maxR - minR) * Math.sqrt(val / maxVal);
      }

      const simulation = d3
        .forceSimulation(data)
        .force('center', d3.forceCenter(width / 2, height / 2))
        .force('charge', d3.forceManyBody().strength(3))
        .force(
          'collision',
          d3
            .forceCollide()
            .radius((d) => getRadius(d) + 1.5)
            .strength(0.85),
        )
        .force('x', d3.forceX(width / 2).strength(0.05))
        .force('y', d3.forceY(height / 2).strength(0.05));

      const nodes = svg
        .selectAll('g.node')
        .data(data)
        .join('g')
        .attr('class', 'node')
        .call(
          d3
            .drag()
            .on('start', (e, d) => {
              if (!e.active) simulation.alphaTarget(0.3).restart();
              d.fx = d.x;
              d.fy = d.y;
            })
            .on('drag', (e, d) => {
              d.fx = e.x;
              d.fy = e.y;
            })
            .on('end', (e, d) => {
              if (!e.active) simulation.alphaTarget(0);
              d.fx = null;
              d.fy = null;
            }),
        );

      const circles = nodes
        .append('circle')
        .attr('r', (d) => getRadius(d))
        .attr('fill', (d) => colors[d.sector] || '#888')
        .attr('fill-opacity', 0.82)
        .attr('stroke', (d) => colors[d.sector] || '#888')
        .attr('stroke-width', 2)
        .attr('stroke-opacity', 0.3)
        .style('cursor', 'grab');

      const labels = nodes
        .append('text')
        .attr('text-anchor', 'middle')
        .attr('dominant-baseline', 'central')
        .attr('fill', '#fff')
        .attr('font-weight', '600')
        .attr('pointer-events', 'none');

      // 億 is 10^8. The old code kept the 億-denominated number but relabelled
      // it "B" (10^9) for every non-zh-TW reader, overstating every company
      // tenfold. Convert the value instead of renaming the unit, and always
      // say TWD — a bare "B" reads as USD to most readers (#1317).
      const isZh = ['zh-TW', 'ja', 'ko'].includes(lang);
      function metricNumber(v) {
        if (currentMode === 'employees') return v.toLocaleString();
        if (isZh) return v.toLocaleString();
        return (v / 10).toLocaleString(undefined, { maximumFractionDigits: 1 });
      }
      function metricUnit() {
        if (currentMode === 'employees') return isZh ? ' 人' : '';
        return isZh ? ' 億 TWD' : 'B TWD';
      }

      // Company names arrive as "<Latin> <漢字>" (en/es/fr/…) or "<漢字> <Latin>"
      // (zh-TW/ja/ko). Splitting on the first space truncated 45 of the 70
      // companies to a meaningless token — TSMC showed as "Taiwan", 中鋼
      // (China Steel) as "China", and 台積電 / 台灣大哥大 became two
      // indistinguishable "Taiwan" bubbles. Take the leading same-script run
      // so each label stays whole in whatever script that language uses.
      function shortLabel(name) {
        const isCJK = (c) => /[㐀-鿿豈-﫿぀-ヿ]/.test(c);
        const s = String(name || '').trim();
        if (!s) return s;
        const lead = isCJK(s[0]);
        let out = '';
        for (const ch of s) {
          if (isCJK(ch) !== lead) break;
          out += ch;
        }
        return out.trim() || s;
      }

      // Redraw each label from the CURRENT mode/sector. Labels used to be
      // drawn once at init, so switching the size metric (市值/營收/員工數)
      // or a sector left the old market-cap number frozen on a resized
      // bubble, so the value stopped matching the bubble it sat on (#1223).
      function renderLabels() {
        labels.each(function (d) {
          const el = d3.select(this);
          el.selectAll('tspan').remove();
          el.text(null);
          if (currentSector !== 'all' && d.sector !== currentSector) return;
          const r = getRadius(d);
          const shortName = shortLabel(d.name);
          if (r > 40) {
            el.append('tspan')
              .attr('x', 0)
              .attr('dy', '-0.3em')
              .attr('font-size', `${Math.min(13, r / 4)}px`)
              .text(shortName);
            el.append('tspan')
              .attr('x', 0)
              .attr('dy', '1.2em')
              .attr('font-size', `${Math.min(10, r / 5)}px`)
              .attr('fill-opacity', 0.8)
              .text(metricNumber(getValue(d)) + metricUnit());
          } else if (r > 20) {
            el.attr('font-size', `${Math.min(10, r / 3)}px`).text(shortName);
          } else {
            el.attr('font-size', '8px').text(shortName.slice(0, 2));
          }
        });
      }

      renderLabels();

      const tooltipData = {
        marketCap: lang === 'zh-TW' ? '市值' : 'Market Cap',
        revenue: lang === 'zh-TW' ? '營收' : 'Revenue',
        employees: lang === 'zh-TW' ? '員工' : 'Employees',
        founded: lang === 'zh-TW' ? '成立' : 'Founded',
        unit: isZh ? '億 TWD' : 'B TWD',
        people: lang === 'zh-TW' ? '人' : '',
        year: lang === 'zh-TW' ? '年' : '',
        link: lang === 'zh-TW' ? '→ 看公司條目' : '→ Read article',
      };
      // Same 億→B conversion as the bubble labels; tooltip and label must not
      // disagree about the same company (#1317).
      const money = (v) =>
        isZh
          ? v.toLocaleString()
          : (v / 10).toLocaleString(undefined, { maximumFractionDigits: 1 });

      nodes
        .on('mouseover', (e, d) => {
          tooltip.transition().duration(200).style('opacity', 1);
          tooltip
            .html(
              `
            <strong>${d.name}</strong><br/>
            <span style="color:${colors[d.sector] || '#888'}">● ${d.ticker}</span><br/>
            ${tooltipData.marketCap}：${money(d.marketCap)} ${tooltipData.unit}<br/>
            ${tooltipData.revenue}：${money(d.revenue)} ${tooltipData.unit}<br/>
            ${tooltipData.employees}：${d.employees.toLocaleString()} ${tooltipData.people}<br/>
            ${tooltipData.founded}：${d.founded} ${tooltipData.year}
            ${d.articleUrl ? `<br/><span style="color:#7dd3fc">${tooltipData.link}</span>` : ''}
          `,
            )
            .style('left', e.pageX + 15 + 'px')
            .style('top', e.pageY - 10 + 'px');
          d3.select(e.currentTarget)
            .select('circle')
            .attr('fill-opacity', 1)
            .attr('stroke-width', 3);
        })
        .on('mouseout', (e) => {
          tooltip.transition().duration(300).style('opacity', 0);
          d3.select(e.currentTarget)
            .select('circle')
            .attr('fill-opacity', 0.82)
            .attr('stroke-width', 2);
        })
        .on('click', (e, d) => {
          e.stopPropagation();
          if (d.articleUrl) {
            // 已經是本語言的完整網址（見 dataConfig localizeCompanyArticleUrls），
            // 不要再自己加語言前綴。
            window.location.href = d.articleUrl;
          }
        })
        .style('cursor', (d) => (d.articleUrl ? 'pointer' : 'grab'));

      simulation.on('tick', () => {
        nodes.attr('transform', (d) => {
          d.x = Math.max(getRadius(d), Math.min(width - getRadius(d), d.x));
          d.y = Math.max(getRadius(d), Math.min(height - getRadius(d), d.y));
          return `translate(${d.x},${d.y})`;
        });
      });

      document.querySelectorAll('.toggle-btn').forEach((btn) => {
        btn.addEventListener('click', () => {
          document
            .querySelectorAll('.toggle-btn')
            .forEach((b) => b.classList.remove('active'));
          btn.classList.add('active');
          currentMode = btn.dataset.mode;
          updateBubbles();
        });
      });

      document.querySelectorAll('.sector-btn').forEach((btn) => {
        btn.addEventListener('click', () => {
          document
            .querySelectorAll('.sector-btn')
            .forEach((b) => b.classList.remove('active'));
          btn.classList.add('active');
          currentSector = btn.dataset.sector;
          updateBubbles();
        });
      });

      function updateBubbles() {
        circles
          .transition()
          .duration(600)
          .attr('r', (d) => {
            if (currentSector !== 'all' && d.sector !== currentSector) return 0;
            return getRadius(d);
          })
          .attr('fill-opacity', (d) => {
            if (currentSector !== 'all' && d.sector !== currentSector) return 0;
            return 0.82;
          });

        // Re-render labels so the number inside each bubble matches the
        // active size metric and the current sector filter (#1223).
        renderLabels();

        simulation
          .force(
            'collision',
            d3
              .forceCollide()
              .radius((d) => {
                if (currentSector !== 'all' && d.sector !== currentSector)
                  return 0;
                return getRadius(d) + 1.5;
              })
              .strength(0.85),
          )
          .alpha(0.6)
          .restart();
      }
    }
  </script>

