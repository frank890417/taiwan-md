---
/**
 * data.template.astro — /data「資料台灣」資料中樞（v2，2026-10-23）
 *
 * 設計報告：reports/design-data-hub-evolution-2026-10-23.md
 *
 * 三層＋四個支撐區塊：
 *   §1 數字之間的線（跨主題的問題）→ §2 台灣的數字（指標總表）→
 *   §3 國際資料庫裡的台灣 → §4 站上的圖（全站文章量化圖表索引）→
 *   §5 深度資料專題 → §6 資料從哪裡來 → §7 下載與 API → §8 方法
 *
 * 內容 SSOT 在 src/data/data-hub/*.json，數字一個都不寫進 i18n 字串
 * （v1 的八張數字卡就是寫在字串裡才兩年沒人更新）。全部 build 時產生語意
 * HTML 與 inline SVG；JS 只做子導覽 scroll-spy 跟分類篩選，沒有 JS 時
 * 內容一樣全部看得到（graph.md §三.9、§六）。
 */
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import Icon from '../components/Icon.astro';
import IndicatorCard, {
  type CardLabels,
} from '../components/data-hub/IndicatorCard.astro';
import ImpactChain, {
  type ChainStep,
} from '../components/data-hub/ImpactChain.astro';
import TimeBands, { type Band } from '../components/data-hub/TimeBands.astro';
import TerrainRidge from '../components/brand/TerrainRidge.astro';
import ArticleCard from '../components/ArticleCard.astro';
import {
  getLangFromUrl,
  useTranslations,
  useTranslatedPath,
} from '../i18n/utils';
import { getCategoryConfigs, categoryList } from '../utils/categoryConfig';
import { categoryIcons } from '../icons/taiwan-icons.mjs';
import { getCompanyConfigs } from '../utils/dataConfig';
import ly from '../data/ly-budget.json';
import { fmtYi } from '../utils/budgetViz';
import opendata from '../data/opendata-curation.json';
import elections from '../data/elections-2026.json';
import mapMarkers from '../data/map-markers.json';
import {
  indicatorsData,
  threadsData as threadsJson,
  sourcesData as sourcesJson,
  intlData as intlJson,
  storyData as storyJson,
  groupByCategory,
  loc,
  formatIndicator,
  formatNumber,
  type ValueFormat,
  type Indicator,
  type Loc,
} from '../utils/data-hub';
import { getCorpusCharts, summarizeCharts } from '../utils/data-charts';
import { renderVizBlock } from '../utils/article-render';
import {
  getArticleByZhPath,
  getArticleShipDate,
  type ArticleSummary,
} from '../utils/articles-index';
import { trimSummary } from '../utils/article-embeds';
import '../styles/data-hub.css';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);
const prefix = lang === 'zh-TW' ? '' : `/${lang}`;
const cats = getCategoryConfigs(t);
const catName = (c: string) => cats[c]?.name ?? c;
const catColor = (c: string) => `var(--cat-${c})`;
const catIcon = (c: string) =>
  (categoryIcons as Record<string, string>)[c] ?? 'chart';
const fill = (s: string, vars: Record<string, string | number>) =>
  s.replace(/\{(\w+)\}/g, (_, k) => String(vars[k] ?? ''));

// ── 站上文章：zh 路徑 → 本語言的那一篇（沒有譯文就不出連結）──────────────
type Read = { title: string; href: string; category: string };
const readCache = new Map<string, Promise<Read | null>>();
function resolveRead(zhPath: string): Promise<Read | null> {
  let hit = readCache.get(zhPath);
  if (!hit) {
    hit = (async () => {
      const [folder, ...rest] = zhPath.split('/');
      const slug = rest.join('/');
      if (!folder || !slug) return null;
      const r = await getArticleByZhPath(lang, folder.toLowerCase(), slug);
      if (!r || (lang !== 'zh-TW' && r.lang !== lang)) return null;
      return {
        title: r.article.title,
        href: `${prefix}/${r.article.category}/${encodeURIComponent(r.article.slug)}`,
        category: r.article.category,
      };
    })();
    readCache.set(zhPath, hit);
  }
  return hit;
}
async function resolveReads(paths: string[] = [], max = 3): Promise<Read[]> {
  const out = (await Promise.all(paths.map(resolveRead))).filter(
    (r): r is Read => !!r,
  );
  return out.slice(0, max);
}

// ── §2 指標 ──────────────────────────────────────────────────────────
const indicators: Indicator[] = indicatorsData.indicators;
const byId = new Map(indicators.map((i) => [i.id, i]));
const grouped = groupByCategory(indicators);
const groupOrder = (categoryList as string[])
  .filter((c) => grouped.has(c))
  .sort((a, b) => grouped.get(b)!.length - grouped.get(a)!.length);
const indReads = new Map<string, Read[]>();
for (const ind of indicators) {
  indReads.set(ind.id, await resolveReads(ind.articles, 3));
}
const headline = indicators.filter((i) => i.headline).slice(0, 6);
// 機構數：去掉「（資料來源：…）」這類括號註記再數，同一個機關不重複算
const sourceAgencies = new Set(
  indicators.map((i) =>
    loc(i.source.agency, 'zh-TW')
      .replace(/[（(][^）)]*[）)]/g, '')
      .trim(),
  ),
);
const cardLabels: CardLabels = {
  compare: t('dh.card.compare'),
  source: t('dh.card.source'),
  download: t('dh.card.download'),
  reads: t('dh.card.reads'),
  permalink: t('dh.card.permalink'),
  why: t('dh.card.why'),
  year: t('dh.card.year'),
  value: t('dh.card.value'),
  basis: {
    official: t('dh.basis.official'),
    estimate: t('dh.basis.estimate'),
    projection: t('dh.basis.projection'),
    ranking: t('dh.basis.ranking'),
  },
};

// ── 文內嵌入卡（tw-article 同款：共用 ArticleCard embed 密度）────────────
// 跟 utils/article-embeds.ts 同一套規則：zh 路徑反查本語言譯文，譯文還沒出生就
// 退回 zh 文章＋zh 連結；上站日優先取譯文自己的，沒有就取 zh 原文的。
type Embed = {
  article: ArticleSummary;
  lang: string;
  href: string;
  note?: string;
  date?: string;
};
const localeFor = (l: string) =>
  l === 'en' ? 'en-US' : l === 'zh-TW' ? 'zh-TW' : l;
function fmtShipDate(iso: string): string | undefined {
  if (!iso) return undefined;
  const dt = new Date(iso);
  if (Number.isNaN(dt.getTime())) return undefined;
  if (lang === 'zh-TW')
    return `${dt.getFullYear()} 年 ${dt.getMonth() + 1} 月 ${dt.getDate()} 日`;
  return dt.toLocaleDateString(localeFor(lang), {
    year: 'numeric',
    month: 'short',
    day: 'numeric',
  });
}
async function resolveEmbed(zhPath: string, note?: Loc): Promise<Embed | null> {
  const [folder, ...rest] = zhPath.split('/');
  const slug = rest.join('/');
  if (!folder || !slug) return null;
  const hit = await getArticleByZhPath(lang, folder.toLowerCase(), slug);
  if (!hit) return null;
  let ship = await getArticleShipDate(
    hit.lang,
    hit.article.category,
    hit.article.slug,
  );
  if (!ship && hit.lang !== 'zh-TW') {
    ship = await getArticleShipDate('zh-TW', folder.toLowerCase(), slug);
  }
  const p = hit.lang === 'zh-TW' ? '' : `/${hit.lang}`;
  return {
    article: hit.article,
    lang: hit.lang,
    href: `${p}/${hit.article.category}/${encodeURIComponent(hit.article.slug)}`,
    note: note ? loc(note, lang) : undefined,
    date: fmtShipDate(ship),
  };
}

// ── 七章（原「數字之間的線」）────────────────────────────────────────
type Thread = {
  id: string;
  categories: string[];
  question: Loc;
  /** 章的正文，段落以空行分隔（報告 §10.4） */
  essay: Loc;
  /** 章首大字用哪個指標 */
  lead?: string;
  /** 長期主圖：tw-* 模組與各語言的 fenced block 內文 */
  chart?: { module: string; body: Loc };
  /** 影響鏈：層面＋一句有年份的事實＋站內文章 */
  chain?: { layer: Loc; text: Loc; article?: string }[];
  /** 接下來看什麼 */
  next?: Loc;
  /** 延伸閱讀嵌入卡（正文真的講到的那幾篇） */
  embeds?: { path: string; note?: Loc }[];
  indicators: string[];
  articles: string[];
};
const threads = await Promise.all(
  (threadsJson.threads as Thread[]).map(async (th, i) => {
    const chain: ChainStep[] = await Promise.all(
      (th.chain ?? []).map(async (c) => {
        const r = c.article ? await resolveRead(c.article) : null;
        return {
          layer: loc(c.layer, lang),
          text: loc(c.text, lang),
          href: r?.href,
          articleTitle: r?.title,
        };
      }),
    );
    const embeds = (
      await Promise.all(
        (th.embeds ?? []).map((e) => resolveEmbed(e.path, e.note)),
      )
    ).filter((e): e is Embed => !!e);
    const chartBody = th.chart ? loc(th.chart.body, lang) : '';
    return {
      ...th,
      no: String(i + 1).padStart(2, '0'),
      leadInd: th.lead ? byId.get(th.lead) : undefined,
      leadV:
        th.lead && byId.get(th.lead)
          ? formatIndicator(byId.get(th.lead)!, lang)
          : undefined,
      inds: th.indicators
        .map((id) => byId.get(id))
        .filter((i): i is Indicator => !!i),
      reads: embeds.length ? [] : await resolveReads(th.articles, 6),
      chainSteps: chain,
      embedCards: embeds,
      chartHtml:
        th.chart && chartBody
          ? renderVizBlock(th.chart.module, chartBody, lang)
          : '',
      paragraphs: loc(th.essay, lang).split(/\n\n+/),
    };
  }),
);

// ── 總覽：七十五年 ────────────────────────────────────────────────────
type StoryBand = {
  id: string;
  label: Loc;
  unit: Loc;
  format: ValueFormat;
  decimals?: number;
  zero?: boolean;
  series: [number, number][];
};
const ov = (storyJson as any).overview as
  | {
      kicker: Loc;
      title: Loc;
      essay: Loc;
      chartTitle: Loc;
      source: Loc;
      x0: number;
      x1: number;
      bands: StoryBand[];
      eras: { from: number; to: number; label: Loc }[];
      marks: { year: number; label: Loc }[];
    }
  | undefined;
const ovBands: Band[] = (ov?.bands ?? []).map((b) => ({
  id: b.id,
  label: loc(b.label, lang),
  unit: loc(b.unit, lang),
  zero: b.zero,
  series: b.series,
  fmt: (v: number) =>
    formatNumber(v, b.format, lang, b.decimals) +
    (b.format === 'percent' ? '%' : ''),
}));

// ── §4 站上的圖 ──────────────────────────────────────────────────────
// 「關於」分類是 Taiwan.md 寫自己（產線、孢子、模組型錄）的文章，不是台灣的資料，不收
const charts = (await getCorpusCharts(lang)).filter(
  (c) => c.category !== 'about',
);
const chartStats = summarizeCharts(charts);
const chartGroups = (categoryList as string[])
  .map((c) => ({ cat: c, items: charts.filter((x) => x.category === c) }))
  .filter((g) => g.items.length > 0);
// 精選：每個分類挑一張有來源、畫得出形狀的圖（折線／斜率／長條優先）
const FEATURE_ORDER = [
  'tw-line',
  'tw-multiples',
  'tw-slope',
  'tw-bars',
  'tw-dot',
];
const FEATURE_CATS = [
  'society',
  'economy',
  'geography',
  'culture',
  'food',
  'lifestyle',
];
const featured = FEATURE_CATS.map((c) => {
  const pool = charts.filter((x) => x.category === c && x.source);
  for (const m of FEATURE_ORDER) {
    const hit = pool.find((x) => x.module === m);
    if (hit) return hit;
  }
  return undefined;
})
  .filter((c): c is NonNullable<typeof c> => !!c)
  .slice(0, 6)
  .map((c) => ({ ...c, html: renderVizBlock(c.module, c.raw, lang) }))
  .filter((c) => c.html);

// ── §5 深度專題入口：數字都從各自的 SSOT 讀 ─────────────────────────────
const budgetYears = ly.years as any[];
// 最後一筆可能是還沒三讀的預算案（legal 為 null），主數字用最近一個法定年度
const budgetLatest =
  [...budgetYears].reverse().find((y) => y.legal) ??
  budgetYears[budgetYears.length - 1];
const budgetNext = budgetYears.find(
  (y) => y.fy > budgetLatest.fy && y.proposed && !y.legal,
);
const companies = getCompanyConfigs(t);
const top50Cap = companies.reduce((s, c) => s + (c.marketCap || 0), 0);
const tsmc = companies[0];
const isMyriad = ['zh-TW', 'ja', 'ko'].includes(lang);
const capText = (yi: number) =>
  isMyriad
    ? fmtYi(yi, lang)
    : `NT$${new Intl.NumberFormat(lang, { maximumFractionDigits: 1 }).format(yi / 10000)}T`;
const electionDate = new Intl.DateTimeFormat(lang, {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
}).format(new Date(`${(elections as any).election.date}T00:00:00+08:00`));
const odTotals = (opendata as any).totals ?? {};
const portals = [
  {
    href: translatePath('/budget'),
    icon: 'coins',
    title: t('dh.portal.budget.t'),
    desc: t('dh.portal.budget.d'),
    num: fmtYi(budgetLatest.legal ?? budgetLatest.proposed, lang),
    sub: budgetNext
      ? fill(t('dh.portal.budget.n2'), {
          fy: budgetLatest.fy,
          next: budgetNext.fy,
          nextTotal: fmtYi(budgetNext.proposed, lang),
        })
      : fill(t('dh.portal.budget.n'), { fy: budgetLatest.fy }),
  },
  {
    href: translatePath('/companies'),
    icon: 'chart',
    title: t('dh.portal.companies.t'),
    desc: t('dh.portal.companies.d'),
    num: `${((tsmc.marketCap / top50Cap) * 100).toFixed(0)}%`,
    sub: fill(t('dh.portal.companies.n'), { total: capText(top50Cap) }),
  },
  {
    href: translatePath('/opendata'),
    icon: 'archive',
    title: t('dh.portal.opendata.t'),
    desc: t('dh.portal.opendata.d'),
    num: odTotals.domains ? String(odTotals.domains) : '',
    sub: t('dh.portal.opendata.n'),
  },
  {
    href: translatePath('/elections/2026'),
    icon: 'ballot',
    title: t('dh.portal.elections.t'),
    desc: t('dh.portal.elections.d'),
    num: electionDate,
    sub: t('dh.portal.elections.n'),
  },
  {
    href: translatePath('/map'),
    icon: 'map',
    title: t('dh.portal.map.t'),
    desc: t('dh.portal.map.d'),
    num: new Intl.NumberFormat(lang).format((mapMarkers as any[]).length),
    sub: t('dh.portal.map.n'),
  },
  {
    href: translatePath('/taiwan-shape'),
    icon: 'island',
    title: t('dh.portal.shape.t'),
    desc: t('dh.portal.shape.d'),
    num: 'SVG · TopoJSON',
    sub: t('dh.portal.shape.n'),
  },
];

// ── §6 來源目錄、§3 國際資料庫 ────────────────────────────────────────
type SourceItem = {
  name: Loc;
  org?: Loc;
  url: string;
  good: Loc;
  meta?: string[];
  tip?: Loc;
};
type SourceGroup = { id: string; title: Loc; intro?: Loc; items: SourceItem[] };
const sourceGroups = (sourcesJson.groups ?? []) as SourceGroup[];
// 格式／存取標籤：中文標籤在 sources.json 的 tags 字典裡有各語言寫法，CSV、API 這類原樣顯示
const sourceTags = ((sourcesJson as any).tags ?? {}) as Record<string, Loc>;
const tagText = (m: string) => (sourceTags[m] ? loc(sourceTags[m], lang) : m);
const pitfalls = (sourcesJson.pitfalls ?? []) as { title: Loc; body: Loc }[];
const intlRows = intlJson.rows as {
  db: string;
  kind: string;
  label: string;
  url: string;
  note: Loc;
}[];
const intlCount = (k: string) => intlRows.filter((r) => r.kind === k).length;
const selfComputed = intlJson.selfComputed as {
  id: string;
  name: Loc;
  value: string;
  rank: Loc;
  by: Loc;
  url: string;
}[];

// ── 子導覽 ───────────────────────────────────────────────────────────
const toc = [
  ...(ov ? [{ id: 's-overview', label: t('dh.nav.overview') }] : []),
  { id: 's-threads', label: t('dh.nav.threads') },
  { id: 's-numbers', label: t('dh.nav.numbers') },
  { id: 's-intl', label: t('dh.nav.intl') },
  { id: 's-charts', label: t('dh.nav.charts') },
  { id: 's-portals', label: t('dh.nav.portals') },
  { id: 's-sources', label: t('dh.nav.sources') },
  { id: 's-machine', label: t('dh.nav.machine') },
  { id: 's-method', label: t('dh.nav.method') },
];

const verifiedAt = indicatorsData.meta.verifiedAt;
const verifiedText = new Intl.DateTimeFormat(lang, {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
}).format(new Date(`${verifiedAt}T00:00:00+08:00`));
const site = 'https://taiwan.md';
const datasetLd = {
  '@context': 'https://schema.org',
  '@type': 'Dataset',
  name: t('dh.ld.name'),
  description: t('dh.ld.description'),
  url: `${site}${translatePath('/data')}`,
  inLanguage: lang,
  isAccessibleForFree: true,
  license: 'https://creativecommons.org/licenses/by-sa/4.0/',
  creator: { '@type': 'Organization', name: 'Taiwan.md', url: site },
  spatialCoverage: {
    '@type': 'Place',
    name: 'Taiwan',
    sameAs: 'https://www.wikidata.org/wiki/Q865',
  },
  dateModified: verifiedAt,
  variableMeasured: indicators.map((i) => loc(i.title, lang)),
  distribution: [
    {
      '@type': 'DataDownload',
      encodingFormat: 'text/csv',
      contentUrl: `${site}/data/taiwan-indicators.csv`,
    },
    {
      '@type': 'DataDownload',
      encodingFormat: 'application/json',
      contentUrl: `${site}/data/taiwan-indicators.json`,
    },
  ],
};
---

<Layout
  lang={lang}
  title={t('dh.meta.title')}
  description={t('dh.meta.description')}
  readerSettings={true}
>
  <link
    rel="stylesheet"
    href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500&family=Newsreader:opsz,wght@6..72,400..600&display=swap"
  />
  <main class="data-hub min-h-screen">
    <div class="dh-hero">
      <TerrainRidge
        class="dh-hero-ridge"
        stroke="rgba(233, 240, 238, 0.3)"
        accent="#45c2ab"
        bg="var(--dh-hero-bg)"
        strokeWidth={3.4}
      />
      <PageHero
        eyebrow={t('dh.hero.eyebrow')}
        title={t('dh.hero.title')}
        subtitle={t('dh.hero.subtitle')}
        titleSize="clamp"
        containerWidth="wide"
        bgTone="dark"
        accentColor="#45c2ab"
      >
        <p class="dh-hero-lede">{t('dh.hero.lede')}</p>
        {
          headline.length > 0 && (
            <section class="dh-today" aria-labelledby="dh-today-h">
              <h2 class="dh-today-h" id="dh-today-h">
                {t('dh.today.h')}
              </h2>
              <ul class="dh-today-grid">
                {headline.map((ind) => {
                  const v = formatIndicator(ind, lang);
                  return (
                    <li style={`--dh-cat:${catColor(ind.category)}`}>
                      <a href={`#ind-${ind.id}`}>
                        <div class="dh-today-v">
                          {v.prefix}
                          {v.number}
                          {v.unit && <small>{v.unit}</small>}
                        </div>
                        <div class="dh-today-l">{loc(ind.title, lang)}</div>
                        <div class="dh-today-p">{loc(ind.period, lang)}</div>
                      </a>
                    </li>
                  );
                })}
              </ul>
              <p class="dh-today-foot">
                {fill(t('dh.today.foot'), { date: verifiedText })}
              </p>
            </section>
          )
        }
      </PageHero>
    </div>

    <nav class="dh-subnav" aria-label={t('dh.subnav.label')} id="dh-subnav">
      <div class="dh-subnav-in">
        {
          toc.map((s) => (
            <a href={`#${s.id}`} data-target={s.id}>
              {s.label}
            </a>
          ))
        }
      </div>
    </nav>

    {
      ov && (
        <section class="dh-section is-tint" id="s-overview">
          <div class="dh-wrap">
            <header class="dh-sec-head">
              <p class="dh-kicker">{loc(ov.kicker, lang)}</p>
              <h2 class="dh-h2 is-display">{loc(ov.title, lang)}</h2>
            </header>
            <div class="dh-essay is-lead">
              {loc(ov.essay, lang)
                .split(/\n\n+/)
                .map((p) => (
                  <p>{p}</p>
                ))}
            </div>
            {ovBands.length > 0 && (
              <TimeBands
                title={loc(ov.chartTitle, lang)}
                bands={ovBands}
                eras={ov.eras.map((e) => ({ ...e, label: loc(e.label, lang) }))}
                marks={ov.marks.map((m) => ({
                  ...m,
                  label: loc(m.label, lang),
                }))}
                x0={ov.x0}
                x1={ov.x1}
                source={loc(ov.source, lang)}
                sourceLabel={t('dh.tb.source')}
                yearLabel={t('dh.card.year')}
                tableCaption={loc(ov.chartTitle, lang)}
                marksLabel={t('dh.tb.marks')}
              />
            )}
            <nav class="dh-ch-index" aria-labelledby="dh-ch-index-h">
              <h3 class="dh-ch-index-h" id="dh-ch-index-h">
                {t('dh.overview.index')}
              </h3>
              <ol>
                {threads.map((th) => (
                  <li>
                    <a href={`#thread-${th.id}`}>
                      <span class="dh-ch-index-no">{th.no}</span>
                      <span>{loc(th.question, lang)}</span>
                    </a>
                  </li>
                ))}
              </ol>
            </nav>
          </div>
        </section>
      )
    }

    <!-- §1 七章：每章一個問題，固定六段（報告 §10.4） -->
