---
import Layout from '../layouts/Layout.astro';
import { getLangFromUrl } from '../i18n/utils';
import electionsData from '../data/elections-2026.json';
import i18nData from '../data/elections-2026-candidates.json';

type Copy = {
  metaTitle: string;
  metaDescription: string;
  breadcrumbHome: string;
  breadcrumbHere: string;
  eyebrow: string;
  title: string;
  subtitle: string;
  searchLabel: string;
  searchPlaceholder: string;
  showing: string; // {shown} {total}
  noResult: string;
  statsTitle: string;
  statTotal: string;
  statRaces: string;
  statCouncil: string;
  distTitle: string;
  distRow: string; // {n} {k}
  distRaces: string;
  partyTitle: string;
  partyNote: string;
  partyRow: string; // {party} {n}
  groupMunicipal: string;
  groupCounty: string;
  groupCount: string; // {n}
  candidateCount: string; // {n}
  incumbent: string;
  rosterLink: string;
  qualifiedLink: string;
  sourceLabel: string;
  listSep: string;
  orderNote: string;
  incumbentNote: string;
  incumbentNoteLink: string;
  nextTitle: string;
  nextIntro: string;
  nextItems: Array<{ date: string; label: string; desc: string }>;
  nextSource: string;
  bulletinLinkLabel: string;
  scheduleLinkLabel: string;
  councilTitle: string;
  councilMunicipal: string; // {reg} {ok}
  councilCounty: string; // {reg} {ok}
  councilSource: string;
  footTitle: string;
