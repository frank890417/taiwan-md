    councilTitle: '議員候補者の総数',
    councilMunicipal: '直轄市議員：登録受理 {reg}人、資格適合 {ok}人。',
    councilCounty: '県（市）議員：登録受理 {reg}人、資格適合 {ok}人。',
    councilSource: '出典：中央選挙委員会 10月16日の発表',
    footTitle: '選挙特集のほかのページ',
    footHome: '選挙特集に戻る',
    footLinks: [
      { slug: 'timeline', label: 'タイムライン' },
      { slug: 'donations', label: '政治献金' },
      { slug: 'perspectives', label: 'さまざまな視点' },
    ],
    jsonDescription: '2026年台湾統一地方選挙 市長・県知事候補者名簿',
  },
};

const lang = getLangFromUrl(Astro.url);
const langPrefix = lang === 'zh-TW' ? '' : `/${lang}`;
const cl = lang in copyAll ? lang : 'en';
const c = copyAll[cl];
const isZh = cl === 'zh-TW';
const fill = (tpl: string, vars: Record<string, string | number>) =>
  tpl.replace(/\{(\w+)\}/g, (_, k: string) => String(vars[k] ?? ''));

const areaI18n = i18nData.areaI18n as Record<string, Record<string, string>>;
const partyI18n = i18nData.partyI18n as Record<string, Record<string, string>>;
const areaLabel = (a: string) => (isZh ? a : (areaI18n[a]?.[cl] ?? a));
const partyLabel = (p: string) =>
  isZh ? p : (partyI18n[p]?.[cl] ?? partyI18n[p]?.en ?? p);

const races = electionsData.races;
const groups = [
  {
    key: 'municipal',
    label: c.groupMunicipal,
    races: races.filter((r) => r.group === 'municipal'),
  },
  {
    key: 'county',
    label: c.groupCounty,
    races: races.filter((r) => r.group === 'county'),
  },
];
const total = races.reduce((n, r) => n + r.candidates.length, 0);

// 各選區人數分布（人數由少到多，這是數值順序，不是排名）
const dist = new Map<number, string[]>();
for (const r of races) {
  const n = r.candidates.length;
  dist.set(n, [...(dist.get(n) ?? []), r.area]);
}
const distRows = [...dist.entries()].sort((a, b) => a[0] - b[0]);

// 各政黨推薦人數：依顯示名稱的筆畫（中文）或字母排序，不依人數
const partyCount = new Map<string, number>();
for (const r of races)
  for (const cand of r.candidates)
    partyCount.set(cand.party, (partyCount.get(cand.party) ?? 0) + 1);
const sortLocale = isZh ? 'zh-Hant-u-co-stroke' : cl;
const partyRows = [...partyCount.entries()]
  .map(([party, n]) => ({ party, n, label: partyLabel(party) }))
  .sort((a, b) => a.label.localeCompare(b.label, sortLocale));

const raceId = (area: string) =>
  `race-${races.findIndex((r) => r.area === area) + 1}`;

const src = electionsData.sources;
const councilNumbers = {
  municipal: { reg: 610, ok: 605 },
  county: { reg: 892, ok: 887 },
};
const councilTotal = councilNumbers.municipal.ok + councilNumbers.county.ok;

const toJsonLd = (data: unknown) =>
  JSON.stringify(data).replace(/</g, '\\u003c');
const site = Astro.site ?? Astro.url;
const jsonLd = toJsonLd({
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: c.breadcrumbHome,
      item: new URL(`${langPrefix}/elections/2026/`, site).toString(),
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: c.breadcrumbHere,
      item: new URL(
        `${langPrefix}/elections/2026/candidates/`,
        site,
      ).toString(),
    },
  ],
});

const linkCls =
  'text-[#6b7280] underline decoration-[#d1d5db] underline-offset-2 hover:text-[#374151]';
const serif = "font-family: 'Noto Serif TC', serif;";
const heading = "font-family: 'jf-lanyangming', 'Noto Serif TC', serif;";
---

<Layout
  lang={lang}
  title={c.metaTitle}
  description={c.metaDescription}
  readerSettings
>
  <div class="elections-candidates">
    <!-- Hero -->
    <section
      class="border-b border-[#e7d9b8] bg-gradient-to-b from-[#fef9ed] via-[#fdf6e3] to-[#fbf3df]"
    >
      <div class="mx-auto max-w-[920px] px-4 pb-12 pt-8 md:px-6 md:pb-16">
        <nav aria-label="breadcrumb" class="mb-8 text-sm text-[#78716c]">
          <a
            href={`${langPrefix}/elections/2026/`}
            class="text-[#7c2d12] underline decoration-[#7c2d12]/30 underline-offset-2 hover:decoration-[#7c2d12]"
            >{c.breadcrumbHome}</a
          >
          <span aria-hidden="true" class="mx-1.5">/</span>
          <span aria-current="page">{c.breadcrumbHere}</span>
        </nav>

        <div
          class="mb-3 text-center font-mono text-xs uppercase tracking-[0.18em] text-[#92400e]"
        >
          {c.eyebrow}
        </div>
        <h1
          class="mb-4 text-center text-[2.1rem] font-bold leading-[1.2] text-[#7c2d12] md:text-[3rem]"
          style={heading}
        >
          {c.title}
        </h1>
        <p
          class="mx-auto max-w-[640px] text-center text-base leading-[1.75] text-[#52525b] md:text-lg"
        >
          {c.subtitle}
        </p>
      </div>
    </section>

    <!-- 統計 -->
    <section class="bg-[#fdfaf2] py-12 md:py-16">
      <div class="mx-auto max-w-[920px] px-4 md:px-6">
        <h2
          class="mb-6 text-[1.5rem] font-light text-[#1f2937] md:text-[1.9rem]"
          style={heading}
        >
          {c.statsTitle}
        </h2>

        <dl class="mb-8 grid grid-cols-2 gap-3 sm:grid-cols-3">
          <div class="rounded-xl border-[1.5px] border-[#e5e7eb] bg-white p-4">
            <dt class="text-xs text-[#78716c]">{c.statTotal}</dt>
            <dd class="m-0 text-3xl font-bold text-[#7c2d12]">{total}</dd>
          </div>
          <div class="rounded-xl border-[1.5px] border-[#e5e7eb] bg-white p-4">
            <dt class="text-xs text-[#78716c]">{c.statRaces}</dt>
            <dd class="m-0 text-3xl font-bold text-[#7c2d12]">
              {races.length}
            </dd>
          </div>
          <div
            class="col-span-2 rounded-xl border-[1.5px] border-[#e5e7eb] bg-white p-4 sm:col-span-1"
          >
            <dt class="text-xs text-[#78716c]">{c.statCouncil}</dt>
            <dd class="m-0 text-3xl font-bold text-[#7c2d12]">
              {councilTotal}
            </dd>
          </div>
        </dl>

        <div class="grid gap-6 md:grid-cols-2">
          <div class="rounded-xl border-[1.5px] border-[#e5e7eb] bg-white p-5">
            <h3
              class="mb-3 text-base font-semibold text-[#1f2937]"
              style={serif}
            >
              {c.distTitle}
            </h3>
            <ul class="m-0 list-none space-y-2.5 p-0">
              {
                distRows.map(([n, areas]) => (
                  <li class="text-sm leading-[1.7] text-[#374151]">
                    <span class="font-semibold text-[#7c2d12]">
                      {fill(c.distRow, { n })}
                    </span>
                    <span class="text-[#78716c]">
                      {' · '}
                      {fill(c.distRaces, { k: areas.length })}
                    </span>
                    <div class="text-[#6b7280]">
                      {areas.map((a, i) => (
                        <>
                          {i > 0 && <span>{isZh ? '、' : ', '}</span>}
                          <a href={`#${raceId(a)}`} class={linkCls}>
                            {areaLabel(a)}
                          </a>
                        </>
                      ))}
                    </div>
                  </li>
                ))
              }
            </ul>
          </div>

          <div class="rounded-xl border-[1.5px] border-[#e5e7eb] bg-white p-5">
            <h3
              class="mb-1 text-base font-semibold text-[#1f2937]"
              style={serif}
            >
              {c.partyTitle}
            </h3>
            <p class="mb-3 text-xs leading-[1.6] text-[#78716c]">
              {c.partyNote}
            </p>
            <ul class="m-0 list-none space-y-1 p-0">
              {
                partyRows.map((p) => (
                  <li class="flex items-baseline justify-between gap-3 text-sm text-[#374151]">
                    <span
                      lang={isZh || partyI18n[p.party] ? undefined : 'zh-Hant'}
                    >
                      {p.label}
                    </span>
                    <span class="tabular-nums text-[#6b7280]">
                      {fill(c.candidateCount, { n: p.n })}
                    </span>
                  </li>
                ))
              }
            </ul>
          </div>
        </div>
      </div>
    </section>

    <!-- 名冊 -->
    <section id="roster" class="bg-white py-12 md:py-16">
      <div class="mx-auto max-w-[1080px] px-4 md:px-6">
        <!-- 搜尋框：沒有 JS 時整塊隱藏，所有卡片照常顯示 -->
        <div id="cand-search-wrap" class="mb-8 hidden">
          <label
            for="cand-search"
            class="mb-2 block text-sm font-semibold text-[#1f2937]"
            >{c.searchLabel}</label
          >
          <input
            id="cand-search"
            type="search"
            autocomplete="off"
            placeholder={c.searchPlaceholder}
            class="w-full rounded-xl border-[1.5px] border-[#e5e7eb] bg-[#fdfaf2] px-4 py-3 text-base text-[#1f2937] outline-none focus:border-[#7c2d12]/50"
          />
          <p
            id="cand-status"
            class="mt-2 text-xs text-[#78716c]"
            aria-live="polite"
            data-tpl={c.showing}
            data-total={races.length}
          >
          </p>
        </div>

        {
          groups.map((g) => (
            <div class="cand-group mb-12 last:mb-0" data-cand-group={g.key}>
              <h2
                class="mb-5 flex flex-wrap items-baseline gap-x-3 border-b border-[#e7d9b8] pb-2 text-xl font-semibold text-[#1f2937]"
                style={serif}
              >
                {g.label}
                <span class="text-sm font-normal text-[#78716c]">
                  {fill(c.groupCount, { n: g.races.length })}
                </span>
              </h2>
              <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
                {g.races.map((race) => {
                  const hasIncumbent = race.candidates.some((x) => x.incumbent);
                  const searchText = [
                    race.area,
                    areaLabel(race.area),
                    ...race.candidates.flatMap((x) => [
                      x.name,
                      x.party,
                      partyLabel(x.party),
                    ]),
                  ]
                    .join(' ')
                    .toLowerCase();
                  return (
                    <article
                      id={raceId(race.area)}
                      class="cand-card flex scroll-mt-24 flex-col rounded-xl border-[1.5px] border-[#e5e7eb] bg-white p-5"
                      data-search={searchText}
                    >
                      <header class="mb-3 flex items-baseline justify-between gap-3">
                        <h3
                          class="text-lg font-semibold text-[#1f2937]"
                          style={serif}
                        >
                          {areaLabel(race.area)}
                          {!isZh && (
                            <span
                              class="ml-2 text-sm font-normal text-[#9ca3af]"
                              lang="zh-Hant"
                            >
                              {race.area}
                            </span>
                          )}
                        </h3>
                        <span class="shrink-0 text-xs text-[#78716c]">
                          {fill(c.candidateCount, {
                            n: race.candidates.length,
                          })}
                        </span>
                      </header>
                      <ul class="m-0 list-none divide-y divide-[#f1f0ec] p-0">
                        {race.candidates.map((cand) => (
                          <li class="flex flex-wrap items-baseline gap-x-2 gap-y-0.5 py-2">
                            <span
                              class="text-base font-semibold text-[#1f2937]"
                              lang={isZh ? undefined : 'zh-Hant'}
                            >
                              {cand.name}
                            </span>
                            <span
                              class="text-sm text-[#6b7280]"
                              lang={
                                isZh || partyLabel(cand.party) !== cand.party
                                  ? undefined
                                  : 'zh-Hant'
                              }
                            >
                              {partyLabel(cand.party)}
                            </span>
                            {cand.incumbent && (
                              <span class="rounded border border-[#d1d5db] px-1.5 text-[11px] leading-[1.5] text-[#6b7280]">
                                {c.incumbent}
                              </span>
                            )}
                          </li>
                        ))}
                      </ul>
                      <footer class="mt-auto pt-3 text-[11px] leading-[1.6] text-[#9ca3af]">
                        <p class="m-0">
                          {c.sourceLabel}
                          <a
                            href={race.rosterSource}
                            target="_blank"
                            rel="noopener noreferrer"
                            class={linkCls}
                          >
                            {c.rosterLink}
                          </a>
                          {c.listSep}
                          <a
                            href={race.source}
                            target="_blank"
                            rel="noopener noreferrer"
                            class={linkCls}
                          >
                            {c.qualifiedLink}
                          </a>
                          {hasIncumbent && (
                            <>
                              {c.listSep}
                              <a
                                href={src.incumbent}
                                target="_blank"
                                rel="noopener noreferrer"
                                class={linkCls}
                              >
                                {c.incumbentNoteLink}
                              </a>
                            </>
                          )}
                        </p>
                      </footer>
                    </article>
                  );
                })}
              </div>
            </div>
          ))
        }

        <p
          id="cand-empty"
          class="hidden rounded-xl border border-dashed border-[#d6c9a8] bg-[#fef9ed] p-6 text-center text-sm text-[#78716c]"
        >
          {c.noResult}
        </p>

        <div
          class="mt-10 space-y-2 rounded-xl border border-dashed border-[#d6c9a8] bg-[#fef9ed] p-5 text-sm leading-[1.75] text-[#52525b]"
        >
          <p class="m-0">{c.orderNote}</p>
          <p class="m-0">
            {c.incumbentNote}
            <a
              href={src.incumbent}
              target="_blank"
              rel="noopener noreferrer"
              class="text-[#7c2d12] underline underline-offset-2"
              >{c.incumbentNoteLink}</a
            >
          </p>
        </div>
      </div>
    </section>

    <!-- 接下來會發生什麼 -->
    <section class="bg-[#fdfaf2] py-12 md:py-16">
      <div class="mx-auto max-w-[760px] px-4 md:px-6">
        <h2
          class="mb-3 text-[1.5rem] font-light text-[#1f2937] md:text-[1.9rem]"
          style={heading}
        >
          {c.nextTitle}
        </h2>
        <p class="mb-8 text-base leading-[1.75] text-[#52525b]">
          {c.nextIntro}
        </p>
        <ol class="m-0 list-none space-y-4 p-0">
          {
            c.nextItems.map((it) => (
              <li class="rounded-xl border-[1.5px] border-[#e5e7eb] bg-white p-5">
                <div class="mb-1 font-mono text-xs tracking-wide text-[#92400e]">
                  {it.date}
                </div>
                <h3
                  class="mb-1 text-base font-semibold text-[#1f2937]"
                  style={serif}
                >
                  {it.label}
                </h3>
                <p class="m-0 text-sm leading-[1.7] text-[#52525b]">
                  {it.desc}
                </p>
              </li>
            ))
          }
        </ol>
        <p class="mt-5 text-xs leading-[1.7] text-[#78716c]">
          {c.nextSource}
          <a
            href={src.schedule}
            target="_blank"
            rel="noopener noreferrer"
            class={linkCls}>{c.scheduleLinkLabel}</a
          >{c.listSep}
          <a
            href={src.bulletin}
            target="_blank"
            rel="noopener noreferrer"
            class={linkCls}>{c.bulletinLinkLabel}</a
          >
        </p>

        <div
          class="mt-8 rounded-xl border border-dashed border-[#d6c9a8] bg-[#fef9ed] p-5 text-sm leading-[1.75] text-[#52525b]"
        >
          <h3 class="mb-2 text-base font-semibold text-[#1f2937]" style={serif}>
            {c.councilTitle}
          </h3>
          <p class="m-0">
            {fill(c.councilMunicipal, councilNumbers.municipal)}
          </p>
          <p class="m-0">{fill(c.councilCounty, councilNumbers.county)}</p>
          <p class="mt-2 text-xs text-[#78716c]">
            <a
              href={src.qualified}
              target="_blank"
              rel="noopener noreferrer"
              class={linkCls}>{c.councilSource}</a
            >
          </p>
        </div>
      </div>
    </section>

    <!-- 底部導覽 -->
    <section class="bg-white py-12">
      <div class="mx-auto max-w-[760px] px-4 text-center md:px-6">
        <h2 class="mb-5 text-lg font-semibold text-[#1f2937]" style={serif}>
          {c.footTitle}
        </h2>
        <div class="flex flex-wrap justify-center gap-2.5">
          <a
            href={`${langPrefix}/elections/2026/`}
            class="rounded-full border-[1.5px] border-[#7c2d12]/40 bg-[#fef2ec] px-5 py-2 text-sm font-semibold text-[#7c2d12] no-underline"
            >← {c.footHome}</a
          >
          {
            c.footLinks.map((l) => (
              <a
                href={`${langPrefix}/elections/2026/${l.slug}/`}
                class="rounded-full border-[1.5px] border-[#7c2d12]/25 bg-white px-5 py-2 text-sm font-semibold text-[#7c2d12] no-underline hover:bg-[#fef2ec]"
              >
                {l.label}
              </a>
            ))
          }
        </div>
      </div>
    </section>

    {/* BreadcrumbList 由全站 SEO.astro 依網址產生，子頁不重複輸出 */}
  </div>
</Layout>

<script>
  const wrap = document.getElementById('cand-search-wrap');
  const input = document.getElementById(
    'cand-search',
  ) as HTMLInputElement | null;
  const status = document.getElementById('cand-status');
  const empty = document.getElementById('cand-empty');
  const cards = Array.from(
    document.querySelectorAll<HTMLElement>('.cand-card'),
  );
  const groups = Array.from(
    document.querySelectorAll<HTMLElement>('.cand-group'),
  );

  function apply() {
    const q = (input?.value ?? '').trim().toLowerCase();
    const terms = q.split(/\s+/).filter(Boolean);
    let shown = 0;
    for (const card of cards) {
      const hay = card.dataset.search ?? '';
      const ok = terms.every((t) => hay.includes(t));
      card.hidden = !ok;
      if (ok) shown++;
    }
    for (const g of groups) {
      g.hidden = !g.querySelector('.cand-card:not([hidden])');
    }
    if (empty) empty.classList.toggle('hidden', shown > 0);
    if (status) {
      const tpl = status.dataset.tpl ?? '';
      status.textContent = tpl
        .replace('{shown}', String(shown))
        .replace('{total}', status.dataset.total ?? String(cards.length));
    }
  }

  if (wrap && input) {
    wrap.classList.remove('hidden');
    input.addEventListener('input', apply);
    apply();
  }
</script>

<style>
  .cand-card[hidden],
  .cand-group[hidden] {
    display: none;
  }
</style>
