---
import Layout from '../layouts/Layout.astro';
import { getLangFromUrl } from '../i18n/utils';
import donationsDataRaw from '../data/elections-2026-donations.json';

// 2026 九合一選舉：政治獻金透明度子頁。
// 只寫規則、時程、查詢方法；不寫任何候選人的金額或評論。
// 每個事實的原文出處：reports/research/2026-10/elections-2026/donations-sources.json

type DonationsData = {
  lastVerified: string;
  electionDate: string;
  sources: Record<string, string>;
  timeline: Array<{ id: string; iso: string | null; byDate?: boolean }>;
  limits: {
    rows: Array<{ donor: string; same: number; all: number }>;
    partyToNominee: Array<{ office: string; amount: number }>;
  };
  spendingCaps: {
    announcementNo: string;
    announcementDate: string;
    municipalMayors: Array<{ area: string; cap: number }>;
    countyMayors: Array<{ area: string; cap: number }>;
  };
  previousPublication: Array<{ iso: string; scope: string }>;
};

type Steps = {
  name: string;
  site: string;
  desc: string;
  url: string;
  steps: string[];
  note?: string;
};

type DonationsCopy = {
  metaTitle: string;
  metaDescription: string;
  breadcrumbHome: string;
  breadcrumbHere: string;
  eyebrow: string;
  titlePrefix: string;
  titleEmphasis: string;
  titleSuffix: string;
  subtitle: string;
  stance: string;
  facts: Array<{ value: string; label: string }>;
  nav: Array<{ href: string; label: string }>;
  navLabel: string;
  // 出處列
  sourceLabel: string;
  sourceNote: string;
  listSep: string;
  groupSep: string;
  pdlName: string;
  svlName: string;
  artLabel: (n: number) => string;
  docs: Record<string, string>;
  money: (n: number) => string;
  byDate: (date: string) => string;
  timeline: {
    title: string;
    intro: string;
    doneLabel: string;
    nextLabel: string;
    publishDate: string;
    labels: Record<string, string>;
  };
  who: {
    title: string;
    receiveTitle: string;
    receiveBody: string[];
    donateTitle: string;
    donateBody: string;
    excluded: string[];
    memberNote: string;
    foreignNote: string;
  };
  limits: {
    title: string;
    intro: string;
    colDonor: string;
    colSame: string;
    colAll: string;
    donors: Record<string, string>;
    partyTitle: string;
    partyIntro: string;
    offices: Record<string, string>;
    penalty: string;
  };
  cash: {
    title: string;
    items: string[];
  };
  account: {
    title: string;
    items: string[];
    tipTitle: string;
    tip: string;
  };
  tax: {
    title: string;
    items: string[];
  };
  caps: {
    title: string;
    intro: string;
    formulaTitle: string;
    formula: string;
    usesTitle: string;
    uses: string;
    tableMunicipal: string;
    tableCounty: string;
    colArea: string;
    colCap: string;
    note: string;
  };
  subsidy: {
    title: string;
    items: string[];
    example: string;
  };
  report: {
    title: string;
    items: string[];
    prevTitle: string;
    prevIntro: string;
    prev: Record<string, string>;
    prevOutro: string;
  };
  howto: {
    title: string;
    intro: string;
    stepsLabel: string;
    accounts: Steps;
    ardata: Steps;
    g0v: Steps;
    whenTitle: string;
    when: string;
  };
  related: {
    title: string;
    articles: Array<{ href: string; title: string; desc: string }>;
  };
  footTitle: string;
  footHome: string;
  footLinks: Array<{ slug: string; label: string }>;
  verified: (date: string) => string;
};

const data = donationsDataRaw as unknown as DonationsData;
const src = data.sources;

// 選區名稱：中文頁用中選會用字，英日文頁用譯名（另附中文原字）
