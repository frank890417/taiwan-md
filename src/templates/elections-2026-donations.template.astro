    <!-- 選舉補貼 -->
    <section class="bg-[#fdfaf2] py-16 md:py-20">
      <div class="mx-auto max-w-[760px] px-4 md:px-6">
        <h2 class={h2Cls} style={heading}>{c.subsidy.title}</h2>
        <div class={`mt-8 ${cardCls}`}>
          <ul
            class="list-disc space-y-3 pl-5 text-[0.95rem] leading-[1.8] text-[#374151] marker:text-[#92400e]"
          >
