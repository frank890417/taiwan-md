        >
          <h3 class="mb-2 text-base font-semibold text-[#7c2d12]" style={serif}>
            {c.howto.whenTitle}
          </h3>
          <p class="text-sm leading-[1.8] text-[#374151]">{c.howto.when}</p>
        </div>

        <p class={sourceCls} set:html={srcHtml('howto')} />
        {
          c.sourceNote && (
            <p class="mt-1 text-xs italic text-[#9ca3af]">{c.sourceNote}</p>
          )
        }
      </div>
    </section>

    <!-- 延伸閱讀 -->
    <section class="bg-white py-16 md:py-20">
      <div class="mx-auto max-w-[1080px] px-4 md:px-6">
        <h2 class={h2Cls} style={heading}>{c.related.title}</h2>
        <div class="mt-8 grid gap-4 md:grid-cols-3">
          {
            c.related.articles.map((ar) => (
              <a
                href={ar.href}
                class="group block rounded-xl border-[1.5px] border-[#e5e7eb] bg-white p-6 no-underline transition-all duration-[200ms] hover:-translate-y-px hover:border-[#7c2d12]/30 hover:bg-[#fef9ed] hover:shadow-[0_4px_16px_rgba(124,45,18,0.06)]"
              >
                <h3
                  class="mb-2 text-lg font-semibold text-[#1f2937] group-hover:text-[#7c2d12]"
                  style={serif}
                >
                  {ar.title}
                </h3>
                <p class="text-sm leading-[1.65] text-[#6b7280]">{ar.desc}</p>
              </a>
            ))
          }
        </div>
      </div>
    </section>

    <!-- 底部導覽 -->
    <section class="border-t border-[#e7d9b8] bg-[#fef9ed] py-12">
      <div class="mx-auto max-w-[760px] px-4 text-center md:px-6">
        <h2 class="mb-5 text-lg font-semibold text-[#1f2937]" style={serif}>
          {c.footTitle}
        </h2>
        <div class="flex flex-wrap justify-center gap-2.5">
          <a
            href={`${langPrefix}/elections/2026/`}
            class="rounded-full border-[1.5px] border-[#7c2d12]/40 bg-[#fef2ec] px-5 py-2 text-sm font-semibold text-[#7c2d12] no-underline"
            >← {c.footHome}</a
          >
          {
            c.footLinks.map((l) => (
              <a
                href={`${langPrefix}/elections/2026/${l.slug}/`}
                class="rounded-full border-[1.5px] border-[#7c2d12]/25 bg-white px-5 py-2 text-sm font-semibold text-[#7c2d12] no-underline hover:bg-[#fef2ec]"
              >
                {l.label}
              </a>
            ))
          }
        </div>
        <p class="mt-8 text-xs text-[#9ca3af]">
          <time datetime={data.lastVerified}>
            {c.verified(fmtDate(data.lastVerified))}
          </time>
        </p>
      </div>
    </section>

    {/* BreadcrumbList 由全站 SEO.astro 依網址產生，子頁不重複輸出 */}
  </div>
</Layout>

<style>
  .elections-donations {
    overflow-wrap: anywhere;
  }
  .elections-donations .anchor-section {
    scroll-margin-top: 80px;
  }
  .elections-donations .hero-title {
    letter-spacing: -0.02em;
  }
  .elections-donations h2 {
    letter-spacing: -0.01em;
  }
  .hero::before {
    content: '';
    position: absolute;
    inset: 0;
    background-image:
      radial-gradient(
        circle at 20% 30%,
        rgba(124, 45, 18, 0.05) 0%,
        transparent 50%
      ),
      radial-gradient(
        circle at 80% 70%,
        rgba(146, 64, 14, 0.04) 0%,
        transparent 50%
      );
    pointer-events: none;
  }
</style>
