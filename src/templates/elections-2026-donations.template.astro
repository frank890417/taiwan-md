const lang = getLangFromUrl(Astro.url);
const langPrefix = lang === 'zh-TW' ? '' : `/${lang}`;
const cl = lang in copyAll ? lang : 'en';
const c = copyAll[cl];
const isZh = cl === 'zh-TW';

// 日期：中文 2026/4/22、日文 2026年4月22日、其他 Apr 22, 2026
const fmtDate = (iso: string) => {
  const d = new Date(`${iso}T00:00:00Z`);
  const y = d.getUTCFullYear();
  const m = d.getUTCMonth() + 1;
  const day = d.getUTCDate();
  if (cl === 'zh-TW') return `${y}/${m}/${day}`;
  if (cl === 'ja') return `${y}年${m}月${day}日`;
  return new Intl.DateTimeFormat('en-US', {
    year: 'numeric',
    month: 'short',
    day: 'numeric',
    timeZone: 'UTC',
  }).format(d);
};

// 時間軸狀態：建置當天（台北時間）之前的標「已過」，第一個未到的標「下一站」
const todayIso = new Date(Date.now() + 8 * 60 * 60 * 1000)
  .toISOString()
  .slice(0, 10);
const nextIdx = data.timeline.findIndex((t) => !t.iso || t.iso >= todayIso);
const timelineRows = data.timeline.map((t, i) => ({
  id: t.id,
  date: t.iso
    ? t.byDate
      ? c.byDate(fmtDate(t.iso))
      : fmtDate(t.iso)
    : c.timeline.publishDate,
  iso: t.iso,
  label: c.timeline.labels[t.id] ?? t.id,
  done: i < nextIdx,
  next: i === nextIdx,
  local: t.id === 'applyLocal',
}));

const areaLabel = (area: string) =>
  isZh ? area : (areaI18n[area]?.[cl === 'ja' ? 'ja' : 'en'] ?? area);
