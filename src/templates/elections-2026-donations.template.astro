  const parts = groups.map((g) => {
    if ('law' in g) {
      const base = g.law === 'pdl' ? src.pdlArticle : src.svlArticle;
      const name = g.law === 'pdl' ? c.pdlName : c.svlName;
      const links = g.arts
        .map((n) => a(`${base}${n}`, c.artLabel(n)))
        .join(esc(c.listSep));
      return `${esc(name)} ${links}`;
    }
    return g.docs
      .filter((k) => src[k] && c.docs[k])
      .map((k) => a(src[k], c.docs[k]))
      .join(esc(c.listSep));
  });
  return `${esc(c.sourceLabel)}${parts.join(esc(c.groupSep))}`;
};

const toJsonLd = (value: unknown) =>
  JSON.stringify(value).replace(/</g, '\\u003c');
const site = Astro.site ?? Astro.url;
const jsonLd = toJsonLd({
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: c.breadcrumbHome,
      item: new URL(`${langPrefix}/elections/2026/`, site).toString(),
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: c.breadcrumbHere,
      item: new URL(`${langPrefix}/elections/2026/donations/`, site).toString(),
    },
  ],
});

const heading = "font-family: 'jf-lanyangming', 'Noto Serif TC', serif;";
const serif = "font-family: 'Noto Serif TC', serif;";
const sourceCls = 'mt-6 text-xs leading-[1.9] text-[#78716c]';
const h2Cls =
  'mb-4 text-center text-[1.6rem] font-light text-[#1f2937] md:text-[2.1rem]';
const cardCls =
  'rounded-2xl border-[1.5px] border-[#e7d9b8] bg-white/80 p-6 md:p-8';
const howtoCards = [c.howto.accounts, c.howto.ardata, c.howto.g0v];
