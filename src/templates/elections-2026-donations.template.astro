  連江縣: { en: 'Lienchiang County', ja: '連江県' },
  基隆市: { en: 'Keelung City', ja: '基隆市' },
  新竹市: { en: 'Hsinchu City', ja: '新竹市' },
  嘉義市: { en: 'Chiayi City', ja: '嘉義市' },
