        <ol class="relative list-none border-l-2 border-[#e7d9b8] pl-6">
          {
            timelineRows.map((t) => (
              <li class="relative mb-6 last:mb-0">
                <span
                  aria-hidden="true"
                  class:list={[
                    'absolute -left-[33px] top-1.5 h-4 w-4 rounded-full border-2',
                    t.next
                      ? 'border-[#7c2d12] bg-[#7c2d12]'
