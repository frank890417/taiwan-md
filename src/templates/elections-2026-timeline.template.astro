  voters: {
    title: string;
    intro: string;
    bringTitle: string;
    bring: Array<{ label: string; text: string }>;
    whoTitle: string;
    who: Array<{ label: string; text: string }>;
  };
  timeline: {
    title: string;
    intro: string;
    filterLabel: string;
    all: string;
    cats: Record<string, string>;
    states: Record<ItemState, string>;
    ownerLabel: string;
    sourceLabel: string;
    voterTipLabel: string;
    derivedBadge: string;
    byTpl: string;
  };
  owners: Record<string, string>;
  monthLabel: (year: number, month: number) => string;
  notes: { title: string; items: string[]; lastVerified: string };
  related: { title: string; items: Array<{ href: string; title: string }> };
  footTitle: string;
  footHome: string;
  footLinks: Array<{ slug: string; label: string }>;
};

