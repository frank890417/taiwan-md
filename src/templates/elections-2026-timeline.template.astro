const lang = getLangFromUrl(Astro.url);
const langPrefix = lang === 'zh-TW' ? '' : `/${lang}`;
const cl = lang in copyAll ? lang : 'en';
const c = copyAll[cl];
const fill = (tpl: string, vars: Record<string, string | number>) =>
  tpl.replace(/\{(\w+)\}/g, (_, k: string) => String(vars[k] ?? ''));

const textOf = (item: TimelineItem): ItemText =>
  (item[cl] ?? item.en) as ItemText;
const sourceOf = (key: string) => {
  const s = data.sources[key];
  if (!s) return null;
  return { url: s.url, label: s[cl] ?? s.en ?? key };
};

// ── 狀態：build 時用台北日期判斷 ─────────────────────────────────────
const now = new Date();
const todayIso = new Date(now.getTime() + 8 * 60 * 60 * 1000)
  .toISOString()
  .slice(0, 10);

const items = [...data.items].sort(
  (a, b) => a.start.localeCompare(b.start) || a.end.localeCompare(b.end),
);
const futureStarts = items
  .filter((i) => i.start > todayIso)
  .map((i) => i.start)
  .sort();
const nextStart = futureStarts[0] ?? null;
const stateOf = (i: TimelineItem): ItemState => {
  if (i.end < todayIso) return 'done';
  if (i.start <= todayIso) return 'now';
  if (i.start === nextStart) return 'next';
  return 'upcoming';
};

const doneCount = items.filter((i) => stateOf(i) === 'done').length;
const focusItems = items.filter((i) => {
  const s = stateOf(i);
  return s === 'now' || s === 'next';
});

const fmtDate = (i: TimelineItem) => {
  const [y1, m1, d1] = i.start.split('-');
  const [y2, m2, d2] = i.end.split('-');
  let s = `${y1}/${m1}/${d1}`;
  if (i.end !== i.start) s += y1 === y2 ? `–${m2}/${d2}` : `–${y2}/${m2}/${d2}`;
  return i.by ? fill(c.timeline.byTpl, { date: s }) : s;
};

// 依開始月份分組
const monthGroups: Array<{
  key: string;
  label: string;
  items: TimelineItem[];
}> = [];
for (const item of items) {
  const key = item.start.slice(0, 7);
  let g = monthGroups.find((m) => m.key === key);
  if (!g) {
    const [y, m] = key.split('-').map(Number);
    g = { key, label: c.monthLabel(y, m), items: [] };
    monthGroups.push(g);
  }
  g.items.push(item);
}

const voterItems = items.filter((i) => i.cats.includes('voters'));
const catKeys = ['admin', 'candidates', 'referendum', 'voters'];

const stateChip: Record<ItemState, string> = {
  done: 'bg-[#f0fdf4] text-[#15803d]',
  now: 'bg-[#7c2d12] text-white',
  next: 'bg-[#fef3c7] text-[#92400e]',
  upcoming: 'bg-[#f3f4f6] text-[#6b7280]',
};
const stateDot: Record<ItemState, string> = {
  done: 'border-[#15803d] bg-[#15803d]',
  now: 'border-[#7c2d12] bg-[#7c2d12]',
  next: 'border-[#7c2d12] bg-[#fef2ec]',
  upcoming: 'border-[#d1d5db] bg-white',
};

// ── JSON-LD：BreadcrumbList ───────────────────────────────────────
const toJsonLd = (value: unknown) =>
  JSON.stringify(value).replace(/</g, '\\u003c');
const site = Astro.site ?? Astro.url;
const jsonLd = toJsonLd({
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: c.breadcrumbHome,
      item: new URL(`${langPrefix}/elections/2026/`, site).toString(),
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: c.breadcrumbHere,
      item: new URL(`${langPrefix}/elections/2026/timeline/`, site).toString(),
    },
  ],
});

const heading = "font-family: 'jf-lanyangming', 'Noto Serif TC', serif;";
const serif = "font-family: 'Noto Serif TC', serif;";
// 出處連結沿用全站 main a 的底線與 ↗ 樣式，只調顏色
const linkCls = 'text-[#6b7280] hover:text-[#374151]';
---

<Layout
  lang={lang}
  title={c.metaTitle}
  description={c.metaDescription}
  readerSettings
>
  <div class="elections-timeline">
    <!-- Hero -->
    <section
      class="hero relative overflow-hidden border-b border-[#e7d9b8] bg-gradient-to-b from-[#fef9ed] via-[#fdf6e3] to-[#fbf3df]"
    >
      <div
        class="relative mx-auto max-w-[920px] px-4 pb-12 pt-8 md:px-6 md:pb-16"
      >
        <nav aria-label="breadcrumb" class="mb-8 text-sm text-[#78716c]">
          <a
            href={`${langPrefix}/elections/2026/`}
            class="card-link text-[#7c2d12] underline decoration-[#7c2d12]/30 underline-offset-2 hover:decoration-[#7c2d12]"
            >{c.breadcrumbHome}</a
          >
          <span aria-hidden="true" class="mx-1.5">/</span>
          <span aria-current="page">{c.breadcrumbHere}</span>
        </nav>

        <div
          class="mb-4 text-center font-mono text-xs uppercase tracking-[0.18em] text-[#92400e]"
        >
          {c.hero.eyebrow}
        </div>
        <h1
          class="hero-title mb-5 text-center text-[2.25rem] font-bold leading-[1.2] text-[#1f2937] md:text-[3rem]"
          style={heading}
        >
          {c.hero.title}
        </h1>
        <p
          class="mx-auto mb-10 max-w-[640px] text-center text-base leading-[1.8] text-[#52525b] md:text-lg"
        >
          {c.hero.subtitle}
        </p>

        <div
          class="mx-auto max-w-[560px] rounded-2xl border-[1.5px] border-[#7c2d12]/20 bg-white/75 px-5 py-6 shadow-[0_4px_20px_rgba(124,45,18,0.08)] md:px-8"
        >
          <p class="mb-4 text-center text-xs text-[#78716c]">
            {fill(c.hero.todayLabel, { date: todayIso.replace(/-/g, '/') })}
            <span aria-hidden="true" class="mx-1.5">·</span>
            {fill(c.hero.progress, { done: doneCount, total: items.length })}
          </p>
          {
            focusItems.length > 0 ? (
              <ul class="list-none space-y-3 pl-0">
                {focusItems.map((i) => {
                  const st = stateOf(i);
                  return (
                    <li class="flex flex-wrap items-baseline gap-x-2.5 gap-y-1">
                      <span
                        class={`rounded-full px-2 py-0.5 font-mono text-[10px] uppercase tracking-wider ${stateChip[st]}`}
                      >
                        {c.timeline.states[st]}
                      </span>
                      <span class="font-mono text-sm tabular-nums text-[#7c2d12]">
                        {fmtDate(i)}
                      </span>
                      <a
                        href={`#${i.id}`}
                        class="card-link text-base font-semibold text-[#1f2937] no-underline hover:text-[#7c2d12]"
                      >
                        {textOf(i).title}
                      </a>
                    </li>
                  );
                })}
              </ul>
            ) : (
              <p class="text-center text-base font-semibold text-[#15803d]">
                {c.hero.allDone}
              </p>
            )
          }
        </div>
      </div>
    </section>

    <!-- 選民要自己留意的日期 -->
    <section id="voters" class="anchor-section bg-[#fdfaf2] py-14 md:py-20">
      <div class="mx-auto max-w-[920px] px-4 md:px-6">
        <div class="mb-8 text-center">
          <h2
            class="mb-3 text-[1.5rem] font-light text-[#1f2937] md:text-[2rem]"
            style={heading}
          >
            {c.voters.title}
          </h2>
          <p
            class="mx-auto max-w-[620px] text-base leading-[1.75] text-[#52525b]"
          >
            {c.voters.intro}
          </p>
        </div>

        <ol class="grid list-none gap-4 pl-0 sm:grid-cols-2">
          {
            voterItems.map((i) => {
              const st = stateOf(i);
              const t = textOf(i);
              return (
                <li
                  class={`rounded-xl border-[1.5px] bg-white p-5 ${
                    st === 'done'
                      ? 'border-[#e5e7eb] opacity-80'
                      : 'border-[#e7d9b8]'
                  }`}
                >
                  <div class="mb-2 flex flex-wrap items-baseline gap-x-2.5 gap-y-1">
                    <span class="font-mono text-sm font-semibold tabular-nums text-[#7c2d12]">
                      {fmtDate(i)}
                    </span>
                    <span
                      class={`rounded-full px-2 py-0.5 font-mono text-[10px] uppercase tracking-wider ${stateChip[st]}`}
                    >
                      {c.timeline.states[st]}
                    </span>
                    {i.derived && (
                      <span class="rounded border border-[#d1d5db] px-1.5 font-mono text-[10px] text-[#6b7280]">
                        {c.timeline.derivedBadge}
                      </span>
                    )}
                  </div>
                  <h3
                    class="mb-2 text-base font-semibold leading-[1.5] text-[#1f2937]"
                    style={serif}
                  >
                    <a
                      href={`#${i.id}`}
                      class="card-link text-[#1f2937] no-underline hover:text-[#7c2d12]"
                    >
                      {t.title}
                    </a>
                  </h3>
                  <p class="text-sm leading-[1.7] text-[#52525b]">
                    {t.voterTip ?? t.detail}
                  </p>
                </li>
              );
            })
          }
        </ol>

        <div class="mt-8 grid gap-4 md:grid-cols-2">
          <div
            class="rounded-xl border-[1.5px] border-dashed border-[#d4c5a0] bg-white/70 p-5"
          >
            <h3
              class="mb-3 text-base font-semibold text-[#1f2937]"
              style={serif}
            >
              {c.voters.bringTitle}
            </h3>
            <dl class="m-0 space-y-2.5 text-sm leading-[1.7]">
              {
                c.voters.bring.map((b) => (
                  <div>
                    <dt class="font-semibold text-[#7c2d12]">{b.label}</dt>
                    <dd class="text-[#52525b]">{b.text}</dd>
                  </div>
                ))
              }
            </dl>
            <p class="mt-3 text-xs leading-[1.6] text-[#9ca3af]">
              {c.timeline.sourceLabel}
              {
                ['law-e18', 'cec-idrules', 'cec-63642', 'cec-61230'].map(
                  (k, idx) => {
                    const s = sourceOf(k);
                    return s ? (
                      <>
                        {idx > 0 && <span aria-hidden="true"> · </span>}
                        <a
                          href={s.url}
                          target="_blank"
                          rel="noopener noreferrer"
                          class={linkCls}
                        >
                          {s.label}
                        </a>
                      </>
                    ) : null;
                  },
                )
              }
            </p>
          </div>
          <div
            class="rounded-xl border-[1.5px] border-dashed border-[#d4c5a0] bg-white/70 p-5"
          >
            <h3
              class="mb-3 text-base font-semibold text-[#1f2937]"
              style={serif}
            >
              {c.voters.whoTitle}
            </h3>
            <dl class="m-0 space-y-2.5 text-sm leading-[1.7]">
              {
                c.voters.who.map((w) => (
                  <div>
                    <dt class="font-semibold text-[#7c2d12]">{w.label}</dt>
                    <dd class="text-[#52525b]">{w.text}</dd>
                  </div>
                ))
              }
            </dl>
            <p class="mt-3 text-xs leading-[1.6] text-[#9ca3af]">
              {c.timeline.sourceLabel}
              {
                ['law-e14', 'law-e15', 'law-e4', 'law-r7', 'law-r8'].map(
                  (k, idx) => {
                    const s = sourceOf(k);
                    return s ? (
                      <>
                        {idx > 0 && <span aria-hidden="true"> · </span>}
                        <a
                          href={s.url}
                          target="_blank"
                          rel="noopener noreferrer"
                          class={linkCls}
                        >
                          {s.label}
                        </a>
                      </>
                    ) : null;
                  },
                )
              }
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- 完整時間軸 -->
    <section id="timeline" class="anchor-section bg-white py-14 md:py-20">
      <div class="mx-auto max-w-[800px] px-4 md:px-6">
        <div class="mb-8 text-center">
          <h2
            class="mb-3 text-[1.5rem] font-light text-[#1f2937] md:text-[2rem]"
            style={heading}
          >
            {c.timeline.title}
          </h2>
          <p
            class="mx-auto max-w-[600px] text-base leading-[1.75] text-[#52525b]"
          >
            {c.timeline.intro}
          </p>
        </div>

        <!-- 分類篩選：無 JS 時保持 hidden，時間軸全部顯示 -->
        <div
          class="tl-filter mb-8 justify-center"
          data-tl-filter
          role="group"
          aria-label={c.timeline.filterLabel}
          hidden
        >
          <button
            type="button"
            class="tl-filter-btn rounded-full border-[1.5px] border-[#d1d5db] bg-white px-4 py-1.5 text-sm font-semibold text-[#374151]"
            data-filter="all"
            aria-pressed="true">{c.timeline.all}</button
          >
          {
            catKeys.map((k) => (
              <button
                type="button"
                class="tl-filter-btn rounded-full border-[1.5px] border-[#d1d5db] bg-white px-4 py-1.5 text-sm font-semibold text-[#374151]"
                data-filter={k}
                aria-pressed="false"
              >
                {c.timeline.cats[k]}
              </button>
            ))
          }
        </div>

        {
          monthGroups.map((g) => (
            <div class="tl-month mb-10 last:mb-0" data-tl-month>
              <h3 class="mb-4 font-mono text-xs uppercase tracking-[0.16em] text-[#92400e]">
                {g.label}
              </h3>
              <ol class="relative list-none border-l-[1.5px] border-[#e7d9b8] pl-5 md:pl-6">
                {g.items.map((i) => {
                  const st = stateOf(i);
                  const t = textOf(i);
                  return (
                    <li
                      id={i.id}
                      class="tl-item relative mb-7 last:mb-0"
                      data-cats={i.cats.join(' ')}
                    >
                      <span
                        class={`absolute -left-[27px] top-1.5 block h-2.5 w-2.5 rounded-full border-2 md:-left-[31px] ${stateDot[st]}`}
                        aria-hidden="true"
                      />
                      <div class="mb-1.5 flex flex-wrap items-baseline gap-x-2.5 gap-y-1">
                        <span
                          class={`font-mono text-sm tabular-nums ${
                            st === 'done'
                              ? 'text-[#15803d]'
                              : st === 'upcoming'
                                ? 'text-[#6b7280]'
                                : 'font-semibold text-[#7c2d12]'
                          }`}
                        >
                          {fmtDate(i)}
                        </span>
                        <span
                          class={`rounded-full px-2 py-0.5 font-mono text-[10px] uppercase tracking-wider ${stateChip[st]}`}
                        >
                          {st === 'done' ? '✓ ' : ''}
                          {c.timeline.states[st]}
                        </span>
                        {i.derived && (
                          <span class="rounded border border-[#d1d5db] px-1.5 font-mono text-[10px] text-[#6b7280]">
                            {c.timeline.derivedBadge}
                          </span>
                        )}
                        {i.cats.map((k) => (
                          <span class="rounded-full border border-[#e7d9b8] px-2 py-0.5 text-[11px] text-[#92400e]">
                            {c.timeline.cats[k]}
                          </span>
                        ))}
                      </div>
                      <h4
                        class={`mb-1.5 text-[1.05rem] font-semibold leading-[1.5] ${
                          st === 'done' ? 'text-[#4b5563]' : 'text-[#1f2937]'
                        }`}
                        style={serif}
                      >
                        {t.title}
                      </h4>
                      <p class="mb-2 text-sm leading-[1.75] text-[#52525b]">
                        {t.detail}
                      </p>
                      {t.voterTip && (
                        <p class="mb-2 rounded-lg border-l-[3px] border-[#7c2d12]/50 bg-[#fef9ed] px-3 py-2 text-sm leading-[1.7] text-[#374151]">
                          <span class="font-semibold text-[#7c2d12]">
                            {c.timeline.voterTipLabel}
                          </span>
                          {t.voterTip}
                        </p>
                      )}
                      <p class="text-xs leading-[1.7] text-[#9ca3af]">
                        <span>
                          {c.timeline.ownerLabel}
                          <span class="text-[#6b7280]">
                            {c.owners[i.owner] ?? i.owner}
                          </span>
                        </span>
                        <span aria-hidden="true" class="mx-1.5">
                          |
                        </span>
                        <span>
                          {c.timeline.sourceLabel}
                          {i.sources.map((k, idx) => {
                            const s = sourceOf(k);
                            return s ? (
                              <>
                                {idx > 0 && <span aria-hidden="true"> · </span>}
                                <a
                                  href={s.url}
                                  target="_blank"
                                  rel="noopener noreferrer"
                                  class={linkCls}
                                >
                                  {s.label}
                                </a>
                              </>
                            ) : null;
                          })}
                        </span>
                      </p>
                    </li>
                  );
                })}
              </ol>
            </div>
          ))
        }
      </div>
    </section>

    <!-- 這頁怎麼整理的 -->
    <section class="border-t border-[#f1f0ec] bg-[#fdfaf2] py-12 md:py-16">
      <div class="mx-auto max-w-[760px] px-4 md:px-6">
        <h2
          class="mb-5 text-center text-xl font-light text-[#1f2937] md:text-2xl"
          style={heading}
        >
          {c.notes.title}
        </h2>
        <ul
          class="list-none space-y-2.5 pl-0 text-sm leading-[1.75] text-[#52525b]"
        >
          {
            c.notes.items.map((n) => (
              <li class="flex gap-2.5">
                <span class="text-[#92400e]" aria-hidden="true">
                  ·
                </span>
                <span>{n}</span>
              </li>
            ))
          }
        </ul>
        <p class="mt-5 text-center text-xs text-[#9ca3af]">
          {c.notes.lastVerified}<time datetime={data.lastVerified}
            >{data.lastVerified}</time
          >
        </p>

        <h3
          class="mb-3 mt-10 text-center text-base font-semibold text-[#1f2937]"
          style={serif}
        >
          {c.related.title}
        </h3>
        <div class="flex flex-wrap justify-center gap-2">
          {
            c.related.items.map((r) => (
              <a
                href={r.href}
                class="card-link rounded-lg border-[1.5px] border-[#e5e7eb] bg-white px-3.5 py-1.5 text-sm text-[#374151] no-underline hover:border-[#7c2d12]/30 hover:text-[#7c2d12]"
              >
                {r.title}
              </a>
            ))
          }
        </div>
      </div>
    </section>

    <!-- 底部導覽 -->
    <section class="bg-white py-12">
      <div class="mx-auto max-w-[760px] px-4 text-center md:px-6">
        <h2 class="mb-5 text-lg font-semibold text-[#1f2937]" style={serif}>
          {c.footTitle}
        </h2>
        <div class="flex flex-wrap justify-center gap-2.5">
          <a
            href={`${langPrefix}/elections/2026/`}
            class="card-link rounded-full border-[1.5px] border-[#7c2d12]/40 bg-[#fef2ec] px-5 py-2 text-sm font-semibold text-[#7c2d12] no-underline"
            >← {c.footHome}</a
          >
          {
            c.footLinks.map((l) => (
              <a
                href={`${langPrefix}/elections/2026/${l.slug}/`}
                class="card-link rounded-full border-[1.5px] border-[#7c2d12]/25 bg-white px-5 py-2 text-sm font-semibold text-[#7c2d12] no-underline hover:bg-[#fef2ec]"
              >
                {l.label}
              </a>
            ))
          }
        </div>
      </div>
    </section>

    {/* BreadcrumbList 由全站 SEO.astro 依網址產生，子頁不重複輸出 */}
  </div>
</Layout>

<script>
  // 分類篩選：無 JS 時按鈕維持 hidden、時間軸全部顯示。
  const filter = document.querySelector<HTMLElement>('[data-tl-filter]');
  if (filter) {
    filter.hidden = false;
    const buttons = filter.querySelectorAll<HTMLButtonElement>(
      'button[data-filter]',
    );
    const months = document.querySelectorAll<HTMLElement>('[data-tl-month]');
    filter.addEventListener('click', (event) => {
      const target = event.target as HTMLElement | null;
      const btn = target?.closest<HTMLButtonElement>('button[data-filter]');
      if (!btn) return;
      const key = btn.dataset.filter ?? 'all';
      buttons.forEach((b) =>
        b.setAttribute('aria-pressed', b === btn ? 'true' : 'false'),
      );
      months.forEach((m) => {
        let visible = 0;
        m.querySelectorAll<HTMLElement>('.tl-item').forEach((item) => {
          const cats = (item.dataset.cats ?? '').split(' ');
          const show = key === 'all' || cats.includes(key);
          item.hidden = !show;
          if (show) visible += 1;
        });
        m.hidden = visible === 0;
      });
    });
  }
</script>

<style>
  .elections-timeline [hidden] {
    display: none !important;
  }
  .elections-timeline .anchor-section,
  .elections-timeline .tl-item {
    scroll-margin-top: 80px;
  }
  .elections-timeline .tl-filter:not([hidden]) {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .elections-timeline .tl-filter-btn[aria-pressed='true'] {
    border-color: #1f2937;
    background: #1f2937;
    color: #fff;
  }
  .elections-timeline .hero-title {
    letter-spacing: -0.02em;
  }
  .elections-timeline h2 {
    letter-spacing: -0.01em;
  }
  .elections-timeline .tl-item h4,
  .elections-timeline .tl-item p {
    overflow-wrap: anywhere;
  }
  .hero::before {
    content: '';
    position: absolute;
    inset: 0;
    background-image:
      radial-gradient(
        circle at 20% 30%,
        rgba(124, 45, 18, 0.05) 0%,
        transparent 50%
      ),
      radial-gradient(
        circle at 80% 70%,
        rgba(146, 64, 14, 0.04) 0%,
        transparent 50%
      );
    pointer-events: none;
  }
</style>
