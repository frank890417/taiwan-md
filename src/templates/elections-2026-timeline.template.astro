type ItemText = { title: string; detail: string; voterTip?: string };
type TimelineItem = {
  id: string;
  start: string;
  end: string;
  by?: boolean;
  derived?: boolean;
  cats: string[];
  owner: string;
  sources: string[];
  [lang: string]: unknown;
};
type SourceEntry = { url: string; [lang: string]: string };
type TimelineData = {
  lastVerified: string;
  sources: Record<string, SourceEntry>;
  items: TimelineItem[];
};
type ItemState = 'done' | 'now' | 'next' | 'upcoming';

type PageCopy = {
  metaTitle: string;
  metaDescription: string;
  breadcrumbHome: string;
  breadcrumbHere: string;
  hero: {
    eyebrow: string;
    title: string;
    subtitle: string;
    todayLabel: string;
    progress: string;
