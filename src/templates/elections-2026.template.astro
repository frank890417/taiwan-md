// ─────────────────────────────────────────────────────────────────────
// 2026-10 升級：縣市長候選人、怎麼投票、同日公投、快速導覽、JSON-LD。
// 事實只來自 src/data/elections-2026.json（研究檔：
// reports/research/2026-10/elections-2026/{candidates,voting-info}.json）。
// 新增介面文案集中在 upgradeCopy（zh-TW/en/ja/ko/fr/es），其他語言退回 en。
// 候選人呈現完全對稱：同樣欄位、同樣大小、不用政黨色、不標領先。
// ─────────────────────────────────────────────────────────────────────

// 有新區塊文案的語言代碼；沒有的退回 en
type UpLang = string;

type LinkKind =
  | 'announcement'
  | 'law'
  | 'idRules'
  | 'pollingPlaces'
  | 'bulletin'
  | 'schedule'
  | 'referendumNotice'
  | 'referendumBulletin';

// article：這位候選人在 Taiwan.md 有人物條目時才有（zh 是中文檔名，slug 是
// 其他 12 語的網址）。只放主 session 逐篇核對過是同一人的條目。
type Candidate = {
  name: string;
  party: string;
  incumbent: boolean;
  number: number | null;
  registeredOn: string;
  source: string;
  incumbentSource?: string;
  article?: { zh: string; slug: string };
};

type ElectionsData = {
  lastVerified: string;
  election: {
    date: string;
    startDate: string;
    endDate: string;
    organizer: string;
    source: string;
  };
  sources: Record<string, string>;
  offices: Array<{
    key: string;
    type: string;
    seats: number | null;
    source: string;
    sourceFile?: string;
  }>;
  totalElected: { count: number; source: string };
  races: Array<{
    area: string;
    office: string;
    group: 'municipal' | 'county';
    seats: number;
    source: string;
    rosterSource: string;
    candidates: Candidate[];
  }>;
  votingInfo: Array<
    { id: string; links: Array<{ kind: LinkKind; url: string }> } & Record<
      UpLang,
      { q: string; a: string }
    >
  >;
  referendum: {
    case: number;
    date: string;
    hours: string;
    question: string;
    proposedBy: string;
    establishedOn: string;
    votingAge: number;
    localElectionVotingAge: number;
    threshold: string;
    presentations: { count: number; firstDate: string };
    sources: Array<{ kind: LinkKind; url: string }>;
  };
};

const electionsData = electionsDataRaw as unknown as ElectionsData;

