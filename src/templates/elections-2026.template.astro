const copy = electionCopy[lang as keyof typeof electionCopy] ?? electionCopy.en;
const pageTitle = copy.meta.title;
const pageDescription = copy.meta.description;

const electionDate = new Date('2026-11-28T08:00:00+08:00');
const now = new Date();
const daysUntil = Math.ceil(
  (electionDate.getTime() - now.getTime()) / (1000 * 60 * 60 * 24),
);
const isUpcoming = daysUntil > 0;
const isRecent = daysUntil > -7 && daysUntil <= 0;

// Timeline milestone states — computed at build time (site rebuilds daily),
// Taipei-local date so day boundaries flip on Taiwan time.
const todayIso = new Date(now.getTime() + 8 * 60 * 60 * 1000)
  .toISOString()
  .slice(0, 10);
const nextMilestoneIdx = copy.timeline.items.findIndex(
  (m) => m.iso >= todayIso,
);
const nextMilestone =
  nextMilestoneIdx >= 0 ? copy.timeline.items[nextMilestoneIdx] : null;

// ── 2026-10 升級：衍生值 ──────────────────────────────────────────────
const upLang: UpLang = lang in upgradeCopy ? (lang as UpLang) : 'en';
const up = upgradeCopy[upLang];
const isZh = upLang === 'zh-TW';
const fill = (tpl: string, vars: Record<string, string | number>) =>
  tpl.replace(/\{(\w+)\}/g, (_, k: string) => String(vars[k] ?? ''));

// 九種職位：中選會公告有分項的用正式名額，其餘保留原數字並標「預估」。
// data.offices 與 copy.offices.items 同序（直轄市長 → 村里長）。
const officeRows = copy.offices.items.map((e, i) => {
  const seats = electionsData.offices[i]?.seats;
  return seats == null
    ? { ...e, estimate: true }
    : { ...e, count: seats, estimate: false };
});

const areaLabel = (area: string) =>
  isZh ? area : (areaI18n[area]?.[upLang as Exclude<UpLang, 'zh-TW'>] ?? area);
const partyLabel = (party: string) => {
  if (isZh) return party;
  const names = partyI18n[party];
  return names?.[upLang as Exclude<UpLang, 'zh-TW'>] ?? names?.en ?? party;
};

type Race = ElectionsData['races'][number];
// 號次全部抽出後依號次排序；抽籤前保持研究檔順序（登記日期先後）。
const isNumbered = (r: Race) => r.candidates.every((c) => c.number != null);
const orderedCandidates = (r: Race) =>
  isNumbered(r)
    ? [...r.candidates].sort((a, b) => (a.number ?? 0) - (b.number ?? 0))
    : r.candidates;
const allNumbered = electionsData.races.every(isNumbered);
const totalCandidates = electionsData.races.reduce(
  (n, r) => n + r.candidates.length,
  0,
);
const raceGroups = [
  {
    key: 'municipal' as const,
    label: up.candidates.groupMunicipal,
    races: electionsData.races.filter((r) => r.group === 'municipal'),
  },
  {
    key: 'county' as const,
    label: up.candidates.groupCounty,
    races: electionsData.races.filter((r) => r.group === 'county'),
  },
];
// 卡片錨點 race-{index} 用資料檔裡的順序；每組的登記名冊 PDF 只列一次。
const raceIndex = (r: Race) => electionsData.races.indexOf(r);
const groupRosters = (races: Race[]) => [
  ...new Set(races.map((r) => r.rosterSource)),
];

// ── 2026-10 改版：開場、條目連結、數字格式 ──────────────────────────────
// eyebrow 文案前面帶 emoji，開場不放 emoji，顯示時去掉（不動原字串）。
const heroEyebrow = copy.hero.eyebrow.replace(
  /^\p{Extended_Pictographic}️?\s*/u,
  '',
);
const doneSteps = copy.timeline.items.filter((m) => m.iso < todayIso).length;
const totalSteps = copy.timeline.items.length;
const progressPct = Math.round((doneSteps / totalSteps) * 100);

// fr／es 的千位分隔跟英文不同（法文的逗號是小數點）
const numLocale =
  upLang === 'fr' ? 'fr-FR' : upLang === 'es' ? 'es-ES' : 'en-US';
const fmt = (n: number) => n.toLocaleString(numLocale);

// 候選人條目：有條目的連到人物頁，沒有的邀請一起寫。兩種動作同樣大小。
// 外語版還沒有譯文時（例如新條目當天還沒跑翻譯）退回中文條目，不連到 404。
const zhArticleHref = (a: { zh: string; slug: string }) =>
  `/people/${encodeURIComponent(a.zh)}/`;
const hasTranslation = (slug: string) =>
  existsSync(join(process.cwd(), 'knowledge', lang, 'People', `${slug}.md`));
const articleHref = (a: { zh: string; slug: string }) =>
  lang === 'zh-TW' || !hasTranslation(a.slug)
    ? zhArticleHref(a)
    : `/${lang}/people/${a.slug}/`;
const contributeHref = `${langPrefix}/contribute/`;
const proposeHref =
  'https://github.com/frank890417/taiwan-md/issues/new?template=article-proposal.yml';
const linkedCandidates = electionsData.races.reduce(
  (n, r) => n + r.candidates.filter((c) => c.article).length,
  0,
);

// 驗證區的兩個事實查核站：用網址找名稱，不靠清單索引（清單增刪不會錯位）。
const tfcName =
  copy.resources.items.find((r) => r.url.includes('tfc-taiwan'))?.name ?? '';
const cofactsName =
  copy.resources.items.find((r) => r.url.includes('cofacts'))?.name ?? '';

// 線條圖示（24px、stroke 1.75），開場三個事實與專區四張卡共用。
// 選舉頁的圖示改用行線圖示（/brand#icons）；鍵名沿用，渲染結構不動
const electionIcons: Record<string, string> = {
  clock: 'clock',
  id: 'id',
  pin: 'pin',
  timeline: 'calendar',
  candidates: 'community',
  donations: 'coins',
  perspectives: 'comment',
};
const iconPaths: Record<string, string[]> = Object.fromEntries(
  Object.entries(electionIcons).map(([k, n]) => [
    k,
    [(icons as Record<string, string>)[n]],
  ]),
);

const faqItems = electionsData.votingInfo.map((v) => ({
  id: v.id,
  links: v.links,
  ...(v[upLang] ?? v.en),
}));
const referendum = electionsData.referendum;

// JSON-LD：Event（投票日）＋ FAQPage（怎麼投票，用當前語言）。
const pageUrl = new URL(Astro.url.pathname, Astro.site ?? Astro.url).toString();
const toJsonLd = (data: unknown) =>
  JSON.stringify(data).replace(/</g, '\\u003c');
const eventJsonLd = toJsonLd({
  '@context': 'https://schema.org',
  '@type': 'Event',
  name: up.jsonLd.eventName,
  description: up.jsonLd.eventDescription,
  startDate: electionsData.election.startDate,
  endDate: electionsData.election.endDate,
  eventStatus: 'https://schema.org/EventScheduled',
  eventAttendanceMode: 'https://schema.org/OfflineEventAttendanceMode',
  inLanguage: upLang,
  url: pageUrl,
  location: {
    '@type': 'Place',
    name: up.jsonLd.location,
    address: { '@type': 'PostalAddress', addressCountry: 'TW' },
  },
  organizer: {
    '@type': 'GovernmentOrganization',
    name: up.jsonLd.organizer,
    url: 'https://web.cec.gov.tw/',
  },
});
const faqJsonLd = toJsonLd({
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  inLanguage: upLang,
  url: pageUrl,
  mainEntity: faqItems.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
});

// 章節導覽：七個段落（07 延伸閱讀不列，避免導覽過長）
const navItems = [
  { id: 'candidates', label: up.nav.candidates },
  { id: 'how-to-vote', label: up.nav.howToVote },
  { id: 'referendum', label: up.nav.referendum },
  { id: 'timeline', label: up.nav.timeline },
  { id: 'offices', label: up.nav.offices },
  { id: 'subpages', label: up.nav.subpages },
  { id: 'about', label: up.nav.about },
];
const candFilters = [
  { key: 'all', label: up.candidates.filterAll },
  { key: 'municipal', label: up.candidates.filterMunicipal },
  { key: 'county', label: up.candidates.filterCounty },
];
// 資料日期不在連字號斷行：把 {date} 前後拆開，日期包進 <time>
const metaParts = (
  allNumbered ? up.candidates.metaLineNumbered : up.candidates.metaLine
).split('{date}');
// 中文與日文句子之間不加空格，其他語言加
const sentenceGap = isZh || upLang === 'ja' ? '' : ' ';
// 候選人段落的來源只寫一次：審定新聞稿、現任標示（中央社）都從資料檔收集
const qualifiedSources = [...new Set(electionsData.races.map((r) => r.source))];
const incumbentSources = [
  ...new Set(
    electionsData.races.flatMap((r) =>
      r.candidates.flatMap((c) =>
        c.incumbent && c.incumbentSource ? [c.incumbentSource] : [],
      ),
    ),
  ),
];

// 來源連結列（「來源：A、B」）先組成 HTML 字串再 set:html：寫成 JSX 時，
// prettier 會在連結兩側換行，Astro 把換行輸出成空格，中文句子裡很顯眼。
// 所有文字與網址都先跳脫。樣式用 :global(.el-inline-link)。
const escHtml = (t: string) =>
  t
    .replace(/&/g, '&amp;')
    .replace(/</g, '&lt;')
    .replace(/>/g, '&gt;')
    .replace(/"/g, '&quot;');
const sourceLinks = (
  links: Array<{ url: string; label: string }>,
  extraClass = '',
) =>
  links
    .map(
      (l) =>
        `<a href="${escHtml(l.url)}" target="_blank" rel="noopener noreferrer" class="el-inline-link${extraClass ? ` ${extraClass}` : ''}">${escHtml(l.label)}</a>`,
    )
    .join(escHtml(up.candidates.listSep));
const candSourceHtml =
  escHtml(up.candidates.sourceLabel) +
  sourceLinks(
    qualifiedSources.map((url) => ({
      url,
      label: up.candidates.qualifiedLink,
    })),
  ) +
  (incumbentSources.length > 0
    ? escHtml(up.candidates.incumbentPrefix) +
      sourceLinks(
        incumbentSources.map((url) => ({
          url,
          label: up.candidates.incumbentLinkText,
        })),
      ) +
      escHtml(up.candidates.incumbentSuffix)
    : '');
const rosterHtml = (races: Race[]) =>
  sourceLinks(
    groupRosters(races).map((url) => ({
      url,
      label: up.candidates.rosterShort,
    })),
  );
const faqSourceHtml = (links: Array<{ kind: LinkKind; url: string }>) =>
  escHtml(up.howToVote.sourceLabel) +
  sourceLinks(links.map((l) => ({ url: l.url, label: up.links[l.kind] })));
const referendumSourceHtml =
  escHtml(up.referendum.sourceLabel) +
  sourceLinks(
    electionsData.referendum.sources.map((l) => ({
      url: l.url,
      label: up.links[l.kind],
    })),
    'el-inline-link--slate',
  );
import { icons } from '../icons/taiwan-icons.mjs';
---

<Layout
  lang={lang}
  title={pageTitle}
  description={pageDescription}
  readerSettings
>
  <div class="elections-2026">
    <!-- 00 開場：投票日三件事＋倒數與選務進度 -->
    <section class="el-hero" aria-labelledby="el-title">
      <div class="el-wrap el-hero-grid">
        <div class="el-hero-main">
          <p class="el-eyebrow">{heroEyebrow}</p>
          <h1 id="el-title" class="el-h1">
            {copy.hero.titlePrefix}{' '}<span class="el-h1-em"
              >{copy.hero.titleEmphasis}</span
            >{up.hero.titleGap}{copy.hero.titleSuffix}
          </h1>
          <p class="el-hero-sub">{copy.hero.subtitle}</p>
          <ul class="el-facts el-reset" aria-label={up.hero.factsLabel}>
            {
              up.hero.facts.map((f) => (
                <li class="el-fact">
                  <svg class="el-icon" viewBox="0 0 24 24" aria-hidden="true">
                    {iconPaths[f.icon].map((d) => (
                      <path d={d} />
                    ))}
                  </svg>
                  <div>
                    <p class="el-fact-label">{f.label}</p>
                    <p class="el-fact-value">{f.value}</p>
                  </div>
                </li>
              ))
            }
          </ul>
        </div>

        <aside class="el-count" aria-label={copy.hero.countdownLabel}>
          {
            isUpcoming && (
              <>
                <p class="el-count-label">{copy.hero.countdownLabel}</p>
                <p class="el-count-num">
                  <span class="el-count-days">{daysUntil}</span>
                  <span class="el-count-unit">{copy.hero.dayUnit}</span>
                </p>
                <p class="el-count-date">{copy.hero.dateLabel}</p>
              </>
            )
          }
          {
            isRecent && (
              <>
                <p class="el-count-recent">{copy.hero.recentTitle}</p>
                <p class="el-count-date">{copy.hero.recentSubtitle}</p>
              </>
            )
          }
          {
            !isUpcoming && !isRecent && (
              <p class="el-count-date">{copy.hero.dateLabel}</p>
            )
          }
          {
            nextMilestone && (
              <div class="el-count-next">
                <p class="el-count-next-label">{copy.timeline.nextLabel}</p>
                <p class="el-count-next-body">
                  <span class="el-count-next-date">{nextMilestone.date}</span>
                  {nextMilestone.label}
                </p>
              </div>
            )
          }
          <div class="el-progress">
            <div class="el-progress-head">
              <p class="el-progress-label">{up.hero.progressLabel}</p>
              <a href="#timeline" class="el-progress-link"
                >{up.hero.timelineLink} <span aria-hidden="true">→</span></a
              >
            </div>
            <div class="el-progress-bar" aria-hidden="true">
              <span style={`width: ${progressPct}%`}></span>
            </div>
            <p class="el-progress-count">
              {
                fill(up.hero.progressCount, {
                  done: doneSteps,
                  total: totalSteps,
                })
              }
            </p>
          </div>
        </aside>
      </div>
    </section>

    <!-- 章節導覽（sticky，貼在站台表頭下方） -->
    <nav class="el-nav" aria-label={up.nav.label} data-el-nav>
      <div class="el-wrap">
        <div class="el-nav-scroll" data-el-nav-scroll>
          <ul class="el-nav-list el-reset">
            {
              navItems.map((n) => (
                <li>
                  <a href={`#${n.id}`} class="el-nav-link" data-nav-id={n.id}>
                    {n.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </nav>

    <!-- 01 縣市長候選人（中選會審定名單；對稱呈現、無政黨色） -->
    <section
      id="candidates"
      class="el-section anchor-section"
      aria-labelledby="h-candidates"
    >
      <div class="el-wrap">
        <p class="el-sec-no" aria-hidden="true">01</p>
        <div class="el-sec-head">
          <h2 id="h-candidates" class="el-h2">{up.candidates.title}</h2>
          <p class="el-sec-desc">
            {
              fill(up.candidates.intro, {
                races: electionsData.races.length,
                count: totalCandidates,
              })
            }{!allNumbered && sentenceGap + up.candidates.orderNote}
          </p>
          <p class="el-sec-meta">
            {metaParts[0]}<time
              datetime={electionsData.lastVerified}
              class="el-nowrap">{electionsData.lastVerified}</time
            >{metaParts[1]}
          </p>
          <p class="el-source-line" set:html={candSourceHtml} />
        </div>

        <div class="el-cand-tools">
          <div
            class="el-seg"
            role="group"
            aria-label={up.candidates.filterLabel}
            data-cand-filter
            hidden
          >
            {
              candFilters.map((f, i) => (
                <button
                  type="button"
                  data-filter={f.key}
                  aria-pressed={i === 0 ? 'true' : 'false'}
                  class="el-seg-btn"
                >
                  {f.label}
                </button>
              ))
            }
          </div>
          <div class="el-jump">
            <p class="el-jump-label" id="el-jump-label">
              {up.candidates.jumpLabel}
            </p>
            <ul class="el-jump-list el-reset" aria-labelledby="el-jump-label">
              {
                electionsData.races.map((r, i) => (
                  <li data-jump-group={r.group}>
                    <a href={`#race-${i}`} class="el-jump-link">
                      {areaLabel(r.area)}
                    </a>
                  </li>
                ))
              }
            </ul>
          </div>
        </div>

        {
          raceGroups.map((g) => (
            <div class="el-group" data-cand-group={g.key}>
              <div class="el-group-head">
                <h3 class="el-h3">
                  {g.label}
                  <span class="el-group-count">
                    {fill(up.candidates.groupCount, { n: g.races.length })}
                  </span>
                </h3>
                <p class="el-group-src" set:html={rosterHtml(g.races)} />
              </div>
              <div class="el-races">
                {g.races.map((race) => (
                  <article id={`race-${raceIndex(race)}`} class="el-race">
                    <header class="el-race-head">
                      <h4 class="el-race-name">
                        {areaLabel(race.area)}
                        {!isZh && (
                          <span class="el-race-orig" lang="zh-Hant">
                            {race.area}
                          </span>
                        )}
                      </h4>
                      <span class="el-race-count">
                        {fill(up.candidates.raceCount, {
                          n: race.candidates.length,
                        })}
                      </span>
                    </header>
                    <ul class="el-cands el-reset">
                      {orderedCandidates(race).map((c) => (
                        <li class="el-cand">
                          <span class="el-cand-info">
                            {c.number != null && (
                              <span class="el-cand-no">
                                {fill(up.candidates.numberLabel, {
                                  n: c.number,
                                })}
                              </span>
                            )}
                            <span
                              class="el-cand-name"
                              lang={isZh ? undefined : 'zh-Hant'}
                            >
                              {c.name}
                            </span>
                            <span
                              class="el-cand-party"
                              lang={
                                isZh || partyLabel(c.party) !== c.party
                                  ? undefined
                                  : 'zh-Hant'
                              }
                            >
                              {partyLabel(c.party)}
                            </span>
                            {c.incumbent && (
                              <span class="el-tag">
                                {up.candidates.incumbent}
                              </span>
                            )}
                          </span>
                          {c.article ? (
                            <a
                              href={articleHref(c.article)}
                              class="el-cand-act is-article"
                              aria-label={fill(up.candidates.readArticleAria, {
                                name: c.name,
                              })}
                            >
                              {up.candidates.readArticle}
                              <span aria-hidden="true">→</span>
                            </a>
                          ) : (
                            <a
                              href={contributeHref}
                              class="el-cand-act is-contribute"
                              aria-label={fill(up.candidates.contributeAria, {
                                name: c.name,
                              })}
                            >
                              <span aria-hidden="true">＋</span>
                              {up.candidates.contribute}
                            </a>
                          )}
                        </li>
                      ))}
                    </ul>
                  </article>
                ))}
              </div>
            </div>
          ))
        }

        <aside class="el-invite" aria-labelledby="h-invite">
          <h3 id="h-invite" class="el-invite-title">
            {up.candidates.invite.title}
          </h3>
          <p class="el-invite-body">
            {
              fill(up.candidates.invite.body, {
                total: totalCandidates,
                linked: linkedCandidates,
              })
            }
          </p>
          <div class="el-btns">
            <a href={contributeHref} class="el-btn el-btn-primary">
              {up.candidates.invite.contributeCta}
            </a>
            <a
              href={proposeHref}
              target="_blank"
              rel="noopener noreferrer"
              class="el-btn el-btn-ghost"
            >
              {up.candidates.invite.proposeCta}
            </a>
          </div>
        </aside>
      </div>
    </section>

    <!-- 02 怎麼投票（七題全部展開） -->
    <section
      id="how-to-vote"
      class="el-section anchor-section"
      aria-labelledby="h-vote"
    >
      <div class="el-wrap">
        <p class="el-sec-no" aria-hidden="true">02</p>
        <div class="el-sec-head">
          <h2 id="h-vote" class="el-h2">{up.howToVote.title}</h2>
          <p class="el-sec-desc">{up.howToVote.intro}</p>
        </div>
        <div class="el-faqs">
          {
            faqItems.map((f, i) => (
              <article id={`vote-${f.id}`} class="el-faq">
                <p class="el-faq-no" aria-hidden="true">
                  Q{i + 1}
                </p>
                <h3 class="el-faq-q">{f.q}</h3>
                <p class="el-faq-a">{f.a}</p>
                <p class="el-faq-src" set:html={faqSourceHtml(f.links)} />
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <!-- 03 同日公投：另一張票，石板灰底；完全中立，只列程序事實 -->
    <section
      id="referendum"
      class="el-section el-section--slate anchor-section"
      aria-labelledby="h-referendum"
    >
      <div class="el-wrap">
        <p class="el-sec-no" aria-hidden="true">03</p>
        <div class="el-ref-grid">
          <div>
            <p class="el-kicker">{up.referendum.eyebrow}</p>
            <h2 id="h-referendum" class="el-h2">{up.referendum.title}</h2>
            <p class="el-sec-desc">{up.referendum.lead}</p>
            <figure class="el-ref-q">
              <figcaption class="el-ref-q-label">
                {up.referendum.questionLabel}
              </figcaption>
              <p class="el-ref-text" lang="zh-Hant">
                「{referendum.question}」
              </p>
              {
                up.referendum.translation && (
                  <div class="el-ref-tr">
                    <p class="el-ref-tr-label">
                      {up.referendum.translationLabel}
                    </p>
                    <p class="el-ref-tr-text">{up.referendum.translation}</p>
                  </div>
                )
              }
            </figure>
          </div>
          <dl class="el-ref-facts">
            {
              up.referendum.facts.map((fact) => (
                <div class="el-ref-fact">
                  <dt>{fact.label}</dt>
                  <dd>{fact.text}</dd>
                </div>
              ))
            }
          </dl>
        </div>
        <div class="el-ref-foot">
          <p>{up.referendum.neutral}</p>
          <p set:html={referendumSourceHtml} />
        </div>
      </div>
    </section>

    <!-- 04 選務時程（中選會第 622 次委員會議決議） -->
    <section
      id="timeline"
      class="el-section anchor-section"
      aria-labelledby="h-timeline"
    >
      <div class="el-wrap">
        <p class="el-sec-no" aria-hidden="true">04</p>
        <div class="el-sec-head">
          <h2 id="h-timeline" class="el-h2">{copy.timeline.title}</h2>
          <p class="el-sec-desc">{copy.timeline.subtitle}</p>
        </div>
        <ol class="el-steps">
          {
            copy.timeline.items.map((m, i) => {
              const isDone = m.iso < todayIso;
              const isNext = i === nextMilestoneIdx;
              const state = isDone ? 'is-done' : isNext ? 'is-next' : 'is-todo';
              return (
                <li
                  class={`el-step ${state}`}
                  aria-current={isNext ? 'step' : undefined}
                >
                  <span class="el-step-date">{m.date}</span>
                  <span class="el-step-dot" aria-hidden="true" />
                  <span class="el-step-label">
                    {m.label}
                    {isDone && (
                      <span class="el-sr">（{copy.timeline.doneLabel}）</span>
                    )}
                  </span>
                  {isNext && (
                    <span class="el-step-badge">{copy.timeline.nextLabel}</span>
                  )}
                </li>
              );
            })
          }
        </ol>
        <div class="el-steps-foot">
          <a
            href={`${langPrefix}/elections/2026/timeline/`}
            class="el-more-link"
          >
            {up.timeline.fullLink}
            <span aria-hidden="true">→</span>
          </a>
          <p class="el-note">{copy.timeline.sourceNote}</p>
        </div>
      </div>
    </section>

    <!-- 05 九種職位（正式名額；數字全部用主文字色） -->
    <section
      id="offices"
      class="el-section anchor-section"
      aria-labelledby="h-offices"
    >
      <div class="el-wrap">
        <p class="el-sec-no" aria-hidden="true">05</p>
        <div class="el-sec-head">
          <h2 id="h-offices" class="el-h2">{copy.offices.title}</h2>
          <p class="el-sec-desc">{copy.offices.intro}</p>
        </div>
        <p class="el-total">
          <span class="el-total-label">{up.offices.totalPrefix}</span>
          <span class="el-total-num">
            {fmt(electionsData.totalElected.count)}
          </span>
          <span class="el-total-unit">{up.offices.totalSuffix}</span>
          <a
            href={electionsData.totalElected.source}
            target="_blank"
            rel="noopener noreferrer"
            class="el-inline-link el-total-src">{up.offices.totalSource}</a
          >
        </p>
        <ul class="el-offices el-reset">
          {
            officeRows.map((e) => (
              <li class="el-office">
                <h3 class="el-office-name">{e.name}</h3>
                <p class="el-office-count">
                  {e.estimate && (
                    <span class="el-office-approx">
                      {up.offices.approxPrefix}
                    </span>
                  )}
                  {fmt(e.count)}
                </p>
                <p class="el-office-desc">
                  {e.desc}
                  {e.estimate && (
                    <span class="el-tag el-tag--inline">
                      {up.offices.estimateLabel}
                    </span>
                  )}
                </p>
              </li>
            ))
          }
        </ul>
        <p class="el-note el-note--after">{copy.offices.sourceNote}</p>
      </div>
    </section>

    <!-- 06 專區頁面（四個子頁；已上線的整張卡是連結） -->
    <section
      id="subpages"
      class="el-section anchor-section"
      aria-labelledby="h-subpages"
    >
      <div class="el-wrap">
        <p class="el-sec-no" aria-hidden="true">06</p>
        <div class="el-sec-head">
          <h2 id="h-subpages" class="el-h2">{up.subpages.title}</h2>
          <p class="el-sec-desc">{up.subpages.subtitle}</p>
        </div>
        <ul class="el-pages el-reset">
          {
            copy.roadmap.items.map((item, i) => {
              const slug = roadmapSlugs[i];
              const live = liveSubpages.has(slug);
              return (
                <li>
                  {live ? (
                    <a
                      href={`${langPrefix}/elections/2026/${slug}/`}
                      class="el-page is-live"
                    >
                      <span class="el-page-top">
                        <svg
                          class="el-icon el-page-icon"
                          viewBox="0 0 24 24"
                          aria-hidden="true"
                        >
                          {iconPaths[slug].map((d) => (
                            <path d={d} />
                          ))}
                        </svg>
                        <span class="el-status is-live">
