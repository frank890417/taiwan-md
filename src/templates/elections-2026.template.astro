    white-space: nowrap;
  }
  .el-tag--inline {
    margin-inline-start: 6px;
    vertical-align: 1px;
  }
  .el-btns {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 20px;
  }
  .el-btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 9px 16px;
    font-family: var(--el-sans);
    font-size: 14px;
    font-weight: 600;
    line-height: 1.4;
    border-radius: 8px;
    text-decoration: none;
    transition:
      background-color 0.15s,
      border-color 0.15s,
      color 0.15s;
  }
  .el-btn-primary {
    color: #fff;
    background: var(--el-accent);
    border: 1px solid var(--el-accent);
  }
  .el-btn-primary:hover {
    color: #fff;
    background: #67250e;
    border-color: #67250e;
  }
  .el-btn-ghost {
    color: var(--el-ink);
    background: var(--el-card);
    border: 1px solid #d6cdb8;
  }
  .el-btn-ghost:hover {
    color: var(--el-accent);
    border-color: var(--el-accent);
  }

  /* ── 01 候選人 ── */
  .el-cand-tools {
    display: flex;
    flex-direction: column;
    gap: 14px;
    margin: 0 0 32px;
    padding: 16px 0;
    border-top: 1px solid var(--el-rule);
    border-bottom: 1px solid var(--el-rule);
  }
  .el-seg:not([hidden]) {
    display: inline-flex;
    align-self: flex-start;
    gap: 2px;
    padding: 3px;
    background: #f1ebde;
    border: 1px solid var(--el-border);
    border-radius: 10px;
  }
  .el-seg-btn {
    padding: 6px 14px;
    font-family: var(--el-sans);
    font-size: 14px;
    font-weight: 500;
    line-height: 1.4;
    color: var(--el-ink-2);
    background: transparent;
    border: 0;
    border-radius: 7px;
    cursor: pointer;
    transition:
      background-color 0.15s,
      color 0.15s;
  }
  .el-seg-btn:hover {
    color: var(--el-ink);
  }
  .el-seg-btn[aria-pressed='true'] {
    color: var(--el-ink);
    background: var(--el-card);
    box-shadow:
      0 0 0 1px var(--el-border),
      0 1px 2px rgba(28, 25, 23, 0.08);
  }
  .el-jump {
    display: flex;
    flex-direction: column;
    gap: 8px;
    min-width: 0;
  }
  .el-jump-label {
    flex: none;
    margin: 0;
    font-size: 13px;
    line-height: 1.6;
    color: var(--el-ink-3);
    white-space: nowrap;
  }
  .el-jump-list {
    display: flex;
    gap: 6px;
    margin: 0 -20px;
    padding: 2px 20px;
    overflow-x: auto;
    scrollbar-width: none;
    -webkit-overflow-scrolling: touch;
  }
  .el-jump-list::-webkit-scrollbar {
    display: none;
  }
  .el-jump-list > li {
    flex: none;
  }
  .el-jump-link {
    display: inline-block;
    padding: 2px 10px;
    font-size: 13px;
    line-height: 1.6;
    color: var(--el-ink-2);
    white-space: nowrap;
    background: var(--el-card);
    border: 1px solid var(--el-border);
    border-radius: 999px;
    transition:
      color 0.15s,
      border-color 0.15s;
  }
  .el-jump-link:hover {
    color: var(--el-accent);
    border-color: rgba(124, 45, 18, 0.45);
  }
  .el-group + .el-group {
    margin-top: 40px;
  }
  .el-group-head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: baseline;
    gap: 6px 16px;
    margin-bottom: 16px;
  }
  .el-group-count {
    margin-inline-start: 10px;
    font-family: var(--el-sans);
    font-size: 14px;
    font-weight: 400;
    color: var(--el-ink-3);
  }
  .el-group-src {
    margin: 0;
    font-size: 13px;
    line-height: 1.6;
  }
  .el-races {
    columns: 1;
    column-gap: 16px;
  }
  .el-race {
    display: inline-block;
    width: 100%;
    margin: 0 0 16px;
    padding: 16px 18px 6px;
    break-inside: avoid;
    background: var(--el-card);
    border: 1px solid var(--el-border);
    border-radius: 12px;
    scroll-margin-top: 64px;
  }
  .el-race:target {
    border-color: var(--el-accent);
    box-shadow: 0 0 0 3px var(--el-accent-soft);
  }
  .el-race-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 12px;
    padding-bottom: 10px;
    border-bottom: 1px solid var(--el-rule);
  }
  .el-race-name {
    margin: 0;
    font-family: var(--el-serif);
    font-size: 18px;
    font-weight: 600;
    line-height: 1.4;
    color: var(--el-ink);
  }
  .el-race-orig {
    margin-inline-start: 6px;
    font-family: var(--el-sans);
    font-size: 13px;
    font-weight: 400;
    color: var(--el-ink-3);
  }
  .el-race-count {
    flex: none;
    font-size: 13px;
    line-height: 1.5;
    color: var(--el-ink-3);
    font-variant-numeric: tabular-nums;
  }
  .el-cand {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 12px;
    padding: 10px 0;
  }
  .el-cand + .el-cand {
    border-top: 1px solid var(--el-rule);
  }
  .el-cand-info {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 2px 8px;
    min-width: 0;
  }
  .el-cand-no {
    font-family: var(--el-mono);
    font-size: 13px;
    color: var(--el-ink-2);
    font-variant-numeric: tabular-nums;
  }
  .el-cand-name {
    font-size: 16px;
    font-weight: 600;
    line-height: 1.5;
    color: var(--el-ink);
    overflow-wrap: anywhere;
  }
  .el-cand-party {
    font-size: 14px;
    line-height: 1.5;
    color: var(--el-ink-2);
  }
  /* 條目動作：兩種同樣大小、同樣位置；只有顏色與底線樣式不同 */
  .el-cand-act {
    flex: none;
    font-size: 13px;
    font-weight: 500;
    line-height: 1.5;
    white-space: nowrap;
    padding-bottom: 1px;
    transition:
      color 0.15s,
      border-color 0.15s;
  }
  .el-cand-act.is-article {
    color: var(--el-accent);
    border-bottom: 1px solid rgba(124, 45, 18, 0.35);
  }
  .el-cand-act.is-article:hover {
    color: var(--el-accent);
    border-bottom-color: var(--el-accent);
  }
  .el-cand-act.is-contribute {
    color: var(--el-ink-2);
    border-bottom: 1px dashed #a8a29e;
  }
  .el-cand-act.is-contribute:hover {
    color: var(--el-accent);
    border-bottom-color: var(--el-accent);
  }
  .el-invite {
    margin-top: 24px;
    padding: 24px;
    background: var(--el-card);
    border: 1.5px dashed rgba(124, 45, 18, 0.45);
    border-radius: 14px;
  }
  .el-invite-title {
    margin: 0;
    font-family: var(--el-serif);
    font-size: 20px;
    font-weight: 700;
    line-height: 1.4;
    color: var(--el-ink);
  }
  .el-invite-body {
    margin: 10px 0 0;
    max-width: 720px;
    font-size: 15px;
    line-height: 1.8;
    color: var(--el-ink-2);
  }

  /* ── 02 怎麼投票 ── */
  .el-faqs {
    display: grid;
    gap: 16px;
  }
  .el-faq {
    display: flex;
    flex-direction: column;
    padding: 20px;
    background: var(--el-card);
    border: 1px solid var(--el-border);
    border-radius: 12px;
    scroll-margin-top: 64px;
  }
  .el-faq-no {
    margin: 0;
    font-family: var(--el-mono);
    font-size: 13px;
    font-weight: 600;
    line-height: 1.4;
    letter-spacing: 0.06em;
    color: var(--el-accent);
  }
  .el-faq-q {
    margin: 6px 0 0;
    font-family: var(--el-sans);
    font-size: 17px;
    font-weight: 600;
    line-height: 1.5;
    letter-spacing: 0;
    color: var(--el-ink);
  }
  .el-faq-a {
    margin: 8px 0 0;
    font-size: 15px;
    line-height: 1.8;
    color: #44403c;
  }
  .el-faq-src {
    margin: auto 0 0;
    padding-top: 14px;
    font-size: 13px;
    line-height: 1.7;
    color: var(--el-ink-3);
  }

  /* ── 03 同日公投 ── */
  .el-ref-grid {
    display: grid;
    gap: 32px;
  }
  .el-kicker {
    margin: 0 0 8px;
    font-size: 14px;
    font-weight: 600;
    line-height: 1.5;
    letter-spacing: 0.04em;
    color: #475569;
  }
  .el-ref-q {
    margin: 24px 0 0;
    padding: 20px 22px;
    background: #fff;
    border: 1px solid #dfe2e7;
    border-left: 3px solid #64748b;
    border-radius: 4px 12px 12px 4px;
  }
  .el-ref-q-label,
  .el-ref-tr-label {
    margin: 0;
    font-size: 13px;
    line-height: 1.6;
    color: #5b6472;
  }
  .el-ref-text {
    margin: 8px 0 0;
    font-family: var(--el-serif);
    font-size: 21px;
    font-weight: 600;
    line-height: 1.65;
    color: var(--el-ink);
  }
  .el-ref-tr {
    margin-top: 14px;
    padding-top: 12px;
    border-top: 1px solid #eceef1;
  }
  .el-ref-tr-text {
    margin: 4px 0 0;
    font-size: 15px;
    line-height: 1.7;
    color: #374151;
  }
  .el-ref-facts {
    margin: 0;
    padding: 4px 20px;
    background: #fff;
    border: 1px solid #dfe2e7;
    border-radius: 12px;
  }
  .el-ref-fact {
    padding: 14px 0;
  }
  .el-ref-fact + .el-ref-fact {
    border-top: 1px solid #eceef1;
  }
  .el-ref-fact dt {
    margin: 0;
    font-size: 13px;
    font-weight: 600;
    line-height: 1.5;
    color: #475569;
  }
  .el-ref-fact dd {
    margin: 4px 0 0;
    font-size: 15px;
    line-height: 1.75;
    color: var(--el-ink);
  }
  .el-ref-foot {
    margin-top: 32px;
    padding-top: 18px;
    border-top: 1px solid #d9dde3;
    font-size: 13px;
    line-height: 1.7;
    color: #4b5563;
  }
  .el-ref-foot p {
    margin: 0;
  }
  .el-ref-foot p + p {
    margin-top: 6px;
  }

  /* ── 04 選務時程：手機／平板直式，桌機橫向步驟條 ── */
  .el-steps {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .el-step {
    position: relative;
    padding: 0 0 22px 30px;
  }
  .el-step:last-child {
    padding-bottom: 0;
  }
  .el-step::before {
    content: '';
    position: absolute;
    left: 6px;
    top: 20px;
    bottom: -2px;
    width: 2px;
    background: var(--el-border);
  }
  .el-step:last-child::before {
    display: none;
  }
  .el-step.is-done::before {
    background: var(--el-done);
  }
  .el-step-dot {
    position: absolute;
    left: 0;
    top: 4px;
    width: 14px;
    height: 14px;
    box-sizing: border-box;
    border: 2px solid #cfc6b3;
    border-radius: 50%;
    background: var(--el-bg);
  }
  .is-done .el-step-dot {
    background: var(--el-done);
    border-color: var(--el-done);
  }
  .is-next .el-step-dot {
    background: var(--el-card);
    border-color: var(--el-accent);
    box-shadow: 0 0 0 4px var(--el-accent-soft);
  }
  .el-step-date {
    display: block;
    font-family: var(--el-mono);
    font-size: 13px;
    line-height: 1.6;
    color: var(--el-ink-3);
    font-variant-numeric: tabular-nums;
  }
  .is-done .el-step-date {
    color: var(--el-done);
  }
  .is-next .el-step-date {
    color: var(--el-accent);
    font-weight: 600;
  }
  .el-step-label {
    display: block;
    font-size: 15px;
    line-height: 1.6;
    color: var(--el-ink-2);
  }
  .is-next .el-step-label {
    font-weight: 600;
    color: var(--el-ink);
  }
  .el-step-badge {
    display: inline-block;
    margin-top: 4px;
    padding: 1px 8px;
    font-size: 12px;
    font-weight: 600;
    line-height: 1.6;
    color: var(--el-accent);
    background: var(--el-accent-soft);
    border-radius: 999px;
  }
  .el-steps-foot {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 12px;
    margin-top: 36px;
  }
  .el-more-link {
    font-size: 15px;
    font-weight: 600;
    line-height: 1.5;
    color: var(--el-accent);
    border-bottom: 1px solid rgba(124, 45, 18, 0.3);
    padding-bottom: 1px;
  }
  .el-more-link:hover {
    color: var(--el-accent);
    border-bottom-color: var(--el-accent);
  }

  /* ── 05 九種職位 ── */
  .el-total {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 4px 10px;
    margin: 0 0 24px;
    padding: 18px 0;
    border-top: 1px solid var(--el-rule);
    border-bottom: 1px solid var(--el-rule);
  }
  .el-total-label,
  .el-total-unit {
    font-size: 16px;
    color: var(--el-ink-2);
  }
  .el-total-num {
    font-family: var(--el-serif);
    font-size: 44px;
    font-weight: 700;
    line-height: 1.1;
    letter-spacing: -0.01em;
    color: var(--el-accent);
    font-variant-numeric: tabular-nums;
  }
  .el-total-src {
    margin-inline-start: auto;
    font-size: 13px;
  }
  .el-offices {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px;
  }
  .el-office {
    padding: 16px;
    background: var(--el-card);
    border: 1px solid var(--el-border);
    border-radius: 12px;
  }
  .el-office-name {
    margin: 0;
    font-family: var(--el-sans);
    font-size: 15px;
    font-weight: 600;
    line-height: 1.45;
    letter-spacing: 0;
    color: var(--el-ink);
  }
  .el-office-count {
    margin: 6px 0 0;
    font-family: var(--el-sans);
    font-size: 24px;
    font-weight: 700;
    line-height: 1.2;
    color: var(--el-ink);
    font-variant-numeric: tabular-nums;
  }
  .el-office-approx {
    font-size: 15px;
    font-weight: 600;
  }
  .el-office-desc {
    margin: 6px 0 0;
    font-size: 13px;
    line-height: 1.6;
    color: var(--el-ink-2);
  }

  /* ── 06 專區頁面 ── */
  .el-pages {
    display: grid;
    gap: 16px;
  }
  .el-pages > li {
    display: flex;
  }
  .el-page {
    display: flex;
    flex-direction: column;
    width: 100%;
    padding: 20px;
    color: var(--el-ink);
    text-decoration: none;
    background: var(--el-card);
    border: 1px solid var(--el-border);
    border-radius: 12px;
  }
  a.el-page {
    transition:
      border-color 0.15s,
      box-shadow 0.15s;
  }
  a.el-page:hover {
    color: var(--el-ink);
    border-color: rgba(124, 45, 18, 0.45);
    box-shadow: 0 8px 24px rgba(124, 45, 18, 0.07);
  }
  .el-page.is-wip {
    background: rgba(255, 255, 255, 0.55);
  }
  .el-page-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 14px;
  }
  .el-page-icon {
    color: var(--el-accent);
  }
  .is-wip .el-page-icon {
    color: var(--el-ink-3);
  }
  .el-status {
    padding: 1px 8px;
    font-size: 12px;
    font-weight: 600;
    line-height: 1.6;
    border-radius: 999px;
  }
  .el-status.is-live {
    color: var(--el-done);
    background: #eef3e2;
  }
  .el-status.is-wip {
    color: var(--el-ink-2);
    background: #f1ebde;
  }
  .el-page-title {
    display: block;
    font-family: var(--el-sans);
    font-size: 16px;
    font-weight: 600;
    line-height: 1.5;
    color: var(--el-ink);
    transition: color 0.15s;
  }
  a.el-page:hover .el-page-title {
    color: var(--el-accent);
  }
  .el-page-desc {
    display: block;
    margin-top: 6px;
    font-size: 14px;
    line-height: 1.7;
    color: var(--el-ink-2);
  }
  .el-page-cta {
    margin-top: auto;
    padding-top: 14px;
    font-size: 14px;
    font-weight: 600;
    line-height: 1.5;
    color: var(--el-accent);
  }

  /* ── 07 延伸閱讀與公民工具 ── */
  .el-further {
    display: grid;
    gap: 40px;
  }
  .el-col-intro {
    margin: 8px 0 0;
    font-size: 15px;
    line-height: 1.75;
    color: var(--el-ink-2);
  }
  .el-list {
    margin-top: 16px;
    border-top: 1px solid var(--el-border);
  }
  .el-list > li {
    border-bottom: 1px solid var(--el-rule);
  }
  .el-list-link {
    display: block;
    padding: 14px 0;
    color: var(--el-ink);
    border-bottom: 0;
  }
  .el-list-link:hover {
    color: var(--el-ink);
  }
  .el-list-title {
    display: block;
    font-size: 16px;
    font-weight: 600;
    line-height: 1.5;
    color: var(--el-ink);
    transition: color 0.15s;
  }
  .el-list-link:hover .el-list-title {
    color: var(--el-accent);
  }
  .el-ext {
    margin-inline-start: 4px;
    font-weight: 400;
    color: var(--el-ink-3);
  }
  .el-list-desc {
    display: block;
    margin-top: 2px;
    font-size: 14px;
    line-height: 1.65;
    color: var(--el-ink-2);
  }

  /* ── 08 關於本專區 ── */
  .el-about-grid {
    display: grid;
    gap: 36px;
  }
  .el-lead {
    margin: 12px 0 0;
    font-size: 18px;
    font-weight: 500;
    line-height: 1.75;
    color: var(--el-ink);
  }
  .el-about-p {
    margin: 14px 0 0;
    font-size: 16px;
    line-height: 1.85;
    color: #44403c;
  }
  .el-verify {
    align-self: start;
    padding: 22px 24px;
    background: rgba(255, 255, 255, 0.6);
    border: 1px solid var(--el-border);
    border-radius: 12px;
  }
  .el-checks {
    margin-top: 6px;
  }
  .el-checks > li {
    position: relative;
    margin-top: 10px;
    padding-left: 18px;
    font-size: 15px;
    line-height: 1.75;
    color: #44403c;
  }
  .el-checks > li::before {
    content: '';
    position: absolute;
    left: 2px;
    top: 0.72em;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--el-accent);
  }
  .el-domain {
    font-family: var(--el-mono);
    font-size: 14px;
  }
  .el-about-meta {
    margin-top: 20px;
    padding-top: 14px;
    border-top: 1px solid var(--el-border);
    font-size: 13px;
    line-height: 1.7;
    color: var(--el-ink-2);
  }
  .el-about-meta p {
    margin: 0;
  }
  .el-about-meta p + p {
    margin-top: 4px;
  }
  .el-tagline {
    margin: 48px 0 0;
    padding-top: 20px;
    border-top: 1px solid var(--el-border);
    font-size: 14px;
    line-height: 1.7;
    text-align: center;
    color: var(--el-ink-2);
  }

  /* ── 斷點 ── */
  @media (min-width: 640px) {
    .el-facts {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 12px;
    }
    .el-fact {
      flex-direction: column;
      gap: 10px;
    }
    .el-races {
      columns: 2;
    }
    .el-pages {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (min-width: 768px) {
    .el-wrap {
      padding: 0 32px;
    }
    .el-nav-scroll {
      margin: 0 -32px;
      padding: 0 32px;
