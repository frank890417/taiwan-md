<script>
  // 1. 候選人篩選：沒有 JS 時按鈕維持 hidden，兩組與 22 個縣市標籤全部顯示。
  const filter = document.querySelector<HTMLElement>('[data-cand-filter]');
  if (filter) {
    filter.hidden = false;
    const groups = document.querySelectorAll<HTMLElement>('[data-cand-group]');
    const jumps = document.querySelectorAll<HTMLElement>('[data-jump-group]');
    const buttons = filter.querySelectorAll<HTMLButtonElement>(
      'button[data-filter]',
    );
    filter.addEventListener('click', (event) => {
      const target = event.target as HTMLElement | null;
      const btn = target?.closest<HTMLButtonElement>('button[data-filter]');
      if (!btn) return;
      const key = btn.dataset.filter;
      buttons.forEach((b) =>
        b.setAttribute('aria-pressed', b === btn ? 'true' : 'false'),
      );
      const shown = (group?: string) => key === 'all' || group === key;
      groups.forEach((g) => {
        g.hidden = !shown(g.dataset.candGroup);
      });
      jumps.forEach((j) => {
        j.hidden = !shown(j.dataset.jumpGroup);
      });
    });
  }

  // 2. 章節導覽：跟著站台表頭（含語言橫幅）的實際高度貼齊；
  //    IntersectionObserver 標出目前段落；手機橫向捲動時只動導覽本身的
  //    scrollLeft（不用 scrollIntoView，避免整頁上下跳）。
  const nav = document.querySelector<HTMLElement>('[data-el-nav]');
  if (nav) {
    const scroller = nav.querySelector<HTMLElement>('[data-el-nav-scroll]');
    const links = Array.from(
      nav.querySelectorAll<HTMLAnchorElement>('a[data-nav-id]'),
    );
    const sections = links
      .map((l) => document.getElementById(l.dataset.navId ?? ''))
      .filter((s): s is HTMLElement => s !== null);

    const headerBox = document.getElementById('header-container');
    const syncTop = () => {
      if (!headerBox) return;
      const bottom = Math.round(headerBox.getBoundingClientRect().bottom);
      if (bottom > 0) nav.style.setProperty('--el-nav-top', `${bottom}px`);
    };
    syncTop();
    if (headerBox && typeof ResizeObserver !== 'undefined') {
      new ResizeObserver(syncTop).observe(headerBox);
    }
    window.addEventListener('resize', syncTop, { passive: true });

    const reduceMotion = window.matchMedia(
      '(prefers-reduced-motion: reduce)',
    ).matches;
    let current: string | null = null;
    const setCurrent = (id: string | null) => {
      if (id === current) return;
      current = id;
      links.forEach((l) => {
        if (l.dataset.navId === id) l.setAttribute('aria-current', 'true');
        else l.removeAttribute('aria-current');
      });
      const active = links.find((l) => l.dataset.navId === id);
      if (active && scroller && scroller.scrollWidth > scroller.clientWidth) {
        const left =
          active.offsetLeft - (scroller.clientWidth - active.offsetWidth) / 2;
        scroller.scrollTo({
          left: Math.max(0, left),
          behavior: reduceMotion ? 'auto' : 'smooth',
        });
      }
    };

    if ('IntersectionObserver' in window && sections.length > 0) {
      const headerBottom = headerBox?.getBoundingClientRect().bottom ?? 56;
      const bandTop = Math.round(headerBottom + nav.offsetHeight + 24);
      const visible = new Set<string>();
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((e) => {
            if (e.isIntersecting) visible.add(e.target.id);
            else visible.delete(e.target.id);
          });
          const first = sections.find((s) => visible.has(s.id));
          if (first) setCurrent(first.id);
          else if (sections[0].getBoundingClientRect().top > 0)
            setCurrent(null);
        },
        // 觀察帶的上緣＝表頭＋導覽＋24px，比錨點落點（約 120px）再低一點，
        // 點導覽跳過去時，上一段的底邊已經離開觀察帶。
        { rootMargin: `-${bandTop}px 0px -55% 0px` },
      );
      sections.forEach((s) => observer.observe(s));
    }
  }
</script>

