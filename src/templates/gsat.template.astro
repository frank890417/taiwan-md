        avoidTitle: 'Do not bring these to your seat',
        avoid: [
          'Mobile phones, smart watches, smart glasses, wristbands, earphones, or other electronic wearable devices.',
          'Unapproved electronic equipment, notes, books, calculators, or stationery that does not meet the current brochure rules.',
          'Any item you are unsure about: leave it outside the test seat or confirm with the test center before the session begins.',
        ],
        flowTitle: 'The day before → the day of the exam',
        flow: [
          {
            time: 'The day before',
            text: 'Check the CEEC venue/seating notice, test subjects and timetable; walk or map the route and prepare two transport options.',
          },
          {
            time: 'Before departure',
            text: 'Recheck your original identity document and permitted stationery. Turn off devices and keep them out of the test seat.',
          },
          {
            time: 'At the venue',
            text: 'Follow the test center’s admission time and staff directions. Confirm your room and seat calmly; do not rely on a screenshot alone.',
          },
          {
            time: 'During the session',
            text: 'Read the answer-sheet and booklet instructions first. If you are unwell or have a test-site problem, raise your hand and ask a proctor rather than handling it alone.',
          },
        ],
        supportTitle: 'Need an accommodation?',
        support:
          'Candidates with disabilities or major illnesses should apply through the CEEC’s annual accommodation process within the published registration window. Services may include accessible seating, assistive devices, a separate or lower-floor room, extra testing time, enlarged or braille papers, and other case-based arrangements.',
        supportLink: 'CEEC accommodation application information',
        brochureLink: 'AY116 CEEC exam brochure (official PDF)',
        notice:
          'Rules, permitted items and schedules can change each year. The current CEEC brochure and test-center notice always control.',
      }
    : {
        title: '考前一晚到入場前：學測應試準備清單',
        intro:
          '把本區當作行前檢查表，不當成簡章的替代品。考場規定、有效證件與可攜物品應以當年度大考中心簡章、試場分配表與考區公告為準。',
        packingTitle: '出門前，逐項勾選',
        packing: [
          '當年度簡章規定的應試有效證件正本；學生證不是應試有效證件，請勿只帶學生證。',
          '黑色 2B 軟心鉛筆、乾淨橡皮擦、黑色墨水筆與透明墊板；各考科細節仍須依當年度簡章確認。',
          '如需攜帶文具，使用無文字符號的透明文具袋（盒），避免帶入無法辨識或不符規範的用品。',
          '考區、試場與座位資訊；預留進場查驗與交通延誤時間，並準備至少一個備用交通方案。',
          '保暖衣物、雨具與個人必要藥物；醫療用品若可能影響應試，請提早向大考中心確認是否需要申請服務。',
        ],
        avoidTitle: '不要帶進座位',
        avoid: [
          '行動電話、智慧手錶、智慧眼鏡、智慧手環、耳機等電子穿戴式裝置。',
          '未獲允許的電子設備、筆記、書籍、計算機或不符合當年度簡章規範的文具。',
          '任何拿不準的物品：不放在座位周邊，於考試前向考區人員確認。',
        ],
        flowTitle: '前一日 → 考試當日',
        flow: [
          {
            time: '考前一日',
            text: '查大考中心試場分配與座位資訊，核對自己報考的科目與節次；先走一次或在地圖上確認路線，至少備妥兩種交通方案。',
          },
          {
            time: '出門前',
            text: '再確認有效證件正本與合規文具；所有電子裝置關機、不帶進座位。',
          },
          {
            time: '抵達考區',
            text: '依考區開放時間與試務人員指示入場；冷靜確認試場與座位，不只依賴手機截圖。',
          },
          {
            time: '考試進行中',
            text: '先讀答案卡與試題本說明；身體不適或遇到試務問題時舉手請監試人員協助，不要自行處理。',
          },
        ],
        supportTitle: '需要特殊應考服務？',
        support:
          '身心障礙或重大傷病考生，應在大考中心公告的報名期限內，依年度規定提出應考服務申請。服務可能包括便於應試的座位、低樓層或特殊試場、輔具、延長考試時間、放大或點字試題等，均依個案與審查結果辦理。',
        supportLink: '大考中心：身心障礙及重大傷病考生應考服務',
        brochureLink: '116 學年度考試簡章（大考中心 PDF）',
        notice:
          '考試日期、可攜物品、違規處理與服務申請均可能逐年更新；最後決定以當年度簡章及考區公告為準。',
      };
---

<Layout lang={lang} title={pageTitle} description={pageDescription}>
  <main class="gsat main" style="padding: 0;">
    {/* ============ HERO ============ */}
    <section class="gsat-hero">
      <div class="section-inner">
        <p class="eyebrow">{copy.hero.eyebrow}</p>
        <h1 class="hero-title">
          <span>{copy.hero.titlePrefix}</span>
          <span class="em">{copy.hero.titleEmphasis}</span>
          {copy.hero.titleSuffix && <span>{copy.hero.titleSuffix}</span>}
        </h1>
        <p class="hero-subtitle">{copy.hero.subtitle}</p>
        <div class="hero-meta-row">
          <div class="countdown-chip">
            <span class="chip-label">{copy.hero.countdownLabel}</span>
            <span class="chip-value">
              {daysUntil}
              <span class="chip-unit">{copy.hero.dayUnit}</span>
            </span>
          </div>
          <div class="date-chip">{copy.hero.dateLabel}</div>
        </div>
        <div class="hero-status">
          <strong>{copy.hero.recentTitle}</strong>
          <span>{copy.hero.recentSubtitle}</span>
        </div>
      </div>
    </section>

    {/* ============ ROLE ============ */}
    <section class="gsat-role">
      <div class="section-inner">
        <h2>{copy.role.title}</h2>
        <div class="role-grid">
          <p class="role-p role-p1">{copy.role.p1}</p>
          <p class="role-p role-p2">{copy.role.p2}</p>
          <p class="role-p role-p3">{copy.role.p3}</p>
          <p class="role-p role-p4">{copy.role.p4}</p>
        </div>
        <a
          class="cta-primary"
          href={copy.related.articles[0]?.href ?? '/exams/gsat/'}
        >
          {copy.role.primaryCta}
        </a>
      </div>
    </section>

    {/* ============ CURATION (文章整合) ============ */}
    <section class="gsat-curation">
      <div class="section-inner">
        <h2>{copy.curation.title}</h2>
        <p class="section-intro">{copy.curation.intro}</p>
        <div class="curation-grid">
          <div class="truth-card">
            <h3>{copy.curation.overviewTitle}</h3>
            <p>{copy.curation.overviewBody}</p>
          </div>
          <div class="truth-card">
            <h3>{copy.curation.fairnessTitle}</h3>
            <p>{copy.curation.fairnessBody}</p>
          </div>
        </div>
        <blockquote class="curation-quote">
          <p>{copy.curation.fairnessQuote.text}</p>
          <cite>{copy.curation.fairnessQuote.who}</cite>
        </blockquote>
        <a
          class="cta-primary cta-article"
          href={copy.curation.articleLink.href}
        >
          {copy.curation.articleLink.label}
        </a>
      </div>
    </section>

    {/* ============ SUBJECTS ============ */}
    <section class="gsat-subjects">
      <div class="section-inner">
        <h2>{copy.subjects.title}</h2>
        <p class="section-intro">{copy.subjects.intro}</p>
        <div class="subject-grid">
          {
            copy.subjects.items.map((s, i) => (
              <div class="card subject-card">
                <div class="card-icon">{subjectCardIcons[i]}</div>
                <h3>{s.name}</h3>
                <p class="card-spec">{s.spec}</p>
                <p class="card-desc">{s.desc}</p>
              </div>
            ))
          }
        </div>
        {
          copy.subjects.sourceNote && (
            <p class="source-note">📌 {copy.subjects.sourceNote}</p>
          )
        }
      </div>
    </section>

    {/* ============ NUMBERS ============ */}
    <section class="gsat-numbers">
      <div class="section-inner">
        <h2>{copy.numbers.title}</h2>
        <p class="section-intro">{copy.numbers.intro}</p>
        <div class="stat-grid">
          {
            copy.numbers.stats.map((s) => (
              <div class="stat-card">
                <div class="stat-value">{s.value}</div>
                <div class="stat-label">{s.label}</div>
                <div class="stat-note">{s.note}</div>
              </div>
            ))
          }
        </div>
        <div class="chart-panel">
          <h3>{copy.numbers.chartTitle}</h3>
          <div class="tw-bars" id="tw-bars-gsat">
            {
              bars.map((b) => (
                <div class="tw-bar">
                  <div
                    class="tw-bar-inner"
                    style={`width: ${Math.round((b.value / maxVal) * 100)}%`}
                  >
                    <span class="tw-bar-val">{b.value.toLocaleString()}</span>
                  </div>
                  <div class="tw-bar-label">
                    <span class="tw-bar-year">{b.label}</span>
                    {b.note && <span class="tw-bar-note">{b.note}</span>}
                  </div>
                </div>
              ))
            }
          </div>
          <p class="source-note">📌 {copy.numbers.chartSource}</p>
        </div>
      </div>
    </section>

    {/* ============ PEOPLE ============ */}
    <section class="gsat-people">
      <div class="section-inner">
        <h2>{copy.people.title}</h2>
        <p class="section-intro">{copy.people.intro}</p>
        <div class="people-groups">
          {
            copy.people.groups.map((g) => (
              <div class="people-group">
                <h3 class="group-title">{g.group}</h3>
                <div class="people-grid">
                  {g.items.map((p) => (
                    <a class="card person-card" href={p.href}>
                      <div
                        class="person-badge"
                        style={`background:${accents[0]}`}
                      >
                        {p.badge}
                      </div>
                      <h4>{p.name}</h4>
                      <p>{p.desc}</p>
                    </a>
                  ))}
                </div>
              </div>
            ))
          }
        </div>
        <blockquote class="people-quote">
          <p>{copy.people.quote.text}</p>
          <cite>{copy.people.quote.who}</cite>
        </blockquote>
      </div>
    </section>

    {/* ============ PIPELINES ============ */}
    <section class="gsat-pipelines">
      <div class="section-inner">
        <h2>{copy.pipelines.title}</h2>
        <p class="section-intro">{copy.pipelines.intro}</p>
        <div class="pipeline-grid">
          {
            copy.pipelines.items.map((p) => (
              <div class="card pipeline-card">
                <div class="pipeline-accent" style={`background:${p.accent}`} />
                <h3>{p.name}</h3>
                <p class="card-spec">{p.spec}</p>
                <p class="card-desc">{p.desc}</p>
              </div>
            ))
          }
        </div>
        <p class="source-note">📌 {copy.pipelines.sourceNote}</p>
      </div>
    </section>

    {/* ============ EXAM-DAY READINESS ============ */}
    <section class="gsat-exam-day" aria-labelledby="gsat-exam-day-title">
      <div class="section-inner">
        <p class="section-kicker">EXAM-DAY FIELD NOTE</p>
        <h2 id="gsat-exam-day-title">{examDay.title}</h2>
        <p class="section-intro">{examDay.intro}</p>
        <div class="exam-prep-grid">
          <article class="exam-panel packing-panel">
            <h3>✓ {examDay.packingTitle}</h3>
            <div class="packing-list">
              {
                examDay.packing.map((item) => (
                  <label class="pack-item">
                    <input type="checkbox" />
                    <span class="pack-text">{item}</span>
                  </label>
                ))
              }
            </div>
          </article>
          <article class="exam-panel avoid-panel">
            <h3>× {examDay.avoidTitle}</h3>
            <ul>{examDay.avoid.map((item) => <li>{item}</li>)}</ul>
          </article>
        </div>
        <div class="exam-flow">
          <h3>{examDay.flowTitle}</h3>
          <ol>
            {
              examDay.flow.map((step, index) => (
                <li>
                  <>
                    <span class="flow-number">0{index + 1}</span>
                    <div>
                      <>
                        <strong>{step.time}</strong>
                        <p>{step.text}</p>
                      </>
                    </div>
                  </>
                </li>
              ))
            }
          </ol>
        </div>
        <aside class="exam-support">
          <div>
            <p class="support-label">ACCESS & ACCOMMODATION</p>
            <h3>{examDay.supportTitle}</h3>
            <p>{examDay.support}</p>
          </div>
          <div class="exam-links">
            <a
              href="https://www.ceec.edu.tw/xmfile?xsmsid=0J052605494129871538"
              target="_blank"
              rel="noopener"
              >{examDay.supportLink} <span aria-hidden="true">↗</span></a
            >
            <a
              href="https://www.ceec.edu.tw/files/file_pool/1/0q215601929252011195/116%E5%AD%B8%E5%B9%B4%E5%BA%A6%E7%B0%A1%E7%AB%A0.pdf"
              target="_blank"
              rel="noopener"
              >{examDay.brochureLink} <span aria-hidden="true">↗</span></a
            >
          </div>
        </aside>
        <p class="exam-day-notice">⚠ {examDay.notice}</p>
      </div>
    </section>

    {/* ============ HISTORY ============ */}
    <section class="gsat-history">
      <div class="section-inner">
        <h2>{copy.history.title}</h2>
        <p class="section-intro">{copy.history.intro}</p>
        <ol class="tw-timeline" id="tw-timeline-gsat">
          {
            copy.history.items.map((h) => (
              <li>
                <time>{h.year}</time>
                <h3>{h.title}</h3>
                <p>{h.note}</p>
              </li>
            ))
          }
        </ol>
      </div>
    </section>

    {/* ============ RELATED ============ */}
    <section class="gsat-related">
      <div class="section-inner">
        <h2>{copy.related.title}</h2>
        <p class="section-intro">{copy.related.intro}</p>
        <div class="article-grid">
          {
            copy.related.articles.map((a) => (
              <a class="card article-card" href={a.href}>
                <span
                  class="article-badge"
                  style={`background:${a.badge === 'Featured' ? accents[0] : a.badge === 'Hub' ? accents[2] : accents[1]}`}
                >
                  {a.badge}
                </span>
                <h3>{a.title}</h3>
                <p>{a.desc}</p>
              </a>
            ))
          }
        </div>
      </div>
    </section>

    {/* ============ RESOURCES ============ */}
    <section class="gsat-resources">
      <div class="section-inner">
        <h2>{copy.resources.title}</h2>
        <p class="section-intro">{copy.resources.intro}</p>
        <div class="resource-grid">
          {
            copy.resources.items.map((r) => (
              <a
                class="card resource-card"
                href={r.url}
                target="_blank"
                rel="noopener"
              >
                <span class="resource-icon">{r.icon}</span>
                <h3>{r.name}</h3>
                <p>{r.desc}</p>
              </a>
            ))
          }
        </div>
      </div>
    </section>

    {/* ============ VERIFY FOOTER ============ */}
    <section class="gsat-verify">
      <div class="section-inner">
        <h2>{copy.verify.title}</h2>
        <p>
          {copy.verify.domainPrefix}
          <strong>taiwan.md</strong>{copy.verify.domainSuffix}
        </p>
        <ul class="verify-list">
          <li>✅ {copy.verify.gitLog}</li>
          <li>📎 {copy.verify.attribution}</li>
          <li>🧭 {copy.verify.mvp}</li>
          <li>🚧 {copy.verify.roadmap}</li>
        </ul>
        <p class="verify-footer">
          {copy.verify.footerPrefix}
          <strong>{copy.verify.footerEmphasis}</strong>
        </p>
      </div>
    </section>
  </main>

  <style>
    /* ===== GSAT 專題樣式（CEEC 學測卡酒紅色系）===== */
    .gsat {
      --gsat-accent: #9d3d45;
      --gsat-navy: #6d3226;
      --gsat-bg: #eeecea;
      --gsat-soft: #fdf3ec;
      --gsat-border: #e0d9cf;
      --gsat-link: #cf4747;
      --gsat-text: #505050;
      background: var(--gsat-bg);
    }
    .gsat .section-inner {
      max-width: 1100px;
      margin: 0 auto;
      padding: 56px 20px;
    }
    .gsat h2 {
      font-size: 1.75rem;
      color: var(--gsat-navy);
      border-left: 5px solid var(--gsat-accent);
      padding-left: 14px;
      margin-bottom: 12px;
    }
    .gsat .section-intro {
      color: var(--gsat-text);
      max-width: 780px;
      margin-bottom: 28px;
    }

    /* Hero */
    .gsat-hero {
      background: linear-gradient(
        160deg,
        #eeecea 0%,
        #fdf3ec 45%,
        #ffffff 100%
      );
      border-bottom: 3px solid var(--gsat-accent);
    }
    .gsat-hero .eyebrow {
      font-size: 0.9rem;
      letter-spacing: 0.12em;
      color: var(--gsat-accent);
      font-weight: 700;
      margin-bottom: 12px;
    }
    .gsat-hero .hero-title {
      font-size: 3.4rem;
      line-height: 1.1;
      color: var(--gsat-navy);
      margin-bottom: 16px;
    }
    .gsat-hero .hero-title .em {
      color: var(--gsat-accent);
      position: relative;
    }
