const lang = getLangFromUrl(Astro.url);
const copy = gsatCopy[lang] ?? gsatCopy['zh-TW'];
const pageTitle = copy.meta.title;
const pageDescription = copy.meta.description;

// ===== build-time countdown to the next GSAT (116 academic year: 2027-01-22) =====
const nextExamDate = new Date('2027-01-22T08:30:00+08:00');
const nowBuild = new Date();
const msPerDay = 86_400_000;
const daysUntil = Math.max(
  0,
  Math.ceil((nextExamDate.getTime() - nowBuild.getTime()) / msPerDay),
);

// chart geometry
const bars = copy.numbers.bars;
const maxVal = Math.max(...bars.map((b) => b.value));

const subjectCardIcons = ['國', '英', 'A', 'B', '社', '自'];

// ===== 實用準備清單：明確區分「當年度簡章規定」與「行前建議」 =====
const examDay =
  lang === 'en'
    ? {
        title: 'Before the bell: a practical GSAT checklist',
        intro:
