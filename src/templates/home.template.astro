---
/**
 * home.template.astro — 統一首頁 template（13 個語言共用）
 *
 * 為什麼是一份樣板：原本每個語言各一份 index.astro，內容幾乎一樣。實際只有兩種
 * 展廳散文：中文一份、其他語言共用一份英文（HomeEnHalls），其餘只差網址前綴。
 * 對照 about.template.astro / dashboard.template.astro 的同一個做法。
 * （2026-05-03 sleepy-colden P2 follow-through unification）
 *
 * ── 2026-11-19 首頁第一期：修補與重排 ──────────────────────────────────
 * 規格：reports/design-homepage-about-implementation-2026-11-19.md 第 2 節。
 * 首頁現在的工作是門面：說清楚這是什麼、它現在有多大、它是活的而且有人在、
 * 然後請人走進去。十二個區塊的順序：
 *
 *    1 開場              hero                HeroSection（主視覺不動）
 *    2 引語時間軸        cover_story         CoverStory
 *    3 四扇門            reader_doors        ReaderDoors
 *    4 直接能用的        tools_band          ToolsBand（新）
 *    5 分類格            category_grid       CategoryGrid（從頁尾附近上移）
 *    6 四展廳            exhibition_halls    散文全文留在這份樣板，每廳加一張縮圖
 *    7 不知道從哪開始？  reading_path        ReadingPath + RandomDiscovery（併成一區）
 *                        random_discovery
 *    8 人                people              PeopleSection（新；內含 community_feedback）
 *    9 最近              recent_updates      RecentUpdates（改成最近新進的文章）
 *   10 為什麼用繁體中文  language_statement  LanguageStatement（原文不動）
 *   11 生命體            organism_preview    OrganismPreview（三處併成一處）
 *   12 參與與訂閱        join                JoinSection（新；內含 contribute、newsletter）
 *
 * 中間那一欄是 data-ga-view 的區塊名。舊名一個都沒改，改版前後的曝光數據才接得上；
 * 新名只有 tools_band、people、join。區塊名是事件參數的值，不是自訂維度，
 * 不用在 register-ga4-custom-dimensions.py 登記。
 *
 * 「為什麼需要 Taiwan.md？」四張價值卡從首頁拿掉，搬去關於頁（另一條線在做）。
 * 它底下的兩顆連結（知識圖譜、原始資料）留在首頁的生命體那一區。
 *
 * ⚠️ 四個展廳的中文策展散文是原味，重排時一個字都不能動，連縮排都不要動
 * （prettier 重新折行時，折在兩個中文字之間會多出一個看得見的空白）。縮圖是插在
 * 每一廳標題底下的獨立元素，沒有碰散文的任何一行。
 *
 * 這份樣板不輸出 HTML 註解：說明都寫成 Astro 註解，不會跟著正式頁送出去
 * （改版前首頁帶著 20 KB 的程式註解）。
 */
import { categoryList } from '../utils/categoryConfig';
import { readingPathLabels } from '../i18n/reading-path';
import '../styles/home-sections.css';
import Layout from '../layouts/Layout.astro';
import HomeDefs from '../components/home/HomeDefs.astro';
import HeroSection from '../components/home/HeroSection.astro';
import CoverStory from '../components/home/CoverStory.astro';
import ReaderDoors from '../components/home/ReaderDoors.astro';
import ToolsBand from '../components/home/ToolsBand.astro';
import CategoryGrid from '../components/CategoryGrid.astro';
import HallThumb from '../components/home/HallThumb.astro';
import HomeEnHalls from '../components/home/HomeEnHalls.astro';
import ReadingPath from '../components/ReadingPath.astro';
import RandomDiscovery from '../components/home/RandomDiscovery.astro';
import PeopleSection from '../components/home/PeopleSection.astro';
import RecentUpdates from '../components/home/RecentUpdates.astro';
import LanguageStatement from '../components/home/LanguageStatement.astro';
import OrganismPreview from '../components/home/OrganismPreview.astro';
import JoinSection from '../components/home/JoinSection.astro';
import ProticoScript from '../components/ProticoScript.astro';
import { useTranslations, getLangFromUrl } from '../i18n/utils';
import { useHomeT } from '../components/home/home-i18n';
import matter from 'gray-matter';
import { readFileSync, readdirSync } from 'node:fs';
import { resolve, join, basename } from 'node:path';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const th = useHomeT(lang);

// 分類數從分類設定算（about 是站務分類，不算主題）。頁面描述與分類格的標題都用
// 這一個數字，13 個語言一致；原本描述裡寫死「12 大主題」，頁面上卻是 13 張卡。
const categoryCount = categoryList.filter(
  (category) => category !== 'about',
).length;

// ── Lang-derived helpers ─────────────────────────────────────────────────────
// langPath: '' for zh-TW (SSOT root), else '{lang}/' for non-default langs.
// langUrlPrefix: '' for zh, else '/{lang}'. Used for cross-page links.
// isZh: gate for Chinese-vs-English narrative (zh has bespoke 中文 prose, the
// other 5 langs all share the same English hall narrative).
const isZh = lang === 'zh-TW';
const langUrlPrefix = isZh ? '' : `/${lang}`;

// ── Exhibition: scan A-grade articles for pick cards ──
interface PickArticle {
  title: string;
  href: string;
  footnotes: number;
  readingTime: number;
  description: string;
  featured?: boolean;
}

const categoryFolders: Record<string, string> = {
  history: 'History',
  geography: 'Geography',
  culture: 'Culture',
  food: 'Food',
  art: 'Art',
  music: 'Music',
  technology: 'Technology',
  nature: 'Nature',
  people: 'People',
  society: 'Society',
  economy: 'Economy',
  lifestyle: 'Lifestyle',
};

const topPicks: Record<string, PickArticle[]> = {};

for (const [slug, folder] of Object.entries(categoryFolders)) {
  // Lang-aware folder: zh reads knowledge/{Cat}/, others knowledge/{lang}/{Cat}/
  const dir = isZh
    ? resolve(process.cwd(), 'knowledge', folder)
    : resolve(process.cwd(), 'knowledge', lang, folder);
  const picks: PickArticle[] = [];
  try {
    const files = readdirSync(dir).filter(
      (f) => f.endsWith('.md') && !f.startsWith('_'),
    );
    for (const file of files) {
      const raw = readFileSync(join(dir, file), 'utf-8');
      const { data } = matter(raw);
      const fnCount = (raw.match(/^\[\^\d+\]:/gm) || []).length;
      // Two-tier threshold: featured articles at ≥8fn, others at ≥15fn
      const threshold = data.featured ? 8 : 15;
      if (fnCount >= threshold) {
        picks.push({
          title: data.title || basename(file, '.md'),
          href: `${langUrlPrefix}/${slug}/${encodeURIComponent(basename(file, '.md'))}`,
          footnotes: fnCount,
          readingTime: data.readingTime || 10,
          description: data.description || '',
          featured: data.featured || false,
        });
      }
    }
  } catch {}
  // Featured first, then by footnotes
  topPicks[slug] = picks
    .sort((a, b) => {
      if (a.featured !== b.featured) return a.featured ? -1 : 1;
      return b.footnotes - a.footnotes;
    })
    .slice(0, 3);
}

// ── Hall-level dedup: remove near-duplicate titles across categories in same hall ──
const hallGroups: Record<string, string[]> = {
  hall1: ['geography', 'nature', 'lifestyle'],
  hall2: ['history', 'culture', 'society'],
  hall3: ['people', 'art', 'music'],
  hall4: ['technology', 'economy', 'food'],
};

for (const cats of Object.values(hallGroups)) {
  const seen = new Set<string>();
  for (const cat of cats) {
    topPicks[cat] = (topPicks[cat] || [])
      .filter((p) => {
        const prefix = p.title.slice(0, 4);
        if (seen.has(prefix)) return false;
        seen.add(prefix);
        return true;
      })
      .slice(0, 2); // max 2 per category within a hall
  }
}

// ── Dynamic reading path: pick top A-grade from different categories ──
const usedCategories = new Set<string>();
const readingCandidates = Object.entries(topPicks)
  .flatMap(([cat, arts]) => arts.slice(0, 1).map((a) => ({ ...a, cat })))
  .sort((a, b) => b.footnotes - a.footnotes);

const readingPathSteps = readingCandidates
  .filter((a) => {
    if (usedCategories.has(a.cat)) return false;
    usedCategories.add(a.cat);
    return true;
  })
  .slice(0, 5)
  .map((a) => ({
    href: a.href,
    title: a.title,
    description:
      a.description.length > 60
        ? a.description.slice(0, 57) + '...'
        : a.description,
    time: `${a.readingTime} min`,
  }));

const totalTime = readingPathSteps.reduce(
  (sum, s) => sum + parseInt(s.time),
  0,
);

const readingPathFooterItems = [
  {
    icon: '⏱️',
    label: `${t('home.readingPath.footer.totalLabel')} ${totalTime} ${t('home.readingPath.footer.minutesUnit')}`,
  },
  {
    icon: '🎯',
    label: `${readingPathSteps.length} ${t('home.readingPath.footer.domainsLabel')}`,
  },
  { icon: '🌟', label: t('home.readingPath.footer.getToKnow') },
];
---

<Layout
  lang={lang}
  title={t('home.meta.title')}
  description={t('home.meta.description').replace(
    '{categories}',
    String(categoryCount),
  )}
  readerSettings
>
  <div class="home-page">
    <HomeDefs />

    <div data-ga-view="hero"><HeroSection /></div>

    <div id="cover-story" data-ga-view="cover_story">
      <CoverStory />
    </div>

    <div data-ga-view="reader_doors"><ReaderDoors /></div>

    <div data-ga-view="tools_band"><ToolsBand /></div>

    <section
      id="categories"
      class="home-section home-categories"
      aria-labelledby="categories-heading"
    >
      <div class="home-wrap">
        <header class="home-head">
          <p class="home-eyebrow">{th('home.categories.eyebrow')}</p>
          <h2 id="categories-heading" class="home-title">
            {
              t('home.categories.divider').replace(
                '{count}',
                String(categoryCount),
              )
            }
          </h2>
        </header>
      </div>
      <div data-ga-view="category_grid"><CategoryGrid /></div>
    </section>

    {
      /* ===== EXHIBITION HALLS =====
       Partial Tailwind migration (Phase 6): wrappers moved to inline
       utilities. The .hall-* / .pick-* / .topic-pill repeating card
       classes stay in scoped <style> because they repeat × 8 halls;
       inlining would turn the markup into noise. Same call as Header. */
    }
    <section class="home-section" data-ga-view="exhibition_halls">
      <div class="mb-8 text-center">
        <h2
          class="text-center font-['jf-lanyangming','Noto_Serif_TC','Source_Han_Serif_TC',serif] text-[2rem] font-light text-[#1f2937]"
        >
          {t('home.categories.heading')}
        </h2>
      </div>

      <div
        class="exhibition-halls mx-auto max-w-[var(--container-prose)] px-8 max-[768px]:px-6 max-[480px]:px-4"
      >
        {
          !isZh && (
            <HomeEnHalls topPicks={topPicks} langUrlPrefix={langUrlPrefix} />
          )
        }
        {
          isZh && (
            <>
              {/* ── 展廳一：這座島長什麼樣 ── */}
              <div class="exhibition-hall">
                <div class="hall-divider">
                  <div class="hall-line" />
                  <span class="hall-label">壹 — 這座島長什麼樣</span>
                  <div class="hall-line" />
                </div>
                <HallThumb hall={1} />
                <div class="hall-body">
                  <p>
                    這座島嶼只有 36,000 平方公里，卻從海平面堆到 3,952
                    公尺。菲律賓海板塊每年往歐亞板塊擠 8
                    公分，把台灣拱成全球山地密度最高的島嶼之一。
                    <a
                      href="/geography"
                      data-ga-section="hall_pill"
                      class="topic-pill"
                    >
                      🗺️ 這裡的地理
                    </a>
                    不是風景明信片，是一座還在長高的島。
                    北回歸線穿過嘉義，同一天你可以從墾丁的熱帶海灘開車到合歡山看霜雪。
                  </p>
                  {topPicks.geography && topPicks.geography.length > 0 && (
                    <div class="hall-picks">
                      {topPicks.geography.map((a) => (
                        <a
                          href={a.href}
                          data-ga-section="hall_pick"
                          class="pick-card"
                        >
                          <span class="pick-head">
                            <span class="pick-title">{a.title}</span>
                            <span class="pick-fn">{a.footnotes} 引用</span>
                          </span>
                          {a.description && (
                            <span class="pick-desc">
                              {a.description.length > 80
                                ? a.description.slice(0, 77) + '...'
                                : a.description}
                            </span>
                          )}
                        </a>
                      ))}
                    </div>
                  )}

                  <p>
                    比荷蘭還小的島上，擠進了 59,000 種生物，佔全球物種的 2.5%。
                    櫻花鉤吻鮭在大甲溪上游活了一萬五千年，
                    台灣黑熊的族群數量不到六百隻。
                    <a
                      href="/nature"
                      data-ga-section="hall_pill"
                      class="topic-pill"
                    >
                      🌿 台灣的自然
                    </a>
                    從海底珊瑚礁到 3,000 公尺的雲霧帶，
                    垂直壓縮了北半球從赤道到寒帶的所有生態系。
                    這裡是生態學家的天堂，也是開發壓力的前線。
                  </p>
                  {topPicks.nature && topPicks.nature.length > 0 && (
                    <div class="hall-picks">
                      {topPicks.nature.map((a) => (
                        <a
                          href={a.href}
                          data-ga-section="hall_pick"
                          class="pick-card"
                        >
                          <span class="pick-head">
                            <span class="pick-title">{a.title}</span>
                            <span class="pick-fn">{a.footnotes} 引用</span>
                          </span>
                          {a.description && (
                            <span class="pick-desc">
                              {a.description.length > 80
                                ? a.description.slice(0, 77) + '...'
                                : a.description}
                            </span>
                          )}
                        </a>
                      ))}
                    </div>
                  )}

                  <p>
                    13,000 家便利商店，平均每 2,000
                    人共用一家。繳水電費、領包裹、買高鐵票、
                    影印畢業論文，全在同一個櫃台完成。
                    <a
                      href="/lifestyle"
                      data-ga-section="hall_pill"
                      class="topic-pill"
                    >
                      🏠 台灣人的生活
                    </a>
                    被一套極度壓縮的基礎建設包裹著——
                    但下了班走進巷弄，阿嬤還是會問你那句「你吃飽了沒？」
                  </p>
                  {topPicks.lifestyle && topPicks.lifestyle.length > 0 && (
                    <div class="hall-picks">
                      {topPicks.lifestyle.map((a) => (
                        <a
                          href={a.href}
                          data-ga-section="hall_pick"
                          class="pick-card"
                        >
                          <span class="pick-head">
                            <span class="pick-title">{a.title}</span>
                            <span class="pick-fn">{a.footnotes} 引用</span>
                          </span>
                          {a.description && (
                            <span class="pick-desc">
                              {a.description.length > 80
                                ? a.description.slice(0, 77) + '...'
                                : a.description}
                            </span>
                          )}
                        </a>
                      ))}
                    </div>
                  )}
                </div>
              </div>

              {/* ── Bridge 1→2 (A2, Wave 3) ── */}
              <div class="hall-bridge">
                <div class="hall-bridge-line" />
                <em class="hall-bridge-text">{t('home.bridge.1to2')}</em>
                <div class="hall-bridge-line" />
              </div>

              {/* ── 展廳二：這座島怎麼來的 ── */}
              <div class="exhibition-hall">
                <div class="hall-divider">
                  <div class="hall-line" />
                  <span class="hall-label">貳 — 這座島怎麼來的</span>
                  <div class="hall-line" />
                </div>
                <HallThumb hall={2} />
                <div class="hall-body">
                  <p>
                    1624 年荷蘭人在台南築起熱蘭遮城。之後四百年換了八個政權，
                    平均五十年一次，每次都帶來新的語言、法律和時區。
                    <a
                      href="/history"
                      data-ga-section="hall_pill"
                      class="topic-pill"
                    >
                      📜 台灣的歷史
                    </a>
                    最不可思議的一章在 1996 年： 1,431
                    萬人走進投票所，投出華人社會第一次總統直選。
                    沒有流血，沒有政變。威權統治了三十八年的島嶼，安靜地把自己變成了民主國家。
                  </p>
                  {topPicks.history && topPicks.history.length > 0 && (
                    <div class="hall-picks">
                      {topPicks.history.map((a) => (
                        <a
                          href={a.href}
                          data-ga-section="hall_pick"
                          class="pick-card"
                        >
                          <span class="pick-head">
                            <span class="pick-title">{a.title}</span>
                            <span class="pick-fn">{a.footnotes} 引用</span>
                          </span>
                          {a.description && (
                            <span class="pick-desc">
                              {a.description.length > 80
                                ? a.description.slice(0, 77) + '...'
                                : a.description}
                            </span>
                          )}
                        </a>
                      ))}
                    </div>
                  )}

                  <p>
                    16
                    個原住民族在這裡住了六千年。閩南人帶來了媽祖，客家人帶來了義民爺，
                    外省人帶來了眷村裡的山東饅頭，東南亞新住民帶來了開齋節。
                    <a
                      href="/culture"
                      data-ga-section="hall_pill"
                      class="topic-pill"
                    >
                      🎭 台灣的文化
                    </a>
                    不是熔爐——沒有人被融掉。
                    大甲媽祖遶境九天有百萬人跟著走，鄒族的戰祭同一個月在阿里山舉行。
                    兩件事都是台灣，而且不矛盾。
                  </p>
                  {topPicks.culture && topPicks.culture.length > 0 && (
                    <div class="hall-picks">
                      {topPicks.culture.map((a) => (
                        <a
                          href={a.href}
                          data-ga-section="hall_pick"
                          class="pick-card"
                        >
                          <span class="pick-head">
                            <span class="pick-title">{a.title}</span>
                            <span class="pick-fn">{a.footnotes} 引用</span>
                          </span>
                          {a.description && (
                            <span class="pick-desc">
                              {a.description.length > 80
                                ? a.description.slice(0, 77) + '...'
                                : a.description}
                            </span>
                          )}
                        </a>
                      ))}
                    </div>
                  )}

                  <p>
                    2019 年 5 月 17
                    日，立法院投票通過同婚專法，台灣成為亞洲第一個同性婚姻合法化的國家。
                    半年前的公投裡，765 萬人才剛投票反對。
                    <a
                      href="/society"
                      data-ga-section="hall_pill"
                      class="topic-pill"
                    >
                      ⚖️ 台灣社會
                    </a>
                    最迷人的地方就在這裡：
                    公投說不，立法院說是，然後社會繼續運轉。吵完繼續一起排隊買早餐。
                  </p>
                  {topPicks.society && topPicks.society.length > 0 && (
                    <div class="hall-picks">
                      {topPicks.society.map((a) => (
                        <a
                          href={a.href}
                          data-ga-section="hall_pick"
                          class="pick-card"
                        >
                          <span class="pick-head">
                            <span class="pick-title">{a.title}</span>
                            <span class="pick-fn">{a.footnotes} 引用</span>
                          </span>
                          {a.description && (
                            <span class="pick-desc">
                              {a.description.length > 80
                                ? a.description.slice(0, 77) + '...'
                                : a.description}
                            </span>
                          )}
                        </a>
                      ))}
                    </div>
                  )}
                </div>
              </div>

              {/* ── Bridge 2→3 ── */}
              <div class="hall-bridge">
                <div class="hall-bridge-line" />
                <em class="hall-bridge-text">{t('home.bridge.2to3')}</em>
                <div class="hall-bridge-line" />
              </div>

              {/* ── 展廳三：這座島的人在做什麼 ── */}
              <div class="exhibition-hall">
                <div class="hall-divider">
                  <div class="hall-line" />
                  <span class="hall-label">參 — 這座島的人在做什麼</span>
                  <div class="hall-line" />
                </div>
                <HallThumb hall={3} />
                <div class="hall-body">
                  <p>
                    嚴長壽高中畢業在美國運通送信，五年後當上總經理。
                    林書豪坐了兩年板凳，然後用一週改寫了 NBA 的亞裔敘事。
                    陳樹菊在台東市場賣菜四十八年，捐了一千多萬。
                    <a
                      href="/people"
                      data-ga-section="hall_pill"
                      class="topic-pill"
                    >
                      👥 台灣的人物
                    </a>
                    沒有一個是從教科書裡走出來的——
                    他們的故事之所以值得讀，是因為每一個轉折都有可能不發生。
                  </p>
                  {topPicks.people && topPicks.people.length > 0 && (
                    <div class="hall-picks">
                      {topPicks.people.map((a) => (
                        <a
                          href={a.href}
                          data-ga-section="hall_pick"
                          class="pick-card"
                        >
                          <span class="pick-head">
                            <span class="pick-title">{a.title}</span>
