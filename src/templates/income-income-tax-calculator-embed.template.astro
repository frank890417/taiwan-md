---
/**
 * /embed/income/income-tax-calculator/ 內嵌板（13 語共用）。給別的網站用 iframe 嵌入。
 */
import IncomeToolEmbed from '../components/income/IncomeToolEmbed.astro';
import IncomeTaxCalculator from '../components/income/tools/IncomeTaxCalculator.astro';
import { getLangFromUrl } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
---

<IncomeToolEmbed lang={lang} slug="income-tax-calculator" ns="tax">
  <IncomeTaxCalculator lang={lang} variant="embed" />
</IncomeToolEmbed>
