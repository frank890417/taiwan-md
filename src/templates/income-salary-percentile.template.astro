---
/**
 * /income/salary-percentile/ 單獨工具頁（13 語共用）。版型由地基的 ToolPage 提供，
 * 文案在 src/i18n/income/，計算在 src/utils/income/。
 */
import IncomeToolPage from '../components/income/IncomeToolPage.astro';
import SalaryPercentile from '../components/income/tools/SalaryPercentile.astro';
import { getLangFromUrl } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
---

<IncomeToolPage
  lang={lang}
  slug="salary-percentile"
  ns="percentile"
  embedHeight={640}
>
  <SalaryPercentile lang={lang} variant="page" />
</IncomeToolPage>
