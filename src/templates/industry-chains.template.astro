---
/**
 * industry-chains.template.astro — /industry/supply-chains「供應鏈地圖」（13 語共用 template）。
 *
 * 設計報告：reports/design-industry-topic-2026-11-10.md §4.2 T2、T5
 * 內容：src/data/industry/content/chains.json（環節、公司、角色、出處；文字 {zh,en}）
 * 元件：src/components/industry/ChainFlow.astro（語意 HTML 流程，全部預設可見）
 *
 * 每家公司的角色只寫「它在這一環做什麼」，出處是公司年報、官網或公開資訊觀測站。
 * 不寫市占、排名、股價與任何評價。
 */
import '../styles/budget.css';
import '../styles/industry.css';
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import ChainFlow from '../components/industry/ChainFlow.astro';
import { getLangFromUrl, useTranslatedPath } from '../i18n/utils';
import { useIndustryT, hasIndustryLocale } from '../i18n/industry';
import { related, relatedList } from '../utils/industryRelated';
import companiesMeta from '../data/industry/companies-meta.json';
import chainsData from '../data/industry/content/chains.json';

const lang = getLangFromUrl(Astro.url);
const ti = useIndustryT(lang);
const translatePath = useTranslatedPath(lang);
const zh = lang === 'zh-TW';
const cjk = ['zh-TW', 'ja', 'ko'].includes(lang);
const companiesHref = translatePath('/companies/');
const CH = chainsData as any;
// 榜內（前 50 大）才有 /companies 的列可以連；掉榜名單在 meta 裡但沒有表格列
const inTable = new Set(
  Object.entries(companiesMeta.companies as Record<string, any>)
    .filter(([, m]) => m.inTop50)
    .map(([t]) => t),
);

const chains = [];
for (const c of CH.chains) {
  const stages = [];
  for (const s of c.stages) {
    const companies = [];
    for (const co of s.companies) {
      let href: string | undefined;
      if (co.ticker && inTable.has(co.ticker)) {
        href = `${companiesHref}#c-${co.ticker}`;
      } else if (co.article) {
        href = (await related(lang, co.article[0], co.article[1]))?.href;
      }
      const key = `chains.chains.${c.id}.stages.${s.id}.companies.${co.id}`;
      companies.push({
        name: cjk ? co.name : co.en ? `${co.en}（${co.name}）` : co.name,
        ticker: co.ticker,
        role: ti(`${key}.role`),
        hq: co.hq ? ti(`county.${co.hq}`) : undefined,
        href,
        sourceUrl: co.url,
      });
    }
    const sk = `chains.chains.${c.id}.stages.${s.id}`;
    stages.push({
      id: s.id,
      name: ti(`${sk}.name`),
      what: ti(`${sk}.what`),
      companies,
      foreignNote: s.gap ? ti(`${sk}.gap`) : undefined,
      foreignSourceUrl: s.gapUrl,
    });
  }
  chains.push({
    id: c.id,
    title: ti(`chains.chains.${c.id}.title`),
    lede: ti(`chains.chains.${c.id}.lede`),
    stages,
    rel: await relatedList(lang, c.articles ?? []),
    nCompanies: stages.reduce((a, s) => a + s.companies.length, 0),
  });
}
const labels = {
  stage: ti('ch.label.stage'),
  company: ti('ch.label.company'),
  role: ti('ch.label.role'),
  hq: ti('ch.label.hq'),
  gap: ti('ch.label.gap'),
  source: ti('label.source'),
  table: ti('ch.label.table'),
};
---

<Layout
  lang={lang}
  title={ti('ch.meta.title')}
  description={ti('ch.meta.description')}
  readerSettings={true}
>
  <main class="budget-page industry-page min-h-screen">
    <PageHero
      eyebrow={ti('ch.hero.eyebrow')}
      title={ti('ch.hero.title')}
      subtitle={ti('ch.hero.subtitle')}
      titleSize="clamp"
      containerWidth="wide"
    >
      <blockquote class="bp-kicker bp-hero-verse">
        {ti('ch.hero.verse')}
      </blockquote>
      <p class="ip-disclaimer">
        <b>{ti('disclaimer.h')}</b>
        {ti('ch.disclaimer.p')}
      </p>
      {
        !zh && !hasIndustryLocale(lang) && (
          <p class="ip-langnote">{ti('langnote')}</p>
        )
      }
    </PageHero>

    <section class="bp-section" id="chains">
      <div class="bp-wrap">
        <h2 class="bp-h2">{ti('ch.h2')}</h2>
        <p class="bp-lede">{ti('ch.lede')}</p>
        <nav class="ip-chain-toc bp-related" aria-label={ti('ch.toc')}>
          {
            chains.map((c) => (
              <a href={`#chain-${c.id}`}>
                {c.title}（{c.stages.length}／{c.nCompanies}）
              </a>
            ))
          }
          <a href={translatePath('/industry/')}>← {ti('ch.back')}</a>
        </nav>
        <form class="ip-find" id="ip-find" hidden>
          <label for="ip-find-q">{ti('ch.find.label')}</label>
          <input
            id="ip-find-q"
            type="search"
            autocomplete="off"
            placeholder={ti('ch.find.placeholder')}
            data-none={ti('ch.find.none')}
            data-hit={ti('ch.find.hit')}
          />
          <p class="ip-find-out" id="ip-find-out" aria-live="polite"></p>
        </form>

        {
          chains.map((c) => (
            <>
              <ChainFlow
                id={`chain-${c.id}`}
                title={c.title}
                lede={c.lede}
                stages={c.stages}
                labels={labels}
              />
              {c.rel.length > 0 && (
                <div class="bp-related is-inline">
                  <span class="bp-related-k">{ti('label.related')}</span>
                  {c.rel.map((r) => (
                    <a href={r.href} title={r.desc}>
                      {r.title}
                    </a>
                  ))}
                </div>
              )}
            </>
          ))
        }
      </div>
    </section>

    <section class="bp-section" id="method">
      <div class="bp-wrap">
        <h2 class="bp-h2">{ti('ch.method.h2')}</h2>
        <div class="bp-prose">
          <p>{ti('ch.method.p1')}</p>
          <p>{ti('ch.method.p2')}</p>
          <p>{ti('ch.method.p3')}</p>
        </div>
        <div class="bp-related">
          <a href={translatePath('/industry/')}>📖 {ti('ch.back')}</a>
          <a href={`${companiesHref}#rank`}>🏢 {ti('s9.tool.rank.h')}</a>
          <a
            href="https://github.com/frank890417/taiwan-md/blob/main/data/industry/research/supply-chains.json"
            target="_blank"
            rel="noopener">⬇︎ {ti('s9.research')}</a
          >
          <a
            href="https://github.com/frank890417/taiwan-md/issues/new"
            target="_blank"
            rel="noopener">✎ {ti('s9.corrections')}</a
          >
        </div>
        <p class="bg-chart-src">
          {ti('ch.asof', { date: CH.asOf })}
        </p>
      </div>
    </section>
  </main>

  <script>
    // 「這家公司在哪條鏈上」：輸入公司名或代號，標亮出現的節點並報出位置。純前端，資料就是頁面上的節點。
    const form = document.getElementById('ip-find') as HTMLFormElement | null;
    const input = document.getElementById(
      'ip-find-q',
    ) as HTMLInputElement | null;
    const out = document.getElementById('ip-find-out');
    if (form && input && out) {
      const nodes = Array.from(
        document.querySelectorAll<HTMLElement>('.ip-node'),
      );
      form.hidden = false;
      form.addEventListener('submit', (e) => e.preventDefault());
      const run = () => {
        const q = input.value.trim().toLowerCase();
        const hits: string[] = [];
        for (const n of nodes) {
          const on = q.length > 0 && (n.dataset.node || '').includes(q);
          n.classList.toggle('is-hit', on);
          if (on) {
            const stage = n
              .closest('.ip-stage')
              ?.querySelector('.ip-stage-name')?.textContent;
            const chain = n
              .closest('.ip-chain')
              ?.querySelector('.ip-chain-h')?.textContent;
            hits.push(`${chain} › ${stage}`);
          }
        }
        out.textContent = !q
          ? ''
          : hits.length
            ? `${input.dataset.hit}${[...new Set(hits)].join('；')}`
            : input.dataset.none || '';
      };
      input.addEventListener('input', run);
      const q = new URLSearchParams(location.search).get('q');
      if (q) {
        input.value = q;
        run();
      }
    }
  </script>
</Layout>
