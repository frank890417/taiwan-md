  </main>

  <script>
    // 漸進增強：1) 時間軸分軌篩選（預設全部可見）；2) 黏頂子導覽 scroll-spy；
    // 3) 量 fixed header 底緣寫 --bp-sticky-top（跟 /budget 同一個變數）。
    const filter = document.getElementById('ip-tl-filter');
    if (filter) {
      const items = Array.from(
        document.querySelectorAll<HTMLElement>('.ip-tl-item'),
      );
      const blocks = Array.from(
        document.querySelectorAll<HTMLElement>('.ip-era-block'),
      );
      filter.hidden = false;
      filter.addEventListener('click', (e) => {
        const btn = (e.target as HTMLElement).closest('button');
        if (!btn) return;
        const track = btn.dataset.track!;
        filter
          .querySelectorAll('button')
          .forEach((b) => b.setAttribute('aria-pressed', String(b === btn)));
        for (const li of items) {
          li.hidden = track !== 'all' && li.dataset.track !== track;
        }
        for (const b of blocks) {
          b.hidden = !b.querySelector('.ip-tl-item:not([hidden])');
        }
      });
    }
    const subnav = document.getElementById('bp-subnav');
    if (subnav) {
      const header = document.querySelector<HTMLElement>('header');
      const setTop = () => {
        const b = header?.getBoundingClientRect().bottom ?? 0;
        document.documentElement.style.setProperty(
          '--bp-sticky-top',
          `${Math.max(0, Math.round(b))}px`,
        );
      };
      setTop();
      window.addEventListener('resize', setTop, { passive: true });
      const links = Array.from(
        subnav.querySelectorAll<HTMLAnchorElement>('a[data-target]'),
      );
      const io = new IntersectionObserver(
        (entries) => {
          for (const en of entries) {
            if (!en.isIntersecting) continue;
            for (const a of links) {
              const on = a.dataset.target === en.target.id;
              a.classList.toggle('is-active', on);
              if (on) a.scrollIntoView({ block: 'nearest', inline: 'center' });
            }
          }
        },
        { rootMargin: '-40% 0px -55% 0px' },
      );
      links.forEach((a) => {
        const el = document.getElementById(a.dataset.target!);
        if (el) io.observe(el);
      });
    }
  </script>
</Layout>
