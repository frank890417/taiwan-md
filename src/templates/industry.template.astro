---

<Layout
  lang={lang}
  title={ti('meta.title')}
  description={ti('meta.description')}
  readerSettings={true}
>
  <main class="budget-page industry-page min-h-screen">
    <PageHero
      eyebrow={ti('hero.eyebrow')}
      title={ti('hero.title')}
      subtitle={ti('hero.subtitle')}
      titleSize="clamp"
      containerWidth="wide"
    >
      <blockquote class="bp-kicker bp-hero-verse">
        {ti('hero.verse')}
      </blockquote>
      <div class="bp-hero-stats">
        <div class="bp-stat is-warm">
          <div class="bp-stat-v">{pct1(elecShare)}</div>
          <div class="bp-stat-l">
            {ti('hero.stat.export', { year: expY1 })}
          </div>
        </div>
        <div class="bp-stat">
          <div class="bp-stat-v">{pct1(mfgLast)}</div>
          <div class="bp-stat-l">
            {ti('hero.stat.mfg', { year: gs.years[gs.years.length - 1] })}
          </div>
        </div>
        <div class="bp-stat is-cool">
          <div class="bp-stat-v">{fmtYi(pkTotalLast, lang)}</div>
          <div class="bp-stat-l">
            {ti('hero.stat.parks', { year: pk.years[pkLast] })}
          </div>
        </div>
        <div class="bp-stat is-warm">
          <div class="bp-stat-v">{pct1(conc.top1Pct)}</div>
          <div class="bp-stat-l">
            {ti('hero.stat.tsmc', { date: COMPANIES_SNAPSHOT_DATE })}
          </div>
        </div>
      </div>
      <p class="ip-disclaimer">
        <b>{ti('disclaimer.h')}</b>
        {ti('disclaimer.p')}
      </p>
      {
        !zh && !hasIndustryLocale(lang) && (
          <p class="ip-langnote">{ti('langnote')}</p>
        )
      }
      <nav class="bp-brief" aria-label={ti('hero.jump')}>
        <h2 class="bp-brief-h">{ti('hero.brief')}</h2>
        <ol class="bp-brief-list">
          {
            toc.map((s, i) => (
              <li>
                <a href={`#${s.id}`}>
                  <span class="bp-brief-n">{i + 1}</span>
                  <span class="bp-brief-body">
                    <span class="bp-brief-label">{s.label}</span>
                    <span class="bp-brief-take">{s.take}</span>
                  </span>
                </a>
              </li>
            ))
          }
        </ol>
      </nav>
    </PageHero>

    <nav class="bp-subnav" aria-label={ti('subnav.label')} id="bp-subnav">
      <div class="bp-subnav-in">
        {
          toc.map((s) => (
            <a href={`#${s.id}`} data-target={s.id}>
              {s.label}
            </a>
          ))
        }
      </div>
    </nav>

    <!-- §1 歷史 -->
    <section class="bp-section" id="s1">
      <div class="bp-wrap">
        <blockquote class="bp-kicker">{ti('s1.kicker')}</blockquote>
        <h2 class="bp-h2">{ti('s1.h2')}</h2>
        <p class="bp-lede">{ti('s1.lede')}</p>
        <StackedArea
          id="c-longexp"
          title={ti('s1.chart.title')}
          subtitle={ti('s1.chart.sub')}
          years={lh.years}
          cats={lhCats}
          values={lh.rows.map((r: any) => r.values)}
          mode="share"
          lang={lang}
          source={srcLineL(lh.source)}
        />
        <div class="bp-prose">
          <p>{ti('s1.p1')}</p>
          <p>{ti('s1.p2')}</p>
        </div>

        <h3 class="bp-h3" id="timeline">{ti('s1.tl.h')}</h3>
        <p class="bp-note">{ti('s1.tl.note')}</p>
        <div class="ip-tl-filter" id="ip-tl-filter" hidden>
          <button type="button" data-track="all" aria-pressed="true">
            {ti('tl.all')}
          </button>
          {
            tracks.map((k) => (
              <button type="button" data-track={k} aria-pressed="false">
                <span class={`ip-tl-dot ip-track-${k}`} aria-hidden="true" />
                {ti(`tl.track.${k}`)}
              </button>
            ))
          }
        </div>
        {
          eventsByEra.map(({ era, events }: any) => (
