---
/**
 * names-romanize.template.astro — /names/romanize 姓名拼音工具頁（zh-TW／en／ja 共用）。
 *
 * 工具本體是 src/components/names/NameConverter.astro（主頁內嵌的是同一個元件的精簡模式）。
 * 這一頁多三樣東西：做不到的事（逐條寫明）、它怎麼算的、官方對照表全文（無 JS 也查得到）。
 * 設計報告：reports/design-names-topic-2026-11-10.md §4.1
 */
import '../styles/budget.css';
import '../styles/names.css';
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import NameConverter from '../components/names/NameConverter.astro';
import { getLangFromUrl, useTranslatedPath } from '../i18n/utils';
import { useNames, toolStrings } from '../i18n/names';
import boca from '../data/names/boca-table.json';
import { SOURCES } from '../data/names/story';
import { nlang, pick3, rich, srcNo } from '../utils/names/page';

const lang = getLangFromUrl(Astro.url);
const translatePath = useTranslatedPath(lang);
const L = nlang(lang);
const table = boca as any;
const V = { bocaRows: table.rows.length };
const tn0 = useNames(lang);
const t = (k: string) => tn0(k, V);
const S = toolStrings(lang);
// 這一頁只引用到的來源，編號沿用主頁（同一張清單）
const used = ['S3', 'S5', 'S6', 'S15', 'S16', 'S30'];
const sources = SOURCES.filter((s) => used.includes(s.id));
---

<Layout
  lang={lang}
  title={t('rz.meta.title')}
  description={t('rz.meta.desc')}
  readerSettings={true}
>
  <main class="budget-page names-page min-h-screen">
    <PageHero
      eyebrow={t('rz.hero.eyebrow')}
      title={t('rz.hero.title')}
      subtitle={t('rz.hero.subtitle')}
      titleSize="clamp"
      containerWidth="wide"
    />
    <section class="bp-section" id="tool">
      <div class="bp-wrap">
        <div class="np-cta">
          <a class="is-ghost" href={translatePath('/names')}>{t('rz.back')}</a>
        </div>
        <NameConverter
          s={S}
          mode="full"
          initial={t('anat.name')}
          uiLang={lang}
        />
      </div>
    </section>

    <section class="bp-section" id="limits">
      <div class="bp-wrap">
        <h2 class="bp-h2">{t('rz.limits.h')}</h2>
        <ol class="np-srclist">
          {[1, 2, 3, 4, 5, 6, 7, 8].map((n) => <li>{t(`rz.limits.${n}`)}</li>)}
        </ol>
      </div>
    </section>

    <section class="bp-section" id="how">
      <div class="bp-wrap">
        <h2 class="bp-h2">{t('rz.how.h')}</h2>
        <div class="bp-prose">
          <p set:html={rich(t('rz.how.p1'))} />
          <p set:html={rich(t('rz.how.p2'))} />
        </div>

        <h3 class="bp-h3">{t('rz.table.h')}</h3>
        <p class="bp-lede">
          {t('rz.table.p')}
          <a class="np-fn" href="#src-S3">[{srcNo('S3')}]</a>
        </p>
        <details class="bg-table" id="official-table">
          <summary>{t('rz.table.summary')}</summary>
          <div class="bg-table-wrap">
            <table class="np-rom">
              <thead>
                <tr>
                  <th scope="col">{t('rz.col.zy')}</th>
                  <th scope="col">{t('s3.col.wg')}</th>
                  <th scope="col">{t('s3.col.mps2')}</th>
                  <th scope="col">{t('s3.col.tongyong')}</th>
                  <th scope="col">{t('s3.col.hanyu')}</th>
                </tr>
              </thead>
              <tbody>
                {
                  table.rows.map((row: string[]) => (
                    <tr>
                      <td lang="zh-Hant">{row[0]}</td>
                      <td class="rom">{row[1]}</td>
                      <td class="rom">{row[2]}</td>
                      <td class="rom">{row[3]}</td>
                      <td class="rom">{row[4]}</td>
                    </tr>
                  ))
                }
              </tbody>
            </table>
          </div>
        </details>

        <h3 class="bp-h3">{t('s8.sources.h')}</h3>
        <ul class="np-srclist" style="list-style:none;padding-inline-start:0">
          {
            sources.map((sc) => (
              <li id={`src-${sc.id}`}>
                [{srcNo(sc.id)}]{' '}
                <a href={sc.url} target="_blank" rel="noopener">
                  {pick3(sc.title, L)}
                </a>
                <span> · {sc.date}</span>
              </li>
            ))
          }
        </ul>
        <div class="np-cta">
          <a href={translatePath('/names')}>{t('rz.back')}</a>
        </div>
      </div>
    </section>
  </main>
</Layout>
