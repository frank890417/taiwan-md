---
/**
 * names.template.astro — /names「台灣人的名字」專題主頁（zh-TW／en／ja 共用）。
 *
 * 設計報告：reports/design-names-topic-2026-11-10.md（EVOLVE Mode 4）
 * 資料：src/data/names/moi.json（scripts/tools/build-names-data.py 從研究檔產生）、
 *       src/data/names/story.ts（時間軸、名制、各方說法、來源清單）、
 *       src/data/names/boca-table.json（領事事務局對照表）、surname-readings.json
 * 文案：src/i18n/names.ts。數字不寫在文案裡，文案用 {變數}，這裡從資料檔取值填入。
 * 版面與圖表樣式沿用 src/styles/budget.css（主元素同時掛 budget-page 與 names-page）。
 * 爭議段落（拼音政策、原住民族正名、新住民姓名）各方具名並列，頁面不下結論。
 */
import '../styles/budget.css';
import '../styles/names.css';
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import HBars from '../components/names/HBars.astro';
import TrendLine from '../components/names/TrendLine.astro';
import NameConverter from '../components/names/NameConverter.astro';
import { getLangFromUrl, useTranslatedPath } from '../i18n/utils';
import { useNames, toolStrings } from '../i18n/names';
import moi from '../data/names/moi.json';
import boca from '../data/names/boca-table.json';
import surnameReadings from '../data/names/surname-readings.json';
import {
  SOURCES,
  ROMAN_TIMELINE,
  INDIGENOUS_TIMELINE,
  NAMING_SYSTEMS,
  ROMAN_VOICES,
  INDIGENOUS_VOICES,
  IMMIGRANT_VOICES,
} from '../data/names/story';
import {
  nlang,
  pick3,
  rich,
  fnHtml,
  fmtInt,
  wgGiven,
  surnameRow,
  zhuyinOf,
  countyShort,
  TILE_GRID,
  COUNTY_EN,
} from '../utils/names/page';
import { makeRelated } from '../utils/names/related';
import { romanizeSyllable } from '../utils/names/romanize';

const lang = getLangFromUrl(Astro.url);
const translatePath = useTranslatedPath(lang);
const L = nlang(lang);
const en = L === 'en';
const m = moi as any;

// ── 從資料檔取值（文案的 {變數} 全部來自這裡）───────────────────────
const pop = m.meta.population as number;
const rows = m.surnames.rows as [number, string, number, number][];
const conc = m.concentration.rows as [string, number, number, number][];
const top10Pct = conc[0][2];
const top20Pct = conc[1][3];
const top100Pct = conc[9][3];
const chen = rows[0];
const lin = rows[1];
const cohortsF = m.cohorts.female as any[];
const cohortsM = m.cohorts.male as any[];
const cohortCount = (list: any[], roc: number, name: string): number =>
  (list
    .find((c) => c.roc[0] === roc)
    ?.top.find((t: [string, number]) => t[0] === name) || [0, 0])[1];
const shufenN = m.given.female[0][1] as number;
const shufenPeak =
  cohortCount(cohortsF, 50, '淑芬') + cohortCount(cohortsF, 60, '淑芬');
const momHist = m.motherSurname.history.rows as [number, number][];
const momRecent = m.motherSurname.recent.rows as [
  string,
  number,
  number,
  number,
][];
const momLast = momRecent[momRecent.length - 1];
const nc = m.nameChanges.rows as [number, number][];
const romTop15 = rows.slice(0, 15).map((r) => surnameRow(r[1]));
const romSame = romTop15.filter(
  (r) => r.wg === r.hanyu && r.wg === r.tongyong && r.wg === r.mps2,
).length;
const V: Record<string, string | number> = {
  nSurnames: fmtInt(m.counts.surnames),
  nCompound: m.counts.compound,
  compoundPop: fmtInt(m.counts.compoundPop),
  restSurnames: fmtInt(m.counts.surnames - 100),
  top10Pct,
  top20Pct,
  top100Pct,
  chenN: fmtInt(chen[2]),
  chenPct: chen[3],
  linPct: lin[3],
  chenLinPct: (((chen[2] + lin[2]) / pop) * 100).toFixed(2),
  rareOne: m.rare.one,
  rareTen: m.rare.tenOrLess,
  rareTenPct: m.rare.tenOrLessPct,
  singlePop: fmtInt(m.singleName.pop),
  singlePct: m.singleName.pct,
  longTotal: fmtInt(m.longNames.total),
  longIndPct: m.longNames.indigenousPct,
  spouseTotal: fmtInt(m.spouseSurname.total),
  spousePct: m.spouseSurname.pct,
  spouseFemPct: m.spouseSurname.femalePct,
  spFlowAdd: fmtInt(m.spouseSurname.flowAdd),
  spFlowRemove: fmtInt(m.spouseSurname.flowRemove),
  redupPop: fmtInt(m.reduplicated.pop),
  redupFemale: fmtInt(m.reduplicated.female),
  shufenN: fmtInt(shufenN),
  jiahaoN: fmtInt(m.given.male[0][1]),
  shufenPeak: fmtInt(shufenPeak),
  shufenPeakPct: ((shufenPeak / shufenN) * 100).toFixed(1),
  indPop: fmtInt(m.indigenous.population),
  indParallel: fmtInt(m.indigenous.romanizedParallel),
  indParallelPct: m.indigenous.romanizedParallelPct,
  indRestored: fmtInt(m.indigenous.restored),
  indRestoredHan: fmtInt(m.indigenous.restoredHan),
  indBirthTrad: fmtInt(m.indigenous.birthTraditional),
  indOther: fmtInt(m.indigenous.other),
  indTop10Pct: m.indigenous.top10Pct,
  mom2008: momHist[0][1],
  momLatest: momLast[3].toFixed(1),
  momLatestN: fmtInt(momLast[2]),
  momLatestTotal: fmtInt(momLast[1]),
  agreedMotherPct: m.motherAgreement.agreedMotherPct,
  oneParty: fmtInt(m.motherAgreement.oneParty),
  onePartyMotherPct: m.motherAgreement.onePartyMotherPct.toFixed(1),
  draw: m.motherAgreement.draw,
  taitung: m.motherAgreement.topCounties['臺東縣'],
  hualien: m.motherAgreement.topCounties['花蓮縣'],
  nc2013: fmtInt(nc[0][1]),
  nc2022: fmtInt(nc[nc.length - 1][1]),
  ncDropPct: (((nc[0][1] - nc[nc.length - 1][1]) / nc[0][1]) * 100).toFixed(1),
  bocaRows: (boca as any).rows.length,
  romSame,
};
const tn0 = useNames(lang);
const t = (k: string) => tn0(k, V);
const r = (k: string) => rich(t(k));

// ── 英雄區：一個名字，四種拼法 ───────────────────────────────────────
const anatName = Array.from(t('anat.name'));
const anatZy = anatName.map((c, i) => zhuyinOf(c, i === 0));
const anatSpell = (['wg', 'hanyu', 'tongyong', 'mps2'] as const).map((sys) => {
  const p = anatZy.map((z) => romanizeSyllable(z)![sys]);
  return { sys, surname: p[0], given: p.slice(1).join('-') };
});

// ── §1 姓氏 ──────────────────────────────────────────────────────────
const concSegs = [
  { cls: 's0', pct: conc[0][2], label: t('s1.conc.l0') },
  { cls: 's1', pct: conc[1][2], label: t('s1.conc.l1') },
  {
    cls: 's2',
    pct: +(top100Pct - top20Pct).toFixed(2),
    label: t('s1.conc.l2'),
  },
  { cls: 's3', pct: +(100 - top100Pct).toFixed(2), label: t('s1.conc.l3') },
];
const top20Bars = rows.slice(0, 20).map((row) => ({
  id: `sn-${row[0]}`,
  label: en ? `${row[1]} ${surnameRow(row[1]).enLabel}` : row[1],
  value: row[2],
  text: fmtInt(row[2]),
  extra: `${row[3]}%`,
  highlight: row[0] <= 10,
}));
const national10 = new Set(rows.slice(0, 10).map((x) => x[1]));
const countyMap = new Map(
  (m.counties.rows as [string, string[], number][]).map((c) => [
    countyShort(c[0]),
    c,
  ]),
);
const tiles = TILE_GRID.flat().map((k) => {
  if (!k) return null;
  const c = countyMap.get(k);
  if (!c) throw new Error(`[names] 縣市磚對不上資料：${k}`);
  return {
    key: k,
    name: en ? COUNTY_EN[k] : k,
    top: c[1][0],
    local: c[1].filter((s) => !national10.has(s)),
    pct: c[2],
    full: c[1].join('、'),
  };
});

// ── §2 年代 ──────────────────────────────────────────────────────────
const nameCell = (n: string) => (en ? `${n} ${wgGiven(n)}` : n);
const cohortRows = cohortsF
  .map((f: any, i: number) => ({ f, mm: cohortsM[i] }))
  // 最早一個年代（1912–1920）前十名都只有個位數，不放進主表，留在資料表
  .filter(({ f }) => f.roc[0] >= 10);
const yearsLabel = (c: any) =>
  c.partial ? `${c.ce[0]}–${c.ce[1]}.6` : `${c.ce[0]}–${c.ce[1]}`;
const rocLabel = (c: any) => tn0('s2.roc', { a: c.roc[0], b: c.roc[1] });

// ── §4 台語客語 ──────────────────────────────────────────────────────
const sr = surnameReadings as any;
const localRows = sr.rows.slice(0, 12).map((x: any) => ({
  ...x,
  toned: surnameRow(x.surname).toned,
  href: sr.meta.taigi.entry.replace('{id}', x.sutianId),
}));
const toneSup = (s: string) => s.replace(/(\d+)$/, '<sup>$1</sup>');

// ── §6 改名與從姓 ────────────────────────────────────────────────────
const ncBars = nc.map(([y, v]) => ({
  id: `nc-${y}`,
  label: String(y),
  value: v,
  text: fmtInt(v),
}));
const momPoints: [number, number][] = [
  ...momHist,
  ...momRecent
    .filter((x) => parseInt(x[0], 10) + 1911 > momHist[momHist.length - 1][0])
    .map((x) => [parseInt(x[0], 10) + 1911, x[3]] as [number, number]),
];

// ── 站內延伸閱讀 ─────────────────────────────────────────────────────
const related = await makeRelated(lang);
const REL = {
  s0: await related([
    ['Culture', '菜市場名'],
    ['Culture', '台灣人小時候的英文名字'],
    ['Culture', '台灣婚喪喜慶與人生禮俗'],
    ['Culture', '滿月習俗'],
  ]),
  s1: await related([
    ['Culture', '族群（閩南客家原住民外省新住民）'],
    ['Culture', '客家文化與語言'],
    ['Society', '外省人'],
    ['History', '平埔族'],
  ]),
  s2: await related([
    ['Culture', '菜市場名'],
    ['History', '日治時期'],
    ['Culture', '台灣諧音禁忌文化'],
  ]),
  s3: await related([
    ['Culture', '注音符號'],
    ['Culture', '台灣華語的演化'],
    ['Technology', '東亞文字輸入法'],
    ['Society', '中華台北'],
    ['Society', '台灣在國際標準中的標示問題'],
  ]),
  s4: await related([
    ['Culture', '語言多樣性與母語文化'],
    ['Culture', '台灣教會公報'],
    ['People', '蔡培火'],
    ['People', '蔣為文'],
    ['Culture', '客家文化與語言'],
    ['People', '杜潘芳格'],
  ]),
  s5: await related([
    ['Culture', '台灣原住民族姓名'],
    ['Politics', '原住民族正名'],
    ['History', '台灣原住民族歷史與正名運動'],
    ['People', '莫那能'],
    ['Culture', '台灣原住民族16族文化地圖'],
    ['Culture', '台灣原住民語言復振運動'],
  ]),
  s6: await related([
    ['History', '婦女運動'],
    ['Society', '婦女新知'],
    ['Society', '台灣少子化危機'],
    ['Society', '人權與性別平等'],
  ]),
  s7: await related([
    ['Culture', '台灣人小時候的英文名字'],
    ['Society', '移工'],
    ['Society', '台灣海外僑民與離散社群'],
    ['Food', '台灣新住民美食融合'],
  ]),
  people: await related([
    ['People', '莫那能'],
    ['People', '阿爆'],
    ['People', '張惠妹'],
    ['People', '李登輝'],
    ['People', '鄭成功'],
    ['People', '唐鳳'],
    ['People', '鄧麗君'],
    ['People', '三毛'],
    ['People', '陽岱鋼'],
    ['People', '林強'],
  ]),
};

const toc = [0, 1, 2, 3, 4, 5, 6, 7, 8].map((n) => ({
  id: `s${n}`,
  label: t(`toc.s${n}`),
  take: t(`toc.s${n}.take`),
}));
const moiSrc = pick3(SOURCES[0].title, L);
const S = toolStrings(lang);
const voices = (list: typeof ROMAN_VOICES) =>
  list.map((side, i) => ({
    cls: ['side-a', 'side-b', 'side-c'][i] || 'side-c',
    title: pick3(side.title, L),
    items: side.items.map((it) => ({
      html: rich(pick3(it.text, L)) + fnHtml(it.src),
    })),
  }));
const timeline = (list: typeof ROMAN_TIMELINE) =>
  list.map((e) => ({
    date: e.date,
    cls: e.kind === 'pass' ? 'is-pass' : e.kind === 'key' ? 'is-key' : '',
    html: rich(pick3(e.text, L)) + fnHtml(e.src),
  }));
---

<Layout
  lang={lang}
  title={t('meta.title')}
  description={t('meta.desc')}
  readerSettings={true}
>
  <main class="budget-page names-page min-h-screen">
    <PageHero
      eyebrow={t('hero.eyebrow')}
      title={t('hero.title')}
      subtitle={t('hero.subtitle')}
      titleSize="clamp"
      containerWidth="wide"
    >
      <blockquote class="bp-kicker bp-hero-verse">{t('hero.verse')}</blockquote>

      <figure class="np-anatomy">
        <div class="np-anatomy-top">
          <div class="np-han" lang="zh-Hant" aria-label={t('anat.name')}>
            {
              anatName.map((c, i) => (
                <span
                  class={`np-han-cell ${i === 0 ? 'is-surname' : 'is-given'}`}
                >
                  <span class="np-han-role">
                    {i === 0
                      ? t('anat.surname')
                      : i === 1
                        ? t('anat.given')
                        : ' '}
                  </span>
                  <span class="np-han-char">{c}</span>
                  <span class="np-han-zy">{anatZy[i]}</span>
                </span>
              ))
            }
          </div>
        </div>
        <ul class="np-spell">
          {
            anatSpell.map((sp) => (
              <li>
                <span class="np-spell-sys">
                  {
                    S[
                      `sys${sp.sys === 'wg' ? 'Wg' : sp.sys === 'hanyu' ? 'Hanyu' : sp.sys === 'tongyong' ? 'Tongyong' : 'Mps2'}`
                    ]
                  }
                </span>
                <span class="np-spell-v">
                  <mark>{sp.surname}</mark>, {sp.given}
                </span>
              </li>
            ))
          }
        </ul>
        <figcaption class="np-anatomy-cap" set:html={r('anat.cap')} />
      </figure>

      <div class="bp-hero-stats">
        <div class="bp-stat">
          <div class="bp-stat-v">{V.nSurnames}</div>
          <div class="bp-stat-l">
            {t('hero.stat1.l')} · {t('hero.stat1.sub')}
          </div>
        </div>
        <div class="bp-stat is-warm">
          <div class="bp-stat-v">{top10Pct}%</div>
          <div class="bp-stat-l">
            {t('hero.stat2.l')} · {t('hero.stat2.sub')}
          </div>
        </div>
        <div class="bp-stat is-cool">
          <div class="bp-stat-v">{V.bocaRows} × 4</div>
          <div class="bp-stat-l">
            {t('hero.stat3.l')} · {t('hero.stat3.sub')}
          </div>
        </div>
        <div class="bp-stat is-warm">
          <div class="bp-stat-v">{V.momLatest}%</div>
          <div class="bp-stat-l">
            {t('hero.stat4.l')} · {t('hero.stat4.sub')}
          </div>
        </div>
      </div>

      <nav class="bp-brief" aria-label={t('hero.jump')}>
        <h2 class="bp-brief-h">{t('hero.brief')}</h2>
        <ol class="bp-brief-list">
          {
            toc.map((s, i) => (
              <li>
                <a href={`#${s.id}`}>
                  <span class="bp-brief-n">{i}</span>
                  <span class="bp-brief-body">
                    <span class="bp-brief-label">{s.label}</span>
                    <span class="bp-brief-take">{s.take}</span>
                  </span>
                </a>
              </li>
            ))
          }
        </ol>
      </nav>
    </PageHero>

    <nav class="bp-subnav" aria-label={t('subnav.label')} id="bp-subnav">
      <div class="bp-subnav-in">
        {
          toc.map((s) => (
            <a href={`#${s.id}`} data-target={s.id}>
              {s.label}
            </a>
          ))
        }
      </div>
    </nav>

    <!-- §0 構造 -->
    <section class="bp-section" id="s0">
      <div class="bp-wrap">
        <blockquote class="bp-kicker">{t('s0.kicker')}</blockquote>
        <h2 class="bp-h2">{t('s0.h2')}</h2>
        <p class="bp-lede" set:html={r('s0.lede')} />
        <div class="bp-guide">
          {
            [1, 2, 3, 4].map((n) => (
              <div class="bp-guide-card">
                <h4>{t(`s0.c${n}.h`)}</h4>
                <p set:html={r(`s0.c${n}.p`)} />
              </div>
            ))
          }
        </div>
        {
          REL.s0.length > 0 && (
            <div class="bp-related is-inline">
              <span class="bp-related-k">{t('common.related')}</span>
              {REL.s0.map((x) => (
                <a href={x.href} title={x.desc}>
                  {x.title}
                </a>
              ))}
            </div>
          )
        }
      </div>
    </section>

    <!-- §1 姓氏 -->
    <section class="bp-section" id="s1">
      <div class="bp-wrap">
        <blockquote class="bp-kicker">{t('s1.kicker')}</blockquote>
        <h2 class="bp-h2">{t('s1.h2')}</h2>
        <p class="bp-lede" set:html={r('s1.lede')} />

        <figure class="bg-chart np-conc" id="c-conc">
          <h4 class="bg-chart-title">{t('s1.conc.title')}</h4>
          <p class="bg-chart-sub">{t('s1.conc.sub')}</p>
          <div class="np-conc-bar" role="img" aria-label={t('s1.conc.title')}>
            {
              concSegs.map((sg) => (
                <div
                  class={`np-conc-seg ${sg.cls}`}
                  style={`width:${sg.pct}%`}
                  title={`${sg.label}：${sg.pct}%`}
                >
                  {sg.pct >= 8 ? `${sg.pct}%` : ''}
                </div>
              ))
            }
          </div>
          <ul class="np-conc-legend">
            {
              concSegs.map((sg) => (
                <li>
                  <i class={sg.cls} />
                  {sg.label} <b>{sg.pct}%</b>
                </li>
              ))
            }
          </ul>
          <figcaption class="bg-chart-src">
            {t('common.src')}{moiSrc}，p.25
          </figcaption>
        </figure>

        <div class="bp-prose">
          <p set:html={r('s1.p1')} />
          <p set:html={r('s1.p2')} />
        </div>

        <HBars
          id="c-surnames"
          title={t('s1.bars.title')}
          subtitle={t('s1.bars.sub')}
          rows={top20Bars}
          tick={(v: number) =>
            v === 0
              ? '0'
              : en
                ? `${(v / 1e6).toFixed(1)}M`
                : `${v / 10000}${t('common.wan')}`}
          source={`${moiSrc}，p.282–283；${t('common.derived')}`}
          sourceLabel={t('common.src')}
          tableLabel={t('common.table')}
          cols={[t('s1.bars.col1'), t('s1.bars.col2'), t('common.share')]}
        />

        <figure class="bg-chart" id="c-tiles">
          <h4 class="bg-chart-title">{t('s1.tiles.title')}</h4>
          <p class="bg-chart-sub">{t('s1.tiles.sub')}</p>
          <div class="np-tiles" role="img" aria-label={t('s1.tiles.title')}>
            {
              tiles.map((tile) =>
                tile ? (
                  <div
                    class={`np-tile ${tile.top === '林' ? 'is-lin' : ''}`}
                    title={`${tile.name}：${tile.full}（${tile.pct}%）`}
                  >
                    <span class="np-tile-c">{tile.name}</span>
                    <span class="np-tile-top" lang="zh-Hant">
                      {tile.top}
                    </span>
                    <span class="np-tile-local" lang="zh-Hant">
                      {tile.local.join('')}
                    </span>
                  </div>
                ) : (
                  <div class="np-tile is-empty" aria-hidden="true" />
                ),
              )
            }
          </div>
          <p class="np-tiles-legend" set:html={t('s1.tiles.legend')} />
          <figcaption class="bg-chart-src">
            {t('common.src')}{moiSrc}，p.30
          </figcaption>
          <details class="bg-table">
            <summary>{t('common.table')}</summary>
            <div class="bg-table-wrap">
              <table>
                <tbody>
                  {
                    tiles
                      .filter((x) => !!x)
                      .map((x) => (
                        <tr>
                          <td>{x!.name}</td>
                          <td lang="zh-Hant">{x!.full}</td>
                          <td class="num">{x!.pct}%</td>
                        </tr>
                      ))
                  }
                </tbody>
              </table>
            </div>
          </details>
        </figure>

        <div class="bp-prose">
          <p set:html={r('s1.p3')} />
        </div>
        <p class="bp-note" set:html={r('s1.note')} />
        {
          REL.s1.length > 0 && (
            <div class="bp-related is-inline">
              <span class="bp-related-k">{t('common.related')}</span>
