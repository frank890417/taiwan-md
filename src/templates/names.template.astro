  <script>
    // 黏頂子導覽：量 header 底緣；scroll-spy 高亮當前段（做法同 /budget）
    const subnav = document.getElementById('bp-subnav');
    if (subnav) {
      const measure = () => {
        const hc = document.getElementById('header-container');
        const b = hc ? hc.getBoundingClientRect().bottom : 56;
        document.documentElement.style.setProperty(
          '--bp-sticky-top',
          `${Math.max(0, Math.round(b))}px`,
        );
      };
      measure();
      window.addEventListener('resize', measure, { passive: true });
      setTimeout(measure, 800);
      const links = Array.from(
        subnav.querySelectorAll<HTMLAnchorElement>('a[data-target]'),
      );
      const sections = links
        .map((a) => document.getElementById(a.dataset.target!))
        .filter((s): s is HTMLElement => !!s);
      const setActive = (id: string) => {
        for (const a of links) {
          const on = a.dataset.target === id;
          a.classList.toggle('is-active', on);
          if (on && subnav.scrollWidth > subnav.clientWidth)
            a.scrollIntoView({
              block: 'nearest',
              inline: 'center',
              behavior: 'smooth',
            });
        }
      };
      if ('IntersectionObserver' in window) {
        const visible = new Map<string, number>();
        const io = new IntersectionObserver(
          (entries) => {
            for (const e of entries)
              visible.set(
                (e.target as HTMLElement).id,
                e.isIntersecting ? e.intersectionRatio : 0,
              );
            let bestId = '';
            let best = 0;
            for (const s of sections) {
              const v = visible.get(s.id) || 0;
              if (v > best) {
                best = v;
                bestId = s.id;
              }
            }
            if (bestId) setActive(bestId);
          },
          { rootMargin: '-40% 0px -50% 0px', threshold: [0, 0.01, 0.1, 0.25] },
        );
        sections.forEach((s) => io.observe(s));
      }
    }
  </script>
